const title = "Seeing is Believing? — Masters of Marine Illusion: Mimicry & Camouflage | Le Tsuan Design";
const description = "Seeing is Believing?: Masters of Marine Illusion: Mimicry & Camouflage. Exhibition Design for Taichung Aquarium in Taichung, Taiwan, 2026 — Le Tsuan Design.";
const canonical = "https://letsuan.com/project-marine-illusion";
