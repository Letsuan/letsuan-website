const jsonLd = [{"@context": "https://schema.org", "@type": "CreativeWork", "name": "Masters of Marine Illusion: Mimicry & Camouflage", "description": "Masters of Marine Illusion: Mimicry & Camouflage — an exhibition on the ocean's most dangerous illusions, Taichung Aquarium. Built around the two most sophisticated visual strategies in marine biology — camouflage, the art of disappearing, and mimicry, the art of being mistaken for something else — this 68㎡ exhibition.", "url": "https://letsuan.com/project-marine-illusion", "image": "https://letsuan.com/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg", "creator": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "author": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "datePublished": "2026", "hasPart": [{"@type": "CreativeWork", "name": "Design & Engineering Execution"}]}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Masters of Marine Illusion: Mimicry & Camouflage", "item": "https://letsuan.com/project-marine-illusion"}]}];
const eyebrowLeft = "EXHIBITION — 2026";
const eyebrowRight = "TAICHUNG AQUARIUM";
const h1Main = "Seeing is Believing?";
const h1Sub = "Masters of Marine Illusion: Mimicry & Camouflage";
const metaFields = [{"label": "CLIENT", "value": "Taichung Aquarium"}, {"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2026"}, {"label": "CATEGORY", "value": "Exhibition Design, Graphic Design, Visual Design, Installation Art, Construction"}];
const bodyHtml = "<p>A mimic octopus can flatten itself, bend its arms, and change color enough to pass for a flounder, a lionfish, or a sea snake to a predator swimming past. That kind of trick is what \"Masters of Marine Illusion: Mimicry &amp; Camouflage\" set out to explain, using 7 species including the mimic octopus and the pharaoh cuttlefish to walk visitors through the two most sophisticated survival strategies in marine biology: camouflage, which is the art of disappearing, and mimicry, which is the art of being mistaken for something else.</p>\n<p>The exhibition space at Taichung Aquarium measures just 68 square meters, so before exhibition design could even start, simply fitting the story in became the first problem to solve.</p>\n<h2>Taking Space Back From the Walls</h2>\n<p>Rather than compress the visitor path to make room for displays, we went after the walls instead. Every new wall structure uses an ultra-thin lining method, fitted to the millimeter against the existing shell. The thinner the wall, the more of the central floor could go to circulation and to the core motion-sensing interactive zone, which kept the flow moving during peak traffic and kept standing room open throughout. 68 square meters turned from a constraint into something closer to a calculated surplus.</p>\n<h2>Steps Instead of a Flat Wall</h2>\n<p>Once the walls receded, a new problem showed up: flush displays read as flat and a little monotonous. The aquarium tanks in the core camouflage zone were designed in a stepped, cascading arrangement instead, with staggered heights that work for both adult and child sightlines at once, letting crowds spread out naturally without directional signage forcing it. The tiered surfaces, horizontal and vertical, absorbed the signage, graphics, and indirect wall-wash lighting into one continuous reading experience across the tanks, the habitats, and the content. In the darkened space, the steps gave the light a rhythm, and visitors' feet tended to follow it without quite meaning to.</p>\n<h2>Everything Hidden, Nothing Exposed</h2>\n<p>This was the hardest engineering problem on the project, since a space this small has no room for a single visible line. Wiring for the life-support systems, lighting controls, and motion sensors is embedded entirely inside hidden channels within the thin wall assembly, leaving no cabling visible anywhere, so the deep-sea immersion never breaks over a stray wire.</p>\n<p>Screens, speakers, sensors, and projectors are all recessed and mounted flush, taking up no circulation space at all. Power for the tanks' life support, filtration, and temperature control runs on its own circuit, kept separate from the interactive and AV systems, with concealed heat dissipation and maintenance access built in from the start, since the display had to look right and still be serviceable years later, and neither could come at the other's expense.</p>\n<h2>Building Green for an Exhibition About the Ocean</h2>\n<p>Since the exhibition is fundamentally about marine conservation, we carried that principle into the construction itself. From the wall substrate and surface coatings to the trim and the full-space wall graphics, every material carries international environmental certification. The wall graphics run on eco-certified non-woven fabric, holding both the Green Building Material Label and international healthy-building-material certification aligned with LEED and WELL, made from recycled fiber, tested to Class 1 fire retardancy under CNS7614 A3125, and certified formaldehyde-free. Structure through to surface graphics, the build meets low-emission, low-off-gassing, recyclable standards throughout.</p>\n<h2>Lighting for the Animals, Not Just the Visitors</h2>\n<p>The space runs on low-ambient, high-contrast mood lighting, with deep-sea blue at #00183A as the base tone, accented only by lines of fluorescent cyan and warning yellow marking focal points. That choice wasn't only about atmosphere; it also kept bright light from stressing the living specimens in the tanks. Where a visitor's eyes land in that light was already decided before they walked in: not the wall, not the equipment behind it, but the animals caught mid-camouflage or mid-mimicry.</p>";
const relatedProjects = [{"href": "./project-la-fortuna-bordada", "label": "La Fortuna Bordada"}, {"href": "./project-missing-scientist", "label": "The Missing Scientist"}, {"href": "./project-westernmost-point", "label": "The Westernmost Point of Taiwan"}];
const nextHref = "./project-cat-art";
const images = [{"src": "./images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg", "alt": "Seeing is Believing? — Masters of Marine Illusion exhibition panorama with visitors viewing aquarium tanks"}, {"src": "./images/marine-illusion-masters-of-marine-illusion-octopus-mural-letsuan-design.jpg", "alt": "Masters of Marine Illusion octopus mural entrance wall"}, {"src": "./images/marine-illusion-masters-of-marine-illusion-visitor-letsuan-design.jpg", "alt": "Masters of Marine Illusion visitor interacting with Ocean Mimic Master game"}, {"src": "./images/marine-illusion-masters-of-marine-illusion-visitor-viewing-letsuan-design.jpg", "alt": "Masters of Marine Illusion visitor viewing tiered aquarium display"}, {"src": "./images/marine-illusion-masters-of-marine-illusion-display-case-letsuan-design.jpg", "alt": "Masters of Marine Illusion display case detail"}, {"src": "./images/marine-illusion-masters-of-marine-illusion-thin-wall-lining-letsuan-design.jpg", "alt": "Masters of Marine Illusion thin-wall lining installation in progress"}, {"src": "./images/marine-illusion-masters-of-marine-illusion-aquarium-tank-letsuan-design.jpg", "alt": "Masters of Marine Illusion aquarium tank installation detail"}];
