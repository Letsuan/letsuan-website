const ogImage = "https://letsuan.com/images/tokyo-ghost-hospital-exhibition-08-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Tokyo Ghost Hospital Exhibition", "description": "A Japanese-designed horror experience by TOEI, over 1,200 square meters.", "url": "https://letsuan.com/project-tokyo-ghost-hospital", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/tokyo-ghost-hospital-exhibition-08-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2015", "hasPart": [{"@type": "CreativeWork", "name": "1,200+ Square Metres, Two Floors, Zero Drilling"}, {"@type": "CreativeWork", "name": "Two Timelines Under One Roof"}, {"@type": "CreativeWork", "name": "Two Eras of Materials on One Job Site"}, {"@type": "CreativeWork", "name": "More Than Ten Actors, Timed to the Millisecond"}, {"@type": "CreativeWork", "name": "Walls That Couldn't Touch the Building, Yet Had to Take the Hit"}, {"@type": "CreativeWork", "name": "Built, Run, Then Erased"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Tokyo Ghost Hospital Exhibition", "item": "https://letsuan.com/project-tokyo-ghost-hospital"}]}];
