const h1Sub = "Tokyo Ghost Hospital";
const metaFields = [{"label": "CLIENT", "value": "Toei Animation"}, {"label": "LOCATION", "value": "Taipei, Taiwan"}, {"label": "YEAR", "value": "2015"}, {"label": "AREA", "value": "1,200+㎡"}, {"label": "CATEGORY", "value": "Exhibition Design, Construction"}];
const bodyHtml = "<h2>1,200+ Square Metres, Two Floors, Zero Drilling</h2>\n<p>We handled the on-site <a href=\"./what-we-do#service-construction\">construction</a> of Tokyo Ghost Hospital's Taiwan run, bringing TOEI Company's physical horror experience, refined over more than a decade of touring across Japan, to life across two floors of the west-wing special exhibition rooms at the National Taiwan Science Education Center, and completing the full teardown and restoration once the run ended. The exhibition spans the <a href=\"./portfolio\">museum</a>'s 7th and 8th floors and covers more than 1,200 square metres.</p>\n<h2>Two Timelines Under One Roof</h2>\n<p>The exhibition is built around two parallel timelines. The Modern Hospital recreates a present-day clinic, records room, ER, and operating theatre; the Past Hospital pulls visitors back to a Taisho-era clinic in Shinjuku, rebuilding a traditional doji entryway, tatami rooms, and garden. A storyline threads the two halls together, leading visitors to uncover the secret of a missing girl named SAKURA. The circulation design had to satisfy the pacing of that narrative while managing large crowds entering in controlled batches across the two floors.</p>\n<h2>Two Eras of Materials on One Job Site</h2>\n<p>Working from the Japanese team's set designs and Taisho-era architectural research, and using props and set pieces manufactured by the original Japanese studio, we built the modern clinical scenes and the traditional Japanese-style scenes inside the existing exhibition halls. That meant handling materials and construction methods spanning two eras and two completely different styles at the same time, on the same site.</p>\n<p>TOEI's standards for scene fidelity were exacting: the texture of the building materials, the colour of the aging treatment, the hardware fittings, down to the smallest set dressing, all had to faithfully capture the period feel of both Taisho-era Japanese architecture and a modern medical facility, and every detail had to pass the Japanese team's set-authenticity review before it counted as finished.</p>\n<h2>More Than Ten Actors, Timed to the Millisecond</h2>\n<p>Multiple sets of micro-switches were installed throughout the space, linking wind, scent, lighting, and sound effects, each precisely triggered along the visitor route to build an <a href=\"./what-we-do#service-exhibition\">immersive</a> horror experience in the dark. Each zone also had its own hidden passages and mechanisms, choreographed with the positioning, ambush points, and entrance timing of a cast of more than 10 professional actors, delivering multi-point, multi-character scare pacing within a limited footprint, while balancing performer safety against narrative tension.</p>\n<h2>Walls That Couldn't Touch the Building, Yet Had to Take the Hit</h2>\n<p>This was the hardest constraint in the entire project. Museum regulations prohibited any partition or set wall from being drilled or fastened into the building's original walls, floor, or ceiling; every structure had to be built purely from components supporting each other in a freestanding system, with zero contact on the existing building.</p>\n<p>But in the dark, frightened visitors instinctively push against walls and grab at props, which is a completely normal reaction. So these walls had to do two contradictory things at once: rely on the building for nothing, while still holding up against visitors pushing and grabbing at them in a moment of fright.</p>\n<p>We reinforced the structural load capacity of every non-fixed wall and every touchable prop, meeting visitor safety, scene realism, and long-term durability across the full run, all without ever anchoring into the original building.</p>\n<h2>Built, Run, Then Erased</h2>\n<p>With the exhibition spanning two special-exhibit rooms across the 7th and 8th floors, engineering plans also had to work around the existing building structure, fire-safety circulation, and visitor-flow control points, so the immersive experience and the venue's safety code could both hold true at once. Construction also had to accommodate the museum's operating schedule and its existing electrical and fire-safety systems, completing the full build within a fixed timeframe. After the run ended, from June 27 to September 13, 2015, we carried out a full teardown of the exhibition space and restored the special-exhibit rooms to their original condition for the museum's future use.</p>";
const relatedProjects = [{"href": "./project-story-telling", "label": "Story Telling by the Ancient People"}, {"href": "./project-nmns-teldap", "label": "NMNS TELDAP"}, {"href": "./project-wang-ye-donggang", "label": "The Hunt of the Celestial Court"}];
const nextHref = "./project-jehol-biota";
const images = [{"src": "./images/tokyo-ghost-hospital-exhibition-08-letsuan-design.jpg", "alt": "Two eras, one immersive scare in the dark — Tokyo Ghost Hospital effect"}, {"src": "./images/tokyo-ghost-hospital-exhibition-01-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital entrance"}, {"src": "./images/tokyo-ghost-hospital-exhibition-03-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital scene"}, {"src": "./images/tokyo-ghost-hospital-exhibition-11-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital passageway"}, {"src": "./images/tokyo-ghost-hospital-exhibition-04-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital room"}, {"src": "./images/tokyo-ghost-hospital-exhibition-05-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital corridor"}, {"src": "./images/tokyo-ghost-hospital-exhibition-02-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital hallway"}, {"src": "./images/tokyo-ghost-hospital-exhibition-06-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital set-piece detail"}, {"src": "./images/tokyo-ghost-hospital-exhibition-12-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital finale"}, {"src": "./images/tokyo-ghost-hospital-exhibition-13-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital closing scene"}, {"src": "./images/tokyo-ghost-hospital-entrance-queue-with-horror-signage-letsuan-design.jpg", "alt": "Queue entrance with Tokyo Ghost Hospital signage, stone archway and horror-themed wall graphics"}, {"src": "./images/tokyo-ghost-hospital-exhibition-07-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital installation"}, {"src": "./images/tokyo-ghost-hospital-exhibition-8810-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital scene 2"}, {"src": "./images/tokyo-ghost-hospital-exhibition-909-letsuan-design.jpg", "alt": "Tokyo Ghost Hospital display"}];
