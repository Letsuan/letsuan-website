const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "ExhibitionEvent", "name": "Know the Sea by Being Close to It — Central Taiwan Marine Conservation Education Center", "description": "Know the Sea by Being Close to It: a marine conservation education center built around three named Chinese white dolphins, inside the National Museum of Natural Science, Taichung.", "url": "https://letsuan.com/project-satoumi", "image": [{"@type": "ImageObject", "url": "https://letsuan.com/images/satoumi-marine-conservation-center-entrance-mural-letsuan-design.jpg", "caption": "Letsuan Design | Know the Sea by Being Close to It — entrance mural for the Central Taiwan Marine Conservation Education Center"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/satoumi-mangrove-fiddler-crab-diorama-display-letsuan-design.jpg", "caption": "Wetland ecology exhibit unit diorama with crabs foraging among mangrove seedlings"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/satoumi-water-ripple-light-effect-ceiling-letsuan-design.jpg", "caption": "Letsuan Design | Know the Sea by Being Close to It — shimmering water-ripple light effect across the gallery ceiling"}], "creator": {"@id": "https://letsuan.com/#organization"}, "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2024", "dateModified": "2026-09-22", "hasPart": [{"@type": "CreativeWork", "name": "From Restaurant to Conservation Center"}, {"@type": "CreativeWork", "name": "A Floor-Level Gap and a Leak"}, {"@type": "CreativeWork", "name": "An HVAC Room: Fire Safety and Noise at Once"}, {"@type": "CreativeWork", "name": "An Accessibility Review That Touched the Whole Museum"}, {"@type": "CreativeWork", "name": "Moving Materials Without Closing the Museum"}], "isPartOf": {"@id": "https://letsuan.com/#website"}, "location": {"@type": "Place", "name": "Taichung, Taiwan"}, "startDate": "2024"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Know the Sea by Being Close to It", "item": "https://letsuan.com/project-satoumi"}]}];
