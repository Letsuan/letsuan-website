---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { organizationJsonLd } from '../data/organization';

const title = "This Space Doesn't Exist — Yet. | Le Tsuan Design";
const description = "The page you followed has moved, been renamed, or never existed.";
const canonical = 'https://letsuan.com/404';
const ogImage = 'https://letsuan.com/assets/logo.png';

const directory = [
  { href: '/portfolio', label: 'Portfolio', meta: '38+ PROJECTS' },
  { href: '/what-we-do', label: 'What We Do', meta: 'SERVICES' },
  { href: '/about', label: 'About Us', meta: 'SINCE 2014' },
  { href: '/contact', label: 'Contact', meta: 'GET IN TOUCH' },
];
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={organizationJsonLd}>
  <Fragment slot="head">
    <meta http-equiv="refresh" content="5;url=/" />
  </Fragment>
  <div class="ltsuan-page">
    <Nav active="none" zhHref="/zh-TW/portfolio" />

    <div class="ltsuan-404-body">
      <div class="ltsuan-404-inner">
        <div class="ltsuan-404-code-row">
          <span class="ltsuan-404-code">404</span>
          <span class="ltsuan-404-label">WAYFINDING</span>
        </div>
        <h1 class="ltsuan-h1">This Space Doesn't Exist — Yet.</h1>
        <p class="ltsuan-lead">The page you followed has moved, been renamed, or never existed. Use the directory below, or head back to the homepage.</p>
        <p class="ltsuan-redirect-note">Redirecting to the homepage in 5 seconds&hellip;</p>

        <div class="ltsuan-404-actions">
          <a href="/" class="ltsuan-btn-primary">Back to Home</a>
          <a href="/contact" class="ltsuan-btn-secondary">Contact Us</a>
        </div>

        <div class="ltsuan-404-directory">
          <div class="ltsuan-404-directory-label">DIRECTORY</div>
          {directory.map((item) => (
            <a href={item.href} class="ltsuan-404-directory-item">
              <span>{item.label}</span>
              <span class="ltsuan-404-directory-meta">{item.meta}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <Footer />
  </div>
</Layout>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .ltsuan-404-body {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 150px 56px 90px;
  }
  .ltsuan-404-inner {
    max-width: 1000px;
    margin: 0 auto;
    width: 100%;
  }
  .ltsuan-404-code-row {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 28px;
  }
  .ltsuan-404-code {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(60px, 10vw, 140px);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--ltsuan-accent);
  }
  .ltsuan-404-label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    letter-spacing: 0.25em;
    opacity: 0.5;
    padding-bottom: 6px;
  }
  .ltsuan-h1 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(30px, 4.6vw, 54px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
    max-width: 16ch;
  }
  .ltsuan-lead {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: rgba(244, 239, 232, 0.65);
    max-width: 52ch;
    margin: 0 0 12px;
  }
  .ltsuan-redirect-note {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.4);
    max-width: 52ch;
    margin: 0 0 44px;
  }
  .ltsuan-404-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }
  .ltsuan-btn-primary {
    display: inline-block;
    padding: 16px 36px;
    background: var(--ltsuan-accent);
    color: #1a1613;
    border-radius: 999px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 14px;
    text-decoration: none;
  }
  .ltsuan-btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 16px 32px;
    border: 1px solid rgba(244, 239, 232, 0.3);
    border-radius: 999px;
    color: var(--ltsuan-text);
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 14px;
    text-decoration: none;
  }
  .ltsuan-404-directory {
    border-top: 1px solid rgba(244, 239, 232, 0.12);
  }
  .ltsuan-404-directory-label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: rgba(244, 239, 232, 0.5);
    padding: 24px 0 4px;
  }
  .ltsuan-404-directory-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    border-top: 1px solid rgba(244, 239, 232, 0.1);
    text-decoration: none;
    color: var(--ltsuan-text);
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 18px;
    transition: color 0.2s ease;
  }
  .ltsuan-404-directory-item:last-child {
    border-bottom: 1px solid rgba(244, 239, 232, 0.1);
  }
  .ltsuan-404-directory-item:hover {
    color: #8cc81e;
  }
  .ltsuan-404-directory-meta {
    font-size: 13px;
    opacity: 0.5;
    letter-spacing: 0.1em;
  }
</style>
