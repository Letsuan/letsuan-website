---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Le Tsuan Design | From Dragon to Beast";
const description = "From Dragon to Beast: Extinction and Radiation. Exhibition Design for National Museum of Natural Science in Taichung, Taiwan, 2013 — Le Tsuan Design.";
const canonical = "https://letsuan.com/project-dragon-to-beast";
const ogImage = "https://letsuan.com/images/dragon-to-beast-sauropod-skeletons-being-installed-in-outdoor-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "From Dragon to Beast: Extinction and Radiation", "description": "Dinosaur and mammal fossils from Gansu, China, National Museum of Natural Science.", "url": "https://letsuan.com/project-dragon-to-beast", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/dragon-to-beast-sauropod-skeletons-being-installed-in-outdoor-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2013", "hasPart": [{"@type": "CreativeWork", "name": "Core Techniques and Technical Highlights"}, {"@type": "CreativeWork", "name": "On-Site Crisis Response and Safety Management"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "From Dragon to Beast: Extinction and Radiation", "item": "https://letsuan.com/project-dragon-to-beast"}]}];
const eyebrowLeft = "EXHIBITION — 2013";
const eyebrowRight = "NATIONAL MUSEUM OF NATURAL SCIENCE";
const h1Main = "From Dragon to Beast";
const h1Sub = "Extinction and Radiation";
const metaFields = [{"label": "CLIENT", "value": "National Museum of Natural Science"}, {"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2013"}, {"label": "CATEGORY", "value": "Exhibition Design, Construction"}];
const bodyHtml = "<h2>30 Meters of Fossil, 6 Meters of Wall</h2>\n<p>From Dragon to Beast was the largest, highest-specification international exhibition the National Museum of Natural Science had staged to date. Over a hundred rare fossils crossed the sea from the Gansu Geological Museum and the Hezheng Paleozoological Museum, including the largest and most completely preserved sauropod dinosaur ever discovered in Asia, the 30-meter-long Yongjing Titanosaur, alongside more than 140 significant pieces from the <a href=\"./portfolio\">museum</a>'s own collection, many displayed outside mainland China for the first time. We took on the full design-build contract: display structures, custom cases, lighting and visual integration, flooring, and outdoor weatherproofing, against international-grade preservation standards, a tight schedule, and a highly complex mix of cross-disciplinary trades.</p>\n<h2>A Wall That Had to Stand on Its Own</h2>\n<p>The Dragon Hall was the centerpiece of the exhibition, an independent display wall standing 6 meters tall that had to carry the enormous suspended load of the giant dinosaur fossil and its heavy steel armature entirely on its own, without leaning on or damaging the existing building structure. Precise structural center-of-gravity calculations and load-distribution analysis led us to a self-supporting freestanding structural method: the wall itself became a complete structural system, holding up a 30-meter dinosaur without ever leaning on a single beam or column of the museum.</p>\n<h2>Sealed Once, No Second Chance</h2>\n<p>Under international museum preservation standards, once the fossils were positioned, the display case glass had to be sealed in a single pass, and from that moment until the end of the exhibition it couldn't be opened again. That meant every light fixture's angle, every color temperature, the microclimate humidity control inside the case, and the flatness of every finish surface had to be exactly right before the seal went on. There was no adjusting afterward; every parameter had to be the final answer on the first attempt.</p>\n<h2>Color as Geology</h2>\n<p>More than seven dedicated color schemes and lighting systems, one per display case, used color and optics as a metaphor for different geological eras, clearly separating fossil groups and evolutionary stages so visitors could sense they were walking through a journey spanning hundreds of millions of years just from the shifts in light and tone, without reading a single wall panel in full.</p>\n<p>The floor got the same level of calculation: a high-strength raised timber flooring system with hidden LED light strips seamlessly embedded within it doubled as ambient exhibition lighting and safe <a href=\"./what-we-do#service-visual\">wayfinding</a> for large crowds, and the extended outdoor exhibition zone received additional high-standard moisture-proofing, UV resistance, and weatherproof coating to keep the wood flooring and display elements from warping or fading under prolonged sun and rain.</p>\n<h2>A Collapse Near the Finish Line</h2>\n<p>With installation nearly complete, an existing staircase, sealed off years earlier and unused for a long time, suddenly became structurally unstable, causing a localized floor collapse in the exhibition hall. We completed a safety-focused repair first, laying full carpet coverage over the area to keep the opening on schedule and circulation safe, and left the permanent structural repair for the museum to carry out through its standard procedures after the exhibition closed. The project was delivered with zero safety incidents and zero schedule delays, and the 30-meter dinosaur arrived in its hall exactly on time.</p>";
const relatedProjects = [{"href": "./project-story-telling", "label": "Story Telling by the Ancient People"}, {"href": "./project-nmns-teldap", "label": "NMNS TELDAP"}, {"href": "./project-wang-ye-donggang", "label": "The Hunt of the Celestial Court"}];
const nextHref = "./project-engineering-construction";
const images = [{"src": "./images/dragon-to-beast-sauropod-skeletons-being-installed-in-outdoor-letsuan-design.jpg", "alt": "From Dragon to Beast — Sauropod skeletons being installed in outdoor courtyard"}, {"src": "./images/dragon-to-beast-large-sauropod-skeleton-display-with-feature-letsuan-design.jpg", "alt": "Large sauropod skeleton display with feature walls"}, {"src": "./images/dragon-to-beast-dinosaur-skeleton-exhibit-zone-with-map-letsuan-design.jpg", "alt": "Dinosaur skeleton exhibit zone with map display"}, {"src": "./images/dragon-to-beast-origin-development-mammals-entrance-letsuan-design.jpg", "alt": "Visitor photographing a small mammal skeleton display at the Origin and Development of Mammals exhibit entrance"}, {"src": "./images/dragon-to-beast-orange-exhibition-hall-illuminated-pathway-visitors-letsuan-design.png", "alt": "Visitors walking through orange-toned exhibition hall with illuminated floor pathways and skeleton display cases"}, {"src": "./images/dragon-to-beast-exhibition-zone-with-colorful-feature-walls-letsuan-design.jpg", "alt": "Exhibition zone with colorful feature walls and fossil display cases"}, {"src": "./images/dragon-to-beast-carnivora-skeleton-display-corner-letsuan-design.jpg", "alt": "Carnivora exhibition corner with orange walls displaying carnivore mammal skeletons and skulls in illuminated glass cases"}, {"src": "./images/dragon-to-beast-african-mammal-exhibition-zone-with-skeleton-letsuan-design.jpg", "alt": "African mammal exhibition zone with skeleton displays"}, {"src": "./images/dragon-to-beast-row-of-large-skull-fossils-letsuan-design.jpg", "alt": "Row of large skull fossils in glass display case"}, {"src": "./images/dragon-to-beast-prehistoric-mammal-skeleton-diorama-letsuan-design.jpg", "alt": "Prehistoric mammal skeleton mounts displayed against a painted savanna backdrop"}, {"src": "./images/dragon-to-beast-skeleton-display-case-with-rhino-letsuan-design.jpg", "alt": "Skeleton display case with rhino and mammal fossils"}, {"src": "./images/dragon-to-beast-rhinoceros-giraffe-skeleton-gallery-letsuan-design.jpg", "alt": "White rhinoceros and giraffe skeleton mounts on display, with the adjoining gallery visible beyond"}, {"src": "./images/dragon-to-beast-mammal-skull-fossil-display-shelves-letsuan-design.jpg", "alt": "Rows of mammal skull and jawbone fossils displayed on illuminated shelves and in a glass case"}, {"src": "./images/dragon-to-beast-whale-skeletons-suspended-above-display-cases-letsuan-design.jpg", "alt": "Whale skeletons suspended above display cases"}, {"src": "./images/dragon-to-beast-mammal-fossil-gallery-with-illustrated-letsuan-design.jpg", "alt": "Mammal fossil gallery with illustrated backdrop panels"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
