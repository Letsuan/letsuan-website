const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "ExhibitionEvent", "name": "Wind in Motion — Ørsted's Sustainable Wind Wave", "description": "A recyclable cardboard exhibition pavilion for Ørsted at the 2024 Taiwan Climate Action Expo.", "url": "https://letsuan.com/project-orsted-climate-expo", "creator": {"@id": "https://letsuan.com/#organization"}, "image": [{"@type": "ImageObject", "url": "https://letsuan.com/images/orsted-climate-expo-2024-01-letsuan-design.jpg", "caption": "Letsuan Design | Wind in Motion — Visitors and students gathered at the Ørsted pavilion entrance, with an Earth graphic on the blue feature wall and a photo-booth character reading 'camera this way'"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/orsted-climate-expo-2024-02-letsuan-design.jpg", "caption": "Visitors queue past the blue Earth feature wall at the Ørsted pavilion, with a staff member in a black suit standing beside the exhibit panel"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/orsted-climate-expo-2024-03-letsuan-design.jpg", "caption": "Visitors gather at the purple wind-power information wall, with a cardboard sea-creature mascot and a colorful spinning info wheel"}], "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2024", "dateModified": "2026-09-04", "hasPart": [{"@type": "CreativeWork", "name": "Background"}, {"@type": "CreativeWork", "name": "Design thinking: letting the structure tell the story"}, {"@type": "CreativeWork", "name": "The build problem: making cardboard stand up on its own"}, {"@type": "CreativeWork", "name": "Material and fabrication: from a sheet of cardboard to a finished pavilion"}, {"@type": "CreativeWork", "name": "Results: what 95% recyclable actually looked like"}], "isPartOf": {"@id": "https://letsuan.com/#website"}, "location": {"@type": "Place", "name": "Taichung, Taiwan"}, "startDate": "2024"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Wind in Motion — Ørsted's Sustainable Wind Wave", "item": "https://letsuan.com/project-orsted-climate-expo"}]}];
