---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Le Tsuan Design | I Love Taiwan";
const description = "The Lawn Needed More Protection Than the Artwork Did. Construction for National Taiwan Museum of Fine Arts in Taichung, Taiwan, 2013-2014 — Le Tsuan Design.";
const canonical = "https://letsuan.com/project-asian-art-biennial";
const alternateHrefs = [
  { hreflang: "en", href: canonical },
  { hreflang: "zh-TW", href: "https://letsuan.com/zh-TW/project-asian-art-biennial" },
  { hreflang: "x-default", href: canonical },
];

const ogImage = "https://letsuan.com/images/asian-art-biennial-01-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "2013 Asian Art Biennial — Fitment Project", "url": "https://letsuan.com/project-asian-art-biennial", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/asian-art-biennial-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2013", "hasPart": [{"@type": "CreativeWork", "name": "The Challenge: A Lawn That Was Both Stage and Constraint"}, {"@type": "CreativeWork", "name": "Our Approach"}, {"@type": "CreativeWork", "name": "Outcome"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "2013 Asian Art Biennial — Fitment Project", "item": "https://letsuan.com/project-asian-art-biennial"}]}];
const eyebrowLeft = "EXHIBITION — 2013";
const eyebrowRight = "NATIONAL TAIWAN MUSEUM OF FINE ARTS";
const h1Main = "The Lawn Needed More Protection Than the Artwork Did";
const h1Sub = "2013 Asian Art Biennial";
const metaFields = [{"label": "CLIENT", "value": "National Taiwan Museum of Fine Arts"}, {"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2013-2014"}, {"label": "CATEGORY", "value": "Construction"}];
const bodyHtml = "<h2>Ten Light Boxes, One Lawn That Couldn't Be Damaged</h2>\n<p>In 2013, the artist collective LuxuryLogico took part in the National Taiwan Museum of Fine Arts' \"2013 Asian Art Biennial: Everyday Life\" with a piece called I LOVE TAIWAN, using a large array of light-box installations to turn a well-worn Taiwanese catchphrase into a variable-scale outdoor artwork scattered across the museum's lawn. We handled the on-site construction and fabrication of the piece.</p>\n<h2>The Lawn Was Part of the Work</h2>\n<p>The site was the museum's expansive outdoor lawn, which functioned as both backdrop and part of the artwork's effect: light boxes standing scattered across the green, lighting up at night into a landscape of light. There was one non-negotiable requirement for the build: fix and wire all ten light boxes without damaging the lawn itself. That ruled out the heavy machinery normally used for outdoor construction, large-scale foundation excavation, and anything that would leave exposed soil or compaction marks behind, since the lawn's condition was tied directly to how the artwork looked and to the museum's ongoing maintenance obligations.</p>\n<h2>Building Without a Trace</h2>\n<p>For each light box's post and base, we skipped pouring concrete altogether and designed a custom base component to carry the load instead, using a low-disturbance fixing method that avoided large-scale digging. Power cabling between the ten light boxes ran along existing hard-paved surfaces wherever possible, or was buried shallow underground, cutting down how often equipment had to be dragged across the grass.</p>\n<p>We used manual labor and small tools instead of heavy machinery, working zone by zone in batches so the foot traffic and load on any one section of lawn stayed within what it could recover from. Large canvas sheets covered the main routes and work areas, so all foot traffic, tool storage, and material handling sat on canvas rather than directly on the grass.</p>\n<p>Once each installation was positioned, we checked the lawn zone by zone, backfilling and leveling any compression marks or loosened soil so the surface was flat again before opening day. With teardown in mind, the light-box structures and materials were chosen for roughly 90% recyclability, so most of the material could be reused or recycled once the show closed rather than becoming waste.</p>\n<h2>Result</h2>\n<p>The ten-light-box I LOVE TAIWAN installation went up across the museum's outdoor lawn without incident, hidden among the greenery by day and lighting up into a sea of text by night. The lawn came through the install exactly as it went in.</p>";
const relatedProjects = [{"href": "./project-yokai-world", "label": "Experience the Yokai World"}, {"href": "./project-westernmost-point", "label": "The Westernmost Point of Taiwan"}, {"href": "./project-detention-pier2", "label": "Detention — Reality Experience"}];
const nextHref = "./project-nmns-teldap";
const images = [{"src": "./images/asian-art-biennial-i-love-taiwan-zhuyin-entrance-sign-letsuan-design.jpg", "alt": "The Lawn Needed More Protection Than the Artwork Did — Illuminated Zhuyin phonetic symbols spelling out 'I LOVE TAIWAN' at the National Taiwan Museum of Fine Arts entrance at night, part of the 2013 Asian Art Biennial"}, {"src": "./images/asian-art-biennial-02-letsuan-design.jpg", "alt": "Illuminated Zhuyin phonetic symbols spelling 'I LOVE TAIWAN' on the museum lawn at night, with the National Taiwan Museum of Fine Arts building and 2013 Asian Art Biennial banner behind"}, {"src": "./images/asian-art-biennial-love-taiwan-led-light-installation-on-lawn-letsuan-design.jpg", "alt": "Illuminated LED light installation spelling 'I Love Taiwan' in Zhuyin phonetic script on the lawn at night"}, {"src": "./images/asian-art-biennial-03-letsuan-design.jpg", "alt": "Construction process: a worker hand-digs a shallow cable trench (left) while light-box materials are laid out on the lawn (right), avoiding heavy machinery to protect the grass"}, {"src": "./images/asian-art-biennial-04-letsuan-design.jpg", "alt": "Steel post frames and coiled cabling for the light-box installations laid out on the museum lawn before assembly"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  alternateHrefs={alternateHrefs}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
