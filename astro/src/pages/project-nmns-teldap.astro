const ogImage = "https://letsuan.com/images/nmns-teldap-digital-archives-01-letsuan-design.jpg";
const jsonLd = [{"@context": "https://schema.org", "@type": "CreativeWork", "name": "NMNS TELDAP Exhibition", "url": "https://letsuan.com/project-nmns-teldap", "creator": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "image": "https://letsuan.com/images/nmns-teldap-digital-archives-01-letsuan-design.jpg", "author": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "datePublished": "2013"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "NMNS TELDAP Exhibition", "item": "https://letsuan.com/project-nmns-teldap"}]}];
const eyebrowLeft = "EXHIBITION — 2013";
const eyebrowRight = "NATIONAL MUSEUM OF NATURAL SCIENCE";
const h1Main = "NMNS TELDAP";
const h1Sub = "Digital Archives Exhibition";
const metaFields = [{"label": "CLIENT", "value": "National Museum of Natural Science"}, {"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2013"}, {"label": "CATEGORY", "value": "Construction"}];
const bodyHtml = "<h2>A Counter That Had to Look Like It Grew There</h2>\n<p>As part of the \"Digital Archives and Digital Learning\" national science and technology program's permanent service point inside the museum, we took on the spatial construction for the \"Digital Archives @ Learning\" service area, turning what had been a flat information counter into a physical service node with real presence, where visitors can browse the archive collections and explore digital learning resources right on site.</p>\n<p>The design uses a large curved volume as the main structure of the service area, with a curved timber base echoing the museum's existing arc-shaped circulation language, so the service counter reads as a visual focal point in the space as much as a functional object. A suspended, petal-shaped circular light fixture overhead reinforces the area's identity and its sense of technology.</p>\n<h2>Built Without a Visible Joint</h2>\n<p>The service area floor uses raised-flooring construction, accommodating reserved MEP routing and on-site leveling requirements. Walls and display cases are finished entirely in laminate, balancing wear resistance with overall visual consistency.</p>\n<p>The counter itself is built using a curved timber-jointing method, cut and laminated section by section on site from multiple layers of plywood to form a continuous curved structure, then wrapped entirely in engineered stone precisely cut and fitted to the curve for a seamless, monolithic finish. Sections of the front elevation use custom-fabricated S-curved laminated ultra-clear glass, or low-iron glass, with parts requiring a secondary curving process to take final shape. That step is difficult on its own, and it still had to fit precisely and seamlessly against the curved timber, which demanded rigorous control over both material selection and on-site sequencing.</p>\n<p>The service area also integrates several touch-screen inquiry stations and information panels, letting visitors search the archive database and take part in interactive digital-learning content.</p>\n<h2>A Gap the Drawings Never Showed</h2>\n<p>During construction, we found a roughly 120-centimeter discrepancy between the construction drawings and the actual dimensions on site. This wasn't a rounding error but a gap large enough to throw off the entire curved structure. After remeasuring the site, we corrected the relevant component dimensions and setting-out baselines in real time, so the curved structure and overall form still came together on schedule. The original keyboard-tray design also turned out to be limited in real use, so we reviewed and adjusted its structural configuration on the spot, improving the operating angle and storage efficiency for users.</p>\n<p>The service area is now fully integrated with the interactive inquiry stations, handling service, guidance, and hands-on experience in one continuous piece of furniture, with a circulation design that echoes the museum's existing spatial language.</p>";
const relatedProjects = [{"href": "./project-story-telling", "label": "Story Telling by the Ancient People"}, {"href": "./project-wang-ye-donggang", "label": "The Hunt of the Celestial Court"}, {"href": "./project-dragon-to-beast", "label": "From Dragon to Beast"}];
const nextHref = "./project-hakka-culture";
const images = [{"src": "./images/nmns-teldap-digital-archives-01-letsuan-design.jpg", "alt": "NMNS TELDAP exhibit space"}, {"src": "./images/nmns-teldap-digital-archives-03-letsuan-design.jpg", "alt": "NMNS TELDAP interactive learning"}, {"src": "./images/nmns-teldap-digital-archives-02-letsuan-design.jpg", "alt": "NMNS TELDAP display"}];
