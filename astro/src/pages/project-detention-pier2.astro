letsuan-design.jpg", "alt": "Red exhibition wall introducing the Detention game story with character art"}, {"src": "./images/detention-pier2-red-history-timeline-wall-with-display-letsuan-design.jpg", "alt": "Red history timeline wall with display cases"}, {"src": "./images/detention-reality-experience-songshan-01-letsuan-design.jpg", "alt": "Detention Pier2 mask scene"}, {"src": "./images/detention-reality-experience-songshan-02-letsuan-design.jpg", "alt": "Detention Pier2 signage"}, {"src": "./images/detention-reality-experience-songshan-03-letsuan-design.jpg", "alt": "Detention Pier2 immersive scene wide view"}];
