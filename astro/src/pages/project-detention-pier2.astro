const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Detention — Reality Experience", "description": "An atmospheric horror exhibition set in 1960s Taiwan under martial law, staged at Songshan Cultural and Creative Park and The Pier2 Art Center.", "url": "https://letsuan.com/project-detention-pier2", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/detention-pier2-detention-reality-experience-metal-wall-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2019", "hasPart": [{"@type": "CreativeWork", "name": "Part 1: Professional Set Production & Multi-Sensory Immersive Craft (Art Direction & Immersive Craft)"}, {"@type": "CreativeWork", "name": "Part 2: Core Design Challenge — Low-Light Horror Environment vs. Fire Safety Regulations"}, {"@type": "CreativeWork", "name": "Part 3: Project Outcomes Summary"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Detention — Reality Experience", "item": "https://letsuan.com/project-detention-pier2"}]}];
const eyebrowLeft = "EXHIBITION — 2021";
const eyebrowRight = "TAIPEI + KAOHSIUNG";
