const jsonLd = [{"@context": "https://schema.org", "@type": "CreativeWork", "name": "Hakka Culture Development Center", "url": "https://letsuan.com/project-hakka-culture", "creator": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "image": "https://letsuan.com/images/hakka-culture-entrance-feature-wall-with-tree-cutout-letsuan-design.jpg", "author": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "datePublished": "2012"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Hakka Culture Development Center", "item": "https://letsuan.com/project-hakka-culture"}]}];
