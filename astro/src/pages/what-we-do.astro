<script>
  import '../scripts/reveal';

  const tracker = document.querySelector<HTMLElement>('[data-process-tracker]');
  const fill = document.querySelector<HTMLElement>('[data-process-fill]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.ltsuan-process-btn'));
  const detailId = document.querySelector<HTMLElement>('[data-process-detail-id]');
  const detailEn = document.querySelector<HTMLElement>('[data-process-detail-en]');
  const detailDesc = document.querySelector<HTMLElement>('[data-process-detail-desc]');
  const steps = JSON.parse(document.getElementById('ltsuan-process-data')?.textContent || '[]') as Array<{ id: string; en: string; zh: string; desc: string }>;

  function setStep(index: number) {
    const step = steps[index];
    if (!step || !tracker || !fill) return;
    fill.style.transform = `scaleX(${(index + 1) / steps.length})`;
    buttons.forEach((btn, i) => {
      const passed = i <= index;
      btn.classList.toggle('is-current', i === index);
      btn.classList.toggle('is-passed', passed);
      if (i === index) btn.setAttribute('aria-current', 'step');
      else btn.removeAttribute('aria-current');
    });
    if (detailId) detailId.textContent = step.id;
    if (detailEn) detailEn.textContent = step.en.toUpperCase();
    if (detailDesc) detailDesc.textContent = step.desc;
  }

  setStep(0);

  buttons.forEach((btn, i) => {
    btn.addEventListener('click', () => setStep(i));
    btn.addEventListener('mouseenter', () => setStep(i));
    btn.addEventListener('focus', () => setStep(i));
  });

  const heroH1 = document.querySelector<HTMLElement>('[data-hero-h1]');
  const heroLead = document.querySelector<HTMLElement>('[data-hero-lead]');
  function syncLeadWidth() {
    if (!heroH1 || !heroLead) return;
    heroLead.style.maxWidth = `${heroH1.getBoundingClientRect().width}px`;
  }
  syncLeadWidth();
  window.addEventListener('resize', syncLeadWidth);

  const detailBox = document.querySelector<HTMLElement>('.ltsuan-process-detail');
  const detailHead = document.querySelector<HTMLElement>('.ltsuan-process-detail-head');
  function syncDetailDescWidth() {
    if (!detailDesc || !detailBox || !detailHead || buttons.length < 4) return;
    const boxRect = detailBox.getBoundingClientRect();
    const boxPaddingLeft = parseFloat(getComputedStyle(detailBox).paddingLeft);
    const startRect = buttons[1].getBoundingClientRect();
    const endRect = buttons[3].getBoundingClientRect();
    const insetLeft = `${startRect.left - boxRect.left - boxPaddingLeft}px`;
    detailDesc.style.marginLeft = insetLeft;
    detailDesc.style.width = `${endRect.right - startRect.left}px`;
    detailHead.style.marginLeft = insetLeft;
  }
  syncDetailDescWidth();
  window.addEventListener('resize', syncDetailDescWidth);

  function syncStatRuleWidths() {
    document.querySelectorAll<HTMLElement>('.ltsuan-stat-meta').forEach((meta) => {
      const label = meta.querySelector<HTMLElement>('.ltsuan-stat-label');
      const rule = meta.querySelector<HTMLElement>('.ltsuan-stat-rule');
      if (!label || !rule) return;
      rule.style.width = `${label.getBoundingClientRect().width}px`;
    });
  }
  syncStatRuleWidths();
  window.addEventListener('resize', syncStatRuleWidths);
</script>

