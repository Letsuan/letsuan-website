---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { organizationJsonLd } from '../data/organization';
import { avifPath } from '../utils/images';

const title = 'Letsuan Design | What We Do';
const description = 'Letsuan Design insists on integrated design-build: six core services, a five-stage process, and eight engineering capabilities, all handled by one accountable team from concept to opening.';
const canonical = 'https://letsuan.com/what-we-do';
const alternateHrefs = [
  { hreflang: 'en', href: canonical },
  { hreflang: 'zh-TW', href: 'https://letsuan.com/zh-TW/what-we-do' },
  { hreflang: 'x-default', href: canonical },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://letsuan.com/what-we-do#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://letsuan.com/#website' },
      about: { '@id': 'https://letsuan.com/#organization' },
    },
    {
      '@type': 'OfferCatalog',
      '@id': 'https://letsuan.com/what-we-do#catalog',
      name: 'Letsuan Design Services & Engineering Capabilities',
      provider: { '@id': 'https://letsuan.com/#organization' },
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Curatorial Services', description: 'Full curatorial planning: concept development, content research, and narrative scripting for every exhibition.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Exhibition Design', description: 'Narrative-driven exhibitions and immersive installations for museums and cultural venues.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Interior Design', description: 'Commercial and institutional interiors planned around how people actually move and gather.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Visual Design', description: 'Identity systems, wayfinding, and environmental graphics that carry a brand through physical space.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Construction', description: 'In-house fabrication and site management that takes a design from drawing to built reality.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Multimedia & Interactive Design', description: 'Technical planning and hardware/software integration for sensor-triggered, projection, and interactive-screen installations.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Heritage & Non-Invasive Construction', description: 'Free-standing, zero-penetration structural systems for protected buildings and heritage sites, engineered to carry full scenic and MEP loads without touching the original fabric.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'IP-Licensed Exhibition Delivery', description: 'Executed to licensor specification: character fidelity, official color codes, and finish quality, all verified through direct on-site supervision and sign-off.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Blackout & AV Integration', description: 'Full blackout treatment and zoned lighting, integrated with concealed wiring and mechanically driven, multi-zone sensor-triggered automation.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Precision Environmental Control', description: 'Environments engineered to tight numerical tolerances for uniform illumination, acoustic isolation, and sensor sensitivity, built for VR, AV, and interactive systems.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Structural & Seismic Engineering', description: 'Freestanding and suspended structures designed and evaluated against local seismic safety factors from the design stage onward.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Compressed-Timeline Site Management', description: 'Phased, cross-trade scheduling and multi-party coordination that hits fixed opening dates under real-world constraints such as shared access, weather, and regulatory review.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'In-House Fabrication & Waste Management', description: 'Units and fixtures are fabricated in our own workshop and brought on-site for assembly, keeping materials and labor traceable end to end while reducing on-site waste and disruption.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Remote International Delivery', description: 'Complete, precise construction documentation that lets a local crew abroad handle fabrication, display design, and installation without on-site supervision.' } },
      ],
    },
  ],
};

const processSteps = [
  { id: '01', en: 'Feasibility', zh: 'Feasibility', desc: "Before a single line is drawn, we complete the site survey, review code and structural constraints, and confirm client requirements, mapping site conditions and the budget ceiling up front so the design phase never runs into a scheme that turns out to be unbuildable." },
  { id: '02', en: 'Design & Engineering', zh: 'Design & Engineering', desc: 'Design and structural engineering run in parallel, so the concept is buildable within site and code constraints from day one. Architectural, structural, and MEP drawings are cross-checked together, cutting the risk of conflicts surfacing during construction and sending drawings back to the drawing board.' },
  { id: '03', en: 'Fabrication & Testing', zh: 'Fabrication & Testing', desc: 'We fabricate everything in-house, testing mechanical, lighting, and AV systems before anything leaves the workshop. Every unit goes through trial assembly and quality checks before shipping, so problems get solved in the workshop rather than on site.' },
  { id: '04', en: 'On-site Installation', zh: 'On-site Installation', desc: "We install trade by trade on schedule under our own site management, coordinating with venue operations and any third-party inspectors. Progress and quality are managed in step, so drawings and the built result stay consistent at every handoff between trades." },
  { id: '05', en: 'Handover', zh: 'Handover', desc: "We close with a final walkthrough, documentation, and sign-off with the client, completing any licensor or regulatory procedures along the way and leaving behind a complete maintenance manual and a point of contact, so there's someone to call for day-to-day operations after opening." },
];

const services = [
  { n: '01', zh: 'Curatorial Services', en: 'Curatorial Services', headline: 'A good exhibition starts with a good point of view.', desc: 'We handle full curatorial planning: concept development, content research, and narrative scripting for every exhibition. Twelve years of museum and exhibition experience have taught us how to set a thematic direction, turn research into content, and work out the display logic.', img: '/images/curatorial-services-team-reviewing-concept-letsuan-design.jpg', alt: 'Curatorial team reviewing an exhibition concept draft around a table' },
  { n: '02', zh: 'Exhibition Design', en: 'Exhibition Design', headline: 'Space tells the story, and visitors walk into it.', desc: 'We design story-driven exhibitions for museums, aquariums, and cultural venues. Narrative, spatial planning, lighting, and interactive multimedia work together to turn an abstract theme into a concrete design that visitors can read simply by moving through the space.', img: '/images/exhibition-design-museum-gallery-corridor-letsuan-design.jpg', alt: 'Museum exhibition gallery corridor space design' },
  { n: '03', zh: 'Interior Design', en: 'Interior Design', headline: 'Spaces designed for people, not just for looks.', desc: 'As a licensed interior decorator, we design commercial and institutional interiors around how people actually move and gather. Zoning, circulation, and material choices are all planned so people can move through the space and use it without friction.', img: '/images/interior-design-executive-office-letsuan-design.jpg', alt: 'Corporate office interior design space' },
  { n: '04', zh: 'Visual Design', en: 'Visual Design', headline: 'A brand recognizable wherever you look.', desc: "We bring a client's brand identity, corporate identity system, and wayfinding design into real space. From the entrance signage to the environmental graphics inside and outside the venue, the logo system and visual tone stay faithful to the client's brand.", img: '/images/visual-design-wayfinding-signage-letsuan-design.jpg', alt: 'Venue wayfinding signage and environmental visual design' },
  { n: '05', zh: 'Construction', en: 'Construction', headline: 'From groundbreaking to handover, the team stays on site.', desc: 'We handle exhibition-site engineering from design drawings through to completion, including construction and display fabrication. Our team runs fabrication and site management directly; specialized trades are carried out by partner teams under our direct supervision.', img: '/images/construction-site-supervisor-reviewing-plans-letsuan-design.jpg', alt: 'Construction site supervisor reviewing drawings on site' },
  { n: '06', zh: 'Multimedia & Interactive Design', en: 'Multimedia & Interactive Design', headline: "Exhibits that respond to visitors in real time, not just something to watch.", desc: "We plan sensor-triggered, projection, and interactive-screen installations, so content responds in real time to a visitor's movement and dwell time. Technical planning, content scripting, and hardware/software integration are handled by the same team, keeping everything running reliably on site.", img: '/images/multimedia-interactive-touch-table-exhibit-letsuan-design.jpg', alt: 'Visitor operating an interactive touch-table exhibit' },
];

const capabilities = [
  { zh: 'Heritage & Non-Invasive Construction', en: 'Heritage & Non-Invasive Construction', desc: 'Free-standing, zero-penetration structural systems for protected buildings and heritage sites, engineered to carry full scenic and MEP loads without touching the original fabric.', img: '/images/yokai-world-exhibition-hero-letsuan-design.jpg', alt: 'Experience the Yokai World — Yokai exhibition entrance', evidenceHref: './project-yokai-world', evidenceLabel: 'Experience the Yokai World' },
  { zh: 'IP-Licensed Exhibitions', en: 'IP-Licensed Exhibitions', desc: 'Executed to licensor specification: character fidelity, official color codes, and finish quality, all verified through direct on-site supervision and sign-off.', img: '/images/conan-anniv-kaito-kid-pre-installation-photo-letsuan-design.jpg', alt: 'Photo of the Kaito Kid figure taken before installation, in preparation for fixing it onto the rooftop platform', evidenceHref: './project-serialization-anniversary', evidenceLabel: 'INCIDENT IN CONAN EXHIBIT' },
  { zh: 'Blackout & AV Integration', en: 'Blackout & AV Integration', desc: 'Full blackout treatment and zoned lighting, integrated with concealed wiring and mechanically driven, multi-zone sensor-triggered automation.', img: '/images/immersive-projection-mapping-grid-installation-letsuan-design.jpg', alt: 'Immersive projection room with a wraparound calibration grid mapped across curved walls and floor, ceiling rigged with rows of projectors, technicians testing the setup', evidenceHref: './project-beyond-just-an-exhibition', evidenceLabel: 'Beyond Just an Exhibition' },
  { zh: 'Precision Environmental Control', en: 'Precision Environmental Control', desc: 'Environments engineered to tight numerical tolerances for uniform illumination, acoustic isolation, and sensor sensitivity, built for VR, AV, and interactive systems.', img: '/images/notre-dame-profile-line-letsuan-design.jpg', imgPosition: 'center 15%', alt: 'Three visitors in profile wearing VR headsets and backpacks against a black-and-white graphic mural', evidenceHref: './project-notre-dame', evidenceLabel: 'Eternal Notre-Dame' },
  { zh: 'Structural & Seismic Engineering', en: 'Structural & Seismic Engineering', desc: 'Freestanding and suspended structures designed and evaluated against local seismic safety factors from the design stage onward.', img: '/images/dragon-to-beast-sauropod-skeletons-being-installed-in-outdoor-letsuan-design.jpg', alt: 'From Dragon to Beast — Sauropod skeletons being installed in outdoor courtyard', evidenceHref: './project-dragon-to-beast', evidenceLabel: 'From Dragon to Beast' },
  { zh: 'Compressed-Timeline Site Management', en: 'Compressed-Timeline Site Management', desc: 'Phased, cross-trade scheduling and multi-party coordination that hits fixed opening dates under real-world constraints such as shared access, weather, and regulatory review.', img: '/images/wang-ye-worship-donggang-01-letsuan-design.jpg', alt: 'The Hunt of the Celestial Court exhibition', evidenceHref: './project-wang-ye-donggang', evidenceLabel: 'The Hunt of the Celestial Court' },
  { zh: 'In-House Fabrication & Waste Management', en: 'In-House Fabrication & Waste Management', desc: 'Units and fixtures are fabricated in our own workshop and brought on-site for assembly, keeping materials and labor traceable end to end while reducing on-site waste and disruption.', img: '/images/offshore-wind-om-learning-center-01-letsuan-design.jpg', alt: "Offshore Wind O&M learning center — meeting room wall with Ørsted's Love Your Home earth mural, meeting table in front", evidenceHref: './project-offshore-wind', evidenceLabel: 'Offshore Wind O&M Building' },
  { zh: 'Remote International Delivery', en: 'Remote International Delivery', desc: 'Complete, precise construction documentation that lets a local crew abroad handle fabrication, display design, and installation without on-site supervision.', img: '/images/la-fortuna-bordada-exhibition-banner-museo-entrance-letsuan-design.jpg', alt: 'La Fortuna Bordada exhibition banner at the Museo Nacional de Artes Decorativas entrance', evidenceHref: './project-la-fortuna-bordada', evidenceLabel: 'La Fortuna Bordada' },
];
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, pageJsonLd]} alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="what-we-do" zhHref="/zh-TW/what-we-do" />

    <div class="ltsuan-container">
    <section id="hero">
      <div class="ltsuan-hero-grid">
        <div class="ltsuan-hero-copy">
          <h1 class="ltsuan-h1" data-hero-h1>Giving Space<br /><span class="ltsuan-h1-accent">Concrete Form</span></h1>
          <p class="ltsuan-lead" data-hero-lead>From the first site survey to final handover, one team stays accountable for every stage: feasibility, design, fabrication, and installation. That keeps complex work easy to follow, so the experience unfolds naturally.</p>
        </div>
        <div class="ltsuan-hero-panel">
          <div class="ltsuan-hero-card">
            <picture>
              <source
                type="image/avif"
                srcset="/images/what-we-do-hero-team-sketch-wall-letsuan-design-960w.avif 960w, /images/what-we-do-hero-team-sketch-wall-letsuan-design-1920w.avif 1920w, /images/what-we-do-hero-team-sketch-wall-letsuan-design.avif 1430w"
                sizes="(max-width: 900px) 92vw, 40vw"
              />
              <img
                class="ltsuan-hero-card-photo"
                src="/images/what-we-do-hero-team-sketch-wall-letsuan-design.jpg"
                srcset="/images/what-we-do-hero-team-sketch-wall-letsuan-design-960w.jpg 960w, /images/what-we-do-hero-team-sketch-wall-letsuan-design-1920w.jpg 1920w, /images/what-we-do-hero-team-sketch-wall-letsuan-design.jpg 1430w"
                sizes="(max-width: 900px) 92vw, 40vw"
                width="1430"
                height="1402"
                alt="Letsuan Design team reviewing architectural floor plans and sketches on a glass wall"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <section id="why">
      <div class="ltsuan-why-grid">
        <div class="ltsuan-stat">
          <div class="ltsuan-stat-row">
            <div class="ltsuan-stat-num">12+</div>
            <div class="ltsuan-stat-meta">
              <div class="ltsuan-stat-label">YEARS</div>
              <div class="ltsuan-stat-rule"></div>
              <div class="ltsuan-stat-sub">OF<br />DESIGN<br />PRACTICE</div>
            </div>
          </div>
          <p class="ltsuan-stat-caption">EST. 2014 — CONTINUOUS PRACTICE</p>
        </div>
        <div class="ltsuan-why-copy">
          <h2 class="ltsuan-why-h2">Why insist on <span class="ltsuan-pill">integrated design-build?</span><br />Because drawings are imagination, and the site is the experience.</h2>
          <p class="ltsuan-why-highlight">A hairsbreadth of misalignment in a lighting angle, a sliver of a gap between a case and the wall: each is a hole in the story. Drawings never make it to the site. Only one team, staying on it end to end, can keep that story intact once it's built.</p>
          <div class="ltsuan-why-cols">
            <div class="ltsuan-why-text">
              <p>Plenty of exhibitions look beautiful on paper and lose something once they're built. It's usually because curation, design, and construction sit with different vendors. Responsibility gets diffused, and the gap that's left is the one the visitor has to live with.</p>
              <p>Letsuan Design chose the heavier, more accountable path: the same team stays responsible from the curatorial framework through the final lighting walkthrough before opening. Woodwork, metalwork, lighting, and multimedia are all fabricated and calibrated on site by that same group.</p>
              <p>When the same people are watching over both the drawings and the site, the story doesn't get lost on the construction floor, and the exhibition delivers the experience it promised.</p>
            </div>
            <div class="ltsuan-why-card-col">
              <div class="ltsuan-why-card">
                <div class="ltsuan-why-card-label">ONE TEAM ACCOUNTABILITY</div>
                <p class="ltsuan-why-card-body">One team, from concept to opening.<br /><span>Single point of responsibility, from curatorial framework to final walkthrough.</span></p>
              </div>
              <div class="ltsuan-why-tags">
                <span>Fabrication Integration</span>
                <span>On-Site Assembly</span>
                <span>Lighting Integration</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="services">
      <div class="ltsuan-section-stat">
        <div class="ltsuan-stat-num">6</div>
        <div class="ltsuan-stat-meta">
          <div class="ltsuan-stat-label">SERVICES</div>
          <div class="ltsuan-stat-rule"></div>
          <div class="ltsuan-stat-sub">SIX<br />CORE SERVICES</div>
        </div>
      </div>
      <div class="ltsuan-services-grid">
        {services.map((svc) => (
          <div class="ltsuan-service-card" id={`service-${svc.n}`}>
            <div class="ltsn-panel">
              <picture>
                <source srcset={avifPath(svc.img)} type="image/avif" />
                <img alt={svc.alt} src={svc.img} class="ltsuan-service-img" loading="lazy" decoding="async" />
              </picture>
              <span class="ltsuan-service-img-en">{svc.en.toLowerCase()}</span>
              <span class="ltsuan-service-img-mark">✳</span>
            </div>
            <div class="ltsuan-service-title-row">
              <span class="ltsuan-service-n">{svc.n}</span>
              <span class="ltsuan-service-dot"></span>
              <h3 class="ltsuan-service-zh">{svc.zh}</h3>
            </div>
            <p class="ltsuan-service-desc">{svc.desc}</p>
            <div class="ltsuan-service-foot">
              <div class="ltsuan-service-rule"></div>
              <p class="ltsuan-service-headline">{svc.headline}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="process-steps">
      <div class="ltsuan-process-heading">
        <h2 class="ltsuan-process-h2">Process</h2>
        <span class="ltsuan-process-sub">From confirmed brief to handover, one team stays responsible throughout</span>
      </div>

      <div class="ltsuan-process-tracker" data-process-tracker>
        <div class="ltsuan-process-line-track"></div>
        <div class="ltsuan-process-line-fill" data-process-fill></div>
        <div class="ltsuan-process-buttons">
          {processSteps.map((step, i) => (
            <button type="button" class="ltsuan-process-btn" data-step-id={step.id} data-step-index={i} aria-current={i === 0 ? 'step' : undefined}>
              <span class="ltsuan-process-ring">
                <span class="ltsuan-process-dot"></span>
              </span>
              <span class="ltsuan-process-btn-zh">{step.zh}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="ltsuan-process-detail">
        <div class="ltsuan-process-detail-head">
          <span class="ltsuan-process-detail-id" data-process-detail-id>01</span>
          <span class="ltsuan-process-detail-rule"></span>
          <span class="ltsuan-process-detail-en" data-process-detail-en>FEASIBILITY</span>
        </div>
        <p class="ltsuan-process-detail-desc" data-process-detail-desc>{processSteps[0].desc}</p>
      </div>

      <div class="ltsuan-process-mobile">
        <div class="ltsuan-process-mobile-line"></div>
        {processSteps.map((step) => (
          <details class="ltsuan-process-mobile-item">
            <summary>
              <span class="ltsuan-process-mobile-dot"></span>
              <span class="ltsuan-process-mobile-zh">{step.zh}</span>
            </summary>
            <p>{step.desc}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="capabilities">
      <div class="ltsuan-reveal">
        <h2 class="ltsuan-section-h2">Engineering that meets what the site,<br />the client, and the code all demand.</h2>
        <p class="ltsuan-section-intro">Letsuan Design specializes in non-invasive heritage construction, IP-licensed exhibition delivery, blackout AV integration, and precision environmental control, serving museums and cultural venues across Taiwan and abroad.</p>
      </div>
      <div class="ltsuan-capabilities-grid">
        {capabilities.map((cap) => (
          <div class="ltsuan-cap-card">
            <h3 class="ltsuan-cap-title">{cap.zh}</h3>
            <p class="ltsuan-cap-desc">{cap.desc}</p>
            <div class="ltsuan-cap-foot">
              <div class="ltsuan-cap-rule"><span class="ltsuan-cap-glow"></span></div>
              <a href={cap.evidenceHref} class="ltsuan-cap-evidence"><span>{cap.evidenceLabel}</span><span class="ltsuan-cap-arrow">↗</span></a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="contact">
      <div class="ltsuan-cta">
        <div class="ltsuan-cta-pill"><span class="ltsuan-cta-dot"></span>NEW PROJECTS FOR 2026 — OPEN</div>
        <h2 class="ltsuan-cta-h2">Let's talk about<br />your next exhibition.</h2>
        <p class="ltsuan-cta-copy">Whatever form the exhibition takes, our starting question stays the same: how do we lead visitors into the story, and make the experience a memory they carry with them.</p>
        <div class="ltsuan-cta-actions">
          <a href="https://letsuan.com/contact" class="ltsuan-cta-btn">
            <span>info@letsuan.com</span>
            <span class="ltsuan-cta-btn-arrow">↗</span>
          </a>
          <div class="ltsuan-cta-note">We'll get back to you within two business days.</div>
        </div>

        <div class="ltsuan-cta-footer">
          <div class="ltsuan-cta-social">
            <a href="https://www.facebook.com/LETSUANDESIGN" target="_blank" rel="noopener" aria-label="Facebook" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.pinterest.com/Letsuan_Design/" target="_blank" rel="noopener" aria-label="Pinterest" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.194-.332 1.361-.052.219-.173.265-.4.16-1.492-.694-2.424-2.874-2.424-4.625 0-3.767 2.737-7.229 7.892-7.229 4.144 0 7.365 2.953 7.365 6.897 0 4.116-2.595 7.428-6.199 7.428-1.211 0-2.349-.629-2.738-1.373 0 0-.599 2.282-.744 2.84-.269 1.037-.997 2.336-1.484 3.129 1.118.346 2.303.53 3.532.53 6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/letsuan-design/" target="_blank" rel="noopener" aria-label="LinkedIn" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.454c.98 0 1.775-.773 1.775-1.729V1.729C24 .774 23.205 0 22.225 0zM7.12 20.452H3.56V9h3.56v11.452zM5.34 7.433c-1.144 0-2.067-.926-2.067-2.065 0-1.138.923-2.065 2.067-2.065 1.14 0 2.064.927 2.064 2.065 0 1.139-.923 2.065-2.064 2.065zM20.452 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.137 1.447-2.137 2.941v5.665H9.359V9h3.412v1.561h.049c.475-.9 1.637-1.85 3.37-1.85 3.601 0 4.266 2.37 4.266 5.455v6.286z"/></svg>
            </a>
          </div>
          <div class="ltsuan-cta-cityline">Taichung Studio, Taipei Studio&nbsp;&nbsp;|&nbsp;&nbsp;+886 4 2321 5956</div>
          <div class="ltsuan-cta-address">6F.-1, No. 85, Sec. 1, Huamei W. St., West District, Taichung City 403020, Taiwan&nbsp;&nbsp;|&nbsp;&nbsp;3F., No. 62, Sec. 6, Yanping N. Rd., Shilin District, Taipei City 111069, Taiwan</div>
