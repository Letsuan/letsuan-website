---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CornerFrame from '../components/CornerFrame.astro';
import { organizationJsonLd } from '../data/organization';
import { avifPath } from '../utils/images';
import { services as coreServiceMeta } from '../data/homepage';

const coreServiceCopy: Record<string, { headline: string; desc: string }> = {
  curatorial: {
    headline: 'A good exhibition starts with a good point of view.',
    desc: "We handle full curatorial planning: concept development, content research and narrative scripting for every exhibition. Twelve years working on museums and exhibitions has taught us how to set the thematic direction, translate research into content and work out the display logic, so visitors can follow the exhibition's argument as they walk through it.",
  },
  exhibition: {
    headline: 'Space tells the story, and visitors walk into it.',
    desc: 'For museums, aquariums and cultural venues, we design exhibitions built around a story. Storyline, spatial planning, lighting and interactive multimedia all work together to turn an abstract theme into a concrete design that visitors read as they move through the space, not from long blocks of wall text.',
  },
  interior: {
    headline: 'Spaces designed for people, not just for looks.',
    desc: 'As a licensed interior decorator, we design commercial and institutional interiors around how people actually move and gather, not around appearance alone. Spatial zoning, circulation and material choices are all planned so people can move through the space and settle into it without friction.',
  },
  visual: {
    headline: 'A brand recognized in every corner.',
    desc: 'We handle brand identity, corporate identity systems and wayfinding, plus the graphic environments that carry a brand consistently through physical space. Logo systems and environmental graphics, both inside and outside a venue, keep the same visual tone recognizable wherever a visitor looks.',
  },
  construction: {
    headline: 'From groundbreaking to handover, our own team stays on it.',
    desc: 'We handle exhibition-site engineering from design drawings through to completion, including construction and display fabrication. Our team does the in-house fabrication and site management directly; specialized trades are carried out by partner teams under our direct supervision. We oversee material selection, scheduling and quality control throughout, and the finished space matches the drawings and holds up under long-term use.',
  },
};

const title = 'What We Do | Exhibition Curation, Interior Design & Turn-key Construction';
const description = 'See how Le Tsuan Design delivers museum-grade exhibitions through a five-stage process, from site survey to fabrication, installation and handover. It also covers our engineering capabilities for heritage sites, IP-licensed exhibits and high-precision environments.';
const canonical = 'https://letsuan.com/what-we-do';
const ogImage = 'https://letsuan.com/assets/logo.png';

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://letsuan.com/what-we-do#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://letsuan.com/#website' },
      about: { '@id': 'https://letsuan.com/#organization' },
    },
    {
      '@type': 'OfferCatalog',
      '@id': 'https://letsuan.com/what-we-do#catalog',
      name: 'Le Tsuan Design Services & Engineering Capabilities',
      provider: { '@id': 'https://letsuan.com/#organization' },
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Exhibition Design', description: 'Narrative-led exhibitions and immersive installations for museums and cultural venues.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Interior Design', description: 'Commercial and institutional interiors designed around how people actually move and gather.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Visual Design', description: 'Identity systems, wayfinding and environmental graphics that carry a brand through physical space.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Construction', description: 'In-house fabrication and site management that takes a design from drawing to reality.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Heritage & Non-Invasive Construction', description: 'Free-standing, zero-penetration structural systems for protected buildings and historic sites, engineered to carry full scenic and MEP loads without touching the original fabric.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'IP-Licensed Exhibition Delivery', description: 'Execution to licensor specification: character fidelity, official colour codes, and finish quality verified through direct on-site supervision and sign-off.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Dark-Exhibit & AV Integration', description: 'Full blackout treatment, zoned lighting, and multi-zone sensor-triggered automation integrated with concealed wiring and mechanical actuation.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'High-Precision Environmental Control', description: 'Lighting uniformity, acoustic isolation, and sensor-sensitive environments engineered to tight numerical tolerances for VR, AV and interactive systems.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Structural & Seismic Engineering', description: 'Freestanding and suspended structures designed and evaluated against local seismic safety factors from the design stage onward.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Compressed-Schedule Site Management', description: 'Phased, cross-trade scheduling and multi-party coordination to hit fixed opening dates under real-world constraints such as shared access, weather, and regulatory windows.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'In-House Fabrication & Waste Management', description: 'Units and fixtures are fabricated in our own workshop and brought in for assembly, keeping materials and labor accountable end to end and reducing on-site waste and disruption. Every site follows a formal waste-sorting and recycling protocol.' } },
      ],
    },
  ],
};

const processSteps = [
  { num: '01', title: 'Brief & Feasibility', desc: 'Site survey, code and structural constraints, and client requirements assessed before a single drawing is made.' },
  { num: '02', title: 'Concept & Engineering Design', desc: 'Design and structural engineering developed in parallel, so the concept is buildable within site and code constraints from day one.' },
  { num: '03', title: 'Fabrication & Testing', desc: 'In-house fabrication with mechanical, lighting and AV systems tested before anything leaves the workshop.' },
  { num: '04', title: 'Site Installation', desc: 'Scheduled, trade-by-trade installation under our own site management, coordinated with venue operations and any third-party inspectors.' },
  { num: '05', title: 'Handover & QA', desc: 'Final walkthrough, documentation and sign-off with the client and, where applicable, the licensor or regulatory authority.' },
];

const capabilities = [
  { title: 'Heritage & Non-Invasive Construction', desc: 'Free-standing, zero-penetration structural systems for protected buildings and historic sites, engineered to carry full scenic and MEP loads without touching the original fabric.', img: './images/yokai-world-exhibition-hero-letsuan-design.jpg', alt: 'Experience the Yokai World — Yokai exhibition entrance', evidenceHref: './project-yokai-world', evidenceLabel: 'Experience the Yokai World' },
  { title: 'IP-Licensed Exhibition Delivery', desc: 'Execution to licensor specification: character fidelity, official colour codes, and finish quality verified through direct on-site supervision and sign-off.', img: './images/conan-anniv-kaito-kid-pre-installation-photo-letsuan-design.jpg', alt: 'Photo of the Kaito Kid figure taken before installation, in preparation for fixing it onto the rooftop platform', evidenceHref: './project-serialization-anniversary', evidenceLabel: 'INCIDENT IN CONAN EXHIBIT' },
  { title: 'Dark-Exhibit & AV Integration', desc: 'Full blackout treatment, zoned lighting, and multi-zone sensor-triggered automation integrated with concealed wiring and mechanical actuation.', img: './images/immersive-projection-mapping-grid-installation-letsuan-design.jpg', alt: 'Immersive projection room with a wraparound calibration grid mapped across curved walls and floor, ceiling rigged with rows of projectors, technicians testing the setup', evidenceHref: './project-beyond-just-an-exhibition', evidenceLabel: 'Beyond Just an Exhibition–You Are Part of the Art!' },
  { title: 'High-Precision Environmental Control', desc: 'Lighting uniformity, acoustic isolation, and sensor-sensitive environments engineered to tight numerical tolerances for VR, AV and interactive systems.', img: './images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg', imgPosition: 'center 30%', alt: 'Visitors exploring the Masters of Marine Illusion exhibition at Taichung Aquarium, an interior and exhibition design project by Le Tsuan Design', evidenceHref: './project-marine-illusion', evidenceLabel: 'Masters of Marine Illusion' },
  { title: 'Structural & Seismic Engineering', desc: 'Freestanding and suspended structures designed and evaluated against local seismic safety factors from the design stage onward.', img: './images/dragon-to-beast-sauropod-skeletons-being-installed-in-outdoor-letsuan-design.jpg', alt: 'From Dragon to Beast — Sauropod skeletons being installed in outdoor courtyard', evidenceHref: './project-dragon-to-beast', evidenceLabel: 'From Dragon to Beast' },
  { title: 'Compressed-Schedule Site Management', desc: 'Phased, cross-trade scheduling and multi-party coordination to hit fixed opening dates under real-world constraints such as shared access, weather, and regulatory windows.', img: './images/notre-dame-profile-line-letsuan-design.jpg', imgPosition: 'center 15%', alt: 'Three visitors in profile wearing VR headsets and backpacks against a black-and-white graphic mural', evidenceHref: './project-notre-dame', evidenceLabel: 'Eternal Notre-Dame VR Exhibition' },
  { title: 'In-House Fabrication & Waste Management', desc: 'Units and fixtures are fabricated in our own workshop and brought in for assembly, keeping materials and labor accountable end to end and reducing on-site waste and disruption. Every site follows a formal waste-sorting and recycling protocol.', img: './images/mobile-museum-exhibition-01-letsuan-design.jpg', alt: '8.5 ping: A Museum on Wheels — Mobile Museum vehicle', evidenceHref: './project-mobile-museum', evidenceLabel: 'Mobile Museum Vehicle Fabrication' },
  { title: 'Remote International Delivery', desc: 'Complete construction documentation precise enough to guide fabrication, display design and installation without any on-site supervision, for exhibitions built and installed entirely by a local crew abroad.', img: './images/la-fortuna-bordada-exhibition-banner-museo-entrance-letsuan-design.jpg', alt: 'La Fortuna Bordada exhibition banner at the Museo Nacional de Artes Decorativas entrance', evidenceHref: './project-la-fortuna-bordada', evidenceLabel: 'La Fortuna Bordada — Madrid' },
];
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, pageJsonLd]}>
  <div class="ltsuan-page">
    <Nav active="what-we-do" />

    <section id="process">
      <div class="ltsuan-reveal ltsuan-process-block">
        <div class="ltsuan-process-copy">
          <h1 class="ltsuan-h1">Giving Form to Space.</h1>
          <p class="ltsuan-lead">From site survey to final handover, the same team carries every stage: feasibility, design, fabrication and installation. Complex knowledge becomes understandable. Experience unfolds naturally.</p>
        </div>
        <a href="./portfolio" class="ltsuan-badge">VIEW<br />PORTFOLIO</a>
      </div>
      <div class="ltsuan-hero-media">
        <picture>
          <source srcset={avifPath('./images/centered-sparkler-hand-letsuan-design.jpg')} type="image/avif" />
          <img src="./images/centered-sparkler-hand-letsuan-design.jpg" alt="Hand holding a lit sparkler against a bokeh light backdrop" class="ltsuan-hero-img" />
        </picture>
        <CornerFrame size={16} />
      </div>
    </section>

    <section id="core-services">
      <div class="ltsuan-reveal">
        <h2 class="ltsuan-section-h2">Five services. One accountable studio.</h2>
      </div>
      <div class="ltsuan-core-grid">
        {coreServiceMeta.map((svc) => (
          <div class="ltsuan-core-card">
            <div class="ltsuan-core-img-wrap">
              <picture>
                <source srcset={avifPath(svc.realImg)} type="image/avif" />
                <img alt={svc.alt} src={svc.realImg} class="ltsuan-core-img" loading="lazy" decoding="async" />
              </picture>
            </div>
            <h3 class="ltsuan-core-title">{svc.title}</h3>
            <p class="ltsuan-core-headline">{coreServiceCopy[svc.id].headline}</p>
            <p class="ltsuan-core-desc">{coreServiceCopy[svc.id].desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="process-steps">
      <h2 class="ltsuan-process-h2">From brief to handover, one accountable team.</h2>
      <div class="ltsuan-process-grid">
        <div class="ltsuan-process-line"></div>
        {processSteps.map((step) => (
          <div>
            <div class="ltsuan-tick"></div>
            <div class="ltsuan-step-num">{step.num}</div>
            <h3 class="ltsuan-step-title">{step.title}</h3>
            <p class="ltsuan-step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="services">
      <div class="ltsuan-reveal">
        <h2 class="ltsuan-section-h2">Built to withstand what the site<br />the client and the code demand.</h2>
        <p class="ltsuan-section-intro">Le Tsuan Design specialises in heritage non-invasive construction, IP-licensed exhibition delivery, dark-exhibit AV integration and high-precision environmental control for museums and cultural venues across Taiwan and internationally.</p>
      </div>
      <div class="ltsuan-capabilities-grid">
        {capabilities.map((cap) => (
          <div class="ltsuan-cap-card">
            <CornerFrame size={10} opacity={0.55} />
            <div class="ltsuan-cap-img-wrap">
              <picture>
                <source srcset={avifPath(cap.img)} type="image/avif" />
                <img alt={cap.alt} src={cap.img} style={`object-position:${cap.imgPosition || 'center'}`} class="ltsuan-cap-img" loading="lazy" decoding="async" />
              </picture>
            </div>
            <h3 class="ltsuan-cap-title">{cap.title}</h3>
            <p class="ltsuan-cap-desc">{cap.desc}</p>
            <a href={cap.evidenceHref} class="ltsuan-cap-evidence">{cap.evidenceLabel} →</a>
          </div>
        ))}
      </div>
    </section>

    <Footer background="#0B1526" />
  </div>
</Layout>

<script>
  import '../scripts/reveal';
</script>

<style is:global>
  :root {
    --ltsuan-bg: #0b1526;
    --ltsuan-panel: #101b33;
    --ltsuan-accent: #8ec31f;
    --ltsuan-accent-hover: #a8dc4a;
    --ltsuan-line: rgba(244, 239, 232, 0.12);
    --ltsuan-dim: rgba(244, 239, 232, 0.6);
    --ltsuan-blueprint: #c9d6e8;
  }
</style>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
  }
  #process {
    padding: 110px 60px 60px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-process-block {
    position: relative;
  }
  .ltsuan-process-copy {
    margin-bottom: 36px;
    max-width: 900px;
  }
  .ltsuan-h1 {
    font-family: 'Oswald', sans-serif;
    font-weight: 300;
    font-size: clamp(40px, 5.4vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
  }
  .ltsuan-lead {
    font-family: 'Oswald', sans-serif;
    font-weight: 300;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.3;
    color: var(--ltsuan-dim);
    margin: 0;
    max-width: 52ch;
  }
  .ltsuan-badge {
    position: absolute;
    top: 0;
    right: 0;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 1px solid var(--ltsuan-line);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ltsuan-text);
    text-decoration: none;
  }
  .ltsuan-hero-media {
    position: relative;
    overflow: hidden;
    height: clamp(280px, 36vw, 460px);
  }
  .ltsuan-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
    filter: brightness(0.88) saturate(1.08);
  }
  #core-services {
    padding: 56px 60px 56px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-core-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .ltsuan-core-card {
    background: var(--ltsuan-panel);
    padding: 24px;
  }
  .ltsuan-core-img-wrap {
    position: relative;
    height: 140px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .ltsuan-core-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.85) saturate(1.05);
  }
  .ltsuan-core-title {
    font-family: 'Oswald', sans-serif;
    font-weight: 400;
    font-size: 17px;
    margin: 0 0 8px;
  }
  .ltsuan-core-headline {
    font-family: 'Oswald', sans-serif;
    font-weight: 300;
    font-size: 14px;
    color: var(--ltsuan-accent);
    margin: 0 0 10px;
  }
  .ltsuan-core-desc {
    font-family: 'Oswald', sans-serif;
    font-size: 13px;
    line-height: 1.65;
    color: rgba(244, 239, 232, 0.6);
    margin: 0;
  }
  #process-steps {
    padding: 56px 60px 56px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-process-h2 {
    font-family: 'Oswald', sans-serif;
    font-weight: 300;
    font-size: clamp(24px, 2.6vw, 32px);
    margin: 0 0 40px;
    max-width: 44ch;
  }
  .ltsuan-process-grid {
    display: grid;
    gap: 24px;
    position: relative;
    grid-template-columns: repeat(5, 1fr);
  }
  @media (max-width: 900px) {
    .ltsuan-process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .ltsuan-process-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .ltsuan-badge {
      position: static !important;
      margin: 20px 0 0 !important;
    }
  }
  .ltsuan-process-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--ltsuan-blueprint);
    opacity: 0.3;
  }
  .ltsuan-tick {
    width: 1px;
    height: 14px;
    background: var(--ltsuan-blueprint);
    opacity: 0.5;
    margin-bottom: 10px;
  }
  .ltsuan-step-num {
    font-family: 'Oswald', sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--ltsuan-accent);
    margin-bottom: 12px;
  }
  .ltsuan-step-title {
    font-family: 'Oswald', sans-serif;
    font-weight: 400;
    font-size: 17px;
    margin: 0 0 10px;
  }
  .ltsuan-step-desc {
    font-family: 'Oswald', sans-serif;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(244, 239, 232, 0.6);
    margin: 0;
  }
  #services {
    padding: 56px 60px 56px 79px;
    background: var(--ltsuan-panel);
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-section-h2 {
    font-family: 'Oswald', sans-serif;
    font-weight: 300;
    font-size: clamp(28px, 4vw, 44px);
    margin: 0 0 36px;
    max-width: 760px;
  }
  .ltsuan-section-intro {
    text-align: left;
    font-family: 'Oswald', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: rgba(244, 239, 232, 0.65);
    max-width: 760px;
    margin: 0 0 36px;
  }
  .ltsuan-capabilities-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 900px) {
    .ltsuan-capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .ltsuan-capabilities-grid {
      grid-template-columns: 1fr;
    }
  }
  .ltsuan-cap-card {
    position: relative;
    background: var(--ltsuan-panel);
    padding: 24px;
  }
  .ltsuan-cap-img-wrap {
    position: relative;
    height: 120px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .ltsuan-cap-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.35s ease;
    filter: brightness(0.8) saturate(1.1);
    transform: scale(1.15);
  }
  .ltsuan-cap-card:hover .ltsuan-cap-img {
    filter: brightness(1) saturate(1.15);
  }
  .ltsuan-cap-title {
    font-family: 'Oswald', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.3;
    min-height: calc(1.3em * 2);
    margin: 0 0 8px;
  }
  .ltsuan-cap-desc {
    font-family: 'Oswald', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.55);
    margin: 0;
    text-align: left;
  }
  .ltsuan-cap-evidence {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ltsuan-accent);
    text-decoration: none;
  }
</style>
