const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "The Missing Scientist — Electromagnetic Horizon II", "description": "A science-communication exhibition demystifying high-voltage power and electromagnetic waves.", "url": "https://letsuan.com/project-missing-scientist", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/missing-scientist-visitor-viewing-curved-gallery-wall-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2023", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "The Missing Scientist — Electromagnetic Horizon II", "item": "https://letsuan.com/project-missing-scientist"}]}];
