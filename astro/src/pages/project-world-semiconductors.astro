---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Le Tsuan Design | The World of Semiconductors";
const description = "The World of Semiconductors: TSMC × National Museum of Natural Science. Visual Design for TSMC in Taichung,Taiwan, 2021 — Le Tsuan Design.";
const canonical = "https://letsuan.com/project-world-semiconductors";
const ogImage = "https://letsuan.com/images/world-of-semiconductors-01-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "The World of Semiconductors — TSMC & NMNS", "description": "An exhibition presented with TSMC at the National Museum of Natural Science.", "url": "https://letsuan.com/project-world-semiconductors", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/world-of-semiconductors-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2021", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "The World of Semiconductors — TSMC & NMNS", "item": "https://letsuan.com/project-world-semiconductors"}]}];
const eyebrowLeft = "EVENT — 2021";
const eyebrowRight = "NATIONAL MUSEUM OF NATURAL SCIENCE";
const h1Main = "The World of Semiconductors";
const h1Sub = "TSMC × National Museum of Natural Science";
const metaFields = [{"label": "CLIENT", "value": "TSMC"}, {"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2021"}, {"label": "AREA", "value": "240㎡"}, {"label": "CATEGORY", "value": "Visual Design, Event, Construction"}];
const bodyHtml = "<h2>A Ceremony Stage Built Into a Corridor Entrance</h2>\n<p>The TSMC Charity Foundation donated \"The World of Semiconductors\" gallery to the National Museum of Natural Science, and the opening ceremony was staged at the entrance of the <a href=\"./portfolio\">museum</a>'s existing visitor corridor, where we built a curved backdrop wall, a raised stage, and the lighting and sound systems for the event. The venue is a publicly owned cultural heritage space, and the museum set one condition for the entire project: don't damage the existing walls or flooring, and restore everything completely once the event is over.</p>\n<h2>Building Around Visitors Who Never Stopped Walking Through</h2>\n<p>The original corridor had to remain open for visitor traffic throughout, so we sectioned off the construction zone with temporary fencing and fully enclosed hoarding, keeping enough clear width for visitors to pass through, with alternate wayfinding signage and on-site staff to guide them. Assembly and rigging of the larger structures were scheduled entirely during closed hours; during open hours, only the finished appearance was maintained, with no high-risk work carried out at all.</p>\n<h2>A Curved Wall That Never Touched the Real One</h2>\n<p>The curved backdrop wall had to match the gallery's architectural form yet couldn't be fastened to the existing wall at all.</p>\n<p>We used an independent frame system, assembled on site into its curved shape, entirely self-supporting and carrying its own load, with zero attachment to the museum's original wall structure. Where the frame met the floor, it was stabilized with removable counterweight bases; no expansion bolts, no nail guns, nothing requiring drilling was used. In places where the site's curvature was complex enough to need the frame to rest partially against an existing wall for positioning, only soft cushioning pads were used as a buffer, never direct force against the painted surface.</p>\n<p>The printed graphics were secured to the frame with hook-and-loop fastener, clamps, or straps.</p>\n<h2>A Stage Built Like Blocks</h2>\n<p>The raised stage used a fully custom, timber, brick-module-style construction: individual timber units were pre-cut in a factory workshop, then locked together on site with mortise-and-tenon joints, bolts, and quick-release hardware, never making fixed contact with the original floor.</p>\n<p>Every module's base was fitted with an adjustable levelling shim and non-slip rubber feet, using the module's own weight and shim adjustment to achieve stability and level correction, with no ground anchors, no expansion bolts, and <a href=\"./what-we-do#heritage-non-invasive-construction\">no drilling</a>. Because the stage's shape echoed the curved backdrop rather than a standard rectangle, every module had to be test-fitted on site against its irregular outline, confirming tight seams, no height differences, and no exposed fasteners, so visitors wouldn't trip.</p>\n<p>Once assembled, the structure went through a shake test and a localized load test before it was cleared for use. The projector sat in a concealed floor-level configuration, housed inside a reserved equipment bay built into the stage structure itself, with no contact with the original floor.</p>\n<h2>The Real Inspection Happened After Teardown</h2>\n<p>Once the ceremony ended, we followed a clear teardown schedule to remove every temporary structure, counterweight, and cable as quickly as possible. Warning signage and safety personnel were present on site throughout construction, and the stage's load capacity, module connections, and projector housing were all safety-checked before use. The real inspection came after teardown: a walkthrough of the original corridor, walls, and floor, confirming no scratches, no adhesive residue, and no drilling marks, jointly verified by the museum and the construction team, with photographic documentation taken both before and after construction.</p>";
const relatedProjects = [{"href": "./project-orsted-energy", "label": "Energy Taiwan 2022 — Ørsted"}, {"href": "./project-detention-pier2", "label": "Detention — Reality Experience"}, {"href": "./project-securities-office", "label": "Securities Company Office Design"}];
const nextHref = "./project-detention-pier2";
const images = [{"src": "./images/world-of-semiconductors-01-letsuan-design.jpg", "alt": "The World of Semiconductors overview"}, {"src": "./images/world-of-semiconductors-02-letsuan-design.jpg", "alt": "The World of Semiconductors gallery"}, {"src": "./images/world-of-semiconductors-03-letsuan-design.jpg", "alt": "The World of Semiconductors exhibit detail"}, {"src": "./images/world-of-semiconductors-04-letsuan-design.jpg", "alt": "The World of Semiconductors gallery entrance with mascot wall graphics, ready for the donation ceremony"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
