---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { organizationJsonLd } from '../data/organization';

const title = 'Letsuan Design | Contact Us';
const description = 'Get in touch with Letsuan Design about your next exhibition, interior or construction project, based in Taichung, Taiwan.';
const canonical = 'https://letsuan.com/contact';
const alternateHrefs = [
  { hreflang: 'en', href: canonical },
  { hreflang: 'zh-TW', href: 'https://letsuan.com/zh-TW/contact' },
  { hreflang: 'x-default', href: canonical },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const faqs = [
  {
    group: 'SERVICES & SCOPE',
    items: [
      { q: 'What services does Letsuan Design provide?', a: 'We provide end-to-end exhibition, interior, and visual design — from curatorial concept and spatial planning through graphic design, fabrication, and on-site construction. Most projects are delivered as a single point of contact from concept to installation.' },
      { q: 'What types of clients and projects do you work with?', a: 'We work primarily with museums, government agencies, and corporate clients on exhibitions, permanent galleries, brand environments, and public installations — as well as smaller-scale interior and graphic design projects.' },
      { q: 'Do you work outside Taiwan?', a: "Yes. While most of our work is based in Taiwan, we've delivered projects internationally, including exhibitions in Spain." },
    ],
  },
  {
    group: 'HOW WE WORK',
    items: [
      { q: 'How do you start a new project, and how long does it usually take?', a: "Every project begins with understanding the site, the audience, and the client's goals, followed by concept development and engineering. Timelines vary by scope — one to two months for a small fitment project, six months to a year for a large-scale museum exhibition with custom fabrication." },
      { q: 'Do you handle construction and fabrication, or only design?', a: 'We handle both. Our in-house team manages design development through construction, fabrication, and installation, so the same team that designs the space also builds it.' },
      { q: 'Do you provide 3D visualizations or concept renderings before construction?', a: 'Yes. Every project moves through concept renderings and 3D visualizations before fabrication begins, so clients can review and approve the design intent ahead of construction.' },
    ],
  },
  {
    group: 'TERMS & PRACTICALITIES',
    items: [
      { q: 'What is the typical project budget range?', a: "We don't publish set pricing — every project is scoped and quoted individually based on size, materials, and construction complexity. Get in touch with your project details for an estimate." },
      { q: 'Do you sign NDAs or protect client confidentiality?', a: 'Yes. We routinely sign NDAs for government and corporate clients, and treat all project materials — briefs, budgets, and unreleased content — as confidential throughout and after the engagement.' },
      { q: 'Do you provide maintenance after an exhibition or installation is completed?', a: 'Yes. Maintenance is included during the warranty period, and we continue to offer paid maintenance support on a case-by-case basis after the warranty expires.' },
    ],
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.flatMap((g) => g.items).map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const email = 'info@letsuan.com';
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, faqJsonLd]} alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="contact" zhHref="/zh-TW/contact" />

    <section id="hero">
      <h1 class="ltsuan-h1">Let's Talk About Your Space.</h1>
      <p class="ltsuan-lead">Tell us about your project — we'll get back to you within two business days of your submission.</p>
    </section>

    <section id="contact-body">
      <div class="ltsuan-contact-col">
        <div>
          <div class="ltsuan-eyebrow">STUDIO — TAICHUNG</div>
          <p class="ltsuan-address">6F.-1, No. 85, Sec. 1, Huamei W. St., West Dist., Taichung City 403020, Taiwan</p>
        </div>
        <div>
          <div class="ltsuan-eyebrow">STUDIO — TAIPEI</div>
          <p class="ltsuan-address">3F., No. 62, Sec. 6, Yanping N. Rd., Shilin Dist., Taipei City 111069, Taiwan</p>
        </div>
        <div>
          <div class="ltsuan-eyebrow">TEL</div>
          <a href="tel:+886423215956" class="ltsuan-plain-link">+886 4 2321 5956</a>
        </div>
        <div>
          <div class="ltsuan-eyebrow">EMAIL</div>
          <a href={`mailto:${email}`} class="ltsuan-plain-link">{email}</a>
        </div>
        <div>
          <div class="ltsuan-eyebrow">SOCIAL</div>
          <a href="https://www.facebook.com/LETSUANDESIGN" class="ltsuan-plain-link">Facebook</a>
        </div>
        <div class="ltsuan-respond-box">
          <div class="ltsuan-respond-eyebrow">HOW WE RESPOND</div>
          <p class="ltsuan-respond-copy">Every form submission below is emailed straight to our team, and we reply within two business days. Project details and budget figures are kept confidential — we routinely sign NDAs for government and corporate clients.</p>
        </div>
      </div>
      <div class="ltsuan-form-col">
        <form id="ltsuan-contact-form" class="ltsuan-form">
          <div class="ltsuan-form-row">
            <div class="ltsuan-field">
              <label for="firstName">First name<span aria-hidden="true">*</span></label>
              <input id="firstName" name="firstName" type="text" required />
            </div>
            <div class="ltsuan-field">
              <label for="lastName">Last name<span aria-hidden="true">*</span></label>
              <input id="lastName" name="lastName" type="text" required />
            </div>
          </div>
          <div class="ltsuan-form-row">
            <div class="ltsuan-field">
              <label for="phone">Phone number</label>
              <input id="phone" name="phone" type="tel" />
            </div>
            <div class="ltsuan-field">
              <label for="formEmail">Email<span aria-hidden="true">*</span></label>
              <input id="formEmail" name="email" type="email" required />
            </div>
          </div>
          <div class="ltsuan-form-row">
            <div class="ltsuan-field">
              <label for="company">Company</label>
              <input id="company" name="company" type="text" />
            </div>
            <div class="ltsuan-field">
              <label for="location">Location / Venue</label>
              <input id="location" name="location" type="text" />
            </div>
          </div>
          <div class="ltsuan-field">
            <label for="question">Project Details<span aria-hidden="true">*</span></label>
            <textarea id="question" name="question" rows="5" required></textarea>
          </div>
          <label class="ltsuan-checkbox">
            <input type="checkbox" id="requiresNda" name="requiresNda" />
            <span>This project requires NDA</span>
          </label>
          <label class="ltsuan-checkbox">
            <input type="checkbox" id="privacyConsent" name="privacyConsent" required />
            <span>I agree to the <a href="/privacy-policy" class="ltsuan-accent-link">privacy policy</a> and consent to Letsuan Design processing my information for this inquiry.<span aria-hidden="true">*</span></span>
          </label>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAEmzrdImQn4O-6za" data-callback="ltsuanTurnstileDone"></div>
          <button type="submit" class="ltsuan-form-submit">Submit <span aria-hidden="true">→</span></button>
          <p id="ltsuan-form-status" class="ltsuan-form-status" role="status" aria-live="polite"></p>
        </form>
        <p class="ltsuan-form-fallback">Trouble loading the form? Email us directly at <a href={`mailto:${email}`} class="ltsuan-accent-link">{email}</a>.</p>
      </div>
    </section>

    <section id="faq">
      <h2 class="ltsuan-faq-h2">FAQ</h2>
      {faqs.map((group) => (
        <div class="ltsuan-faq-group">
          <div class="ltsuan-faq-group-label">{group.group}</div>
          <div class="ltsuan-faq-grid">
            {group.items.map((item) => (
              <div>
                <h3 class="ltsuan-faq-q">{item.q}</h3>
                <p class="ltsuan-faq-a">{item.a}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <Footer />
  </div>
</Layout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  let turnstileToken = '';
  // @ts-ignore
  window.ltsuanTurnstileDone = (token: string) => { turnstileToken = token; };

  const form = document.getElementById('ltsuan-contact-form') as HTMLFormElement;
  const status = document.getElementById('ltsuan-form-status')!;
  const submitBtn = form.querySelector('.ltsuan-form-submit') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (!data.get('privacyConsent')) {
      status.textContent = 'Please agree to the privacy policy to continue.';
      status.className = 'ltsuan-form-status is-error';
      return;
    }
    if (!turnstileToken) {
      status.textContent = 'Please complete the verification above.';
      status.className = 'ltsuan-form-status is-error';
      return;
    }

    const payload = {
      firstName: data.get('firstName'),
      lastName: data.get('lastName'),
      phone: data.get('phone'),
      email: data.get('email'),
      company: data.get('company'),
      location: data.get('location'),
      question: data.get('question'),
      requiresNda: data.get('requiresNda') === 'on',
      turnstileToken,
    };

    submitBtn.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'ltsuan-form-status';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await res.json();
      if (result.success) {
        status.textContent = "Thanks — we'll get back to you within two business days.";
        status.className = 'ltsuan-form-status is-success';
        form.reset();
        // @ts-ignore
        if (window.turnstile) window.turnstile.reset();
        turnstileToken = '';
      } else {
        throw new Error(result.error || 'Submission failed');
      }
    } catch (err) {
      status.textContent = 'Something went wrong — please email us directly instead.';
      status.className = 'ltsuan-form-status is-error';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
  }
  #hero {
    padding: 220px 56px 70px 79px;
    border-bottom: 1px solid rgba(244, 239, 232, 0.08);
  }
  .ltsuan-h1 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(40px, 5.4vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }
  .ltsuan-lead {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(30px, 2.4vw, 40px);
    line-height: 1.19;
    color: rgba(244, 239, 232, 0.6);
    margin: 0;
    max-width: 40ch;
  }
  #contact-body {
    padding: 90px 56px 160px 79px;
    display: flex;
    gap: 64px;
    flex-wrap: wrap;
  }
  .ltsuan-contact-col {
    flex: 1;
    min-width: min(280px, 100%);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .ltsuan-eyebrow {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: rgba(244, 239, 232, 0.6);
    margin-bottom: 10px;
  }
  .ltsuan-address {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
    color: rgba(244, 239, 232, 0.85);
  }
  .ltsuan-plain-link {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 16px;
    text-decoration: none;
  }
  .ltsuan-respond-box {
    padding: 24px;
    background: #141414;
    border: 1px solid rgba(244, 239, 232, 0.08);
  }
  .ltsuan-respond-eyebrow {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--ltsuan-accent);
    margin-bottom: 12px;
  }
  .ltsuan-respond-copy {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: rgba(244, 239, 232, 0.7);
    margin: 0;
  }
  .ltsuan-form-col {
    flex: 1.5;
    min-width: min(320px, 100%);
  }
  .ltsuan-form {
    background: #141414;
    border: 1px solid rgba(244, 239, 232, 0.08);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ltsuan-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .ltsuan-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ltsuan-field label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.05em;
    color: rgba(244, 239, 232, 0.6);
  }
  .ltsuan-field label span {
    color: var(--ltsuan-accent);
    margin-left: 2px;
  }
  .ltsuan-field input,
  .ltsuan-field textarea {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: var(--ltsuan-text);
    background: #0a0a0a;
    border: 1px solid rgba(244, 239, 232, 0.15);
    padding: 10px 12px;
    resize: vertical;
  }
  .ltsuan-field input:focus,
  .ltsuan-field textarea:focus {
    outline: none;
    border-color: var(--ltsuan-accent);
  }
  .ltsuan-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(244, 239, 232, 0.75);
    cursor: pointer;
  }
  .ltsuan-checkbox input {
    margin-top: 3px;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    accent-color: var(--ltsuan-accent);
  }
  .ltsuan-checkbox span {
    flex: 1;
  }
  .ltsuan-checkbox span span {
    color: var(--ltsuan-accent);
    margin-left: 2px;
  }
  .ltsuan-form-submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 0.08em;
    color: #0a0a0a;
    background: var(--ltsuan-accent);
    border: none;
    padding: 12px 24px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .ltsuan-form-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .ltsuan-form-status {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 14px;
    margin: 0;
    min-height: 1.4em;
  }
  .ltsuan-form-status.is-success {
    color: var(--ltsuan-accent);
  }
  .ltsuan-form-status.is-error {
    color: #e0645a;
  }
  .ltsuan-form-fallback {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.55);
    margin: 14px 0 0;
  }
  .ltsuan-accent-link {
    color: var(--ltsuan-accent);
  }
  #faq {
    padding: 0 56px 160px 79px;
  }
  .ltsuan-faq-h2 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--ltsuan-accent);
    margin: 0 0 40px;
  }
  .ltsuan-faq-group {
    max-width: 1200px;
    margin-bottom: 44px;
  }
  .ltsuan-faq-group-label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.15em;
    color: rgba(244, 239, 232, 0.5);
    margin: 0 0 20px;
  }
  .ltsuan-faq-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 48px;
  }
  .ltsuan-faq-grid > div {
    flex: 1 1 340px;
  }
  .ltsuan-faq-q {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 19px;
    margin: 0 0 10px;
  }
  .ltsuan-faq-a {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(244, 239, 232, 0.65);
    margin: 0;
  }
</style>
