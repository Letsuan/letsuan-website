---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Letsuan Design | Jehol Biota Special Exhibition";
const description = "Opening Day, and Not One of the 93 Fossils Could Be Late: Jehol Biota. Construction for National Museum of Natural Science — Letsuan Design.";
const canonical = "https://letsuan.com/project-jehol-biota";
const alternateHrefs = [
  { hreflang: "en", href: canonical },
  { hreflang: "zh-TW", href: "https://letsuan.com/zh-TW/project-jehol-biota" },
  { hreflang: "x-default", href: canonical },
];

const ogImage = "https://letsuan.com/images/jehol-biota-exhibition-01-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Jehol Biota Special Exhibition", "description": "Fossils of the ancient East Asian biological community, National Museum of Natural Science.", "url": "https://letsuan.com/project-jehol-biota", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/jehol-biota-exhibition-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2018", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Jehol Biota Special Exhibition", "item": "https://letsuan.com/project-jehol-biota"}]}];
const eyebrowLeft = "EXHIBITION";
const eyebrowRight = "2019–2020 –NATIONAL MUSEUM OF NATURAL SCIENCE";
const h1Main = "Opening Day, and Not One of the 93 Fossils Could Be Late";
const h1Sub = "Jehol Biota";
const metaFields = [{"label": "CLIENT", "value": "National Museum of Natural Science"}, {"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2019–2020"}, {"label": "AREA", "value": "991.737㎡"}, {"label": "CATEGORY", "value": "Construction"}];
const bodyHtml = "<p>991.737 square meters, 93 fossil specimens, and an opening date that had already been announced to the public and international partners before the fit-out even started. That was the frame for the Jehol Biota Special Exhibition at the National Museum of Natural Science, which brought rare fossils from western Liaoning, China, dating back roughly 125 million years to the early Cretaceous, jointly curated with the NMNS Education Foundation and the Beijing Museum of Natural History. It marked the formal Taiwan debut of one of the twentieth century's most significant paleontological discoveries.</p>\n<p>The exhibition was organized into three zones, \"Entering the Jehol Biota,\" \"Encountering the Jehol Biota,\" and \"Witnessing the Evidence of Flight,\" and the 93 specimens included Scansoriopteryx and Microraptor gui. Among the highlights: China's first mummified Psittacosaurus fossil with clearly preserved skin impressions, the exhibition's largest specimen in a Jinzhousaurus fossil, and a Microraptor gui specimen with its feather melanin granules fully intact, evidence that matters directly to the study of how dinosaurs evolved into birds.</p>\n<p>We served as the <a href=\"./what-we-do#service-construction\">construction</a> contractor, converting the <a href=\"./portfolio\">museum</a>'s existing hall into a professional display environment that met international academic-collaboration standards and fossil-preservation requirements.</p>\n<h2>What the Fit-Out Had to Carry</h2>\n<p>These were precious fossil artifacts on international loan, so the venue had to meet the baseline temperature, humidity, seismic, and dust-control conditions required for museum-grade artifact display, keeping the loaned material safe and intact for the run of the show. The fit-out was also built zone by zone to match the exhibition's entering-encountering-witnessing narrative structure, so visitors would work through the science of the Jehol Biota step by step. Most specimens needed dedicated display cases and interpretive graphic systems, and every decision had to hold artifact-preservation standards and visual presentation in balance, since neither one could be allowed to compromise the other.</p>\n<h2>Working Backward From a Fixed Date</h2>\n<p>This was an international academic collaboration, and the opening date had already been made public, which left no room to slip. We worked backward from that fixed point: how long installation would take, how long the fossil specimens would need to arrive, how long positioning the display cases would take, compressing the entire fit-out into that window while still leaving enough buffer to guarantee the show would open on time regardless of what went wrong along the way. All 93 fossils, some of them hundreds of millions of years old, showed up exactly on schedule in their new home in Taiwan.</p>";
const relatedProjects = [{"href": "./project-story-telling", "label": "Story Telling by the Ancient People"}, {"href": "./project-nmns-teldap", "label": "NMNS TELDAP"}, {"href": "./project-dragon-to-beast", "label": "From Dragon to Beast"}];
const nextHref = "./project-marine-illusion";
const images = [{"src": "./images/jehol-biota-exhibition-01-letsuan-design.jpg", "alt": "Opening Day, and Not One of the 93 Fossils Could Be Late — Jehol Biota exhibition case with bird fossil specimens and illustrations"}, {"src": "./images/jehol-biota-exhibition-02-letsuan-design.jpg", "alt": "Jehol Biota exhibition wall on pterosaur skeleton structures"}, {"src": "./images/jehol-biota-exhibition-03-letsuan-design.jpg", "alt": "Jehol Biota exhibition corridor with fossil display panels"}, {"src": "./images/jehol-biota-exhibition-04-letsuan-design.jpg", "alt": "Curator installing a fossil specimen into a display case at Jehol Biota exhibition"}, {"src": "./images/jehol-biota-exhibition-05-letsuan-design.jpg", "alt": "Jehol Biota exhibition entrance wall with fossil display cases"}, {"src": "./images/jehol-biota-exhibition-06-letsuan-design.jpg", "alt": "Jehol Biota exhibition map wall showing fossil site locations"}, {"src": "./images/jehol-biota-exhibition-07-letsuan-design.jpg", "alt": "Jehol Biota exhibition display with red cabinet and bird artwork"}, {"src": "./images/jehol-biota-exhibition-08-letsuan-design.jpg", "alt": "Jehol Biota exhibition gallery room with fossil display cases"}, {"src": "./images/jehol-biota-exhibition-09-letsuan-design.jpg", "alt": "Jehol Biota exhibition fossil display case detail"}, {"src": "./images/jehol-biota-exhibition-10-letsuan-design.jpg", "alt": "Jehol Biota exhibition wall on fossil biota formation and importance"}, {"src": "./images/jehol-biota-exhibition-11-letsuan-design.jpg", "alt": "Painter finishing the Jehol Biota entrance wall mural during installation"}, {"src": "./images/jehol-biota-exhibition-12-letsuan-design.jpg", "alt": "Exhibition hall under construction ahead of the Jehol Biota opening"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  alternateHrefs={alternateHrefs}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
