---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { organizationJsonLd } from '../data/organization';
import { avifPath } from '../utils/images';

const title = 'Letsuan Design | About Us';
const description = 'Letsuan Design is a Taiwan-based interior, exhibition, and visual design studio in Taichung and Taipei, delivering museum-grade exhibitions and commercial interiors since 2014.';
const canonical = 'https://letsuan.com/about';
const alternateHrefs = [
  { hreflang: 'en', href: canonical },
  { hreflang: 'zh-TW', href: 'https://letsuan.com/zh-TW/about' },
  { hreflang: 'x-default', href: canonical },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const stats = [
  { value: '42+', label: 'PROJECTS DELIVERED' },
  { value: '2014', label: 'FOUNDED' },
  { value: 'TW', label: 'TAICHUNG & TAIPEI' },
  { value: '17,000+ m²', label: 'SPACE DELIVERED' },
];

function splitParagraph(text: string) {
  const m = text.match(/^(First|Second|Third|In addition)([,])/);
  if (!m) return { marker: null as string | null, rest: text };
  return { marker: m[1], rest: text.slice(m[0].length) };
}

const esgItems = [
  {
    num: '01',
    zh: 'Environment',
    enLabel: 'Environmental',
    title: 'Built for the long-term health of the site',
    labels: { 1: 'Zero-Damage Structural Systems', 2: 'Green Materials & Energy Efficiency', 3: 'Reuse & Waste Reduction' } as Record<number, string>,
    paragraphs: [
      "For heritage buildings, historic structures, and older houses, construction convenience is never the priority. Once the fabric is damaged, it can't be undone, so we put the long-term health of the site and its structure first.",
      'First, we build on a zero-damage structural principle. Every design starts with an as-built survey and structural inventory, then uses reversible methods, non-invasive fixings, distributed loading, and zoned protection to avoid irreversible damage to existing beams, columns, brick walls, flooring, and historic surfaces. Every fixing point has to be fully removable.',
      "Second, we treat Taiwan's regulatory minimum of 60% green-material content as a floor, not a target, and keep raising that ratio. We favor low-formaldehyde, low-VOC, recyclable materials sourced from local production, and add high-efficiency LED lighting with circuit control, variable-frequency air conditioning, reworked daylighting and ventilation paths, and detailed thermal and air-tightness work, so the energy savings show up in daily use.",
      'Third, from assessing salvageable materials for reuse to sorting construction waste and controlling dust and noise on site, we calculate lifecycle cost rather than one-off material savings. The goal is a balance between environmental responsibility and client cost that holds up over time.',
    ],
  },
  {
    num: '02',
    zh: 'Social',
    enLabel: 'Social',
    title: 'One safety standard, no exceptions for subcontractors',
    labels: { 3: 'Project Insurance' } as Record<number, string>,
    paragraphs: [
      'Whether a job site is truly sustainable comes down to how it treats its most vulnerable workers. We hold ourselves equally responsible for on-site occupational safety and for the labor conditions of our subcontractors.',
      'As a licensed interior decoration business, the regulatory and safety standards we require of subcontractors match what we require of our own team, with no distinction between the two.',
      'That standard runs through daily practice: pre-shift briefings and toolbox talks, fall and electrical-shock protection, dust and noise controls, permits and supervision for hot work and work at height, and training and qualification checks for contractors. We require reasonable working hours, full labor and health insurance and pension contributions, and zero wage withholding or illegal employment. That commitment extends to every worker on site.',
      "In addition, every large-scale project carries additional project insurance, including contractor's all-risk insurance, employer's liability insurance, and third-party liability insurance. The intent is to make sure clients, users, and the on-site team are fully covered before an incident happens, not after.",
    ],
  },
  {
    num: '03',
    zh: 'Governance',
    enLabel: 'Governance',
    title: 'Compliance as a process you can trace',
    labels: { 1: 'Transparent Disclosure', 2: 'Licensed Permit Filing', 3: 'Traceable Documentation' } as Record<number, string>,
    paragraphs: [
      "Most disputes in the renovation industry come down to something that was never made clear up front. We make that our responsibility to settle before work begins.",
      "First, we proactively disclose our interior decoration business registration number, company registration details, and professional staff qualifications, and clients can verify any of it at any time.",
      "Second, we handle professional renovation permit applications and review submissions on the client's behalf. That covers drawing production, structural safety, fire escape routes, accessibility, and partition-wall review, through to filing and on-site inspection, so the design intent stays realized within a legal framework throughout.",
      'Third, from application through inspection, every compliance procedure, material certificate, construction record, inspection photo, and warranty document is kept complete with cloud backup and stays traceable. Contracts, change orders, and warranty scope are all set out in writing, so every commitment leaves a record that can be checked.',
    ],
  },
];

const esgStepsData = esgItems.map((item) => ({
  id: item.num,
  zh: item.zh,
  en: item.enLabel,
  title: item.title,
  labels: item.labels,
  paragraphs: item.paragraphs,
}));

const faqs = [
  { q: 'What does Letsuan Design specialize in?', a: 'Letsuan Design is a licensed design company based in Taichung and Taipei, Taiwan, specializing in museum-grade exhibitions, commercial interiors, visual identity systems, and design-build contracting.' },
  { q: 'When was Letsuan Design founded?', a: 'The company was founded in 2014 and has completed more than 42 projects for museums, government agencies, and international brands.' },
  { q: 'Does Letsuan Design handle both design and construction?', a: 'Yes. Projects go from design to construction without changing hands: the same team stays on from the first sketch through final installation.' },
  { q: 'Is Letsuan Design a licensed interior decoration business?', a: "Yes. We hold interior decoration business registration number 40E2007328 and handle professional renovation permit applications and review submissions on our clients' behalf." },
];

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://letsuan.com/about#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://letsuan.com/#website' },
      about: { '@id': 'https://letsuan.com/#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://letsuan.com/' },
        { '@type': 'ListItem', position: 2, name: 'About Us', item: canonical },
      ],
    },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, pageJsonLd, faqJsonLd]} alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="about" zhHref="/zh-TW/about" />

    <div class="ltsuan-container">
    <section id="hero">
      <div class="ltsuan-hero-grid">
        <div class="ltsuan-hero-copy">
          <h1 class="ltsuan-h1" data-hero-h1>Space and Story,<br /><span class="ltsuan-h1-accent">Shaped by the Same Hands</span>.</h1>
          <p class="ltsuan-lead" data-hero-lead>A design company based in Taichung and Taipei, Taiwan, serving museums, government agencies, and international brands since 2014, involved from the first sketch through on-site installation.</p>
        </div>
        <div class="ltsuan-hero-panel">
          <div class="ltsuan-hero-photo">
            <picture>
              <source srcset={avifPath('/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg')} type="image/avif" />
              <img src="/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg" alt="Visitors exploring a glowing aquarium display beneath the Masters of Marine exhibit signage in a dim blue-lit gallery" class="ltsuan-hero-photo-img" />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <section id="record">
      <div class="ltsuan-why-grid">
        <div class="ltsuan-stat">
          <div class="ltsuan-stat-row">
            <div class="ltsuan-stat-num">{stats[0].value}</div>
            <div class="ltsuan-stat-meta">
              <div class="ltsuan-stat-label">PROJECTS</div>
              <div class="ltsuan-stat-rule"></div>
              <div class="ltsuan-stat-sub">DELIVERED<br />TO DATE</div>
            </div>
          </div>
          <p class="ltsuan-stat-caption">EST. 2014 — TAICHUNG &amp; TAIPEI</p>
        </div>
        <div class="ltsuan-why-copy">
          <h2 class="ltsuan-why-h2">Company Profile</h2>
          <div class="ltsuan-why-text">
            <p>Letsuan Design is a licensed design company based in Taichung and Taipei, Taiwan, delivering museum-grade exhibitions and commercial interiors since 2014. Our work spans museums, aquariums, cultural venues, corporate spaces, and public installations: any physical space built to communicate something is within our field.</p>
            <p>The team moves comfortably between narrative design, spatial planning, visual systems, and on-site construction, keeping every detail anchored to a single core concept.</p>
            <p>Team composition scales with each project, bringing in licensed architects, fire safety engineers, civil engineers, quality-control staff, and multimedia programmers as individual project needs require.</p>
          </div>
          <div class="ltsuan-stats-mini-grid">
            {stats.slice(1).map((st) => (
              <div class="ltsuan-stats-mini-card">
                <div class="ltsuan-stats-mini-value">{st.value}</div>
                <div class="ltsuan-stats-mini-label">{st.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="sustainability">
      <div class="ltsuan-esg-eyebrow">
        <span class="ltsuan-esg-eyebrow-rule"></span>
        <span class="ltsuan-esg-eyebrow-text">ESG / SUSTAINABILITY</span>
      </div>

      <div class="ltsuan-esg-intro-grid">
        <h2 class="ltsuan-esg-h2">Sustainability<br />as a System</h2>
        <div class="ltsuan-esg-intro-copy">
          <p class="ltsuan-esg-lead-highlight">We define sustainability as the systematic practice of ESG, not the choice of an eco-friendly finish.</p>
          <p class="ltsuan-esg-lead-text">In the renovation industry, sustainability is often reduced to a green-building certification sticker. That falls well short of what we consider adequate. Sustainability has to be a baseline standard built into every design decision, material choice, and construction step, not an optional upgrade at extra cost. It comes down to whether a space can be used for the long term, whether the people on site are kept safe, and whether the client's interests are protected by a documented process.</p>
        </div>
      </div>

      <div class="ltsuan-process-tracker" data-esg-tracker>
        <div class="ltsuan-process-line-track"></div>
        <div class="ltsuan-process-line-fill" data-esg-fill></div>
        <div class="ltsuan-process-buttons" data-esg-buttons>
          {esgItems.map((item, i) => (
            <button type="button" class="ltsuan-process-btn" data-step-index={i} aria-current={i === 0 ? 'step' : undefined}>
              <span class="ltsuan-process-ring">
                <span class="ltsuan-process-dot"></span>
              </span>
              <span class="ltsuan-process-btn-zh">{item.zh}</span>
              <span class="ltsuan-process-btn-en">{item.enLabel}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="ltsuan-process-detail">
        <div class="ltsuan-process-detail-inner">
          <div class="ltsuan-process-detail-head">
            <span class="ltsuan-process-detail-id" data-esg-detail-id>{esgItems[0].num}</span>
            <span class="ltsuan-process-detail-rule"></span>
            <span class="ltsuan-process-detail-en" data-esg-detail-en>{esgItems[0].enLabel.toUpperCase()}</span>
          </div>
          <h3 class="ltsuan-esg-detail-title" data-esg-detail-title>{esgItems[0].title}</h3>
          <div class="ltsuan-process-detail-desc" data-esg-detail-desc>
            {esgItems[0].paragraphs.map((p, pi) => {
              const { marker, rest } = splitParagraph(p);
              const label = esgItems[0].labels[pi];
              if (marker && label) {
                return (
                  <div class="ltsuan-esg-point">
                    <div class="ltsuan-esg-point-head">
                      <span class="ltsuan-esg-para-marker">{marker}</span>
                      <span class="ltsuan-esg-point-label">{label}</span>
                    </div>
                    <p>{rest}</p>
                  </div>
                );
              }
              return <p class={pi === 0 ? 'ltsuan-esg-para-lead' : ''}>{p}</p>;
            })}
          </div>
        </div>
      </div>

      <div class="ltsuan-process-mobile">
        <div class="ltsuan-process-mobile-line"></div>
        {esgItems.map((item) => (
          <details class="ltsuan-process-mobile-item">
            <summary>
              <span class="ltsuan-process-mobile-dot"></span>
              <span class="ltsuan-process-mobile-zh">{item.zh}</span>
              <span class="ltsuan-process-mobile-en">{item.enLabel}</span>
            </summary>
            <h4 class="ltsuan-esg-mobile-title">{item.title}</h4>
            {item.paragraphs.map((p, pi) => {
              const { marker, rest } = splitParagraph(p);
              const label = item.labels[pi];
              if (marker && label) {
                return (
                  <div class="ltsuan-esg-point">
                    <div class="ltsuan-esg-point-head">
                      <span class="ltsuan-esg-para-marker">{marker}</span>
                      <span class="ltsuan-esg-point-label">{label}</span>
                    </div>
                    <p>{rest}</p>
                  </div>
                );
              }
              return <p class={pi === 0 ? 'ltsuan-esg-para-lead' : ''}>{p}</p>;
            })}
          </details>
        ))}
      </div>

      <p class="ltsuan-esg-close">To us, sustainability is risk management, not a cost.<br />It is respect for the site, protection for the people on it, and accountability to the process.<br />Get all three right, done by the same hands, and design finally has a chance to last.</p>
    </section>

    <section id="clients">
      <div class="ltsuan-eyebrow ltsuan-eyebrow-dim">Clients</div>
      <p class="ltsuan-split-text">We work with the Ministry of Culture, the Tourism Administration, the National Museum of Natural Science, Ørsted, FedEx, Toei Animation, Shogakukan, and other agencies and brands.</p>
      <p class="ltsuan-client-list">Ministry of Culture・Tourism Administration, MOTC・Agency of Corrections・Republic of China Air Force Academy・National Museum of Natural Science・National Museum of History・National Taiwan Museum of Fine Arts・National Science and Technology Museum・Ørsted・FedEx・Toei Animation・Shogakukan・SinoPac Securities・Sunwe Solar</p>
      <a href="./portfolio" class="ltsuan-see-work-link"><span>See our work with them</span><span class="ltsuan-see-work-arrow">↗</span></a>
    </section>

    <section id="faq">
      <div class="ltsuan-process-heading">
        <h2 class="ltsuan-process-h2">FAQ</h2>
      </div>
      <div class="ltsuan-faq-grid">
        {faqs.map((f) => (
          <div class="ltsuan-faq-item">
            <h3 class="ltsuan-faq-q">{f.q}</h3>
            <p class="ltsuan-faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="contact">
      <div class="ltsuan-cta">
        <div class="ltsuan-cta-pill"><span class="ltsuan-cta-dot"></span>NEW PROJECTS FOR 2026 — OPEN</div>
        <h2 class="ltsuan-cta-h2">Let's talk about<br />your next idea.</h2>
        <p class="ltsuan-cta-copy">Whatever form the exhibition takes, our starting question stays the same: how do we lead visitors into the story, and make the experience a memory they carry with them.</p>
        <div class="ltsuan-cta-actions">
          <a href="https://letsuan.com/contact" class="ltsuan-cta-btn">
            <span>info@letsuan.com</span>
            <span class="ltsuan-cta-btn-arrow">↗</span>
          </a>
          <div class="ltsuan-cta-note">We'll get back to you within two business days.</div>
        </div>

        <div class="ltsuan-cta-footer">
          <div class="ltsuan-cta-social">
            <a href="https://www.facebook.com/LETSUANDESIGN" target="_blank" rel="noopener" aria-label="Facebook" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.pinterest.com/Letsuan_Design/" target="_blank" rel="noopener" aria-label="Pinterest" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.194-.332 1.361-.052.219-.173.265-.4.16-1.492-.694-2.424-2.874-2.424-4.625 0-3.767 2.737-7.229 7.892-7.229 4.144 0 7.365 2.953 7.365 6.897 0 4.116-2.595 7.428-6.199 7.428-1.211 0-2.349-.629-2.738-1.373 0 0-.599 2.282-.744 2.84-.269 1.037-.997 2.336-1.484 3.129 1.118.346 2.303.53 3.532.53 6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/letsuan-design/" target="_blank" rel="noopener" aria-label="LinkedIn" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.454c.98 0 1.775-.773 1.775-1.729V1.729C24 .774 23.205 0 22.225 0zM7.12 20.452H3.56V9h3.56v11.452zM5.34 7.433c-1.144 0-2.067-.926-2.067-2.065 0-1.138.923-2.065 2.067-2.065 1.14 0 2.064.927 2.064 2.065 0 1.139-.923 2.065-2.064 2.065zM20.452 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.137 1.447-2.137 2.941v5.665H9.359V9h3.412v1.561h.049c.475-.9 1.637-1.85 3.37-1.85 3.601 0 4.266 2.37 4.266 5.455v6.286z"/></svg>
            </a>
          </div>
          <div class="ltsuan-cta-cityline">Taichung Studio, Taipei Studio&nbsp;&nbsp;|&nbsp;&nbsp;+886 4 2321 5956</div>
          <div class="ltsuan-cta-address">6F.-1, No. 85, Sec. 1, Huamei W. St., West District, Taichung City 403020, Taiwan&nbsp;&nbsp;|&nbsp;&nbsp;3F., No. 62, Sec. 6, Yanping N. Rd., Shilin District, Taipei City 111069, Taiwan</div>
          <div class="ltsuan-cta-legal">
            <span>© 2026 Letsuan Design &amp; Interior Deco. All rights reserved.</span>
            <span>Interior Decorators' Registration No. 40E2007328</span>
            <a href="./privacy-policy">Privacy Policy</a>
          </div>
        </div>
      </div>
    </section>
    </div>

    <div class="ltsuan-bottom-bar"></div>
  </div>
</Layout>

<script>
  import '../scripts/reveal';

  const heroH1 = document.querySelector<HTMLElement>('[data-hero-h1]');
  const heroLead = document.querySelector<HTMLElement>('[data-hero-lead]');
  function syncLeadWidth() {
    if (!heroH1 || !heroLead) return;
    heroLead.style.maxWidth = `${heroH1.getBoundingClientRect().width}px`;
  }
  syncLeadWidth();
  window.addEventListener('resize', syncLeadWidth);

  function syncStatRuleWidths() {
    document.querySelectorAll<HTMLElement>('.ltsuan-stat-meta').forEach((meta) => {
      const label = meta.querySelector<HTMLElement>('.ltsuan-stat-label');
      const rule = meta.querySelector<HTMLElement>('.ltsuan-stat-rule');
      if (!label || !rule) return;
      rule.style.width = `${label.getBoundingClientRect().width}px`;
    });
  }
  syncStatRuleWidths();
  window.addEventListener('resize', syncStatRuleWidths);

  function syncEsgHeadingAlign() {
    const label = document.querySelector<HTMLElement>('#record .ltsuan-stat-label');
    const h2 = document.querySelector<HTMLElement>('.ltsuan-esg-h2');
    if (!label || !h2) return;
    if (window.innerWidth <= 900) {
      h2.style.width = '';
      return;
    }
    const width = label.getBoundingClientRect().right - h2.getBoundingClientRect().left;
    if (width > 0) h2.style.width = `${width}px`;
  }
  syncEsgHeadingAlign();
  window.addEventListener('resize', syncEsgHeadingAlign);

  // ESG process-tracker (mirrors the What We Do "Process" section)
  function splitParagraphClient(text: string) {
    const m = text.match(/^(First|Second|Third|In addition)([,])/);
    if (!m) return { marker: null as string | null, rest: text };
    return { marker: m[1], rest: text.slice(m[0].length) };
  }

  const esgTrack = document.querySelector<HTMLElement>('.ltsuan-process-line-track');
  const esgFill = document.querySelector<HTMLElement>('[data-esg-fill]');
  const esgButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-esg-buttons] .ltsuan-process-btn'));
  const esgDetailId = document.querySelector<HTMLElement>('[data-esg-detail-id]');
  const esgDetailEn = document.querySelector<HTMLElement>('[data-esg-detail-en]');
  const esgDetailTitle = document.querySelector<HTMLElement>('[data-esg-detail-title]');
  const esgDetailDesc = document.querySelector<HTMLElement>('[data-esg-detail-desc]');
  const esgSteps = JSON.parse(document.getElementById('ltsuan-esg-data')?.textContent || '[]') as Array<{ id: string; en: string; zh: string; title: string; labels: Record<number, string>; paragraphs: string[] }>;
  let esgCurrentIndex = 0;

  // Astro scopes component styles with a data-astro-cid-* attribute added at build time.
  // Elements created here via the DOM API never get that attribute, so scoped styles
  // (flex layout, accent colors) silently fail to apply unless we copy it over by hand.
  const esgScopeAttr = esgDetailDesc && Array.from(esgDetailDesc.attributes).find((a) => a.name.startsWith('data-astro-cid-'))?.name;
  function scopeEl<T extends HTMLElement>(el: T): T {
    if (esgScopeAttr) el.setAttribute(esgScopeAttr, '');
    return el;
  }

  function syncEsgFillWidth() {
    if (!esgTrack || !esgFill) return;
    if (esgCurrentIndex === esgButtons.length - 1) {
      esgFill.style.transform = 'scaleX(1)';
      return;
    }
    const targetRing = esgButtons[esgCurrentIndex]?.querySelector<HTMLElement>('.ltsuan-process-ring');
    if (!targetRing) return;
    const trackRect = esgTrack.getBoundingClientRect();
    const ringRect = targetRing.getBoundingClientRect();
    const ringCenterX = (ringRect.left + ringRect.right) / 2;
    if (trackRect.width === 0) return;
    const fraction = (ringCenterX - trackRect.left) / trackRect.width;
    esgFill.style.transform = `scaleX(${Math.max(0, fraction)})`;
  }

  function setEsgStep(index: number) {
    const step = esgSteps[index];
    if (!step) return;
    esgCurrentIndex = index;
    esgButtons.forEach((btn, i) => {
      const passed = i <= index;
      btn.classList.toggle('is-current', i === index);
      btn.classList.toggle('is-passed', passed);
      if (i === index) btn.setAttribute('aria-current', 'step');
      else btn.removeAttribute('aria-current');
    });
    syncEsgFillWidth();
    if (esgDetailId) esgDetailId.textContent = step.id;
    if (esgDetailEn) esgDetailEn.textContent = step.en.toUpperCase();
    if (esgDetailTitle) esgDetailTitle.textContent = step.title;
    if (esgDetailDesc) {
      esgDetailDesc.innerHTML = '';
      step.paragraphs.forEach((p, pi) => {
        const { marker, rest } = splitParagraphClient(p);
        const label = step.labels[pi];
        if (marker && label) {
          const wrap = scopeEl(document.createElement('div'));
          wrap.className = 'ltsuan-esg-point';
          const head = scopeEl(document.createElement('div'));
          head.className = 'ltsuan-esg-point-head';
          const markerSpan = scopeEl(document.createElement('span'));
          markerSpan.className = 'ltsuan-esg-para-marker';
          markerSpan.textContent = marker;
          const labelSpan = scopeEl(document.createElement('span'));
          labelSpan.className = 'ltsuan-esg-point-label';
          labelSpan.textContent = label;
          head.appendChild(markerSpan);
          head.appendChild(labelSpan);
          const el = scopeEl(document.createElement('p'));
          el.textContent = rest;
          wrap.appendChild(head);
          wrap.appendChild(el);
          esgDetailDesc.appendChild(wrap);
        } else {
          const el = scopeEl(document.createElement('p'));
          if (pi === 0) el.className = 'ltsuan-esg-para-lead';
          el.textContent = p;
          esgDetailDesc.appendChild(el);
        }
      });
    }
  }

  setEsgStep(0);

  esgButtons.forEach((btn, i) => {
    btn.addEventListener('click', () => setEsgStep(i));
    btn.addEventListener('mouseenter', () => setEsgStep(i));
    btn.addEventListener('focus', () => setEsgStep(i));
  });

  window.addEventListener('resize', syncEsgFillWidth);
</script>

