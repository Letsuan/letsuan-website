---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CornerFrame from '../components/CornerFrame.astro';
import { organizationJsonLd } from '../data/organization';
import { avifPath } from '../utils/images';

const title = 'Le Tsuan Design | About the Studio';
const description = 'Le Tsuan Design is a Taichung, Taiwan-based studio specializing in interior, exhibition, visual design and construction.';
const canonical = 'https://letsuan.com/about';
const alternateHrefs = [
  { hreflang: 'en', href: canonical },
  { hreflang: 'zh-TW', href: 'https://letsuan.com/zh-TW/about' },
  { hreflang: 'x-default', href: canonical },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://letsuan.com/about#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://letsuan.com/#website' },
      about: { '@id': 'https://letsuan.com/#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://letsuan.com/' },
        { '@type': 'ListItem', position: 2, name: 'About', item: canonical },
      ],
    },
  ],
};

const faqs = [
  { q: 'What does Le Tsuan Design specialise in?', a: 'Le Tsuan Design is a licensed interior, exhibition and visual design studio based in Taichung and Taipei, Taiwan, specialising in museum-grade exhibitions, commercial interiors, visual identity systems and turn-key construction.' },
  { q: 'When was Le Tsuan Design founded?', a: 'The studio was founded in 2014 and has delivered 42+ projects across museums, government agencies and global brands.' },
  { q: 'Does Le Tsuan Design handle both design and construction?', a: 'Yes. The project never changes hands between design and construction. The same team stays involved from the first sketch to the final install.' },
  { q: 'Is Le Tsuan Design a licensed interior decorator?', a: "Yes. We hold Interior Decorators' Registration No. 40E2007328 and handle professional renovation permit filing and review submissions on behalf of our clients." },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const stats = [
  { value: '42+', label: 'Projects Delivered', desc: 'Museums, government agencies and global brands across Taiwan.' },
  { value: '2014', label: 'Studio Founded', desc: 'A decade of narrative-led design, based in Taichung and Taipei.' },
  { value: 'TW', label: 'Taichung · Taipei', desc: 'Based in Taiwan, delivering nationwide.' },
  { value: '17,000+ m²', label: 'Space Delivered', desc: 'Sequenced and finished under our own site management, with specialist trades directly supervised.' },
];

const services = [
  { title: 'Curatorial Services', desc: 'From concept development to content research and narrative scripting, we give every exhibition a solid curatorial framework and point of view.', img: '/images/air-force-academy-eagle-sculpture-installation-with-archway-letsuan-design.jpg', alt: 'R.O.C. Air Force Academy 90th Founding Anniversary — Eagle sculpture installation with archway feature wall', evidenceHref: './project-air-force-academy', evidenceLabel: 'R.O.C. Air Force Academy 90th Founding Anniversary' },
  { title: 'Exhibition Design', desc: 'Narrative-led exhibitions for museums, aquariums and cultural venues, from storyline to set design to lighting.', img: '/images/cat-art-dream-painting-cat-parody-with-visitor-letsuan-design.jpg', imgPosition: 'center 40%', alt: "Cat Art Museum — Visitor viewing a gold-framed cat parody reinterpretation of Picasso's The Dream painting", evidenceHref: './project-cat-art', evidenceLabel: 'Cat Art Museum' },
  { title: 'Interior Design', desc: 'Interiors for commercial, cultural and institutional spaces, planned around how people actually move and gather.', img: '/images/securities-company-office-design-02-letsuan-design.jpg', alt: 'Securities Company Office waiting area', evidenceHref: './project-securities-office', evidenceLabel: 'Securities Company Office' },
  { title: 'Visual Design', desc: 'Identity systems, wayfinding and graphic environments that carry a brand consistently through physical space.', img: '/images/westernmost-point-taiwan-01-letsuan-design.jpg', alt: 'The Westernmost Point of Taiwan — Westernmost Point of Taiwan entrance', evidenceHref: './project-westernmost-point', evidenceLabel: 'The Westernmost Point of Taiwan' },
  { title: 'Construction', desc: 'In-house fabrication and site management that takes a design from drawing to a finished, durable build.', img: '/images/engineering-construction-circular-exhibition-hall-with-central-planter-letsuan-design.jpg', alt: 'Disaster Prevention Hall — Circular exhibition hall with central planter and panel walls', evidenceHref: './project-engineering-construction', evidenceLabel: 'Disaster Prevention Hall' },
];
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, pageJsonLd, faqJsonLd]} alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="about" zhHref="/zh-TW/about" />

    <div class="ltsuan-about-main">
      <section id="hero">
        <div class="ltsuan-reveal ltsuan-hero-block">
          <h1 class="ltsuan-hero-h1">Space and story,<br />built by the same hands.</h1>
          <p class="ltsuan-hero-sub">Interior, exhibition and visual design studio based in Taichung and Taipei, Taiwan — serving museums, government agencies and global brands since 2014.</p>
          <a href="./portfolio" class="ltsuan-badge">VIEW<br />PORTFOLIO</a>
        </div>

        <div class="ltsuan-hero-media">
          <picture>
            <source srcset={avifPath('/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg')} type="image/avif" />
            <img
              src="/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg"
              alt="Visitors exploring the Masters of Marine Illusion exhibition at Taichung Aquarium, an interior and exhibition design project by Le Tsuan Design"
              class="ltsuan-hero-img"
            />
          </picture>
          <CornerFrame size={16} />
        </div>
        <div style="height:40px"></div>
      </section>

      <section id="services">
        <div class="ltsuan-reveal ltsuan-services-head">
          <h2 class="ltsuan-section-h2">Services</h2>
          <div class="ltsuan-section-counter">01&nbsp;/&nbsp;05</div>
        </div>
        <div class="ltsuan-services-grid">
          {services.map((svc, i) => (
            <div class:list={['ltsuan-svc-card', { 'ltsuan-svc-card-accent': i === 0 }]}>
              <CornerFrame size={10} opacity={0.55} />
              <div class="ltsuan-svc-img-wrap">
                <picture>
                  <source srcset={avifPath(svc.img)} type="image/avif" />
                  <img alt={svc.alt} src={svc.img} style={`object-position:${svc.imgPosition || 'center'}`} class="ltsuan-svc-img" loading="lazy" decoding="async" />
                </picture>
              </div>
              <h3 class="ltsuan-svc-title">{svc.title}</h3>
              <p class="ltsuan-svc-desc">{svc.desc}</p>
              <a href={svc.evidenceHref} class="ltsuan-svc-evidence">{svc.evidenceLabel} →</a>
            </div>
          ))}
        </div>
      </section>

      <section id="record">
        <div class="ltsuan-reveal ltsuan-stats-band">
          {stats.map((st) => (
            <div class="ltsuan-stat-tile">
              <div class="ltsuan-stat-value">{st.value}</div>
              <div class="ltsuan-stat-label">{st.label}</div>
              <p class="ltsuan-stat-desc">{st.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="studio">
        <div class="ltsuan-reveal ltsuan-studio-copy">
          <div class="ltsuan-eyebrow">THE STUDIO</div>
          <p class="ltsuan-body-copy">Le Tsuan Design is a licensed interior, exhibition and visual design studio based in Taichung and Taipei, Taiwan, delivering museum-grade exhibitions and commercial interiors since 2014. We work across museums, aquariums, cultural venues, corporate spaces and public installations, wherever a physical space needs to carry a message.</p>
          <p class="ltsuan-body-copy">Our team moves fluidly between narrative design, spatial planning, graphic systems and on-site construction, which lets us stay involved from the first sketch to the final install, keeping every detail in service of the same idea.</p>
          <p class="ltsuan-body-copy">We scale the team to the project, bringing in licensed architects, fire-safety engineers, civil engineers and quality-control inspectors as each site and regulatory requirement demands.</p>
          <p class="ltsuan-body-copy ltsuan-body-copy-last">The project never changes hands between design and construction.</p>
        </div>
      </section>

      <section id="sustainability-clients">
        <div class="ltsuan-reveal ltsuan-split">
          <div>
            <div class="ltsuan-eyebrow">SUSTAINABILITY</div>
            <div class="ltsuan-sustain-img-wrap">
              <picture>
                <source srcset={avifPath('/images/green-energy-vision-pavilion-01-letsuan-design.jpg')} type="image/avif" />
                <img src="/images/green-energy-vision-pavilion-01-letsuan-design.jpg" alt="Green Energy Vision pavilion, an interior design project by Le Tsuan Design demonstrating non-invasive sustainable construction" class="ltsuan-sustain-img" />
              </picture>
              <CornerFrame size={14} />
            </div>
            <p class="ltsuan-body-copy-70">Sustainability runs through how we build: non-invasive structural systems that protect heritage sites and historic fabric.</p>
            <p class="ltsuan-body-copy-70">Our green building material usage rate meets the current legal minimum of 60%, balancing environmental responsibility with client cost.</p>
            <p class="ltsuan-body-copy-70 ltsuan-body-copy-last">As a licensed interior decorator, we apply the same regulatory and safety standards to our subcontractors that we apply to ourselves.</p>
          </div>

          <div>
            <div class="ltsuan-eyebrow ltsuan-eyebrow-dim">SELECTED CLIENTS</div>
            <div class="ltsuan-client-imgs">
              <div class="ltsuan-client-img-wrap">
                <picture>
                  <source srcset={avifPath('/images/hakka-culture-gallery-corridor-with-tree-branch-display-letsuan-design.jpg')} type="image/avif" />
                  <img src="/images/hakka-culture-gallery-corridor-with-tree-branch-display-letsuan-design.jpg" alt="Gallery corridor at a Hakka culture exhibition, an exhibition design project by Le Tsuan Design" class="ltsuan-client-img" />
                </picture>
                <CornerFrame size={12} />
              </div>
              <div class="ltsuan-client-img-wrap">
                <picture>
                  <source srcset={avifPath('/images/asian-art-biennial-02-letsuan-design.jpg')} type="image/avif" />
                  <img src="/images/asian-art-biennial-02-letsuan-design.jpg" alt="Asian Art Biennial installation, an exhibition design project by Le Tsuan Design" class="ltsuan-client-img" />
                </picture>
                <CornerFrame size={12} />
              </div>
            </div>
            <p class="ltsuan-body-copy-70">We have partnered with 7+ government agencies and public institutions.</p>
            <p class="ltsuan-client-list">National Museum of Natural Science · National Museum of History · National Taiwan Museum of Fine Arts · Ministry of Culture · R.O.C. Air Force Academy · Ørsted · TSMC · HTC · FedEx · Toei · Shogakukan · SinoPac Securities</p>
            <a href="./portfolio" class="ltsuan-see-work-link">See our work with them →</a>
            <p class="ltsuan-license-note">Licensed Interior Decorator (Registration No. 40E2007328). We handle professional renovation permit filing and review submissions on behalf of our clients.</p>
          </div>
        </div>
      </section>

      <section id="faq">
        <div class="ltsuan-reveal">
          <h2 class="ltsuan-section-h2 ltsuan-faq-title">Frequently Asked Questions</h2>
          <div class="ltsuan-faq-list">
            {faqs.map((f) => (
              <div class="ltsuan-faq-item">
                <h3 class="ltsuan-faq-q">{f.q}</h3>
                <p class="ltsuan-faq-a">{f.a}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <Footer background="#0B1526" />
    </div>
  </div>
</Layout>

<script>
  import '../scripts/reveal';
</script>

<style is:global>
  :root {
    --ltsuan-bg: #0b1526;
    --ltsuan-panel: #101b33;
    --ltsuan-accent: #8ec31f;
    --ltsuan-accent-hover: #a8dc4a;
    --ltsuan-line: rgba(244, 239, 232, 0.12);
    --ltsuan-dim: rgba(244, 239, 232, 0.6);
    --ltsuan-blueprint: #c9d6e8;
  }
</style>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
    position: relative;
  }
  #hero {
    padding: 110px 60px 0 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-hero-block {
    position: relative;
    max-width: 900px;
    margin-bottom: 36px;
  }
  .ltsuan-hero-h1 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(36px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
  }
  .ltsuan-hero-sub {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.5;
    color: var(--ltsuan-dim);
    margin: 0;
    max-width: 46ch;
  }
  .ltsuan-badge {
    position: absolute;
    top: 0;
    right: 0;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 1px solid var(--ltsuan-line);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ltsuan-text);
    text-decoration: none;
  }
  .ltsuan-hero-media {
    position: relative;
    overflow: hidden;
    height: clamp(280px, 36vw, 460px);
  }
  .ltsuan-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.88) saturate(1.08);
  }
  #studio {
    padding: 24px 60px 44px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-studio-copy {
    max-width: 640px;
  }
  .ltsuan-eyebrow {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.15em;
    color: var(--ltsuan-accent);
    margin-bottom: 10px;
  }
  .ltsuan-eyebrow-dim {
    color: var(--ltsuan-dim);
  }
  .ltsuan-body-copy {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.75);
    margin: 0 0 10px;
  }
  .ltsuan-body-copy-70 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.7);
    margin: 0 0 10px;
  }
  .ltsuan-body-copy-last {
    margin-bottom: 0;
  }
  #record {
    padding: 56px 60px;
    border-bottom: 1px solid var(--ltsuan-line);
    background-image: repeating-linear-gradient(135deg, transparent, transparent 26px, rgba(142, 195, 31, 0.05) 26px, rgba(142, 195, 31, 0.05) 27px);
  }
  .ltsuan-stats-band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 900px) {
    .ltsuan-stats-band {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 32px;
    }
  }
  @media (max-width: 560px) {
    .ltsuan-stats-band {
      grid-template-columns: 1fr;
      row-gap: 28px;
    }
  }
  .ltsuan-stat-tile {
    position: relative;
    padding: 0 28px;
    border-left: 1px solid var(--ltsuan-line);
  }
  .ltsuan-stat-tile:first-child {
    padding-left: 0;
    border-left: none;
  }
  @media (max-width: 900px) {
    .ltsuan-stat-tile:nth-child(odd) {
      padding-left: 0;
      border-left: none;
    }
  }
  @media (max-width: 560px) {
    .ltsuan-stat-tile {
      padding-left: 0;
      border-left: none;
    }
  }
  .ltsuan-stat-value {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: clamp(32px, 3.4vw, 46px);
    color: var(--ltsuan-accent);
    margin-bottom: 8px;
  }
  .ltsuan-stat-label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    color: var(--ltsuan-text);
    margin-bottom: 8px;
  }
  .ltsuan-stat-desc {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(244, 239, 232, 0.55);
    margin: 0;
  }
  #sustainability-clients {
    padding: 64px 60px 56px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
  }
  @media (max-width: 640px) {
    .ltsuan-split {
      grid-template-columns: 1fr !important;
    }
    .ltsuan-badge {
      position: static !important;
      margin: 20px 0 0 !important;
    }
    #sustainability-clients,
    #hero,
    #studio,
    #record,
    #services {
      padding-left: 24px !important;
      padding-right: 24px !important;
    }
  }
  .ltsuan-sustain-img-wrap {
    position: relative;
    overflow: hidden;
    height: 160px;
    margin-bottom: 18px;
  }
  .ltsuan-sustain-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.85) saturate(1.1);
  }
  .ltsuan-client-imgs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 18px;
  }
  .ltsuan-client-img-wrap {
    position: relative;
    overflow: hidden;
    height: 160px;
  }
  .ltsuan-client-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.85) saturate(1.1);
  }
  .ltsuan-client-list {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.9;
    color: rgba(244, 239, 232, 0.6);
    margin: 0 0 14px;
  }
  .ltsuan-see-work-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    color: var(--ltsuan-accent);
    text-decoration: none;
  }
  .ltsuan-license-note {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ltsuan-dim);
    margin: 14px 0 0;
  }
  #services {
    padding: 64px 60px 70px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-services-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 36px;
  }
  .ltsuan-section-h2 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 42px);
    margin: 0;
  }
  .ltsuan-section-counter {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--ltsuan-dim);
  }
  .ltsuan-services-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 900px) {
    .ltsuan-services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .ltsuan-services-grid {
      grid-template-columns: 1fr;
    }
  }
  .ltsuan-svc-card {
    position: relative;
    background: var(--ltsuan-panel);
    padding: 24px;
  }
  .ltsuan-svc-card-accent {
    background: linear-gradient(165deg, rgba(142, 195, 31, 0.16), var(--ltsuan-panel) 70%);
    box-shadow: inset 0 0 0 1px rgba(142, 195, 31, 0.35);
  }
  .ltsuan-svc-img-wrap {
    position: relative;
    height: 120px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .ltsuan-svc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.35s ease;
    filter: brightness(0.8) saturate(1.1);
    transform: scale(1.15);
  }
  .ltsuan-svc-card:hover .ltsuan-svc-img {
    filter: brightness(1) saturate(1.15);
  }
  .ltsuan-svc-title {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.3;
    min-height: calc(1.3em * 2);
    margin: 0 0 8px;
  }
  .ltsuan-svc-desc {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.55);
    margin: 0;
    text-align: left;
  }
  .ltsuan-svc-evidence {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ltsuan-accent);
    text-decoration: none;
  }
  #faq {
    padding: 64px 60px 80px 79px;
    max-width: 900px;
  }
  .ltsuan-faq-title {
    margin-bottom: 36px;
  }
  .ltsuan-faq-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .ltsuan-faq-q {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 18px;
    margin: 0 0 8px;
    color: #f4efe8;
  }
  .ltsuan-faq-a {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.75);
    margin: 0;
  }
  @media (max-width: 640px) {
    #faq {
      padding-left: 24px !important;
      padding-right: 24px !important;
    }
  }
</style>
