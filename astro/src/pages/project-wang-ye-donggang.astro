---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Le Tsuan Design | The Hunt of the Celestial Court";
const description = "The Hunt of the Celestial Court. Exhibition Design for National Museum of Natural Science in Taichung, Taiwan, 2012 — Le Tsuan Design.";
const canonical = "https://letsuan.com/project-wang-ye-donggang";
const alternateHrefs = [
  { hreflang: "en", href: canonical },
  { hreflang: "zh-TW", href: "https://letsuan.com/zh-TW/project-wang-ye-donggang" },
  { hreflang: "x-default", href: canonical },
];

const ogImage = "https://letsuan.com/images/wang-ye-worship-donggang-01-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "The Hunt of the Celestial Court — Wang Ye Worship in Donggang", "url": "https://letsuan.com/project-wang-ye-donggang", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/wang-ye-worship-donggang-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2012", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "The Hunt of the Celestial Court — Wang Ye Worship in Donggang", "item": "https://letsuan.com/project-wang-ye-donggang"}]}];
const eyebrowLeft = "EXHIBITION — 2012";
const eyebrowRight = "NATIONAL MUSEUM OF NATURAL SCIENCE";
const h1Main = "The Hunt of the Celestial Court";
const h1Sub = "Wang Ye Worship in Donggang";
const metaFields = [{"label": "CLIENT", "value": "National Museum of Natural Science"}, {"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2012"}, {"label": "CATEGORY", "value": "Exhibition Design, Construction"}];
const bodyHtml = "<h2>Seven Days, One Deity's Court</h2>\n<p>Wang Ye worship traces back a thousand years to the Song Dynasty, centred on the ritual of daitian xunshou, patrolling on heaven's behalf to drive out plague and disease. The place where the deity is enshrined is called the daitianfu, or Celestial Court, and the patrol itself is a periodic ceremonial rite.</p>\n<p>Donggang, a port town in Pingtung, is known for its centuries-old Wang Ye Boat Burning Festival, held once every three years; Donglong Temple, founded in 1706, saw the festival inscribed as a National Important Intangible Cultural Heritage in 2010.</p>\n<p>The centrepiece of this exhibition was a small ceremonial boat built by Donglong Temple in 1994, together with a reconstructed Celestial Court, both supplied for display by Donglong Temple in Donggang, Pingtung. We had seven days from mobilization to final acceptance.</p>\n<h2>Fire Code First, Then the Temple</h2>\n<p>We handled the timber <a href=\"./what-we-do#service-construction\">construction</a> for the Celestial Court's main structure, light partitions, and ceiling detailing, along with fabricating and installing the display platforms and base structures for the ceremonial boat and other artifacts. The board material used was CNS Class-1 fire-retardant plywood, meeting the <a href=\"./portfolio\">museum</a>'s fire code; this wasn't ordinary exhibition carpentry, it was built to a specification that had to clear a national museum's review.</p>\n<p>The boat's display platform has steel reinforcement built in for load capacity and horizontal stability. The lighting uses LED track fixtures with a colour rendering index above 90, with each fixture's beam angle adjusted individually to suit the artifact it lit. The power supply runs on independent circuits, meeting the required safety load factor and residual-current protection.</p>\n<h2>Three Phases in Seven Days</h2>\n<p>Work on site followed the approved construction drawings and setting-out, using zone-based construction to reduce dust impact, with a daily construction log and photo record, incoming material inspected piece by piece. The schedule was coordinated with both the museum and Donglong Temple through three controlled phases: mobilization, installation, and acceptance, all conducted under full site-safety compliance, with fire extinguishing equipment on hand and the museum's night-construction rules fully observed. On March 16, 2012, the Celestial Court opened exactly on schedule.</p>";
const relatedProjects = [{"href": "./project-story-telling", "label": "Story Telling by the Ancient People"}, {"href": "./project-nmns-teldap", "label": "NMNS TELDAP"}, {"href": "./project-dragon-to-beast", "label": "From Dragon to Beast"}];
const nextHref = "./project-just-only-environment";
const images = [{"src": "./images/wang-ye-worship-donggang-01-letsuan-design.jpg", "alt": "The Hunt of the Celestial Court — Wang Ye Worship in Donggang exhibition"}, {"src": "./images/wang-ye-worship-donggang-02-letsuan-design.png", "alt": "Wang Ye Worship exhibition layout"}, {"src": "./images/wang-ye-worship-donggang-03-letsuan-design.jpg", "alt": "Wang Ye Worship exhibition carvings"}, {"src": "./images/wang-ye-worship-donggang-04-letsuan-design.jpg", "alt": "Wang Ye Worship exhibition boat"}, {"src": "./images/wang-ye-worship-donggang-05-letsuan-design.jpg", "alt": "Wang Ye Worship exhibition deity altar"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  alternateHrefs={alternateHrefs}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
