const ogImage = "https://letsuan.com/images/yokai-world-exhibition-hero-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "ExhibitionEvent", "name": "Experience the Yokai World — 100 Stories of Yokai", "description": "A centennial exhibition licensed from Japan's Mizuki Production, engineered as a zero-penetration heritage-site build with multi-zone automated triggers and full dark-exhibit AV/lighting integration, approved on first inspection by the licensor's on-site supervisory team.", "url": "https://letsuan.com/project-yokai-world", "creator": {"@id": "https://letsuan.com/#organization"}, "image": [{"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-hero-letsuan-design.jpg", "caption": "Letsuan Design | Experience the Yokai World — Yokai exhibition entrance"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-03-letsuan-design.jpg", "caption": "Yokai exhibition zone"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-05-letsuan-design.jpg", "caption": "Yokai exhibition habitat"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-13-letsuan-design.jpg", "caption": "Corridor lined with framed illustrated yokai story panels mounted on warm wood-trimmed walls"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-003-letsuan-design.jpg", "caption": "Yokai exhibition welcome installation"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-07-letsuan-design.jpg", "caption": "Letsuan Design | Experience the Yokai World — Yokai exhibition interactive corner"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-005-letsuan-design.jpg", "caption": "Yokai exhibition maze zone"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-11-letsuan-design.jpg", "caption": "Yokai gathering photo wall"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-12-letsuan-design.jpg", "caption": "Yellow character-introduction wall panel featuring GeGeGe no Kitaro yokai characters and a 100th anniversary plaque"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-91-letsuan-design.jpg", "caption": "Yokai illustrated mural wall"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/yokai-world-exhibition-04-letsuan-design-f779cada.jpg", "caption": "Letsuan Design | Experience the Yokai World — Yokai exhibition construction"}], "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022-04-01", "dateModified": "2026-08-06", "hasPart": [{"@type": "CreativeWork", "name": "958.68 Square Metres, Zero Nails, One Chance to Pass Inspection"}, {"@type": "CreativeWork", "name": "The Weight Had to Carry Itself"}, {"@type": "CreativeWork", "name": "Sensors Nobody Sees, a Jolt Everybody Feels"}, {"@type": "CreativeWork", "name": "Darkness Was Solved Before Anything Else Could Be"}, {"@type": "CreativeWork", "name": "Building Through a Pandemic"}, {"@type": "CreativeWork", "name": "Passed the First Time"}, {"@type": "CreativeWork", "name": "What Was Left Standing"}], "isPartOf": {"@id": "https://letsuan.com/#website"}, "location": {"@type": "Place", "name": "Taipei, Taiwan"}, "startDate": "2022", "endDate": "2023"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Experience the Yokai World — 100 Stories of Yokai", "item": "https://letsuan.com/project-yokai-world"}]}];
