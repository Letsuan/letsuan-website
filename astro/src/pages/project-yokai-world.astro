const jsonLd = [{"@context": "https://schema.org", "@type": "CreativeWork", "name": "Experience the Yokai World — 100 Stories of Yokai", "description": "A centennial exhibition licensed from Japan's Mizuki Production, engineered as a zero-penetration heritage-site build with multi-zone automated triggers and full dark-exhibit AV/lighting integration, approved on first inspection by the licensor's on-site supervisory team.", "url": "https://letsuan.com/project-yokai-world", "creator": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "image": "https://letsuan.com/images/yokai-world-exhibition-hero-letsuan-design.jpg", "author": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "datePublished": "2022-04-01", "dateModified": "2026-08-06"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Experience the Yokai World — 100 Stories of Yokai", "item": "https://letsuan.com/project-yokai-world"}]}];
