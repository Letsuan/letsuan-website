];

const ogImage = "https://letsuan.com/images/tccge-observation-deck-zhangbin-01-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Green Energy Education Observation Platform — Changhua Coastal Industrial Park", "description": "A rooftop viewing platform with wind and solar interactive exhibits.", "url": "https://letsuan.com/project-tccge-deck", "creator": {"@id": "https://letsuan.com/#organization"}, "image": [{"@type": "ImageObject", "url": "https://letsuan.com/images/tccge-observation-deck-zhangbin-01-letsuan-design.jpg", "caption": "Letsuan Design | Green Energy Education Observation Platform — TCCGE Observation Deck platform"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/tccge-observation-deck-zhangbin-03-letsuan-design.jpg", "caption": "TCCGE Observation Deck wind education"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/tccge-observation-deck-zhangbin-02-letsuan-design.jpg", "caption": "TCCGE Observation Deck interactive teaching aid"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/tccge-observation-deck-zhangbin-04-letsuan-design.jpg", "caption": "Letsuan Design | Green Energy Education Observation Platform — TCCGE Observation Deck solar display"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/tccge-observation-deck-zhangbin-05-letsuan-design.jpg", "caption": "TCCGE Observation Deck combined exhibit"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/tccge-observation-deck-zhangbin-06-letsuan-design.jpg", "caption": "TCCGE Observation Deck sunset closing view"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/tccge-observation-deck-zhangbin-07-letsuan-design.jpg", "caption": "Letsuan Design | Green Energy Education Observation Platform — TCCGE Observation Deck rooftop garden with wind turbine display"}], "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022", "dateModified": "2026-09-03", "hasPart": [{"@type": "CreativeWork", "name": "Salt, Chemical Gas, and UV, All Acting on the Same Materials"}, {"@type": "CreativeWork", "name": "Waterproofing Comes Before Planting, Not After"}, {"@type": "CreativeWork", "name": "Plants That Can Survive More Than One Season"}, {"@type": "CreativeWork", "name": "304 Stainless Steel Is Only Half the Answer"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Green Energy Education Observation Platform — Changhua Coastal Industrial Park", "item": "https://letsuan.com/project-tccge-deck"}]}];
