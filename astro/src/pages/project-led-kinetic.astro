const jsonLd = [{"@context": "https://schema.org", "@type": "CreativeWork", "name": "Universe — 500 Pieces LED Kinetic Light", "description": "A high-end dynamic installation of 500 kinetic lighting units, conveying astronomical knowledge through light and music.", "url": "https://letsuan.com/project-led-kinetic", "creator": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "image": "https://letsuan.com/images/universe-led-kinetic-light-01-letsuan-design.jpg", "author": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "datePublished": "2024"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Universe — 500 Pieces LED Kinetic Light", "item": "https://letsuan.com/project-led-kinetic"}]}];
const eyebrowLeft = "EXHIBITION — 2024";
const eyebrowRight = "GRANDVIEW MALL";
const h1Main = "Universe";
const h1Sub = "500 Pieces of LED Kinetic Light";
const metaFields = [{"label": "CLIENT", "value": "Grandview Mall Science Museum"}, {"label": "LOCATION", "value": "Canton, China"}, {"label": "YEAR", "value": "2024"}, {"label": "CATEGORY", "value": "Exhibition Design, Installation Art, Interactive Multimedia, Construction"}];
const bodyHtml = "<p>500 kinetic LED fixtures, one winch system per fixture, and a single piece of control software tying it all together, that's the mechanical core of \"Cosmos,\" the dynamic lighting installation we designed for the Science Museum at Guangzhou's Grandview Mall. It works double duty as functional illumination and as the space's visual focal point, and it's paired with music and narration to guide visitors toward an intuitive understanding of astronomical knowledge. We handled the design planning for the lighting installation on this project.</p>\n<h2>Concept</h2>\n<p>The installation takes the vastness of the cosmos as its central image. The 500-fixture array translates astronomical phenomena into a visualized language of light and shadow, and inside a setting woven from sound and light, visitors pick up on the movement of celestial bodies and the abstract scale of the universe without needing it explained to them.</p>\n<h2>Technical Planning</h2>\n<p>Each fixture's vertical position is controlled by its own winch, while LED RGB modules handle color and brightness, both folded into the same specialized control software. During design, we worked out the synchronization logic between the winches' motion paths and the lighting's color transitions, so the array could build varied, layered forms and light effects under precise choreography rather than just moving up and down, which is what gives the piece its combination of fine detail and dynamic tension.</p>";
const relatedProjects = [{"href": "./project-notre-dame", "label": "Eternal Notre-Dame"}, {"href": "./project-green-energy", "label": "The Future Is Worth It"}, {"href": "./project-beyond-just-an-exhibition", "label": "Beyond Just an Exhibition"}];
