const ogImage = "https://letsuan.com/images/mobile-museum-exhibition-01-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Mobile Museum — A Cool Adventure of Reality and Imagination", "description": "National Museum of History exhibition.", "url": "https://letsuan.com/project-mobile-museum", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/mobile-museum-exhibition-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2019", "hasPart": [{"@type": "CreativeWork", "name": "12.03 Meters, Eight Worlds"}, {"@type": "CreativeWork", "name": "The Vehicle Came First"}, {"@type": "CreativeWork", "name": "Designing Around a Door That Still Has to Close"}, {"@type": "CreativeWork", "name": "Eight Units, Eight Solutions"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Mobile Museum — A Cool Adventure of Reality and Imagination", "item": "https://letsuan.com/project-mobile-museum"}]}];
