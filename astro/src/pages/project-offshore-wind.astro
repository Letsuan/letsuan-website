---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Le Tsuan Design | Offshore Wind O&M Building";
const description = "Offshore Wind O&M Building: Learning Center Decorating Modifications. Curatorial Project for Ørsted in Taichung, Taiwan, 2022–Present — Le Tsuan Design.";
const canonical = "https://letsuan.com/project-offshore-wind";
const ogImage = "https://letsuan.com/images/offshore-wind-om-learning-center-01-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Offshore Wind O&M Learning Center", "description": "Decorating modifications that convert underused space into a multi-purpose corporate facility.", "url": "https://letsuan.com/project-offshore-wind", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/offshore-wind-om-learning-center-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Offshore Wind O&M Learning Center", "item": "https://letsuan.com/project-offshore-wind"}]}];
const eyebrowLeft = "INTERIOR";
const eyebrowRight = "2022–Present –Ørsted Taiwan Offshore Wind Farms O&M Hub";
const h1Main = "Offshore Wind O&M Building";
const h1Sub = "Learning Center Decorating Modifications";
const metaFields = [{"label": "CLIENT", "value": "Ørsted"}, {"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2022–Present"}, {"label": "AREA", "value": "231.4㎡"}, {"label": "CATEGORY", "value": "Curatorial Project, Exhibition Design, Interior Design, Graphic Design, Visual Design, Construction"}];
const bodyHtml = "<h2>Turning Idle Corridors Into a Learning Center</h2>\n<p>By reclaiming corridors and underutilized areas within the existing building, we redefined circulation and function, transforming a low-utilization space that had previously served only as a staff dining area into a multi-purpose learning center that integrates training, brand storytelling, and visitor reception. The renovation used sustainable materials throughout, in keeping with the building's LEED certification.</p>\n<h2>Existing Conditions</h2>\n<p>The original space saw concentrated, single-purpose use limited to specific hours. Elsewhere in the building, corridors and scattered leftover areas remained poorly utilized, lacking circulation planning and serving neither corporate image nor training functions.</p>\n<h2>Design Strategy</h2>\n<p>Working within the existing structure, we consolidated the previously dispersed learning center resources into the main space through selective partitioning and functional reorganization. Corridors and residual areas were folded into the plan as well, transformed into a continuous brand-storytelling circulation path, with a branded photo wall installed at a key node so the space itself becomes a complete brand communication interface. Sustainable materials were used throughout the renovation, aligning the interior fit-out with the building's LEED certification and keeping the interior consistent with the building's broader sustainability positioning.</p>\n<h2>Exhibition Narrative</h2>\n<p>Along the circulation path, the narrative unfolds Ørsted's corporate history, its investment footprint in Taiwan's wind farms, Taiwan's world-class wind resource advantages, Ørsted's global presence, its environmental sustainability commitments, and the current status of wind power deployment, before arriving at a branded photo wall where visitors can capture a keepsake image bearing the company's identity.</p>\n<h2>Functional Program</h2>\n<p>The space accommodates corporate image display, policy communication, employee training, presentations, remote conferencing, client reception, and group visits, flexibly supporting both small internal courses and external guided tours.</p>\n<h2>Fourteen Days, With the Cafeteria Still Open</h2>\n<p>The construction window was fourteen days, and work had to proceed without disrupting staff lunch service in the dining area below or the office floors above, so noise, dust and site access all had to work around a building that stayed occupied throughout. Site safety followed Ørsted's own European-standard EHS requirements, stricter than what a domestic fit-out of this scale would typically call for.</p>\n<h2>Outcomes</h2>\n<p>The formerly idle space and corridors were reconfigured into a high-frequency, narratively rich multi-purpose venue. Overall spatial efficiency improved, along with both internal training capacity and external reception capability. The sustainable materials echo the building's LEED certification and carry Ørsted's core commitment to environmental sustainability through from function to material selection. The venue has since received visits from Taiwan's president and premier, along with executives from major banks, officials from energy authorities, and international delegations on professional exchange.</p>";
const relatedProjects = [{"href": "./project-missing-scientist", "label": "The Missing Scientist"}, {"href": "./project-orsted-energy", "label": "Energy Taiwan 2022 — Ørsted"}, {"href": "./project-world-semiconductors", "label": "The World of Semiconductors"}];
const nextHref = "./project-green-energy";
const images = [{"src": "./images/offshore-wind-om-learning-center-01-letsuan-design.jpg", "alt": "Offshore Wind O&M Building — Meeting room with an Orsted 'Love your home' Earth mural on the wall behind a conference table"}, {"src": "./images/offshore-wind-07-letsuan-design.jpg", "alt": "Corridor at the offshore wind exhibition with two visitors walking past a wall displaying Taiwan offshore wind farm capacity data in gigawatts"}, {"src": "./images/offshore-wind-om-learning-center-02-letsuan-design.jpg", "alt": "Curved illustrated wall panels explaining offshore wind farm operations, from coastal installation process to turbine maintenance timeline"}, {"src": "./images/offshore-wind-visitor-viewing-turbine-technology-timeline-wall-letsuan-design.jpg", "alt": "Visitor viewing offshore wind turbine technology timeline wall with video screen showing installation footage"}, {"src": "./images/offshore-wind-om-learning-center-03-letsuan-design.jpg", "alt": "Curved exhibition corridor with a coastal wind farm installation diagram and video screens"}, {"src": "./images/offshore-wind-om-learning-center-07-letsuan-design.jpg", "alt": "Visitor viewing a curved exhibition wall about marine ecology near offshore turbine foundations"}, {"src": "./images/offshore-wind-om-learning-center-06-letsuan-design.jpg", "alt": "Entrance corridor with an Orsted Earth mural, a dotted wave-pattern doorway, and a wind farm photo mural"}, {"src": "./images/offshore-wind-om-learning-center-04-letsuan-design.jpg", "alt": "Visitor flipping an interactive flip-tag panel explaining how wind turbines generate electricity"}, {"src": "./images/offshore-wind-om-learning-center-08-letsuan-design.jpg", "alt": "Staircase beside a wall reading 'Let's create a world that runs entirely on green energy'"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
