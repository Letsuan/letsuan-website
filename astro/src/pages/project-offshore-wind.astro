const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Offshore Wind O&M Learning Center", "description": "Decorating modifications that convert underused space into a multi-purpose corporate facility.", "url": "https://letsuan.com/project-offshore-wind", "creator": {"@id": "https://letsuan.com/#organization"}, "image": [{"@type": "ImageObject", "url": "https://letsuan.com/images/offshore-wind-om-learning-center-01-letsuan-design.jpg", "caption": "Letsuan Design | Offshore Wind O&M Building — Meeting room with an Orsted 'Love your home' Earth mural on the wall behind a conference table"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/offshore-wind-07-letsuan-design.jpg", "caption": "Corridor at the offshore wind exhibition with two visitors walking past a wall displaying Taiwan offshore wind farm capacity data in gigawatts"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/offshore-wind-om-learning-center-02-letsuan-design.jpg", "caption": "Curved illustrated wall panels explaining offshore wind farm operations, from coastal installation process to turbine maintenance timeline"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/offshore-wind-visitor-viewing-turbine-technology-timeline-wall-letsuan-design.jpg", "caption": "Visitor viewing offshore wind turbine technology timeline wall with video screen showing installation footage"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/offshore-wind-om-learning-center-03-letsuan-design.jpg", "caption": "Letsuan Design | Offshore Wind O&M Building — Curved exhibition corridor with a coastal wind farm installation diagram and video screens"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/offshore-wind-om-learning-center-07-letsuan-design.jpg", "caption": "Visitor viewing a curved exhibition wall about marine ecology near offshore turbine foundations"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/offshore-wind-om-learning-center-06-letsuan-design.jpg", "caption": "Entrance corridor with an Orsted Earth mural, a dotted wave-pattern doorway, and a wind farm photo mural"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/offshore-wind-om-learning-center-04-letsuan-design.jpg", "caption": "Visitor flipping an interactive flip-tag panel explaining how wind turbines generate electricity"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/offshore-wind-om-learning-center-08-letsuan-design.jpg", "caption": "Letsuan Design | Offshore Wind O&M Building — Staircase beside a wall reading 'Let's create a world that runs entirely on green energy'"}], "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022", "dateModified": "2026-09-14", "hasPart": [{"@type": "CreativeWork", "name": "Turning Idle Corridors Into a Learning Center"}, {"@type": "CreativeWork", "name": "Fourteen Days, With the Cafeteria Still Open"}, {"@type": "CreativeWork", "name": "Outcomes"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Offshore Wind O&M Learning Center", "item": "https://letsuan.com/project-offshore-wind"}]}];
const eyebrowLeft = "INTERIOR";
const eyebrowRight = "2022–Present –Ørsted Taiwan Offshore Wind Farms O&M Hub";
const h1Main = "Offshore Wind O&M Building";
const h1Sub = "Learning Center Decorating Modifications";
const metaFields = [{"label": "CLIENT", "value": "Ørsted"}, {"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2022–Present"}, {"label": "AREA", "value": "231.4㎡"}];
const bodyHtml = "<h2>Scope</h2>\n<h3>Turning Idle Corridors Into a Learning Center</h3>\n<p>By reclaiming corridors and underutilized areas within the existing building, we redefined circulation and function, transforming a low-utilization space that had previously served only as a staff dining area into a multi-purpose learning center that integrates training, brand storytelling, and visitor reception.</p>\n<h2>Construction</h2>\n<h3>Fourteen Days, With the Cafeteria Still Open</h3>\n<p>The space accommodates corporate image display, policy communication, employee training, presentations, remote conferencing, client reception, and group visits, flexibly supporting both small internal courses and external guided tours. <a href=\"./what-we-do#service-construction\">Construction</a> took just fourteen days and had to proceed without disrupting staff lunch service in the dining area below or the office floors above, so noise, dust, and site access all had to work around a building that stayed occupied throughout. Site safety followed Ørsted's own European-standard EHS requirements, stricter than what a domestic fit-out of this scale would typically call for.</p>\n<h2>Result</h2>\n<p>Sustainable materials were used throughout, in keeping with the building's LEED certification, carrying that commitment from function through to material selection. The formerly idle corridor became a high-frequency, narratively rich multi-purpose venue, with both internal training capacity and external reception capability improved. The venue has since received visits from Taiwan's president and premier, along with executives from major banks, officials from energy authorities, and international delegations on professional exchange.</p>\n<div style=\"display:flex;gap:16px;align-items:center;margin-top:24px;\"><img src=\"/images/green-building-material-label-letsuan-design.png\" alt=\"Green Building Material Label\" style=\"width:2.5cm;height:auto;\" /><img src=\"/images/thbml-taiwan-healthy-building-material-label-letsuan-design.png\" alt=\"Taiwan Healthy Building Material Label (THBML)\" style=\"width:2.5cm;height:auto;\" /></div>\n<h2 class=\"ltsuan-case-appendix\">Facts</h2>\n<ul><li>Area: 231.4㎡</li><li>Materials: sustainable throughout, in keeping with the building’s LEED certification</li></ul>\n<h2 class=\"ltsuan-case-appendix\">Related Services</h2>\n<ul><li><a href=\"./what-we-do#service-curatorial\">Curatorial Services</a></li><li><a href=\"./what-we-do#service-exhibition\">Exhibition Design</a></li><li><a href=\"./what-we-do#service-interior\">Interior Design</a></li><li><a href=\"./what-we-do#service-visual\">Visual Design</a></li><li><a href=\"./what-we-do#service-construction\">Construction</a></li></ul>";
const relatedProjects = [{"href": "./project-missing-scientist", "label": "The Missing Scientist"}, {"href": "./project-orsted-energy", "label": "Energy Taiwan 2022 — Ørsted"}, {"href": "./project-world-semiconductors", "label": "The World of Semiconductors"}];
const nextHref = "./project-green-energy";
const images = [{"src": "./images/offshore-wind-om-learning-center-01-letsuan-design.jpg", "alt": "Letsuan Design | Offshore Wind O&M Building — Meeting room with an Orsted 'Love your home' Earth mural on the wall behind a conference table", "width": 800, "height": 425}, {"src": "./images/offshore-wind-07-letsuan-design.jpg", "alt": "Corridor at the offshore wind exhibition with two visitors walking past a wall displaying Taiwan offshore wind farm capacity data in gigawatts", "width": 2112, "height": 1104}, {"src": "./images/offshore-wind-om-learning-center-02-letsuan-design.jpg", "alt": "Curved illustrated wall panels explaining offshore wind farm operations, from coastal installation process to turbine maintenance timeline", "width": 800, "height": 425}, {"src": "./images/offshore-wind-visitor-viewing-turbine-technology-timeline-wall-letsuan-design.jpg", "alt": "Visitor viewing offshore wind turbine technology timeline wall with video screen showing installation footage", "width": 3840, "height": 2896}, {"src": "./images/offshore-wind-om-learning-center-03-letsuan-design.jpg", "alt": "Letsuan Design | Offshore Wind O&M Building — Curved exhibition corridor with a coastal wind farm installation diagram and video screens", "width": 800, "height": 425}, {"src": "./images/offshore-wind-om-learning-center-07-letsuan-design.jpg", "alt": "Visitor viewing a curved exhibition wall about marine ecology near offshore turbine foundations", "width": 800, "height": 425}, {"src": "./images/offshore-wind-om-learning-center-06-letsuan-design.jpg", "alt": "Entrance corridor with an Orsted Earth mural, a dotted wave-pattern doorway, and a wind farm photo mural", "width": 800, "height": 425}, {"src": "./images/offshore-wind-om-learning-center-04-letsuan-design.jpg", "alt": "Visitor flipping an interactive flip-tag panel explaining how wind turbines generate electricity", "width": 800, "height": 425}, {"src": "./images/offshore-wind-om-learning-center-08-letsuan-design.jpg", "alt": "Letsuan Design | Offshore Wind O&M Building — Staircase beside a wall reading 'Let's create a world that runs entirely on green energy'", "width": 800, "height": 425}];
