---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Letsuan Design | The Westernmost Point of Taiwan";
const description = "The Westernmost Point of Taiwan: 23°06'02.7\"N 120°02'09.0\"E. Installation art for the Tourism Bureau of Tainan City Government, Taiwan.";
const canonical = "https://letsuan.com/project-westernmost-point";
const alternateHrefs = [
  { hreflang: "en", href: canonical },
  { hreflang: "zh-TW", href: "https://letsuan.com/zh-TW/project-westernmost-point" },
  { hreflang: "x-default", href: canonical },
];

const ogImage = "https://letsuan.com/images/westernmost-point-taiwan-01-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "The Westernmost Point of Taiwan", "description": "A paper-cutting montage tunnel engineered with an All-304 stainless steel system and zero-breach fluorocarbon coating to withstand a saline sandbar site.", "url": "https://letsuan.com/project-westernmost-point", "creator": {"@id": "https://letsuan.com/#organization"}, "image": [{"@type": "ImageObject", "url": "https://letsuan.com/images/westernmost-point-friends-polaroid-photo-letsuan-design.jpg", "caption": "Polaroid-style photo of three friends posing at The Westernmost Point of Taiwan sculpture, dated 2022/6/9"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/westernmost-point-taiwan-04-letsuan-design.jpg", "caption": "Westernmost Point of Taiwan silhouette"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/westernmost-point-taiwan-07-letsuan-design.jpg", "caption": "Westernmost Point of Taiwan paper-cutting installation in progress"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/westernmost-point-taiwan-02-letsuan-design.jpg", "caption": "Westernmost Point of Taiwan tunnel"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/westernmost-point-taiwan-03-letsuan-design.jpg", "caption": "Westernmost Point of Taiwan pattern"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/westernmost-point-taiwan-05-letsuan-design.jpg", "caption": "Westernmost Point of Taiwan night view"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/westernmost-point-taiwan-06-letsuan-design.jpg", "caption": "Westernmost Point of Taiwan structure"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/westernmost-point-taiwan-08-letsuan-design.jpg", "caption": "Westernmost Point of Taiwan structural framework detail"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/westernmost-point-taiwan-09-letsuan-design.jpg", "caption": "Westernmost Point of Taiwan final view"}], "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022-01-01", "dateModified": "2026-08-06", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "The Westernmost Point of Taiwan", "item": "https://letsuan.com/project-westernmost-point"}]}];
const eyebrowLeft = "INSTALLATION — 2022";
const eyebrowRight = "Dintouer Sandbank";
const h1Main = "The Westernmost Point of Taiwan";
const h1Sub = "23°06'02.7\"N 120°02'09.0\"E";
const metaFields = [{"label": "CLIENT", "value": "Tourism Bureau of Tainan City Government"}, {"label": "LOCATION", "value": "Tainan, Taiwan"}, {"label": "YEAR", "value": "2022"}, {"label": "CATEGORY", "value": "Installation Art, Construction"}];
const bodyHtml = "<p>At the edge of the nation's territory, we raise a space that breathes.</p>\n<p>The site sits at the threshold between sandbar and surf, with no solid ground beneath it, fully exposed to sea wind, salt spray, and intense UV. Our task was to create a landmark on this unstable terrain that could resist time.</p>\n<p>The design composes a walkable montage tunnel from a sequence of mask panels, light as paper yet architectural in scale, each face carved with a distinct character. Their perforated boundaries choreograph a delicate interplay between privacy and gaze. We designed the act of viewing as circulation itself: the angle and height of each panel are calibrated to the solar path and prevailing wind direction. In the morning, oblique light slices through and guides a slow procession forward; in the afternoon, overlapping shadows compel visitors to pause; at dusk, the entire tunnel is pierced by the afterglow, human silhouettes and paper-cut shadows merging into one, and the circulation becomes a passage from light into darkness, and back out into the sea and sky.</p>\n<p>The entire system uses 304 stainless steel, from the primary structure and mask panels to every bolt, stud, and screw, eliminating galvanic corrosion caused by dissimilar metal contact. Every component is finished with a fluorocarbon coating (PVDF) for weather resistance, UV resistance, and long-term colour retention. Components are factory-finished with the coating before being transported to site; any micro-abrasions incurred during fastening are touched up on-site with colour-matched fluorocarbon paint, keeping the coating film continuous and defect-free so every joint can withstand salt-laden corrosion for years to come.</p>\n<p>The result translates the intricate lexicon of traditional paper-cutting into a spatial experience built to hold up, structurally and visually, under high-specification metal craftsmanship.</p>";
const relatedProjects = [{"href": "./project-led-kinetic", "label": "Universe — LED Kinetic Light"}, {"href": "./project-notre-dame", "label": "Eternal Notre-Dame"}, {"href": "./project-marine-illusion", "label": "Seeing Is Believing"}];
const nextHref = "./project-securities-office";
const images = [{"src": "./images/westernmost-point-friends-polaroid-photo-letsuan-design.jpg", "alt": "Polaroid-style photo of three friends posing at The Westernmost Point of Taiwan sculpture, dated 2022/6/9", "plain": true}, {"src": "./images/westernmost-point-taiwan-04-letsuan-design.jpg", "alt": "Westernmost Point of Taiwan silhouette"}, {"src": "./images/westernmost-point-taiwan-07-letsuan-design.jpg", "alt": "Westernmost Point of Taiwan paper-cutting installation in progress"}, {"src": "./images/westernmost-point-taiwan-02-letsuan-design.jpg", "alt": "Westernmost Point of Taiwan tunnel"}, {"src": "./images/westernmost-point-taiwan-03-letsuan-design.jpg", "alt": "Westernmost Point of Taiwan pattern"}, {"src": "./images/westernmost-point-taiwan-05-letsuan-design.jpg", "alt": "Westernmost Point of Taiwan night view"}, {"src": "./images/westernmost-point-taiwan-06-letsuan-design.jpg", "alt": "Westernmost Point of Taiwan structure"}, {"src": "./images/westernmost-point-taiwan-08-letsuan-design.jpg", "alt": "Westernmost Point of Taiwan structural framework detail"}, {"src": "./images/westernmost-point-taiwan-09-letsuan-design.jpg", "alt": "Westernmost Point of Taiwan final view"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  alternateHrefs={alternateHrefs}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
