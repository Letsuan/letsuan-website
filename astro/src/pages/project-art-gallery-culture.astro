const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Art Gallery (Ministry of Culture)", "description": "Art Gallery exhibition for the Ministry of Culture. When a package arrives in your hands, it begins as a sealed box — its contents invisible from the outside.", "url": "https://letsuan.com/project-art-gallery-culture", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/art-gallery-culture-ministry-of-culture-exhibition-ceiling-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2019", "hasPart": [{"@type": "CreativeWork", "name": "I. Curatorial Concept"}, {"@type": "CreativeWork", "name": "II. Core Design Concept: The Unfolding Diagram as Narrative Structure"}, {"@type": "CreativeWork", "name": "III. Spatial Circulation Design: From Sealed Box to Unfolded Diagram"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Art Gallery (Ministry of Culture)", "item": "https://letsuan.com/project-art-gallery-culture"}]}];
