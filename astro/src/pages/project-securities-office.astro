---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Letsuan Design | Securities Company Office";
const description = "Securities Company Office: A Contemporary, High-End Workplace. Interior Design for Securities Company in New Taipei City, Taiwan — Letsuan Design.";
const canonical = "https://letsuan.com/project-securities-office";
const alternateHrefs = [
  { hreflang: "en", href: canonical },
  { hreflang: "zh-TW", href: "https://letsuan.com/zh-TW/project-securities-office" },
  { hreflang: "x-default", href: canonical },
];

const ogImage = "https://letsuan.com/images/securities-company-office-design-02-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Securities Company Office Design", "description": "A contemporary, high-end office fit-out in Banqiao, New Taipei City.", "url": "https://letsuan.com/project-securities-office", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/securities-company-office-design-02-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Securities Company Office Design", "item": "https://letsuan.com/project-securities-office"}]}];
const eyebrowLeft = "INTERIOR — 2022";
const eyebrowRight = "NEW TAIPEI CITY";
const h1Main = "Securities Company Office";
const h1Sub = "A Contemporary, High-End Workplace";
const metaFields = [{"label": "CLIENT", "value": "Securities Company"}, {"label": "LOCATION", "value": "New Taipei City, Taiwan"}, {"label": "SIZE", "value": "200 ㎡"}, {"label": "CATEGORY", "value": "Interior Design, Construction"}];
const bodyHtml = "<p>Located in the Banqiao District of New Taipei City, this new office was designed around a contemporary, high-end feel. Quality finishes carry that tone throughout, including a feature curved wall and custom-made handles at the entrance. The office now houses a dedicated waiting area, a kitchen and breakout area, a boardroom, executive offices, and an open-plan workstation area. <a href=\"./what-we-do#service-construction\">Construction</a> was handled by Le Tsuan's in-house team.</p>";
const relatedProjects = [{"href": "./project-world-semiconductors", "label": "The World of Semiconductors"}, {"href": "./project-detention-pier2", "label": "Detention — Reality Experience"}, {"href": "./project-orsted-energy", "label": "Energy Taiwan 2022 — Ørsted"}];
const nextHref = "./project-tccge-deck";
const images = [{"src": "./images/securities-company-office-design-02-letsuan-design.jpg", "alt": "Securities Company Office waiting area"}, {"src": "./images/securities-company-office-design-01-letsuan-design.jpg", "alt": "Securities Company Office entrance"}, {"src": "./images/securities-company-office-design-03-letsuan-design.jpg", "alt": "Securities Company Office boardroom"}, {"src": "./images/securities-company-office-design-04-letsuan-design.jpg", "alt": "Securities Company Office workstation"}, {"src": "./images/securities-company-office-design-05-letsuan-design.jpg", "alt": "Securities Company Office corridor"}, {"src": "./images/securities-company-office-design-06-letsuan-design.jpg", "alt": "Securities Company Office executive room"}, {"src": "./images/securities-company-office-design-07-letsuan-design.jpg", "alt": "Securities Company Office feature wall"}, {"src": "./images/securities-company-office-design-08-letsuan-design.jpg", "alt": "Securities Company Office reception view"}, {"src": "./images/securities-company-office-design-09-letsuan-design.jpg", "alt": "Securities Company Office renovation in progress"}, {"src": "./images/securities-company-office-design-10-letsuan-design.jpg", "alt": "Securities Company Office renovation detail, wall finishing"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  alternateHrefs={alternateHrefs}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
