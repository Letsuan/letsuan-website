const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Highlights of NMH Collection Exhibition", "url": "https://letsuan.com/project-nmh-highlights", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/nmh-collection-highlights-06-letsuan-design.png", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2015", "hasPart": [{"@type": "CreativeWork", "name": "Scope"}, {"@type": "CreativeWork", "name": "Background"}, {"@type": "CreativeWork", "name": "Challenge"}, {"@type": "CreativeWork", "name": "Design Strategy"}, {"@type": "CreativeWork", "name": "Deinstallation and Inventory"}, {"@type": "CreativeWork", "name": "Full Rebuild of the Display Cases"}, {"@type": "CreativeWork", "name": "Engineered Stone Casework"}, {"@type": "CreativeWork", "name": "Microclimate Control"}, {"@type": "CreativeWork", "name": "Graphics and Interpretation"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Highlights of NMH Collection Exhibition", "item": "https://letsuan.com/project-nmh-highlights"}]}];
