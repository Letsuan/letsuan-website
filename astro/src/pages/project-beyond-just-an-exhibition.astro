const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "ExhibitionEvent", "name": "Beyond Just an Exhibition—You Are Part of the Art", "description": "Step Into a Breathing Magical Universe of Light and Shadows.", "url": "https://letsuan.com/project-beyond-just-an-exhibition", "creator": {"@id": "https://letsuan.com/#organization"}, "image": [{"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-visitors-interacting-with-pulsating-valley-letsuan-design.jpg", "caption": "Letsuan Design | Beyond Just an Exhibition–You Are Part of the Art! — Visitors interacting with Pulsating Valley floor projection among sunflowers"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-sketch-flight-starry-sky-with-hand-drawn-letsuan-design.jpg", "caption": "Sketch Flight starry sky with hand-drawn birds and airplanes"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-visitors-photographing-immersive-floral-letsuan-design.jpg", "caption": "Visitors photographing immersive floral projection walls"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-bouncing-valley-inflatable-light-ball-letsuan-design.jpg", "caption": "Bouncing Valley inflatable light-ball installation"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-child-and-parent-interacting-letsuan-design.jpg", "caption": "Child and parent interacting with A Table Where Little People Live"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-immersive-floral-wall-projection-with-letsuan-design.jpg", "caption": "Letsuan Design | Beyond Just an Exhibition–You Are Part of the Art! — Immersive floral wall projection with visitors"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-rainbow-and-world-map-immersive-wall-letsuan-design.jpg", "caption": "Rainbow and world map immersive wall with visitor workstations"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-sunflower-field-immersive-room-with-visitors-letsuan-design.jpg", "caption": "Sunflower Field immersive room with visitors"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-grid-patterned-immersive-corridor-with-letsuan-design.jpg", "caption": "Grid-patterned immersive corridor with visitors"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/beyond-exhibition-ceiling-truss-with-projectors-and-blending-letsuan-design.jpg", "caption": "Letsuan Design | Beyond Just an Exhibition–You Are Part of the Art! — Ceiling truss with projectors and blending processors during construction"}], "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2024", "dateModified": "2026-08-06", "hasPart": [{"@type": "CreativeWork", "name": "It Wasn't the Wall Moving, It Was the Wind"}, {"@type": "CreativeWork", "name": "Hanging a Playground From a Floor You Can't Drill Into"}, {"@type": "CreativeWork", "name": "The Wall Never Moved"}, {"@type": "CreativeWork", "name": "What the Drawings Didn't Show"}, {"@type": "CreativeWork", "name": "Seven Days to Zero"}, {"@type": "CreativeWork", "name": "Fourteen Days In, Seven Days Out"}], "isPartOf": {"@id": "https://letsuan.com/#website"}, "location": {"@type": "Place", "name": "Taipei, Taiwan"}, "startDate": "2024"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Beyond Just an Exhibition—You Are Part of the Art", "item": "https://letsuan.com/project-beyond-just-an-exhibition"}]}];
