const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "ExhibitionEvent", "name": "Getting Close to the Sea, to Know the Sea", "description": "Getting Close to the Sea, to Know the Sea — Building a Marine Conservation Education Center Around Three Named White Dolphins. The Central Taiwan Marine Conservation Education Center at the National Museum of Natural Science.", "url": "https://letsuan.com/project-dolphin-education-center", "image": [{"@type": "ImageObject", "url": "https://letsuan.com/images/dolphin-education-center-entrance-tiered-window-display-letsuan-design.jpg", "caption": "Letsuan Design | Getting Close to the Sea, to Know the Sea — tiered display window at the education center entrance"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/dolphin-education-center-white-dolphin-models-longhu-pond-letsuan-design.jpg", "caption": "Three named white dolphin models suspended above the Longhu Pond"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/dolphin-education-center-interactive-drawing-station-letsuan-design.jpg", "caption": "Interactive drawing station where visitors sketch their own white dolphin"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/dolphin-education-center-wetland-diorama-display-letsuan-design.jpg", "caption": "Wetland ecology diorama with stranded dolphin and crab specimens"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/dolphin-education-center-dolphin-life-history-tabletop-letsuan-design.jpg", "caption": "Large tabletop display on the life history of the Indo-Pacific humpback dolphin"}], "creator": {"@id": "https://letsuan.com/#organization"}, "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2024", "dateModified": "2026-09-22", "hasPart": [{"@type": "CreativeWork", "name": "Why This Center, Why Now"}, {"@type": "CreativeWork", "name": "A Messenger From the Sea"}, {"@type": "CreativeWork", "name": "Exhibits and Interactive Devices"}, {"@type": "CreativeWork", "name": "Built to Teach"}, {"@type": "CreativeWork", "name": "An Identity Drawn From Refracted Light"}, {"@type": "CreativeWork", "name": "Turning a Restaurant Into a Museum"}, {"@type": "CreativeWork", "name": "An Accessibility Review That Touched the Whole Building"}, {"@type": "CreativeWork", "name": "Five Exhibit Zones"}], "isPartOf": {"@id": "https://letsuan.com/#website"}, "location": {"@type": "Place", "name": "Taichung, Taiwan"}, "startDate": "2024"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Getting Close to the Sea, to Know the Sea", "item": "https://letsuan.com/project-dolphin-education-center"}]}];
