---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import { organizationJsonLd } from '../data/organization';

const title = 'Le Tsuan Design | Exhibition, Interior & Spatial Construction Studio, Taiwan';
const description = 'Le Tsuan Design is a Taiwan-based studio crafting immersive interior, exhibition, visual and construction projects for museums, brands and public spaces.';
const canonical = 'https://letsuan.com/';
const ogImage = 'https://letsuan.com/assets/logo.png';
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={organizationJsonLd}>
  <div class="ltsuan-page">
    <Nav active="home" />

    <Hero />

    <section id="about">
      <div class="ltsuan-about-inner">
        <div class="ltsuan-about-eyebrow">OUR APPROACH</div>
        <p class="ltsuan-about-headline">The same team that designs the space<br />also builds it.</p>
        <p class="ltsuan-about-copy">One point of contact from first sketch to final install — nothing lost in translation between concept and construction.</p>
      </div>
    </section>

    <ServicesGrid />
    <PortfolioPreview />

    <Footer />
  </div>
</Layout>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
    overflow-x: hidden;
  }
  #about {
    padding: 160px 60px 160px 79px;
    display: flex;
    justify-content: flex-start;
  }
  .ltsuan-about-inner {
    max-width: 920px;
  }
  .ltsuan-about-eyebrow {
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--ltsuan-accent);
    margin-bottom: 24px;
  }
  .ltsuan-about-headline {
    text-align: left;
    font-family: 'Oswald', sans-serif;
    font-weight: 300;
    font-size: clamp(32px, 4.6vw, 58px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
    color: #f0e9de;
  }
  .ltsuan-about-copy {
    text-align: left;
    font-family: 'Oswald', sans-serif;
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.6;
    margin: 0;
    color: rgba(240, 233, 222, 0.55);
    max-width: 600px;
  }
</style>
