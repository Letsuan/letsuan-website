---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import { organizationJsonLd } from '../data/organization';
import { slides } from '../data/homepage';
import { responsiveSrcset } from '../utils/images';

const heroSlide0 = slides[0];
const preloadImage = {
  href: heroSlide0.realImg,
  imagesrcset: responsiveSrcset(heroSlide0.realImg, 'avif', heroSlide0.bgWidth),
  imagesizes: '(max-width: 900px) 180vw, 115vw',
  type: 'image/avif',
};

const title = 'Letsuan Design | Museum Exhibition Design, Taiwan';
const description = 'Taiwan-based design-build studio specializing in museum exhibition design, immersive experiences, and interior construction. Same team from concept to installation. 42+ projects, 17,000+ m² delivered since 2014.';
const canonical = 'https://letsuan.com/';
const alternateHrefs = [
  { hreflang: 'en', href: canonical },
  { hreflang: 'zh-TW', href: 'https://letsuan.com/zh-TW/' },
  { hreflang: 'x-default', href: canonical },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const faqs = [
  { q: 'What does Letsuan Design do?', a: 'Letsuan Design is a Taiwan-based design-build studio specializing in museum exhibition design, immersive experiences and interior construction. The same team carries a project from curatorial concept and spatial design through fabrication and on-site installation.' },
  { q: "Where are Letsuan Design's studios located?", a: 'Letsuan Design has studios in Taichung and Taipei, and delivers projects nationwide and internationally.' },
  { q: 'Which organizations has Letsuan Design worked with?', a: 'Letsuan Design has delivered projects for national museums, government agencies and global brands, including the National Museum of Natural Science, National Museum of History, TSMC, HTC and Ørsted.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, faqJsonLd]} alternateHrefs={alternateHrefs} preloadImage={preloadImage}>
  <div class="ltsuan-page">
    <Nav active="home" zhHref="/zh-TW/" />

    <Hero />

    <section id="about">
      <div class="ltsuan-about-inner">
        <div class="ltsuan-about-eyebrow">OUR APPROACH</div>
        <p class="ltsuan-about-headline">The same team that designs the space<br />also builds it.</p>
        <p class="ltsuan-about-copy">One point of contact from first sketch to final install — nothing lost in translation between concept and construction.</p>
        <p class="ltsuan-about-copy ltsuan-about-copy-extra">Letsuan Design is a Taiwan-based design-build studio specializing in museum exhibition design, immersive experiences, and interior construction. Founded in 2014 with studios in Taichung and Taipei, the same team carries projects from curatorial concept and spatial design through fabrication and on-site installation. Over 42 projects and 17,000+ m² delivered for national museums, government agencies, and global brands including Ørsted, TSMC, HTC VIVE Arts, and Toei Animation.</p>
      </div>
    </section>

    <ServicesGrid />
    <PortfolioPreview />

    <section id="faq">
      <h2 class="ltsuan-faq-title">Frequently Asked Questions</h2>
      <div class="ltsuan-faq-list">
        {faqs.map((f) => (
          <div class="ltsuan-faq-item">
            <h3 class="ltsuan-faq-q">{f.q}</h3>
            <p class="ltsuan-faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="contact">
      <div class="ltsuan-cta">
        <div class="ltsuan-cta-pill"><span class="ltsuan-cta-dot"></span>NEW PROJECTS FOR 2026 — OPEN</div>
        <h2 class="ltsuan-cta-h2">Let's talk about<br />your next idea.</h2>
        <p class="ltsuan-cta-copy">Whatever form the exhibition takes, our starting question stays the same: how do we lead visitors into the story, and make the experience a memory they carry with them.</p>
        <div class="ltsuan-cta-actions">
          <a href="https://letsuan.com/contact" class="ltsuan-cta-btn">
            <span>info@letsuan.com</span>
            <span class="ltsuan-cta-btn-arrow">↗</span>
          </a>
          <div class="ltsuan-cta-note">We'll get back to you within two business days.</div>
        </div>

        <div class="ltsuan-cta-footer">
          <div class="ltsuan-cta-social">
            <a href="https://www.facebook.com/LETSUANDESIGN" target="_blank" rel="noopener" aria-label="Facebook" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.pinterest.com/Letsuan_Design/" target="_blank" rel="noopener" aria-label="Pinterest" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.194-.332 1.361-.052.219-.173.265-.4.16-1.492-.694-2.424-2.874-2.424-4.625 0-3.767 2.737-7.229 7.892-7.229 4.144 0 7.365 2.953 7.365 6.897 0 4.116-2.595 7.428-6.199 7.428-1.211 0-2.349-.629-2.738-1.373 0 0-.599 2.282-.744 2.84-.269 1.037-.997 2.336-1.484 3.129 1.118.346 2.303.53 3.532.53 6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/letsuan-design/" target="_blank" rel="noopener" aria-label="LinkedIn" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.454c.98 0 1.775-.773 1.775-1.729V1.729C24 .774 23.205 0 22.225 0zM7.12 20.452H3.56V9h3.56v11.452zM5.34 7.433c-1.144 0-2.067-.926-2.067-2.065 0-1.138.923-2.065 2.067-2.065 1.14 0 2.064.927 2.064 2.065 0 1.139-.923 2.065-2.064 2.065zM20.452 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.137 1.447-2.137 2.941v5.665H9.359V9h3.412v1.561h.049c.475-.9 1.637-1.85 3.37-1.85 3.601 0 4.266 2.37 4.266 5.455v6.286z"/></svg>
            </a>
          </div>
          <div class="ltsuan-cta-cityline">Taichung Studio, Taipei Studio&nbsp;&nbsp;|&nbsp;&nbsp;+886 4 2321 5956</div>
          <div class="ltsuan-cta-address">6F.-1, No. 85, Sec. 1, Huamei W. St., West District, Taichung City 403020, Taiwan&nbsp;&nbsp;|&nbsp;&nbsp;3F., No. 62, Sec. 6, Yanping N. Rd., Shilin District, Taipei City 111069, Taiwan</div>
          <div class="ltsuan-cta-legal">
            <span>© 2026 Letsuan Design &amp; Interior Deco. All rights reserved.</span>
            <span>Interior Decorators' Registration No. 40E2007328</span>
            <a href="./privacy-policy">Privacy Policy</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
    overflow-x: hidden;
  }
  #about {
    padding: 160px 60px 160px 79px;
    display: flex;
    justify-content: flex-start;
  }
  .ltsuan-about-inner {
    max-width: 920px;
  }
  .ltsuan-about-eyebrow {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--ltsuan-accent);
    margin-bottom: 24px;
  }
  .ltsuan-about-headline {
    text-align: left;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(32px, 4.6vw, 58px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
    color: #f0e9de;
  }
  .ltsuan-about-copy {
    text-align: left;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.6;
    margin: 0;
    color: rgba(240, 233, 222, 0.55);
    text-wrap: pretty;
  }
  .ltsuan-about-copy-extra {
    margin-top: 24px;
    max-width: 52rem;
    font-size: 15px;
    line-height: 1.55;
    opacity: 0.92;
  }
  #faq {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 6vw 150px;
  }
  .ltsuan-faq-title {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(28px, 4vw, 44px);
    margin: 0 0 36px;
    color: #f0e9de;
  }
  .ltsuan-faq-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .ltsuan-faq-q {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 18px;
    margin: 0 0 8px;
    color: #f0e9de;
  }
  .ltsuan-faq-a {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(240, 233, 222, 0.6);
    margin: 0;
  }
  /* CTA (identical to about/what-we-do/portfolio) */
  #contact {
    border-top: 1px solid rgba(244, 239, 232, 0.06);
    padding: 64px 56px;
  }
  @media (min-width: 768px) {
    #contact {
      padding: 112px 56px;
    }
  }
  .ltsuan-cta {
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }
  .ltsuan-cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    border: 1px solid rgba(244, 239, 232, 0.06);
    padding: 4px 12px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: rgba(244, 239, 232, 0.4);
  }
  .ltsuan-cta-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ltsuan-accent);
  }
  .ltsuan-cta-h2 {
    margin: 32px 0 0;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .ltsuan-cta-copy {
    max-width: 42ch;
    margin: 24px auto 0;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    line-height: 1.8;
    color: rgba(244, 239, 232, 0.6);
  }
  .ltsuan-cta-actions {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .ltsuan-cta-actions {
      flex-direction: row;
    }
  }
  .ltsuan-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border-radius: 999px;
    background: var(--ltsuan-accent);
    padding: 14px 28px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: #0a0a0a;
    text-decoration: none;
    transition: background-color 0.2s ease, gap 0.2s ease;
  }
  .ltsuan-cta-btn:hover {
    background: var(--ltsuan-accent-hover);
    gap: 16px;
  }
  .ltsuan-cta-btn-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #0a0a0a;
    color: var(--ltsuan-accent);
  }
  .ltsuan-cta-note {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgba(244, 239, 232, 0.3);
  }
  .ltsuan-cta-footer {
    margin-top: 64px;
    border-top: 1px solid rgba(244, 239, 232, 0.06);
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .ltsuan-cta-social {
    display: flex;
    justify-content: center;
    gap: 12px;
  }
  .ltsuan-cta-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    width: 36px;
    border-radius: 50%;
    border: 1px solid rgba(244, 239, 232, 0.2);
  }
  .ltsuan-cta-cityline {
    text-align: center;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(244, 239, 232, 0.4);
  }
  .ltsuan-cta-address {
    text-align: center;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(244, 239, 232, 0.3);
  }
  .ltsuan-cta-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: 24px;
    row-gap: 8px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: rgba(244, 239, 232, 0.25);
  }
  .ltsuan-cta-legal a {
    color: rgba(244, 239, 232, 0.25);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .ltsuan-cta-legal a:hover {
    color: rgba(244, 239, 232, 0.6);
  }
</style>
