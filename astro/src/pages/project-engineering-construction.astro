const title = "Letsuan Design | Disaster Prevention Hall";
const description = "Disaster Prevention Hall. Construction in Taichung, Taiwan, 2012 — Letsuan Design.";
const canonical = "https://letsuan.com/project-engineering-construction";
const alternateHrefs = [
  { hreflang: "en", href: canonical },
  { hreflang: "zh-TW", href: "https://letsuan.com/zh-TW/project-engineering-construction" },
  { hreflang: "x-default", href: canonical },
];

const ogImage = "https://letsuan.com/images/engineering-construction-circular-exhibition-hall-with-central-planter-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Engineering Construction", "url": "https://letsuan.com/project-engineering-construction", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/engineering-construction-circular-exhibition-hall-with-central-planter-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2012", "hasPart": [{"@type": "CreativeWork", "name": "Site Conditions"}, {"@type": "CreativeWork", "name": "Demolition and Measurement"}, {"@type": "CreativeWork", "name": "Fit-Out"}, {"@type": "CreativeWork", "name": "Result"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Disaster Prevention Hall — 921 Earthquake Museum", "item": "https://letsuan.com/project-engineering-construction"}]}];
const eyebrowLeft = "EXHIBITION — 2012";
const eyebrowRight = "921 EARTHQUAKE MUSEUM OF TAIWAN";
const h1Main = "Disaster Prevention Hall";
const h1Sub = "921 Earthquake Museum of Taiwan";
const metaFields = [{"label": "LOCATION", "value": "Taichung, Taiwan"}, {"label": "YEAR", "value": "2012"}, {"label": "CATEGORY", "value": "Construction"}];
const bodyHtml = "<p>At 1:47 in the morning on September 21, 1999, Taiwan was hit by its largest earthquake in a century. Central Taiwan lost buildings across a wide swath of the region, and the disaster exposed how unprepared both rescue agencies and the public were.</p>\n<p>Given Taiwan's geology and location, earthquakes, typhoons, and rockslides are bound to happen again, and preparation can't be treated as optional. The old saying holds: forewarned is forearmed, and prevention is worth more than any repair that comes after the fact. That is the founding purpose of the Disaster Prevention Hall: give visitors the knowledge to take refuge and respond, so a correct understanding of disaster prevention takes root before the next event arrives.</p>\n<h2>Site Conditions</h2>\n<p>The National Museum of Natural Science's 921 Earthquake Museum sits directly on the original site of the Chelungpu Fault. The building was designed and built around the ground-level offsets the fault's rupture had left behind, so its walls follow a curved line rather than a rectangular plan, and the floor slabs between zones differ in height by roughly 100 centimeters. Because that curvature and those level changes are part of the original architecture, <a href=\"./what-we-do#service-construction\">construction</a> couldn't correct them the way a normal building project would; every layout had to follow the existing curves and level shifts.</p>\n<p>It got more complicated from there: the original exhibition design had been drawn up from architectural plans alone, without anyone surveying the site in person, so the curved walls and floor offsets on paper diverged noticeably from what was actually there. Setting-out baselines couldn't be taken from the drawings at all. The crew ended up templating each zone by hand on site, matching the real curvature zone by zone, which became the project's central technical problem.</p>\n<h2>Demolition and Measurement</h2>\n<p>Work started with tearing out the existing exhibits, display walls, partitions, and fixtures. As each section came down, the crew measured and logged the actual wall curvature and floor-level offsets zone by zone, building the reference data that later setting-out and fit-out work would depend on. Nothing about the curved lines or level changes at the core of the building's original design was allowed to be altered in the process.</p>\n<h2>Fit-Out</h2>\n<p>With the drawings unreliable and the curvature and offsets impossible to correct or hide, the crew templated every zone directly against the real geometry. New display walls and circulation fixtures were built on free-standing frames that didn't attach to the existing curved structure; each zone got its own vertical and horizontal reference lines set out from actual conditions, which let the new work hold proper precision and safety margins even inside a curved, uneven shell.</p>\n<p>The roughly 100-centimeter floor offset was bridged with a combination of gentle ramps and stairs, keeping the level change itself visible as a piece of the building's original design rather than smoothing it away. The exhibition floor also carries a large run of angled laminated glass panels fixed with metal hardware, each pane individually adjusted to the real curvature of the walls and floor around it, which raised the bar on both construction precision and structural safety.</p>\n<p>Flooring throughout was replaced entirely with seamless, through-body vinyl imported from Sweden, colored consistently from surface to core, resistant to wear, with no seams for dirt to collect in, built to take heavy sustained foot traffic while meeting the slip-resistance and cleaning standards a public educational venue needs.</p>\n<h2>Result</h2>\n<p>Once construction wrapped, the building, built originally around the fault's own ground-level offsets, held a full set of interactive disaster-prevention exhibits without losing its curved walls or level changes, letting the architecture's own design vocabulary sit in the same space as its educational content. The idea behind disaster-prevention education, preparing before disaster strikes, is now something visitors absorb directly through the building and the exhibits inside it, learning to respond to earthquakes, typhoons, and other hazards.</p>";
const relatedProjects = [{"href": "./project-story-telling", "label": "Story Telling by the Ancient People"}, {"href": "./project-nmns-teldap", "label": "NMNS TELDAP"}, {"href": "./project-jehol-biota", "label": "Jehol Biota Special Exhibition"}];
const nextHref = "./project-tokyo-ghost-hospital";
const images = [{"src": "./images/engineering-construction-circular-exhibition-hall-with-central-planter-letsuan-design.jpg", "alt": "Disaster Prevention Hall — Circular exhibition hall with central planter and panel walls"}, {"src": "./images/engineering-construction-central-bamboo-planter-feature-with-letsuan-design.jpg", "alt": "Central bamboo planter feature with surrounding display panels"}, {"src": "./images/engineering-construction-flood-myth-wall-panel-with-wave-textured-letsuan-design.jpg", "alt": "Flood myth wall panel with wave-textured relief"}, {"src": "./images/engineering-construction-flood-exhibit-corridor-with-projection-letsuan-design.jpg", "alt": "Flood exhibit corridor with projection and glass display case"}, {"src": "./images/engineering-construction-column-display-with-glass-leaf-sculptures-letsuan-design.jpg", "alt": "Column display with glass leaf sculptures and disaster panels"}, {"src": "./images/engineering-construction-curved-wall-with-flood-control-image-letsuan-design.jpg", "alt": "Curved wall with flood control image panels and Taiwan map graphic"}, {"src": "./images/engineering-construction-water-conservation-exhibit-panels-with-letsuan-design.jpg", "alt": "Water conservation exhibit panels with circular display windows"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  alternateHrefs={alternateHrefs}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
