---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Le Tsuan Design | Traveling Temple";
const description = "Traveling Temple. Exhibition Design in Taipei, Taiwan, 2015 — Le Tsuan Design.";
const canonical = "https://letsuan.com/project-tibetan-thangka";
const ogImage = "https://letsuan.com/images/tibetan-thangka-art-exhibition-01-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Tibetan Thangka Art Exhibition", "url": "https://letsuan.com/project-tibetan-thangka", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/tibetan-thangka-art-exhibition-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2015", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Tibetan Thangka Art Exhibition", "item": "https://letsuan.com/project-tibetan-thangka"}]}];
const eyebrowLeft = "EXHIBITION — 2015";
const eyebrowRight = "NATIONAL CHIANG KAI-SHEK MEMORIAL HALL";
const h1Main = "Traveling Temple";
const h1Sub = "Tibetan Thangka Art Exhibition";
const metaFields = [{"label": "CLIENT", "value": "Mongolian and Tibetan Affairs Commission"}, {"label": "LOCATION", "value": "Taipei, Taiwan"}, {"label": "YEAR", "value": "2015"}, {"label": "CATEGORY", "value": "Exhibition Design, Interior Design, Graphic Design, Logo Design, Construction"}];
const bodyHtml = "<h2>A Scroll That Rolls Up, and a Corridor Nobody Could Close Off</h2>\n<p>A thangka, in Tibetan, means a scroll painting mounted in silk that can be rolled up for storage; its origins run deep and it carries the distinctive brightness and religious content of Tibetan Buddhist culture.</p>\n<p>We handled the on-site construction of \"Traveling Temple: Tibetan Thangka Art Exhibition\" at its National Chiang Kai-shek Memorial Hall venue, completing the display and image-system integration of thangka artifacts from the Rebgong region of Qinghai, China, inside the Cai Yu Gallery. The name \"Traveling Temple\" comes from Rebgong thangka culture itself, moving with faith and spreading across regions, and our task was to rebuild a spiritual environment inside the gallery where visitors could pause and feel something close to a place of worship.</p>\n<h2>An Open Corridor, Not a Room With a Door</h2>\n<p>This was the most basic constraint of the whole project: the Cai Yu Gallery is an open-plan circulation space rather than a standalone exhibition room, so foot traffic can reach the display pieces directly. Thangkas are painted on silk or cloth, fragile and easily affected by touch and environmental conditions, so we encased every single piece in high-transparency acrylic, achieving physical protection without compromising the viewing experience or the colour fidelity of the paintings.</p>\n<h2>Several Metres of Silk, Held Up by Nothing but Tension</h2>\n<p>Several pieces were large thangka banners spanning several metres wide. We used a suspended display method, planning hanging points and tension control along an overhead track system so the silk and cloth artifacts hung flat without being pulled out of shape by their own weight.</p>\n<p>Floor area was limited, so the physical thangka pieces, circulation guidance, and a video-projection zone all had to fit inside the existing footprint; we calculated the spacing between pieces, the visitor route, and crowd pacing to avoid crowding while keeping the distance religious art needs. Large banners, framed vertical thangkas, and documentary photography of Rebgong's artists and residents, three different display formats, were also zoned along the route to balance visual rhythm against protection distance.</p>\n<h2>Walls That Could Come Down Afterward</h2>\n<p>To meet the venue's spatial conditions and the artifacts' hanging requirements, we built dedicated, demountable display partition walls inside the existing site to carry the suspension track, lighting, and fixtures, fully removable and restorable once the show closed, with no impact on the original building. As a short-run special exhibition inside the Cai Yu Gallery, construction worked within the venue's existing architectural conditions, circulation regulations, and exhibition timeline, completing the full display and equipment installation on a limited schedule and in a limited space.</p>";
const relatedProjects = [{"href": "./project-detention-pier2", "label": "Detention — Reality Experience"}, {"href": "./project-detective-conan-taipei", "label": "Detective Conan"}, {"href": "./project-tccge-deck", "label": "Green Energy Education Observation Platform"}];
const nextHref = "./project-asian-art-biennial";
const images = [{"src": "./images/tibetan-thangka-visitor-viewing-scroll-row-white-gallery-letsuan-design.jpg", "alt": "Traveling Temple — Visitor viewing a row of hanging Tibetan thangka scrolls along the white gallery wall"}, {"src": "./images/tibetan-thangka-art-exhibition-01-letsuan-design.jpg", "alt": "Framed Tibetan thangka paintings hung along the exhibition corridor at Cai Yu Art Gallery"}, {"src": "./images/tibetan-thangka-art-exhibition-02-letsuan-design.jpg", "alt": "Large horizontal thangka mural depicting an assembly of Buddhist deities, mounted in the gallery corridor"}, {"src": "./images/tibetan-thangka-art-exhibition-03-letsuan-design.jpg", "alt": "Installation team hanging thangka pieces from the overhead suspension track during construction"}, {"src": "./images/tibetan-thangka-art-exhibition-04-letsuan-design.jpg", "alt": "Construction progress: the team reviews the corridor layout, assembles display panels, and secures a thangka frame with a drill"}, {"src": "./images/tibetan-thangka-art-exhibition-05-letsuan-design.jpg", "alt": "Finished gallery corridor with large thangka murals on display, visitors viewing in the background"}, {"src": "./images/tibetan-thangka-art-exhibition-06-letsuan-design.jpg", "alt": "Documentary photographs of Rebgong thangka artists and residents, including a mother and child and an artist painting a thangka"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
