const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "不只是展覽–你就是藝術的一部分！", "description": "不只是展覽–你就是藝術的一部分！ — 走進呼吸中的光影魔幻宇宙", "url": "https://letsuan.com/zh-TW/project-beyond-just-an-exhibition", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/beyond-exhibition-visitors-interacting-with-pulsating-valley-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2024", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "不只是展覽–你就是藝術的一部分！", "item": "https://letsuan.com/zh-TW/project-beyond-just-an-exhibition"}]}];
