---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "麗荃室內裝修 | 防災教育館";
const description = "防災教育館 — 921地震教育園區";
const canonical = "https://letsuan.com/zh-TW/project-engineering-construction";
const ogImage = "https://letsuan.com/images/engineering-construction-circular-exhibition-hall-with-central-planter-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-engineering-construction" },
  { hreflang: "zh-TW", href: canonical },
  { hreflang: "x-default", href: "https://letsuan.com/project-engineering-construction" },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "防災教育館", "description": "防災教育館 — 921地震教育園區", "url": "https://letsuan.com/zh-TW/project-engineering-construction", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/engineering-construction-circular-exhibition-hall-with-central-planter-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2012", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "防災教育館", "item": "https://letsuan.com/zh-TW/project-engineering-construction"}]}];
const eyebrowLeft = "展覽 — 2012";
const eyebrowRight = "921地震教育園區";
const h1Main = "防災教育館";
const h1Sub = "921地震教育園區";
const metaFields = [{"label": "業主", "value": "921地震教育園區"}, {"label": "地點", "value": "台中，臺灣"}, {"label": "年份", "value": "2012"}, {"label": "類別", "value": "工程施作"}];
const bodyHtml = "<p>1999 年 9 月 21 日凌晨 1 時 47 分，臺灣經歷百年來規模最大的地震之一。這場地震重創臺灣中部廣大地區的建築物，同時暴露出救災機構與民眾在防災準備上的不足。以臺灣所處的地理位置與地質條件而言，地震、颱風、山崩等天然災害必將再度發生，防範不容輕忽。防災教育館的設立宗旨，即在於「未雨綢繆」–讓民眾具備避難與應變的知識，建立正確的防災觀念，其價值遠勝於災後修復。</p>\n<h2>現場條件與挑戰</h2>\n<p>國立自然科學<a href=\"./portfolio\">博物館</a>921地震教育園區坐落於車籠埔斷層原址之上，建築物本身即依斷層錯動後留下的地形高低差進行設計與興建。牆面採弧形設計，<a href=\"./what-we-do#service-interior\">室內</a>平面也因此呈現非矩形樣態，各分區樓板間存在約 100 公分的高低落差。這樣的弧形牆體與樓板高低差屬於原始建築設計的一部分，因此<a href=\"./what-we-do#service-construction\">施工</a>過程中不可比照一般建物邏輯逕行校正，而須依循原設計的弧形線條與高低差進行放樣與整備。此外，展示設計單位當時僅依原始建築施工圖進行設計，並未實際到場量測，圖面所載的弧形牆體與高低差與現場實際狀態存在不小落差，因此各面牆體、樓板的放樣基準無法直接沿用圖面數據，只能請工班在現場依實際弧形曲度逐區打版製作，是本案工程執行上的主要難題。</p>\n<h2>拆除工程</h2>\n<p>工程自拆除當時舊有展示與隔間開始，先行清空既有展示牆體、隔間與相關設施，並就弧形牆體的曲度、樓板高低差等現況逐區量測記錄，作為後續放樣與展示設施整備的依據；過程中特別留意不得更動作為建築設計核心元素的弧形線條與高低差。</p>\n<h2>空間整備與工程執行</h2>\n<p>由於原始牆體的弧形設計與樓板高低差，是當時建築設計的其中一環，不可任意校正或掩蓋，加上圖紙與現場實際狀態存在不小落差，施工團隊只能請工班在現場依實際弧形曲度逐區打版製作：展示牆體與動線設施皆以自立式骨架施作，不與既有弧形結構產生依附關係，逐區依現況個別放樣、建立各自的垂直與水平基準，使新增設施得以在弧形的原始結構條件下維持應有的施工精度與使用安全。針對約 100 公分的樓板高低差，則以緩坡道與階梯銜接的方式處理動線轉換，同時保留高低差本身作為呼應建築設計理念的空間元素。展場中並配置大量斜面膠合玻璃，以五金構件進行支撐固定，玻璃角度須逐片依現場弧形牆體與樓板高低差調整，施工精度與結構安全要求相對較高。地坪面層則全面重作，採用瑞典進口透心材無縫塑膠地磚，其材質色澤上下一致，耐磨損且無接縫藏污之虞，可承受大量參觀人潮的長期踩踏，並符合公共教育場館對防滑與清潔維護的要求。</p>\n<h2>完工成果</h2>\n<p>工程完成後，依斷層錯動後地形高低差設計興建的建築本體，在維持原設計弧形牆體與高低差的前提下，成功容納了互動式防災展示設施，使建築本身的設計語彙與教育內容並存於同一空間。呼應防災教育「未雨綢繆」的核心理念，讓地震、颱風等天然災害的應變知識，得以透過建築現場與展示裝置，直接傳遞給參觀民眾。</p>";
const relatedProjects = [{"href": "./project-story-telling", "label": "五千年的沉默"}, {"href": "./project-nmns-teldap", "label": "科博館數位典藏"}, {"href": "./project-jehol-biota", "label": "開展那天，93件化石一件都不能遲到"}];
const nextHref = "./project-tokyo-ghost-hospital";
const images = [{"src": "../images/engineering-construction-circular-exhibition-hall-with-central-planter-letsuan-design.jpg", "alt": "防災教育館——圓形展廳搭配中央植栽與展板牆面"}, {"src": "../images/engineering-construction-central-bamboo-planter-feature-with-letsuan-design.jpg", "alt": "中央竹林造型植栽裝置，周圍環繞展示看板"}, {"src": "../images/engineering-construction-flood-myth-wall-panel-with-wave-textured-letsuan-design.jpg", "alt": "洪水神話主題牆板，搭配波浪紋理浮雕"}, {"src": "../images/engineering-construction-flood-exhibit-corridor-with-projection-letsuan-design.jpg", "alt": "洪水主題展覽廊道，搭配投影與玻璃展櫃"}, {"src": "../images/engineering-construction-column-display-with-glass-leaf-sculptures-letsuan-design.jpg", "alt": "柱體展示搭配玻璃葉片雕塑與防災看板"}, {"src": "../images/engineering-construction-curved-wall-with-flood-control-image-letsuan-design.jpg", "alt": "弧形牆面搭配防洪意象看板與臺灣地圖圖像"}, {"src": "../images/engineering-construction-water-conservation-exhibit-panels-with-letsuan-design.jpg", "alt": "水資源保育展示看板搭配圓形展示窗"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
  lang="zh-TW"
  alternateHrefs={alternateHrefs}
  closeLabel="關閉"
  backLabel="回作品集"
  nextLabel="下一個專案"
  homeLabel="首頁"
