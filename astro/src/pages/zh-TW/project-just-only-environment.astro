---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "Le Tsuan Design | Just Only";
const description = "Just Only — 環保型錄";
const canonical = "https://letsuan.com/zh-TW/project-just-only-environment";
