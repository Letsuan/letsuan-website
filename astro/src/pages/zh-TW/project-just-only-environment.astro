const bodyHtml = "<p>為 Just Only 環境保護品牌規劃型錄、字體與網站視覺。以簡潔、可讀的設計語言傳達環保理念，讓平面與數位介面維持一致的品牌調性。</p>";
const relatedProjects = [{"href": "./project-fullchamp-brochure", "label": "Fullchamp"}, {"href": "./project-amazing-homeland", "label": "原鄉驚艷"}, {"href": "./project-art-gallery-culture", "label": "看見文化部"}];
const nextHref = "./project-fullchamp-brochure";
