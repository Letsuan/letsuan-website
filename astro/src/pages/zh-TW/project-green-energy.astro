const description = "陽光、風力、地熱，在一座展館裡相遇 — 台泥綠能願景館";
const canonical = "https://letsuan.com/zh-TW/project-green-energy";
const ogImage = "https://letsuan.com/images/green-energy-vision-pavilion-09-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-green-energy" },
  { hreflang: "zh-TW", href: canonical },
  { hreflang: "x-default", href: "https://letsuan.com/project-green-energy" },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "陽光、風力、地熱，在一座展館裡相遇", "description": "陽光、風力、地熱，在一座展館裡相遇 — 台泥綠能願景館", "url": "https://letsuan.com/zh-TW/project-green-energy", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/green-energy-vision-pavilion-09-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022–Present", "hasPart": [{"@type": "CreativeWork", "name": "概念發想：生命與水泥的交織依存"}, {"@type": "CreativeWork", "name": "儀式性入口：我們是誰，我們從哪裡來"}, {"@type": "CreativeWork", "name": "從自然到能源：室內展示動線"}, {"@type": "CreativeWork", "name": "展示主體依照「從環境中找能源」的邏輯，分區展開："}, {"@type": "CreativeWork", "name": "工藝與材料"}], "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "陽光、風力、地熱，在一座展館裡相遇", "item": "https://letsuan.com/zh-TW/project-green-energy"}]}];
const eyebrowLeft = "展覽 — 2022";
const eyebrowRight = "台泥綠能";
const h1Main = "陽光、風力、地熱，在一座展館裡相遇";
const h1Sub = "台泥綠能願景館";
const metaFields = [{"label": "業主", "value": "台泥綠能"}, {"label": "地點", "value": "彰化，臺灣"}, {"label": "年份", "value": "2022年至今"}, {"label": "類別", "value": "策展規劃、展覽設計、室內設計、裝置藝術、互動多媒體、工程施作"}];
const bodyHtml = "<p>台泥綠能股份有限公司成立於 2018 年，是台泥企業團為布局再生能源、由台泥百分之百持股的轉投資企業，專注於太陽光電、風力發電與地熱發電的投資與開發。2019 年底，台泥綠能於彰濱完成 12.1MW 光電與 7.2MW 風電的建置，同一時期，我們受託將廠區旁的空間轉化為對外展示的窗口–「綠能願景館」，在展覽主標語「The future is worth it」之下，展開一段從<a href=\"./what-we-do#service-interior\">室內</a>到屋頂、從機械到有機的敘事旅程。</p>\n<h2>概念發想：生命與水泥的交織依存</h2>\n<p>展館的核心意象，來自一件尺寸達 235 至 270 公分的迎賓裝置–以水泥為載體，讓植物從中生長而出，具象化「生命與水泥的交織依存」這一命題。這件裝置不只是入口端景，更是整座展館的精神註腳：台泥作為水泥製造業者，如何在既有的產業基礎上，走向對環境與生命的長期承諾。我們在設計提案中引用了班雅明的話語作為<a href=\"./what-we-do#service-curatorial\">策展</a>基調–面對生命，我們沒有解答，只有問題，以及各種面對問題的故事；這也定調了展館不以說教方式呈現能源知識，而是以故事線引導參觀者自行探索。</p>\n<h2>儀式性入口：我們是誰，我們從哪裡來</h2>\n<p>參觀動線由一道儀式性入口廊道展開，透過多組投影畫面輪播，拋出「我們是誰？我們從哪裡來？我們要去哪裡？」的提問，並將台泥從傳統水泥事業走向綠能事業的轉型歷程，定位為「解決人與人及人與環境的問題」的持續行動。這段序場刻意壓低資訊量、放大情緒與氛圍，讓參觀者在踏入展示核心區之前，先建立起與主題的情感連結。</p>\n<h2>從自然到能源：室內展示動線</h2>\n<h2>展示主體依照「從環境中找能源」的邏輯，分區展開：</h2>\n<p>能源探索區：以觸控互動白板結合紀錄影片，呈現彰濱綠能廠自建廠以來的歷程，並透過情境式圖文，引導參觀者理解能源如何存在於自然之中。</p>\n<p>即時電量與再生能源學習區：串接二樓即時電能戰情室資訊，加入觸控圖文解說，並系統性介紹生質能、水力、潮汐、波浪等再生能源類型與各國發展現況。</p>\n<p>生活用電與電力傳輸區：以感應燈控裝置比對家電耗電量、說明交直流轉換與智慧電網分佈，並結合 Kinect 手勢偵測與 AR 效果，讓抽象的電力知識轉為可操作的互動體驗。</p>\n<p>太陽能、風力、地熱專區：分別以實體樣品、剖面模型與平板遊戲呈現三種綠能的發電原理，遊戲設計支援單機探索與雙機連線對戰，寓教於樂之餘也創造參觀者之間的互動。</p>\n<p>全息投影互動櫃：整合太陽能、風力、地熱三項再生能源的應用情境，參觀者可透過按鈕觸發對應的三維動畫，具象化「打造一個綠能家園」的願景。</p>\n<p>未來展望區：以保種中心與碳循環為主題，收束整段參觀旅程，呼應「The future is worth it」的核心訊息。</p>\n<p>屋頂綠能地景：戶外空間轉化</p>\n<p>展館的敘事並未停留在室內。我們同時將屋頂空間規劃為戶外景觀平台，讓參觀者得以遠眺台泥的種電場現址，並設置具識別性的拍照打卡點。</p>\n<h2>工藝與材料</h2>\n<p>室內端景大量運用清水模效果搭配木作，並以熱浸鋅 C 型鋼結構作為骨架支撐立體造型牆面；D 區則以不鏽鋼鏡面金屬球與黑鐵字呼應未來感的展示語彙。多媒體互動<a href=\"./what-we-do#service-construction\">工程</a>橫跨商用觸控螢幕、270 度全息投影紅外線觸控系統、Kinect 感應裝置與客製化互動程式撰寫，將硬體、軟體與空間設計整合為單一敘事系統，而非各自獨立的展項堆疊。</p>\n<p>從一件水泥與植物共生的迎賓裝置出發，到屋頂上一片可呼吸的綠色地景，我們為台泥綠能願景館所建立的，不只是一套展示工程，而是一段企業與環境重新對話的空間敘事。</p>\n<div style=\"display:flex;gap:16px;align-items:center;margin-top:24px;\"><img src=\"/images/green-building-material-label-letsuan-design.jpg\" alt=\"綠建材標章\" style=\"width:2.5cm;height:auto;\" /><img src=\"/images/thbml-taiwan-healthy-building-material-label-letsuan-design.png\" alt=\"臺灣健康建材標章（THBML）\" style=\"width:2.5cm;height:auto;\" /></div>";
const relatedProjects = [{"href": "./project-led-kinetic", "label": "宇宙"}, {"href": "./project-notre-dame", "label": "永恆聖母院"}, {"href": "./project-beyond-just-an-exhibition", "label": "不只是展覽–你就是藝術的一部分！"}];
