", "caption": "新一與蘭的等身人形立於櫻花背景前"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/conan-anniv-cherry-blossom-scene-with-life-size-figures-letsuan-design.jpg", "caption": "櫻花場景搭配等身人形立牌"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/conan-anniv-zero-penetration-set-wall-construction-in-letsuan-design.jpg", "caption": "零侵入式場景牆體施工進行中"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/conan-anniv-fabrication-workshop-building-the-exhibition-letsuan-design.jpg", "caption": "製作工坊組裝展覽場景牆體"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/conan-anniv-le-tsuan-design-workshop-panel-fabrication-letsuan-design.jpg", "caption": "麗荃室內裝修｜名偵探柯南——麗荃設計工坊進行牆面製作"}], "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2015-2016", "dateModified": "2026-09-03", "hasPart": [{"@type": "CreativeWork", "name": "在一座不能碰的倉庫裡，把柯南的世界搬進來"}, {"@type": "CreativeWork", "name": "名偵探柯南連載20週年紀念展｜零侵入結構，與一整面漫畫變成的牆"}, {"@type": "CreativeWork", "name": "倉庫是古蹟，我們連一根釘子都不能釘"}, {"@type": "CreativeWork", "name": "把一格一格的漫畫，變成一面能走進去的牆"}, {"@type": "CreativeWork", "name": "四段經典場景，一個入口先破了設定"}], "isPartOf": {"@id": "https://letsuan.com/#website"}, "location": {"@type": "Place", "name": "臺北，臺灣"}, "startDate": "2015", "endDate": "2016"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "名偵探柯南連載20周年紀念展", "item": "https://letsuan.com/zh-TW/project-serialization-anniversary"}]}];
