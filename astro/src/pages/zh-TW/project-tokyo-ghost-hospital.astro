: "https://letsuan.com/images/tokyo-ghost-hospital-exhibition-07-letsuan-design.jpg", "caption": "東京幽靈醫院裝置"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/tokyo-ghost-hospital-exhibition-8810-letsuan-design.jpg", "caption": "東京幽靈醫院場景二"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/tokyo-ghost-hospital-exhibition-909-letsuan-design.jpg", "caption": "麗荃室內裝修｜東京恐怖病院——東京幽靈醫院展示"}], "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2015", "dateModified": "2026-09-03", "hasPart": [{"@type": "CreativeWork", "name": "牆不能靠建築，卻要靠得住觀眾"}, {"@type": "CreativeWork", "name": "東京恐怖病院臺灣站｜1,200+㎡跨樓層暗黑體驗，與一套不能鑽孔的結構系統"}, {"@type": "CreativeWork", "name": "日方對場景的要求，細到每一道刮痕"}, {"@type": "CreativeWork", "name": "嚇人的機關，觀眾看不到一絲破綻"}, {"@type": "CreativeWork", "name": "牆不能靠建築，卻要靠得住觀眾"}], "isPartOf": {"@id": "https://letsuan.com/#website"}, "location": {"@type": "Place", "name": "臺北，臺灣"}, "startDate": "2015"}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "東京恐怖病院", "item": "https://letsuan.com/zh-TW/project-tokyo-ghost-hospital"}]}];
