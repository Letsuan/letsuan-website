];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "草皮比作品更需要被保護", "description": "草皮比作品更需要被保護 — 2013亞洲藝術雙年展", "url": "https://letsuan.com/zh-TW/project-asian-art-biennial", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/asian-art-biennial-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2013-2014", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "草皮比作品更需要被保護", "item": "https://letsuan.com/zh-TW/project-asian-art-biennial"}]}];
