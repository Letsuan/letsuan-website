---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/zh-TW/Nav.astro';
import Footer from '../../components/zh-TW/Footer.astro';
import { organizationJsonLd } from '../../data/organization';

const title = '麗荃室內裝修 | 聯絡我們';
const description = '歡迎與麗荃室內裝修聯繫，討論您下一個展覽、室內設計或工程專案，我們的工作室位於台灣台中。';
const canonical = 'https://letsuan.com/zh-TW/contact';
const alternateHrefs = [
  { hreflang: 'en', href: 'https://letsuan.com/contact' },
  { hreflang: 'zh-TW', href: canonical },
  { hreflang: 'x-default', href: 'https://letsuan.com/contact' },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const faqs = [
  {
    group: '服務範圍',
    items: [
      { q: '麗荃室內裝修提供哪些服務？', a: '我們提供從策展概念、空間規劃到平面設計、製作與現場施工的全流程展覽、室內與視覺設計服務。大多數專案都由單一窗口從概念發展到安裝完成，全程負責到底。' },
      { q: '你們主要服務哪些類型的客戶與專案？', a: '我們主要與博物館、政府機關及企業客戶合作，執行展覽、常設展廳、品牌空間與公共裝置等專案，也承接較小型的室內設計與平面設計案。' },
      { q: '你們有承接台灣以外的專案嗎？', a: '有的。雖然大多數專案都在台灣進行，我們也曾執行過國際專案，包括在西班牙的展覽。' },
    ],
  },
  {
    group: '工作方式',
    items: [
      { q: '你們如何展開一個新專案？', a: '每個專案都從了解場地、觀眾與客戶目標開始，接著進行概念發展，再到細部設計與工程規劃，最後才進入施工階段。' },
      { q: '你們也負責施工與製作，還是只做設計？', a: '兩者我們都負責。我們的內部團隊全程管理從設計發展、施工、製作到安裝，也就是設計空間的團隊，同時也是實際動手搭建的團隊。' },
      { q: '施工前會提供3D視覺化或概念渲染圖嗎？', a: '會的。每個專案在進入製作前，都會經過概念渲染圖與3D視覺化的階段，讓客戶能夠審核並確認設計方向後再開始施工。' },
      { q: '一般專案需要多長時間？', a: '時程依專案規模而定——小型裝修專案可能只需一到兩個月，而大型客製化製作的博物館展覽，從概念發想到開幕通常需要半年到一年。' },
    ],
  },
  {
    group: '條款與實務細節',
    items: [
      { q: '一般專案的預算範圍大約是多少？', a: '我們不公開制式報價——每個專案都會依規模、材料與施工複雜度個別評估與報價。歡迎與我們聯繫，提供專案細節以取得估價。' },
      { q: '你們會簽署NDA保密協議，保護客戶機密嗎？', a: '會的。我們經常為政府機關與企業客戶簽署NDA保密協議，並在合作期間及結束後，將所有專案資料——包含簡報、預算與尚未公開的內容——視為機密處理。' },
      { q: '展覽或裝置完工後，你們有提供後續維護嗎？', a: '有的。保固期內包含維護服務，保固期滿後我們仍會依個案提供付費維護支援。' },
    ],
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.flatMap((g) => g.items).map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const email = 'info@letsuan.com';
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, faqJsonLd]} lang="zh-TW" alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="contact" enHref="/contact" />

    <section id="hero">
      <h1 class="ltsuan-h1">讓我們聊聊您的空間。</h1>
      <p class="ltsuan-lead">告訴我們您的專案——送出後我們會在兩個工作天內回覆您。</p>
    </section>

    <section id="contact-body">
      <div class="ltsuan-contact-col">
        <div>
          <div class="ltsuan-eyebrow">工作室 — 台中</div>
          <p class="ltsuan-address">403020 台中市西區華美西街一段85號6樓之1</p>
        </div>
        <div>
          <div class="ltsuan-eyebrow">工作室 — 台北</div>
          <p class="ltsuan-address">111069 台北市士林區延平北路六段62號3樓</p>
        </div>
        <div>
          <div class="ltsuan-eyebrow">電話</div>
          <a href="tel:+886423215956" class="ltsuan-plain-link">+886 4 2321 5956</a>
        </div>
        <div>
          <div class="ltsuan-eyebrow">電子郵件</div>
          <a href={`mailto:${email}`} class="ltsuan-plain-link">{email}</a>
        </div>
        <div>
          <div class="ltsuan-eyebrow">社群</div>
          <a href="https://www.facebook.com/LETSUANDESIGN" class="ltsuan-plain-link">Facebook</a>
        </div>
        <div class="ltsuan-respond-box">
          <div class="ltsuan-respond-eyebrow">我們如何回覆</div>
          <p class="ltsuan-respond-copy">以下表單送出後會直接寄送至我們的團隊信箱，我們會在兩個工作天內回覆。專案細節與預算資訊將保密處理——我們經常為政府機關與企業客戶簽署NDA保密協議。</p>
        </div>
      </div>
      <div class="ltsuan-form-col">
        <form id="ltsuan-contact-form" class="ltsuan-form">
          <div class="ltsuan-form-row">
            <div class="ltsuan-field">
              <label for="firstName">名字<span aria-hidden="true">*</span></label>
              <input id="firstName" name="firstName" type="text" required />
            </div>
            <div class="ltsuan-field">
              <label for="lastName">姓氏<span aria-hidden="true">*</span></label>
              <input id="lastName" name="lastName" type="text" required />
            </div>
          </div>
          <div class="ltsuan-form-row">
            <div class="ltsuan-field">
              <label for="phone">電話號碼</label>
              <input id="phone" name="phone" type="tel" />
            </div>
            <div class="ltsuan-field">
              <label for="formEmail">電子郵件<span aria-hidden="true">*</span></label>
              <input id="formEmail" name="email" type="email" required />
            </div>
          </div>
          <div class="ltsuan-form-row">
            <div class="ltsuan-field">
              <label for="company">公司</label>
              <input id="company" name="company" type="text" />
            </div>
            <div class="ltsuan-field">
              <label for="location">地點 / 場館</label>
              <input id="location" name="location" type="text" />
            </div>
          </div>
          <div class="ltsuan-field">
            <label for="question">專案細節<span aria-hidden="true">*</span></label>
            <textarea id="question" name="question" rows="5" required></textarea>
          </div>
          <label class="ltsuan-checkbox">
            <input type="checkbox" id="requiresNda" name="requiresNda" />
            <span>本專案需要簽署保密協議（NDA）</span>
          </label>
          <label class="ltsuan-checkbox">
            <input type="checkbox" id="privacyConsent" name="privacyConsent" required />
            <span>我同意<a href="/zh-TW/privacy-policy" class="ltsuan-accent-link">隱私權政策</a>，並同意麗荃室內裝修為此次詢問處理我的個人資料。<span aria-hidden="true">*</span></span>
          </label>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAEmzrdImQn4O-6za" data-callback="ltsuanTurnstileDone"></div>
          <button type="submit" class="ltsuan-form-submit">送出 <span aria-hidden="true">→</span></button>
          <p id="ltsuan-form-status" class="ltsuan-form-status" role="status" aria-live="polite"></p>
        </form>
        <p class="ltsuan-form-fallback">表單無法載入嗎？請直接寄信至 <a href={`mailto:${email}`} class="ltsuan-accent-link">{email}</a>。</p>
      </div>
    </section>

    <section id="faq">
      <h2 class="ltsuan-faq-h2">FAQ</h2>
      {faqs.map((group) => (
        <div class="ltsuan-faq-group">
          <div class="ltsuan-faq-group-label">{group.group}</div>
          <div class="ltsuan-faq-grid">
            {group.items.map((item) => (
              <div>
                <h3 class="ltsuan-faq-q">{item.q}</h3>
                <p class="ltsuan-faq-a">{item.a}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <Footer />
  </div>
</Layout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  let turnstileToken = '';
  // @ts-ignore
  window.ltsuanTurnstileDone = (token: string) => { turnstileToken = token; };

  const form = document.getElementById('ltsuan-contact-form') as HTMLFormElement;
  const status = document.getElementById('ltsuan-form-status')!;
  const submitBtn = form.querySelector('.ltsuan-form-submit') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (!data.get('privacyConsent')) {
      status.textContent = '請先同意隱私權政策才能繼續。';
      status.className = 'ltsuan-form-status is-error';
      return;
    }
    if (!turnstileToken) {
      status.textContent = '請先完成上方的人機驗證。';
      status.className = 'ltsuan-form-status is-error';
      return;
    }

    const payload = {
      firstName: data.get('firstName'),
      lastName: data.get('lastName'),
      phone: data.get('phone'),
      email: data.get('email'),
      company: data.get('company'),
      location: data.get('location'),
      question: data.get('question'),
      requiresNda: data.get('requiresNda') === 'on',
      turnstileToken,
    };

    submitBtn.disabled = true;
    status.textContent = '傳送中…';
    status.className = 'ltsuan-form-status';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await res.json();
      if (result.success) {
        status.textContent = '謝謝您的訊息，我們會在兩個工作天內回覆您。';
        status.className = 'ltsuan-form-status is-success';
        form.reset();
        // @ts-ignore
        if (window.turnstile) window.turnstile.reset();
        turnstileToken = '';
      } else {
        throw new Error(result.error || 'Submission failed');
      }
    } catch (err) {
      status.textContent = '發生錯誤，請直接寄信給我們。';
      status.className = 'ltsuan-form-status is-error';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
  }
  #hero {
    padding: 220px 56px 70px 79px;
    border-bottom: 1px solid rgba(244, 239, 232, 0.08);
  }
  .ltsuan-h1 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(40px, 5.4vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }
  .ltsuan-lead {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(30px, 2.4vw, 40px);
    line-height: 1.19;
    color: rgba(244, 239, 232, 0.6);
    margin: 0;
    max-width: 40ch;
  }
  #contact-body {
    padding: 90px 56px 160px 79px;
    display: flex;
    gap: 64px;
    flex-wrap: wrap;
  }
  .ltsuan-contact-col {
    flex: 1;
    min-width: min(280px, 100%);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .ltsuan-eyebrow {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: rgba(244, 239, 232, 0.6);
    margin-bottom: 10px;
  }
  .ltsuan-address {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
    color: rgba(244, 239, 232, 0.85);
  }
  .ltsuan-plain-link {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 16px;
    text-decoration: none;
  }
  .ltsuan-respond-box {
    padding: 24px;
    background: #141414;
    border: 1px solid rgba(244, 239, 232, 0.08);
  }
  .ltsuan-respond-eyebrow {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--ltsuan-accent);
    margin-bottom: 12px;
  }
  .ltsuan-respond-copy {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: rgba(244, 239, 232, 0.7);
    margin: 0;
  }
  .ltsuan-form-col {
    flex: 1.5;
    min-width: min(320px, 100%);
  }
  .ltsuan-form {
    background: #141414;
    border: 1px solid rgba(244, 239, 232, 0.08);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ltsuan-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .ltsuan-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ltsuan-field label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.05em;
    color: rgba(244, 239, 232, 0.6);
  }
  .ltsuan-field label span {
    color: var(--ltsuan-accent);
    margin-left: 2px;
  }
  .ltsuan-field input,
  .ltsuan-field textarea {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: var(--ltsuan-text);
    background: #0a0a0a;
    border: 1px solid rgba(244, 239, 232, 0.15);
    padding: 10px 12px;
    resize: vertical;
  }
  .ltsuan-field input:focus,
  .ltsuan-field textarea:focus {
    outline: none;
    border-color: var(--ltsuan-accent);
  }
  .ltsuan-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(244, 239, 232, 0.75);
    cursor: pointer;
  }
  .ltsuan-checkbox input {
    margin-top: 3px;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    accent-color: var(--ltsuan-accent);
  }
  .ltsuan-checkbox span {
    flex: 1;
  }
  .ltsuan-checkbox span span {
    color: var(--ltsuan-accent);
    margin-left: 2px;
  }
  .ltsuan-form-submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 0.08em;
    color: #0a0a0a;
    background: var(--ltsuan-accent);
    border: none;
    padding: 12px 24px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .ltsuan-form-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .ltsuan-form-status {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 14px;
    margin: 0;
    min-height: 1.4em;
  }
  .ltsuan-form-status.is-success {
    color: var(--ltsuan-accent);
  }
  .ltsuan-form-status.is-error {
    color: #e0645a;
  }
  .ltsuan-form-fallback {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.55);
    margin: 14px 0 0;
  }
  .ltsuan-accent-link {
    color: var(--ltsuan-accent);
  }
  #faq {
    padding: 0 56px 160px 79px;
  }
  .ltsuan-faq-h2 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--ltsuan-accent);
    margin: 0 0 40px;
  }
  .ltsuan-faq-group {
    max-width: 1200px;
    margin-bottom: 44px;
  }
  .ltsuan-faq-group-label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.15em;
    color: rgba(244, 239, 232, 0.5);
    margin: 0 0 20px;
  }
  .ltsuan-faq-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 48px;
  }
  .ltsuan-faq-grid > div {
    flex: 1 1 340px;
  }
  .ltsuan-faq-q {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 19px;
    margin: 0 0 10px;
  }
  .ltsuan-faq-a {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(244, 239, 232, 0.65);
    margin: 0;
  }
</style>
