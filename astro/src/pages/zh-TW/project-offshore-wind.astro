---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "麗荃室內裝修 | 離岸風電運維中心";
const description = "離岸風電運維中心 — 學習中心裝修改造";
const canonical = "https://letsuan.com/zh-TW/project-offshore-wind";
const ogImage = "https://letsuan.com/images/offshore-wind-om-learning-center-01-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-offshore-wind" },
  { hreflang: "zh-TW", href: canonical },
  { hreflang: "x-default", href: "https://letsuan.com/project-offshore-wind" },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "離岸風電運維中心", "description": "離岸風電運維中心 — 學習中心裝修改造", "url": "https://letsuan.com/zh-TW/project-offshore-wind", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/offshore-wind-om-learning-center-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022–Present", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "離岸風電運維中心", "item": "https://letsuan.com/zh-TW/project-offshore-wind"}]}];
const eyebrowLeft = "室內設計 — 2022年至今";
const eyebrowRight = "臺灣";
const h1Main = "離岸風電運維中心";
const h1Sub = "學習中心裝修改造";
const metaFields = [{"label": "業主", "value": "離岸風電運維中心"}, {"label": "地點", "value": "台中，臺灣"}, {"label": "年份", "value": "2022年至今"}, {"label": "面積", "value": "231.4㎡"}, {"label": "類別", "value": "策展規劃、展覽設計、室內設計、平面設計、視覺設計、工程施作"}];
const bodyHtml = "<p>利用既有建築中的走道與閒置空間，我們重新定義動線與機能，將原本僅供員工用餐的低使用率場域，轉化為一處整合教育訓練、品牌敘事與訪客接待的複合式學習中心。</p>\n<p>空間同時承載企業形象展示、政策溝通、員工培訓、簡報、遠距會議、客戶接待與團體導覽，彈性支援內部小班課程與對外導覽。<a href=\"./what-we-do#service-construction\">施工</a>僅十四天，且不能影響下方餐廳營運與上方辦公樓層，噪音、粉塵與動線都必須在建築持續使用的前提下推進；工安依沃旭歐洲標準EHS執行，嚴於一般國內同規模裝修。</p>\n<p>材料全面採用環保建材，回應建築本體的LEED綠建築認證，把永續承諾從機能一路貫到選材。改造後，原本閒置的廊道成為高頻使用、敘事密度高的多功能場域，內部培訓與對外接待能量同步提升。場地其後接待過總統、行政院長，以及銀行高層、能源主管機關與國際交流團。</p>\n<div style=\"display:flex;gap:16px;align-items:center;margin-top:24px;\"><img src=\"/images/green-building-material-label-letsuan-design.jpg\" alt=\"綠建材標章\" style=\"width:2.5cm;height:auto;\" /><img src=\"/images/thbml-taiwan-healthy-building-material-label-letsuan-design.png\" alt=\"臺灣健康建材標章（THBML）\" style=\"width:2.5cm;height:auto;\" /></div>";
const relatedProjects = [{"href": "./project-missing-scientist", "label": "消失的科學家，藏在限制裡的設計"}, {"href": "./project-orsted-energy", "label": "與風共榮"}, {"href": "./project-world-semiconductors", "label": "半導體的世界"}];
const nextHref = "./project-green-energy";
const images = [{"src": "../images/offshore-wind-om-learning-center-01-letsuan-design.jpg", "alt": "離岸風電運維中心——會議室牆面為沃旭「Love your home」地球壁畫，前方為會議桌"}, {"src": "../images/offshore-wind-07-letsuan-design.jpg", "alt": "離岸風電展覽廊道，兩位訪客走過展示臺灣離岸風場裝置容量數據（吉瓦）的牆面"}, {"src": "../images/offshore-wind-om-learning-center-02-letsuan-design.jpg", "alt": "弧形圖文展牆說明離岸風場運作，從沿海安裝流程到風機維護時程"}, {"src": "../images/offshore-wind-visitor-viewing-turbine-technology-timeline-wall-letsuan-design.jpg", "alt": "訪客觀看離岸風機技術時間軸展牆，搭配播放安裝畫面的影音螢幕"}, {"src": "../images/offshore-wind-om-learning-center-03-letsuan-design.jpg", "alt": "弧形展覽廊道，搭配沿海風場安裝示意圖與影音螢幕"}, {"src": "../images/offshore-wind-om-learning-center-07-letsuan-design.jpg", "alt": "訪客觀看弧形展牆，介紹離岸風機基座周邊海洋生態"}, {"src": "../images/offshore-wind-om-learning-center-06-letsuan-design.jpg", "alt": "入口廊道搭配沃旭地球壁畫、點狀波紋造型門洞與風場照片壁畫"}, {"src": "../images/offshore-wind-om-learning-center-04-letsuan-design.jpg", "alt": "訪客翻閱互動翻牌看板，了解風機發電原理"}, {"src": "../images/offshore-wind-om-learning-center-08-letsuan-design.jpg", "alt": "樓梯旁牆面寫著「一起打造完全仰賴綠能運作的世界」"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
  lang="zh-TW"
  alternateHrefs={alternateHrefs}
  closeLabel="關閉"
  backLabel="回作品集"
  nextLabel="下一個專案"
  homeLabel="首頁"
  relatedLabel="相關專案"
  detailLabel="專案詳情"
/>