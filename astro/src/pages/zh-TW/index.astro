---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/zh-TW/Nav.astro';
import Footer from '../../components/zh-TW/Footer.astro';
import Hero from '../../components/Hero.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import { organizationJsonLd } from '../../data/organization';
import { heroSlides, services, featuredProjects } from '../../data/homepage-zh';

const title = '麗荃室內裝修 | Museum Exhibition Design, Taiwan';
const description = 'Taiwan-based design-build studio specializing in museum exhibition design, immersive experiences, and interior construction. Same team from concept to installation. 42+ projects, 17,000+ m² delivered since 2014.';
const canonical = 'https://letsuan.com/zh-TW/';
const alternateHrefs = [
  { hreflang: 'en', href: 'https://letsuan.com/' },
  { hreflang: 'zh-TW', href: canonical },
  { hreflang: 'x-default', href: 'https://letsuan.com/' },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const faqs = [
  { q: '麗荃室內裝修是做什麼的？', a: '麗荃室內裝修是一間位於臺灣的設計與工程整合公司，專注博物館展覽設計、沉浸式體驗與室內工程建造。同一團隊全程負責從策展概念、空間設計，到製作與現場安裝的完整專案流程。' },
  { q: '麗荃室內裝修的工作室在哪裡？', a: '麗荃室內裝修於臺中與臺北設有作業所，服務範圍涵蓋全臺灣及海外。' },
  { q: '麗荃室內裝修曾與哪些單位合作？', a: '麗荃室內裝修曾為國家級博物館、政府機關與國際品牌執行專案，包括國立自然科學博物館、國立歷史博物館、TSMC、HTC 與 Ørsted。' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, faqJsonLd]} lang="zh-TW" alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="home" enHref="/" />

    <Hero slides={heroSlides} autoAdvanceMs={7000} />

    <section id="about">
      <div class="ltsuan-about-inner">
        <div class="ltsuan-about-eyebrow">我們的理念</div>
        <p class="ltsuan-about-headline">設計空間的團隊，同時也是打造空間的團隊。</p>
        <p class="ltsuan-about-copy">從第一張草圖到最終安裝，單一窗口全程負責，從設計到完工維持同一個標準。</p>
        <p class="ltsuan-about-copy ltsuan-about-copy-extra">麗荃室內裝修是位於台灣的設計與工程整合公司，專注博物館展覽設計、沉浸式體驗與室內工程建造。成立於 2014 年，於臺中與台北設有作業所，由同一團隊負責從策展概念、空間設計，到製作與現場安裝的完整專案流程。</p>
        <p class="ltsuan-about-copy ltsuan-about-copy-extra">截至目前，已完成 42 件以上專案，累計交付面積超過 17,000 平方公尺，服務對象涵蓋國家級博物館、政府機關，以及 Ørsted、TSMC、HTC VIVE Arts 與東映動畫、FedEx 等國際品牌。</p>
      </div>
    </section>

    <ServicesGrid services={services} title="我們的服務" viewAllLabel="查看完整流程 →" />
    <PortfolioPreview featuredProjects={featuredProjects} title="精選作品" viewAllLabel="查看完整作品集 →" />

    <section id="faq">
      <h2 class="ltsuan-faq-title">Frequently Asked Questions</h2>
      <div class="ltsuan-faq-list">
        {faqs.map((f) => (
          <div class="ltsuan-faq-item">
            <h3 class="ltsuan-faq-q">{f.q}</h3>
            <p class="ltsuan-faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
    overflow-x: hidden;
  }
  #about {
    padding: 160px 60px 160px 79px;
    display: flex;
    justify-content: flex-start;
  }
  @media (max-width: 900px) {
    #about {
      padding: 100px 24px 80px;
    }
  }
  .ltsuan-about-inner {
    max-width: 920px;
  }
  .ltsuan-about-eyebrow {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--ltsuan-accent);
    margin-bottom: 24px;
  }
  .ltsuan-about-headline {
    text-align: left;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(13px, 4.3vw, 46px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
    color: #f0e9de;
    white-space: nowrap;
  }
  .ltsuan-about-copy {
    text-align: left;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: clamp(9px, 2.9vw, 18px);
    line-height: 1.6;
    margin: 0;
    color: rgba(240, 233, 222, 0.55);
    max-width: 600px;
    white-space: nowrap;
  }
  .ltsuan-about-copy-extra {
    margin-top: 24px;
    max-width: 52rem;
    font-size: 15px;
    line-height: 1.55;
    opacity: 0.92;
    white-space: normal;
  }
  #faq {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 6vw 150px;
  }
  .ltsuan-faq-title {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(28px, 4vw, 44px);
    margin: 0 0 36px;
    color: #f0e9de;
  }
  .ltsuan-faq-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .ltsuan-faq-q {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 18px;
    margin: 0 0 8px;
    color: #f0e9de;
  }
  .ltsuan-faq-a {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(240, 233, 222, 0.6);
    margin: 0;
  }
</style>
