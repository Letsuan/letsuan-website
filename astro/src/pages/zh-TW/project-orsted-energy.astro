---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "麗荃室內裝修 | 與風共榮";
const description = "與風共榮 — 2022臺灣國際能源展-沃旭能源";
const canonical = "https://letsuan.com/zh-TW/project-orsted-energy";
const ogImage = "https://letsuan.com/images/energy-taiwan-orsted-2022-01-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-orsted-energy" },
  { hreflang: "zh-TW", href: canonical },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "與風共榮", "description": "與風共榮 — 2022臺灣國際能源展-沃旭能源", "url": "https://letsuan.com/zh-TW/project-orsted-energy", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/energy-taiwan-orsted-2022-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "與風共榮", "item": "https://letsuan.com/zh-TW/project-orsted-energy"}]}];
const eyebrowLeft = "活動 — 2022";
const eyebrowRight = "臺北南港展覽館";
const h1Main = "與風共榮";
const h1Sub = "2022臺灣國際能源展-沃旭能源";
const metaFields = [{"label": "業主", "value": "沃旭能源"}, {"label": "地點", "value": "臺北，臺灣"}, {"label": "年份", "value": "2022"}, {"label": "類別", "value": "展覽設計、室內設計、平面設計、視覺設計、活動、工程施作"}];
const bodyHtml = "<p>海面之下，一座座風機的基樁靜靜扎根海床；海面之上，葉片持續轉動，將風的力量化為家家戶戶的電流。Ørsted 沃旭能源以「Let's create a world that runs entirely on green energy」為信念，將這股來自海洋的能量，帶進了2022臺灣國際能源週的展位之中。我們承接本案之設計規劃、工程施作與視覺統籌，讓一座暫時性的展覽空間，承載企業六年深耕臺灣的重量。</p>\n<h2>空間規劃：從限制到象徵</h2>\n<p>場地中央，一根既有結構立柱佇立其間–這是每個策展團隊都會遇到的難題，卻也成為本案敘事的起點。我們選擇不迴避、不掩蓋，而是將這根立柱重新詮釋為離岸風力發電塔柱，以特殊塗裝與造型包覆，讓原本消極的結構限制，轉化為展位中軸最具張力的視覺裝置。塔柱側面架設仿真爬梯，並取用沃旭能源提供之現場工程照片，將運維工程師身著橘色安全吊掛裝備、攀爬作業之身影合成於爬梯高處，讓參觀者遠遠望去幾可亂真，一時錯覺真有人員正於高空進行維護作業–這個安排並非單純的裝飾細節，而是將離岸風電最日常也最艱辛的工作現場，以最真實的影像語言，直接搬進展場之中，讓「運維」不再只是一個名詞，而是一個懸掛在半空中、真實可感的身影。</p>\n<p>以這根「塔柱」為錨點，狹長的展位基地被賦予了明確的敘事節奏：入口處，實木樑架搭建出迎賓門廊，大型品牌 Logo 發光招牌與風機葉片意象燈箱率先映入眼簾，宣告一段關於風與海的旅程即將展開；動線以斜角切入手法引導參觀者深入空間，途經洽談休憩區、品牌影音牆、數據資訊主牆，最終抵達主舞台，完成一趟由品牌初心走向產業實績的閱讀路徑。行至展位末端，一面植生牆靜靜佇立，呼應「Love your home」的核心訴求–風電從海上而來，最終歸於陸地上這片被守護的家園。</p>\n<h2>五段刻在牆上的故事</h2>\n<p>我們於設計階段同步規劃內容架構，將沃旭能源的企業實績轉化為五段沿動線鋪陳的故事。「全球經驗，深耕臺灣」以資訊圖表述說企業自全球航向臺灣海峽的軌跡；「臺灣唯一培育在地運維團隊」記錄全球首艘客製台籍運維船（SOV）與O&amp;M運維中心從藍圖到啟用的歷程，也與塔柱上那道合成的攀爬身影遙相呼應；「ReCoral珊瑚育生可行性研究」則將視角轉向海面之下，講述離岸風機水下基礎如何悄悄成為珊瑚重生的可能棲地；「風電供應商輔導基金」呈現九十二位技術人員接受高階焊接訓練、八十位人員取得GWO國際安全認證的養成足跡；「風起彰化」收尾於十位彰化在地與新移居工作者的臉孔與身影，讓宏大的產業敘事，最終落回一個個真實的人。</p>\n<h2>一座色彩構築的品牌宇宙</h2>\n<p>展位視覺系統全面遵循 Ørsted 企業識別規範，以品牌標準色（藍）及輔助色（紫、黃）建構空間色彩計畫。藍，是海洋與天空的底色，作為主牆核心，襯托地球意象背板與品牌標語，並讓液晶螢幕中的品牌影片靜靜流動；紫，沉澱為資訊主牆的重量，承載著累計裝置容量、風場分布地圖與亞太據點等數據，將企業版圖化作可閱讀的地景；黃，則躍動於量體立面，搭配塔柱上安全吊掛裝備意象，讓工程現場的專業與勇氣具體可感。三種色彩交織成一座濃縮的品牌宇宙，讓參觀者無需言語，便能感受 Ørsted 的識別語彙。</p>\n<h2>把永續，蓋進展位裡</h2>\n<p>我們於工程施作階段，讓「永續」不只是展位訴說的內容，更成為展位自身的體質。牆面基材採夾板貼木紋皮及PVC輸出等綠建材標章產品，實木構件全數選用可回收再利用材質；末端植生牆以真實植栽構築而成，讓綠意成為空間呼吸的一部分。塔柱表面之爬梯結構、以及沃旭能源提供照片之合成比例與張貼高度，皆經過現場反覆測試調整，確保由主動線望去的視覺效果最為逼真、比例最為合理。</p>\n<p>展位配置兩座500×300公分之大型LED電視牆作為主展示介面，分別呈現品牌主視覺與資訊主牆內容，強化展場遠端之視覺穿透力；另設置一座150×50×400公分之立式LED裝置，作為動線節點之補充展示媒介。此外，展場內另配置43吋、55吋、85吋LCD顯示器及200×120公分LED顯示牆，皆具備節能標章認證，於視覺呈現效果與能源效率間取得平衡，其中大型LED電視牆亦支援活動期間之簡報播放，作為現場論壇與議題分享的視覺載體。從立柱的塗裝造型、照片合成輸出與張貼，到木作結構的現場組裝與展項道具佈設，每一處施工皆依原始設計提案進行比例、材質與燈光效果之核對，確保這座暫時的展位，忠實承載了設計最初的意念。</p>\n<h2>一段被記住的旅程</h2>\n<p>展期間，展位搭配開幕典禮、生物多樣性論壇、高層對談（Hygge with Per）、徵才主題分享等多場活動，並藉由大型LED電視牆播放「沃旭輔導基金－GWO人才培育補助」等議題簡報，吸引產業人士、求職者與媒體絡繹到訪。開幕式上，多位貴賓在導覽人員的引路下，穿行過那根被賦予新生命的立柱，抬頭望向高處那道以假亂真的身影，走進沃旭能源深耕臺灣的故事之中–品牌形象的傳遞，在這三天裡同時被完成。</p>";
const relatedProjects = [{"href": "./project-offshore-wind", "label": "離岸風電運維中心"}, {"href": "./project-detention-pier2", "label": "返校"}, {"href": "./project-world-semiconductors", "label": "半導體的世界"}];
const nextHref = "./project-westernmost-point";
const images = [{"src": "../images/energy-taiwan-orsted-2022-01-letsuan-design.jpg", "alt": "Ørsted potted plant giveaway with brand tote at Energy Taiwan 2022"}, {"src": "../images/energy-taiwan-orsted-2022-02-letsuan-design.jpg", "alt": "Ørsted booth signage with technician on ladder at Energy Taiwan 2022"}, {"src": "../images/energy-taiwan-orsted-2022-03-letsuan-design.jpg", "alt": "Visitor photographing Ørsted-branded ice cream at Energy Taiwan 2022"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
  lang="zh-TW"
  alternateHrefs={alternateHrefs}
  closeLabel="關閉"
  backLabel="回作品集"
  nextLabel="下一個專案"
  homeLabel="首頁"
  relatedLabel="相關專案"
  detailLabel="專案詳情"
/>