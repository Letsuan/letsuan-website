---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "麗荃室內裝修 | 美麗與吉祥";
const description = "美麗與吉祥 — 國立歷史博物館館藏刺繡展";
const canonical = "https://letsuan.com/zh-TW/project-la-fortuna-bordada";
const ogImage = "https://letsuan.com/images/la-fortuna-bordada-gallery-corridor-embroidered-garment-panels-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-la-fortuna-bordada" },
  { hreflang: "zh-TW", href: canonical },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "美麗與吉祥", "description": "美麗與吉祥 — 國立歷史博物館館藏刺繡展", "url": "https://letsuan.com/zh-TW/project-la-fortuna-bordada", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/la-fortuna-bordada-gallery-corridor-embroidered-garment-panels-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2017", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "美麗與吉祥", "item": "https://letsuan.com/zh-TW/project-la-fortuna-bordada"}]}];
const eyebrowLeft = "展覽 — 2017";
const eyebrowRight = "西班牙國立裝飾藝術博物館";
const h1Main = "美麗與吉祥";
const h1Sub = "國立歷史博物館館藏刺繡展";
const metaFields = [{"label": "業主", "value": "國立歷史博物館"}, {"label": "地點", "value": "馬德里，西班牙"}, {"label": "年份", "value": "2017"}, {"label": "類別", "value": "展覽設計、室內設計、平面設計、視覺設計、標誌設計"}];
const bodyHtml = "<h2>這場展，我們從頭到尾都沒去過現場</h2>\n<h2>美麗與吉祥：國立歷史博物館館藏刺繡展｜74組刺繡文物，一套圖說，跨海完成的展場工程</h2>\n<p>「美麗與吉祥：國立歷史<a href=\"./portfolio\">博物館</a>館藏刺繡展」在西班牙國立裝飾藝術博物館開幕–這是臺灣傳統刺繡工藝第一次進駐西班牙國家級博物館體系，由駐西班牙代表處歷時兩年推動促成。史博館典藏近千件十九世紀後半葉以來的臺灣服飾與生活刺繡文物，這次精選74組件，分「常民服飾配件」與「官員補服」兩大主題展出。</p>\n<p>我們負責這場展覽的空間規劃與展示工程設計–但整個工程，我們沒有一天人在馬德里。</p>\n<h2>設計在臺灣做完，剩下的交給一套圖說</h2>\n<p>文物要跨國運送，展出場域又在地球另一端的歐洲，我們採取「在台完成設計、圖說跨海交付」的執行模式：整體空間規劃、展示道具設計，全部在臺灣端完成，轉化成一整套完整的施工圖說，交給西班牙當地的工程單位依圖施作、現場安裝。沒有辦法在現場盯工地，也沒辦法隔天再跑一趟修改，這套圖說必須把每一個細節都講清楚，因為它就是我們唯一能跟西班牙工程單位溝通的語言。</p>\n<h2>織品怕光、怕拉扯，展示架得先幫它們想好</h2>\n<p>刺繡文物質地脆弱，忌光害，也忌長時間張力垂掛，我們為此設計了專用的展櫃結構與服飾吊掛系統。像荷包、繡花鞋、童帽這類小型立體配件，形制各不相同，我們依每一類展品的輪廓，個別設計壓克力展示架，量身訂做支撐結構去貼合展品的形狀–這些細節，全部得在設計階段就想到位，因為到了西班牙現場，已經沒有回頭調整的空間。展覽主視覺與圖版輸出設計，則把刺繡紋樣裡花果鳥獸承載的吉祥寓意，轉譯成西方觀眾也能直觀理解的視覺敘事系統，讓文化差異不成為理解的門檻。</p>\n<p>這是我們少數完全透過圖說完成的海外博物館工程案例–沒有到過現場，卻靠著一整套圖說，讓74組刺繡文物在馬德里精準掛上牆、擺進櫃子裡，一組尺寸都沒有錯。</p>";
const relatedProjects = [{"href": "./project-marine-illusion", "label": "眼見為憑？"}, {"href": "./project-offshore-wind", "label": "離岸風電運維中心"}, {"href": "./project-westernmost-point", "label": "臺灣極西點"}];
const nextHref = "./project-serialization-anniversary";
const images = [{"src": "../images/la-fortuna-bordada-exhibition-banner-museo-entrance-letsuan-design.jpg", "alt": "西班牙國立裝飾藝術博物館入口的臺灣刺繡展布條"}, {"src": "../images/la-fortuna-bordada-gallery-display-cases-embroidered-accessories-letsuan-design.jpg", "alt": "展廳陳列刺繡配件的展示櫃"}, {"src": "../images/la-fortuna-bordada-gallery-corridor-embroidered-garment-panels-letsuan-design.jpg", "alt": "展覽廊道陳列刺繡服飾展板"}, {"src": "../images/la-fortuna-bordada-display-case-embroidered-headwear-accessories-letsuan-design.jpg", "alt": "展示櫃陳列刺繡頭飾與配件"}, {"src": "../images/la-fortuna-bordada-framed-embroidery-panels-through-archway-letsuan-design.jpg", "alt": "透過拱門望見裱框刺繡展板"}, {"src": "../images/la-fortuna-bordada-curators-inspecting-embroidered-artifacts-letsuan-design.jpg", "alt": "策展人員檢視展櫃中的刺繡文物"}, {"src": "../images/la-fortuna-bordada-exhibition-wall-embroidered-panels-letsuan-design.jpg", "alt": "展牆陳列成排刺繡展板"}, {"src": "../images/la-fortuna-bordada-wall-framed-rank-badge-embroidery-letsuan-design.jpg", "alt": "展牆陳列裱框官階徽章刺繡，搭配說明文字"}];
---

<ProjectLayout
  title={title}
  description={description}
