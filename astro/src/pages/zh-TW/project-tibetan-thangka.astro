---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "麗荃室內裝修 | 移動寺廟";
const description = "移動寺廟 — 青海熱貢唐卡展";
const canonical = "https://letsuan.com/zh-TW/project-tibetan-thangka";
const ogImage = "https://letsuan.com/images/tibetan-thangka-art-exhibition-01-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-tibetan-thangka" },
  { hreflang: "zh-TW", href: canonical },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "移動寺廟", "description": "移動寺廟 — 青海熱貢唐卡展", "url": "https://letsuan.com/zh-TW/project-tibetan-thangka", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/tibetan-thangka-art-exhibition-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2015", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "移動寺廟", "item": "https://letsuan.com/zh-TW/project-tibetan-thangka"}]}];
const eyebrowLeft = "展覽 — 2015";
const eyebrowRight = "中正紀念堂";
const h1Main = "移動寺廟";
const h1Sub = "青海熱貢唐卡展";
const metaFields = [{"label": "業主", "value": "蒙藏委員會"}, {"label": "地點", "value": "臺北，臺灣"}, {"label": "年份", "value": "2015"}, {"label": "類別", "value": "展覽設計、室內設計、平面設計、標誌設計、工程施作"}];
const bodyHtml = "<h2>在一條開放通道裡，蓋出一座莊嚴的精神空間</h2>\n<p>唐卡在藏語中意指以絲綢裝裱、可捲收的卷軸畫，起源久遠，寓意精妙，蘊含藏傳文化獨特的宗教內涵。我們負責「移動寺廟－青海熱貢唐卡展」於國立中正紀念堂場次的展場工程執行，把源自中國青海熱貢地區的唐卡文物，在采玉藝廊的展覽空間裡完成陳列與影像系統整合。「移動寺廟」這個命名意象，取自熱貢唐卡文化中隨信仰流動、跨越地域傳播的精神，我們的任務，就是在展場之中，重建一處能讓觀者駐足、感受到信仰場域氛圍的精神空間。</p>\n<h2>采玉藝廊不是獨立展廳，人潮隨時能走到文物面前</h2>\n<p>這是這個案子最根本的限制：采玉藝廊是開放式動線空間，不是獨立展廳，人流可以直接接近展件。唐卡是絹本、布本繪畫類文物，質地脆弱，容易受碰觸與環境因素影響–我們針對全數展件施作高透度壓克力完整包覆，在不影響觀展視覺與畫作色彩呈現的前提下，達成實體防護，把人為碰觸與環境變化對文物的風險降到最低。</p>\n<h2>幾公尺寬的唐卡，得靠自己的張力立在那裡</h2>\n<p>展件裡有多幅尺幅可達數公尺寬的大型唐卡橫幅，我們採用懸吊式展示工法，在天花軌道系統上規劃懸掛點位與張力控制，確保絹本、布本文物能平整展開，不會被自身重量往下拉扯變形。展場面積有限，要在既有空間條件下，同時容納唐卡實體展件、動線引導與影像播放區域，我們精算了展件間距、觀展動線與人流節奏，避免壓迫感，同時維持宗教藝術應有的莊嚴距離。大幅唐卡橫幅、裝框直幅唐卡，以及記錄熱貢當地藝師與居民生活樣貌的紀實攝影，三種展件形式也在動線上分區配置，兼顧視覺節奏與文物保護距離。</p>\n<p>因應場館空間條件與文物懸掛需求，我們在既有場地內搭建專用的可拆卸式展示隔間牆面，供懸吊軌道、燈具與展件固定使用，展畢後能完整拆除復原，不影響原建築結構。作為中正紀念堂采玉藝廊的短期特展工程，整體施工也配合了場館既有的建築條件、動線規範與展期時程，在有限工期與空間條件下，完成了這場展覽的陳列與設備安裝。</p>";
const relatedProjects = [{"href": "./project-detention-pier2", "label": "返校"}, {"href": "./project-detective-conan-taipei", "label": "名偵探柯南科學搜查展"}, {"href": "./project-tccge-deck", "label": "綠能教育觀景平台"}];
const nextHref = "./project-asian-art-biennial";
const images = [{"src": "../images/tibetan-thangka-visitor-viewing-scroll-row-white-gallery-letsuan-design.jpg", "alt": "Traveling Temple — Visitor viewing a row of hanging Tibetan thangka scrolls along the white gallery wall"}, {"src": "../images/tibetan-thangka-art-exhibition-01-letsuan-design.jpg", "alt": "Framed Tibetan thangka paintings hung along the exhibition corridor at Cai Yu Art Gallery"}, {"src": "../images/tibetan-thangka-art-exhibition-02-letsuan-design.jpg", "alt": "Large horizontal thangka mural depicting an assembly of Buddhist deities, mounted in the gallery corridor"}, {"src": "../images/tibetan-thangka-art-exhibition-03-letsuan-design.jpg", "alt": "Installation team hanging thangka pieces from the overhead suspension track during construction"}, {"src": "../images/tibetan-thangka-art-exhibition-04-letsuan-design.jpg", "alt": "Construction progress: the team reviews the corridor layout, assembles display panels, and secures a thangka frame with a drill"}, {"src": "../images/tibetan-thangka-art-exhibition-05-letsuan-design.jpg", "alt": "Finished gallery corridor with large thangka murals on display, visitors viewing in the background"}, {"src": "../images/tibetan-thangka-art-exhibition-06-letsuan-design.jpg", "alt": "Documentary photographs of Rebgong thangka artists and residents, including a mother and child and an artist painting a thangka"}];
---

