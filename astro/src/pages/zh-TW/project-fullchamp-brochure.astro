---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "麗荃室內裝修 | Fullchamp";
const description = "Fullchamp — 型錄設計";
const canonical = "https://letsuan.com/zh-TW/project-fullchamp-brochure";
const ogImage = "https://letsuan.com/images/fullchamp-brochure-fullchamp-forged-metal-solutions-brochure-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-fullchamp-brochure" },
  { hreflang: "zh-TW", href: canonical },
  { hreflang: "x-default", href: "https://letsuan.com/project-fullchamp-brochure" },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Fullchamp", "description": "Fullchamp — 型錄設計", "url": "https://letsuan.com/zh-TW/project-fullchamp-brochure", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/fullchamp-brochure-fullchamp-forged-metal-solutions-brochure-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2010", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Fullchamp", "item": "https://letsuan.com/zh-TW/project-fullchamp-brochure"}]}];
const eyebrowLeft = "平面設計 — 2010";
const eyebrowRight = "臺灣";
const h1Main = "Fullchamp";
const h1Sub = "型錄設計";
const metaFields = [{"label": "業主", "value": "Fullchamp"}, {"label": "地點", "value": ""}, {"label": "年份", "value": "2010"}, {"label": "類別", "value": "平面設計、視覺設計、字體設計"}];
const bodyHtml = "<p>Fullchamp 品牌識別與公司型錄設計。從標誌系統到印刷品視覺，建立一致的企業形象語彙，讓品牌在商務溝通與對外形象上有清晰可辨的識別度。</p>";
const relatedProjects = [{"href": "./project-just-only-environment", "label": "Just Only"}, {"href": "./project-amazing-homeland", "label": "原鄉驚艷"}, {"href": "./project-art-gallery-culture", "label": "看見文化部"}];
const nextHref = "./project-dragon-to-beast";
const images = [{"src": "../images/fullchamp-brochure-fullchamp-forged-metal-solutions-brochure-letsuan-design.jpg", "alt": "富春鍛造金屬解決方案型錄封面，搭配卡車意象"}, {"src": "../images/fullchamp-brochure-brochure-spread-showing-12000-ton-metal-letsuan-design.jpg", "alt": "型錄跨頁展示12,000噸鍛壓機設備"}, {"src": "../images/fullchamp-brochure-brochure-spread-with-quality-guarantee-letsuan-design.jpg", "alt": "型錄跨頁展示品質保證與鍛造流程機器人意象"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
  lang="zh-TW"
  alternateHrefs={alternateHrefs}
  closeLabel="關閉"
  backLabel="回作品集"
  nextLabel="下一個專案"
  homeLabel="首頁"
  relatedLabel="相關專案"
  detailLabel="專案詳情"
/>