const description = "永恆聖母院 — VR沉浸式體驗展臺灣首度亮相";
const canonical = "https://letsuan.com/zh-TW/project-notre-dame";
const ogImage = "https://letsuan.com/images/notre-dame-vr-group-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-notre-dame" },
  { hreflang: "zh-TW", href: canonical },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "永恆聖母院", "description": "永恆聖母院 — VR沉浸式體驗展臺灣首度亮相", "url": "https://letsuan.com/zh-TW/project-notre-dame", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/notre-dame-vr-group-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2023-2024", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "永恆聖母院", "item": "https://letsuan.com/zh-TW/project-notre-dame"}]}];
const eyebrowLeft = "展覽 — 2023-2024";
const eyebrowRight = "國立科學工藝博物館";
const h1Main = "永恆聖母院";
const h1Sub = "VR沉浸式體驗展臺灣首度亮相";
const metaFields = [{"label": "業主", "value": "宏達國際電子"}, {"label": "地點", "value": "高雄，臺灣"}, {"label": "年份", "value": "2023-2024"}, {"label": "面積", "value": "720.64㎡"}, {"label": "類別", "value": "展覽設計、裝置藝術、互動多媒體、工程施作"}];
const bodyHtml = "<p>：角色／範疇： 依照法方技術團隊提出之需求規格，負責展場空間規劃、施工圖繪製及牆面輸出圖稿完稿，並擔任工程單位執行現場工程需求處理。</p>\n<p>如何在12天內、於一座不可鑽孔的公有場館裡，重建一座69m高的哥德式主教座堂？</p>\n<p>這是我們在《永恆聖母院》一案中面對的真實命題。法國原創、全球矚目的沉浸式VR體驗，選擇高雄作為亞洲巡迴首站––但法方技術團隊訂下的規格，與臺灣公有展館的現實條件之間，存在著一連串近乎矛盾的限制：牆面不可固著、高空燈具不可鎖固、卸貨電梯須與其他展場共用、施工期間颱風來襲、工期僅有12天。每一項限制，都是一道必須在不違背原始建築、不影響VR系統精準度的前提下解開的工程難題。這篇案例記錄的，不只是「我們完成了什麼」，而是「我們如何把限制轉化為可複製的工法」。</p>\n<h2>12天 場地交接至完工 ｜ 720.64㎡ 展場總面積 ｜ 500m 弧形立面輸出 ｜ 6米／10米 牆體與燈具作業高度 ｜ 100+ VR設備同時運作 ｜ 5% 光線亮暗值容許差</h2>\n<h2>展覽簡介</h2>\n<p>2019年巴黎聖母院大火之後，數位科技挺身而出：虛擬實境如今讓觀眾得以走入這座主教座堂，在修復工程持續進行、民眾無法親臨現場之際，親身感受其壯麗風貌。《永恆聖母院》是一段可自由漫遊的VR之旅––訪客創建自己的虛擬化身，與其他探索者相遇，並近距離細賞最後審判之門、祭壇、拱頂、玫瑰花窗與大型管風琴。這場結合科技成就與跨越時空之旅的45分鐘沉浸式VR體驗，將訪客帶入巴黎聖母院的核心。觀眾將如親臨現場般體驗這座地標建築及其珍稀文物，充分感受其宏偉之美、豐富色彩，以及哥德式建築的精湛工藝。體驗最終將以電梯登上69m高的鐘樓作結，讓訪客沉浸於鐘聲的共鳴之中，隨後步出戶外，眺望維克多・雨果筆下的巴黎。此計畫由Orange電信、巴黎教區與負責主教座堂修復工程的機構共同合作，由Excurio攜手HTC VIVE與VIVE Arts製作，2022年1月於巴黎首映即獲廣大好評，其後於高雄國立科學工藝博物館展開臺灣首度亮相。</p>\n<p>展覽性質特殊，觀眾需配戴VR設備於展場內實際走動體驗，因此現場的網路、空間定位、地坪、牆體、光線等基礎工程條件，皆須配合國際技術團隊訂定的規格逐項到位––任何一項失準，都可能讓VR系統定位失效、體驗中斷。我們依照法方技術團隊提出之需求規格，負責展場空間規劃、繪製施工圖，並完成牆面輸出圖稿完稿，同時擔任工程單位，將展場既有空間改造為符合VR體驗系統運作需求的現地環境。</p>\n<h2>限制，成為方法論</h2>\n<p>牆體不可固著，逼出一套非破壞性支撐工法：展廳牆面高達6米，原始建築結構規範不可鑽孔、鎖固；現場空間亦有限，無法預留施工通道，作業須儘量貼近牆面進行。我們因應此雙重限制，改採非破壞性立架與支撐工法完成遮光、隔間與設備支撐架構，於不損及原建築體的前提下完成空間區劃––完工後經館方現場勘驗確認，牆體及結構表面未有鑽孔、鎖固痕跡。這套工法後續亦可延伸應用於其他歷史場館或不可施工的公有建築案件。</p>\n<p>10米高空、不可破壞防火材，燈具改用「吊」而非「鎖」：燈具須設置於10m高的鋼構樑上，樑體不得鎖固，且鋼構表面已施作防火發泡棉，不可破壞其完整性。我們採用不破壞鋼構及防火材的吊掛工法完成高空燈具設置，於高空作業安全與結構保護間取得平衡；完工後確認鋼構及防火發泡棉表面未有破壞或受損。</p>\n<p>500m弧形立面，容不下一絲接縫：展場周邊弧形立面總長約500m、高600公分，我們依法方提供之圖像素材進行輸出圖稿繪製與完稿，並執行現場張貼施作。因應曲面弧度及超長幅面特性，圖稿繪製與現場施工皆須精準對位，尤其頭尾銜接處須做到無縫精準相接；完工後逐段比對圖像連續性，頭尾銜接處未見明顯接縫或錯位。</p>\n<p>光線容許差5%，決定VR系統成敗：VR頭戴顯示設備及場域感應器對環境光線極為敏感，全區720.64㎡展場須維持光線均勻，亮暗值差異不得超過5%，否則將直接影響VR頭盔的場域辨識精準度。我們同時需兼顧觀眾入場前置作業（置物、穿戴設備）所需的基本照明，在暗場條件與動線安全間取得平衡；完工後以照度計進行全區量測，數值控制於規範範圍內。</p>\n<p>消防通道與VR辨識的兩難：隔間牆面須設置活動門直通消防通道，但門片五金材質若產生反光或訊號干擾，將影響VR系統定位。我們在兩項互斥需求間找出兼容方案，完工後會同消防單位檢視逃生動線，並於VR系統測試中確認門片五金未觀察到訊號干擾。</p>\n<p>100+組設備同時充電，電力零跳電：展覽採頭戴顯示器搭配背包電腦的穿戴式體驗形式，設備總數超過100組，須同時輪替充電。我們逐一精算每組設備充電所需電力，加總換算總用電負載，據此規劃足量迴路與插座配置；完工後於尖峰時段觀察全區用電狀況，未發生跳電情形。</p>\n<p>共用電梯、颱風天，仍要12天交卷：材料與設備運送須使用與其他展場共用之電梯，無法獨立調度；施工期間更適逢卡努颱風來襲，高雄地區停止上班上課，進度一度受影響。我們事前與館方協調搬運時段表，並於颱風後與館方工務協調趕工排程，最終仍於原訂總工期內完成開展前置作業。全案自場地交接至完工，僅耗時12天，屬高強度時間壓縮下的工程專案。</p>\n<p>地震帶上的非固著結構：臺灣位處地震帶，展場內非固著式立架、支撐結構及懸吊燈具等設施，須於設計及施作階段一併考量地震時的穩定性與安全係數，相關結構設計均依建築法規之抗震安全係數要求進行評估規劃。</p>\n<h2>跨單位協調與驗收</h2>\n<p>本案施工期間，我們與多方單位進行現場協調與確認：與法方技術團隊（Excurio、HTC VIVE）確認VR系統定位與環境條件規格；與館方工務單位協調電梯調度、施工通道限制及結構保護事項；與消防單位會同檢視活動門與逃生動線配置。透過跨單位的即時溝通與現場確認，各項工程項目得以在符合多方規範要求的前提下完成。</p>\n<p>在不可鑽孔的牆、不可鎖固的樑、共用的電梯與颱風打亂的工期之間，我們在12天內把一座巴黎主教座堂的重量，安放進高雄的展廳裡。展覽得以在符合國際技術團隊規格要求的前提下，於高雄順利完成亞洲巡迴首站的展出。</p>";
const relatedProjects = [{"href": "./project-led-kinetic", "label": "宇宙"}, {"href": "./project-green-energy", "label": "陽光、風、地熱，在一座展館裡相遇"}, {"href": "./project-beyond-just-an-exhibition", "label": "不只是展覽––你就是藝術的一部分！"}];
