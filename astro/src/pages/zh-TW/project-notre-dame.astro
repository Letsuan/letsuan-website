const images = [{"src": "../images/notre-dame-vr-group-letsuan-design.jpg", "alt": "Eternal Notre-Dame — Four visitors wearing VR headsets and backpacks standing in front of a bold black-and-white graphic mural"}, {"src": "../images/notre-dame-headsets-array-letsuan-design.jpg", "alt": "Rows of VR headsets lined up backstage ready for visitors"}, {"src": "../images/notre-dame-vr-users-letsuan-design.jpg", "alt": "Staff adjusting a visitor's VR headset strap while other visitors wear headsets nearby"}, {"src": "../images/notre-dame-rooftop-vr-letsuan-design.jpg", "alt": "VR scene showing visitors virtually kneeling on Notre-Dame cathedral's rooftop overlooking the Paris skyline"}, {"src": "../images/eternal-notre-dame-vr-exhibition-2023-letsuan-design.jpg", "alt": "Visitors wearing VR headsets standing on a patterned floor beneath a bold black-and-white graphic mural"}, {"src": "../images/notre-dame-profile-line-letsuan-design.jpg", "alt": "Three visitors in profile wearing VR headsets and backpacks against a black-and-white graphic mural"}, {"src": "../images/notre-dame-construction-letsuan-design.jpg", "alt": "Installation in progress: workers on scissor lifts painting the black-and-white graphic mural wall"}, {"src": "../images/notre-dame-mural-install-letsuan-design.jpg", "alt": "Installation in progress: crew painting the large geometric mural using scissor lifts and ladders"}];
