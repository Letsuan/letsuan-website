---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/zh-TW/Nav.astro';
import Footer from '../../components/zh-TW/Footer.astro';
import CornerFrame from '../../components/CornerFrame.astro';
import { organizationJsonLd } from '../../data/organization';
import { avifPath } from '../../utils/images';

const title = '麗荃室內裝修 | 關於我們';
const description = '麗荃室內裝修是一間位於臺灣臺中的設計工作室，專注室內設計、展覽設計、視覺設計與工程建造。';
const canonical = 'https://letsuan.com/zh-TW/about';
const alternateHrefs = [
  { hreflang: 'en', href: 'https://letsuan.com/about' },
  { hreflang: 'zh-TW', href: canonical },
  { hreflang: 'x-default', href: 'https://letsuan.com/about' },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://letsuan.com/zh-TW/about#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://letsuan.com/#website' },
      about: { '@id': 'https://letsuan.com/#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://letsuan.com/zh-TW/' },
        { '@type': 'ListItem', position: 2, name: '關於我們', item: canonical },
      ],
    },
  ],
};

const faqs = [
  { q: '麗荃室內裝修專精哪些領域？', a: '麗荃室內裝修是一間持照的室內、展覽與視覺設計工作室，位於臺灣臺中與臺北，專精博物館等級的展覽、商業室內空間、視覺識別系統與統包工程。' },
  { q: '麗荃室內裝修是什麼時候成立的？', a: '工作室成立於 2014 年，已為博物館、政府機關與國際品牌完成超過 42 件專案。' },
  { q: '麗荃室內裝修是否同時負責設計與施工？', a: '是的，專案從設計到施工不會轉手，同一團隊從第一張草圖到最終安裝全程參與。' },
  { q: '麗荃室內裝修是合法登記的室內裝修業者嗎？', a: '是的，我們持有室內裝修從業者登記字號 40E2007328，並代客戶處理專業裝修許可申請與審查送件。' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const stats = [
  { value: '42+', label: '已交付專案', desc: '博物館、政府機關與遍及全臺的國際品牌。' },
  { value: '2014', label: '工作室成立', desc: '十年以敘事為核心的設計經驗，根植臺中與臺北。' },
  { value: 'TW', label: '臺中・臺北', desc: '立足臺灣，服務遍及全臺。' },
  { value: '17,000+ m²', label: '已交付空間面積', desc: '在自有工地管理下按部就班完工，專業工項皆直接監督。' },
];

const services = [
  { title: '策展服務', desc: '一場好的展覽，不只是把物件擺出來而已。我們從概念發展、內容研究到敘事腳本，為每一檔展覽打好策展框架，讓博物館或品牌在開幕當天就有一場真正站得住腳的展覽。', img: '/images/air-force-academy-eagle-sculpture-installation-with-archway-letsuan-design.jpg', alt: 'R.O.C. Air Force Academy 90th Founding Anniversary — Eagle sculpture installation with archway feature wall', evidenceHref: './project-air-force-academy', evidenceLabel: '九十年的天空，值得被好好述說' },
  { title: '展覽設計', desc: '一場展覽成不成功，取決於它如何引導訪客走過整個空間。我們把敘事、燈光與互動裝置當作同一套系統來設計，而不是各自獨立的廠商拼湊而成。', img: '/images/cat-art-dream-painting-cat-parody-with-visitor-letsuan-design.jpg', imgPosition: 'center 40%', alt: "Cat Art Museum — Visitor viewing a gold-framed cat parody reinterpretation of Picasso's The Dream painting", evidenceHref: './project-cat-art', evidenceLabel: '貓美術館' },
  { title: '室內設計', desc: '商業與機構空間每天都有真實的人在裡面移動、使用，這正是我們設計時的出發點。身為持照室內裝修業者，我們會先規劃動線與空間配置，再處理裝修與材質。', img: '/images/securities-company-office-design-02-letsuan-design.jpg', alt: 'Securities Company Office waiting area', evidenceHref: './project-securities-office', evidenceLabel: '證券公司辦公室' },
  { title: '視覺設計', desc: '品牌形象要能貫徹始終，從入口招牌到第六面指標，都得維持一致的樣貌。我們把識別系統、標示與環境圖像整合成同一套設計。', img: '/images/westernmost-point-taiwan-01-letsuan-design.jpg', alt: 'The Westernmost Point of Taiwan — Westernmost Point of Taiwan entrance', evidenceHref: './project-westernmost-point', evidenceLabel: '臺灣極西點' },
  { title: '工程建造', desc: '設計與工程一旦分屬不同公司，出狀況時往往互踢皮球。我們維持同一個團隊：自有的製作工廠與工地管理直接負責施作，專業工班則在我們的監督下進場作業。', img: '/images/engineering-construction-circular-exhibition-hall-with-central-planter-letsuan-design.jpg', alt: 'Disaster Prevention Hall — Circular exhibition hall with central planter and panel walls', evidenceHref: './project-engineering-construction', evidenceLabel: '防災教育館' },
];
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, pageJsonLd, faqJsonLd]} lang="zh-TW" alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="about" enHref="/about" />

    <div class="ltsuan-about-main">
      <section id="hero">
        <div class="ltsuan-reveal ltsuan-hero-block">
          <h1 class="ltsuan-hero-h1">空間與故事，<br />出自同一雙手。</h1>
          <p class="ltsuan-hero-sub">位於臺灣臺中與臺北的室內、展覽與視覺設計工作室——自 2014 年起服務博物館、政府機關與國際品牌。</p>
          <a href="./portfolio" class="ltsuan-badge">查看<br />作品集</a>
        </div>

        <div class="ltsuan-hero-media">
          <picture>
            <source srcset={avifPath('/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg')} type="image/avif" />
            <img
              src="/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg"
              alt="Visitors exploring the Masters of Marine Illusion exhibition at Taichung Aquarium, an interior and exhibition design project by Letsuan Design"
              class="ltsuan-hero-img"
            />
          </picture>
          <CornerFrame size={16} />
        </div>
        <div style="height:40px"></div>
      </section>

      <section id="studio">
        <div class="ltsuan-reveal ltsuan-studio-copy">
          <div class="ltsuan-eyebrow">工作室介紹</div>
          <p class="ltsuan-body-copy">麗荃室內裝修是一間持照的室內、展覽與視覺設計工作室，位於臺灣臺中與臺北，自 2014 年起交付博物館等級的展覽與商業室內空間。我們的服務範圍涵蓋博物館、水族館、文化場館、企業空間與公共裝置，只要是需要傳達訊息的實體空間，都是我們的專業領域。</p>
          <p class="ltsuan-body-copy">我們的團隊能自在地在敘事設計、空間規劃、視覺系統與現場施工之間切換，讓我們能從第一張草圖到最終安裝全程參與，確保每個細節都服務於同一個核心概念。</p>
          <p class="ltsuan-body-copy">我們會依專案規模調整團隊組成，視個別基地與法規需求，納入持照建築師、消防技師、土木技師與品管人員。</p>
          <p class="ltsuan-body-copy ltsuan-body-copy-last">專案從設計到施工，不會轉手。</p>
        </div>
      </section>

      <section id="record">
        <div class="ltsuan-reveal ltsuan-stats-grid">
          {stats.map((st) => (
            <div class="ltsuan-stat-card">
              <CornerFrame size={10} opacity={0.55} />
              <div class="ltsuan-stat-value">{st.value}</div>
              <div class="ltsuan-stat-label">{st.label}</div>
              <p class="ltsuan-stat-desc">{st.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="sustainability-clients">
        <div class="ltsuan-reveal ltsuan-split">
          <div>
            <div class="ltsuan-eyebrow">永續</div>
            <div class="ltsuan-sustain-img-wrap">
              <picture>
                <source srcset={avifPath('/images/green-energy-vision-pavilion-01-letsuan-design.jpg')} type="image/avif" />
                <img src="/images/green-energy-vision-pavilion-01-letsuan-design.jpg" alt="Green Energy Vision pavilion, an interior design project by Letsuan Design demonstrating non-invasive sustainable construction" class="ltsuan-sustain-img" />
              </picture>
              <CornerFrame size={14} />
            </div>
            <p class="ltsuan-body-copy-70">永續精神貫穿我們的施工方式：以零損傷結構系統保護古蹟場域與歷史構造。</p>
            <p class="ltsuan-body-copy-70">我們的綠建材使用率符合現行法規最低 60% 的要求，在環境責任與業主成本間取得平衡。</p>
            <p class="ltsuan-body-copy-70 ltsuan-body-copy-last">身為持照室內裝修業者，我們對協力廠商要求的法規與安全標準，與我們對自己的要求完全一致。</p>
          </div>

          <div>
            <div class="ltsuan-eyebrow ltsuan-eyebrow-dim">合作客戶</div>
            <div class="ltsuan-client-imgs">
              <div class="ltsuan-client-img-wrap">
                <picture>
                  <source srcset={avifPath('/images/hakka-culture-gallery-corridor-with-tree-branch-display-letsuan-design.jpg')} type="image/avif" />
                  <img src="/images/hakka-culture-gallery-corridor-with-tree-branch-display-letsuan-design.jpg" alt="Gallery corridor at a Hakka culture exhibition, an exhibition design project by Letsuan Design" class="ltsuan-client-img" />
                </picture>
                <CornerFrame size={12} />
              </div>
              <div class="ltsuan-client-img-wrap">
                <picture>
                  <source srcset={avifPath('/images/asian-art-biennial-02-letsuan-design.jpg')} type="image/avif" />
                  <img src="/images/asian-art-biennial-02-letsuan-design.jpg" alt="Asian Art Biennial installation, an exhibition design project by Letsuan Design" class="ltsuan-client-img" />
                </picture>
                <CornerFrame size={12} />
              </div>
            </div>
            <p class="ltsuan-body-copy-70">我們已與 7 個以上的政府機關及公共機構合作。</p>
            <p class="ltsuan-client-list">國立自然科學博物館・國立歷史博物館・國立臺灣美術館・文化部・空軍軍官學校・Ørsted・TSMC・HTC・FedEx・東映・小學館・永豐金證券</p>
            <a href="./portfolio" class="ltsuan-see-work-link">查看我們與他們的合作案例 →</a>
            <p class="ltsuan-license-note">持照室內裝修業者（登記字號 40E2007328）。我們代客戶處理專業裝修許可申請與審查送件。</p>
          </div>
        </div>
      </section>

      <section id="services">
        <div class="ltsuan-reveal ltsuan-services-head">
          <h2 class="ltsuan-section-h2">服務項目</h2>
          <div class="ltsuan-section-counter">01&nbsp;/&nbsp;05</div>
        </div>
        <div class="ltsuan-services-grid">
          {services.map((svc) => (
            <div class="ltsuan-svc-card">
              <CornerFrame size={10} opacity={0.55} />
              <div class="ltsuan-svc-img-wrap">
                <picture>
                  <source srcset={avifPath(svc.img)} type="image/avif" />
                  <img alt={svc.alt} src={svc.img} style={`object-position:${svc.imgPosition || 'center'}`} class="ltsuan-svc-img" loading="lazy" decoding="async" />
                </picture>
              </div>
              <h3 class="ltsuan-svc-title">{svc.title}</h3>
              <p class="ltsuan-svc-desc">{svc.desc}</p>
              <a href={svc.evidenceHref} class="ltsuan-svc-evidence">{svc.evidenceLabel} →</a>
            </div>
          ))}
        </div>
      </section>

      <section id="faq">
        <div class="ltsuan-reveal">
          <h2 class="ltsuan-section-h2 ltsuan-faq-title">常見問題</h2>
          <div class="ltsuan-faq-list">
            {faqs.map((f) => (
              <div class="ltsuan-faq-item">
                <h3 class="ltsuan-faq-q">{f.q}</h3>
                <p class="ltsuan-faq-a">{f.a}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <Footer background="#0B1526" />
    </div>
  </div>
</Layout>

<script>
  import '../../scripts/reveal';
</script>

<style is:global>
  :root {
    --ltsuan-bg: #0b1526;
    --ltsuan-panel: #101b33;
    --ltsuan-accent: #8ec31f;
    --ltsuan-accent-hover: #a8dc4a;
    --ltsuan-line: rgba(244, 239, 232, 0.12);
    --ltsuan-dim: rgba(244, 239, 232, 0.6);
    --ltsuan-blueprint: #c9d6e8;
  }
</style>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
    position: relative;
  }
  #hero {
    padding: 110px 60px 0 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-hero-block {
    position: relative;
    max-width: 900px;
    margin-bottom: 36px;
  }
  .ltsuan-hero-h1 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(36px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
  }
  .ltsuan-hero-sub {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.5;
    color: var(--ltsuan-dim);
    margin: 0;
    max-width: 46ch;
  }
  .ltsuan-badge {
    position: absolute;
    top: 0;
    right: 0;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 1px solid var(--ltsuan-line);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ltsuan-text);
    text-decoration: none;
  }
  .ltsuan-hero-media {
    position: relative;
    overflow: hidden;
    height: clamp(280px, 36vw, 460px);
  }
  .ltsuan-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.88) saturate(1.08);
  }
  #studio {
    padding: 24px 60px 44px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-studio-copy {
    max-width: 640px;
  }
  .ltsuan-eyebrow {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.15em;
    color: var(--ltsuan-accent);
    margin-bottom: 10px;
  }
  .ltsuan-eyebrow-dim {
    color: var(--ltsuan-dim);
  }
  .ltsuan-body-copy {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.75);
    margin: 0 0 10px;
  }
  .ltsuan-body-copy-70 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.7);
    margin: 0 0 10px;
  }
  .ltsuan-body-copy-last {
    margin-bottom: 0;
  }
  #record {
    padding: 36px 60px 44px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-stats-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 900px) {
    .ltsuan-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .ltsuan-stats-grid {
      grid-template-columns: 1fr;
    }
  }
  .ltsuan-stat-card {
    position: relative;
    background: var(--ltsuan-panel);
    padding: 16px;
  }
  .ltsuan-stat-value {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3vw, 38px);
    color: var(--ltsuan-accent);
    margin-bottom: 6px;
  }
  .ltsuan-stat-label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    color: var(--ltsuan-text);
    margin-bottom: 6px;
  }
  .ltsuan-stat-desc {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(244, 239, 232, 0.55);
    margin: 0;
  }
  #sustainability-clients {
    padding: 64px 60px 56px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
  }
  @media (max-width: 640px) {
    .ltsuan-split {
      grid-template-columns: 1fr !important;
    }
    .ltsuan-badge {
      position: static !important;
      margin: 20px 0 0 !important;
    }
    #sustainability-clients,
    #hero,
    #studio,
    #record,
    #services {
      padding-left: 24px !important;
      padding-right: 24px !important;
    }
  }
  .ltsuan-sustain-img-wrap {
    position: relative;
    overflow: hidden;
    height: 160px;
    margin-bottom: 18px;
  }
  .ltsuan-sustain-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.85) saturate(1.1);
  }
  .ltsuan-client-imgs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 18px;
  }
  .ltsuan-client-img-wrap {
    position: relative;
    overflow: hidden;
    height: 160px;
  }
  .ltsuan-client-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.85) saturate(1.1);
  }
  .ltsuan-client-list {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    line-height: 1.9;
    color: rgba(244, 239, 232, 0.6);
    margin: 0 0 14px;
  }
  .ltsuan-see-work-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 14px;
    color: var(--ltsuan-accent);
    text-decoration: none;
  }
  .ltsuan-license-note {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ltsuan-dim);
    margin: 14px 0 0;
  }
  #services {
    padding: 64px 60px 70px 79px;
    background: var(--ltsuan-panel);
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-services-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 36px;
  }
  .ltsuan-section-h2 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 42px);
    margin: 0;
  }
  .ltsuan-section-counter {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--ltsuan-dim);
  }
  .ltsuan-services-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .ltsuan-svc-card {
    position: relative;
