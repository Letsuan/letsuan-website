---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/zh-TW/Nav.astro';
import { organizationJsonLd } from '../../data/organization';
import { avifPath } from '../../utils/images';

const title = '麗荃室內裝修 | 關於我們';
const description = '麗荃室內裝修是一間位於臺灣臺中的設計工作室，專注室內設計、展覽設計、視覺設計與工程建造。';
const canonical = 'https://letsuan.com/zh-TW/about';
const alternateHrefs = [
  { hreflang: 'en', href: 'https://letsuan.com/about' },
  { hreflang: 'zh-TW', href: canonical },
  { hreflang: 'x-default', href: 'https://letsuan.com/about' },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const stats = [
  { value: '42+', label: '已交付專案', desc: '博物館、政府機關與遍及全臺的國際品牌。' },
  { value: '2014', label: '公司成立', desc: '十年以敘事為核心的設計經驗，根植臺中與臺北。' },
  { value: 'TW', label: '臺中・臺北', desc: '立足臺灣，服務遍及全臺。' },
  { value: '17,000+ m²', label: '已交付空間面積', desc: '在自有工地管理下按部就班完工，專業工項皆直接監督。' },
];

function splitParagraph(text: string) {
  const m = text.match(/^(第[一二三]|此外)([，,])/);
  if (!m) return { marker: null as string | null, rest: text };
  return { marker: m[1], rest: text.slice(m[0].length) };
}

const esgItems = [
  {
    num: '01',
    en: 'ENVIRONMENT',
    zh: '環境',
    enLabel: 'Environmental',
    title: '為場域的長期健康而施工',
    labels: { 1: '零損傷結構系統', 2: '綠建材與節能工法', 3: '資源再利用與減廢' } as Record<number, string>,
    paragraphs: [
      '我們接手的許多場域，本身就是資產。特別是古蹟、歷史建築與老屋，其構造一旦被破壞，就無法回復。因此，比起施工的方便性，我們更優先考量基地與構造物的長期健康。',
      '第一，我們以「零損傷結構系統」為原則。所有設計都從現況測繪與構造盤點開始，透過可逆式工法、非破壞性固定、分散荷重與分區保護，盡可能避免對既有梁柱、磚牆、地坪與歷史痕跡的不可逆傷害。每一處固定點，都必須能被完整復原。',
      '第二，在建材與工法上，我們以現行法規要求的 60% 綠建材使用率為最低門檻，並在此之上持續提升配比。我們優先選用低甲醛、低揮發性有機化合物、可回收再生，以及符合台灣在地生產的健康建材。同時導入節能工法，例如高效率 LED 照明與迴路控制、變頻空調與循環對策、自然採光與通風路徑的重新整理、隔熱與氣密的細節處理，這些節能工法落實在日常使用中，讓住戶與使用者實際感受得到差異。',
      '第三，我們實踐資源的再利用與減廢。從舊料的評估再利用、廢料的分類回收，到施工過程中的粉塵與噪音控制，我們在環境責任與業主成本之間，計算的是生命週期成本，而不是一次性的材料差價，目標是取得可被長期維持的平衡。',
    ],
  },
  {
    num: '02',
    en: 'SOCIAL',
    zh: '社會',
    enLabel: 'Social',
    title: '安全標準，沒有內外之分',
    labels: { 3: '工程保險與保障' } as Record<number, string>,
    paragraphs: [
      '一個工地是否永續，要看最弱勢的人是否被保護。',
      '我們對現場人員的職業安全與協力廠商的勞動條件，負起同等責任。身為持照的室內裝修業者，我們要求協力廠商遵守的法規與安全標準，與我們對自身團隊的要求完全一致，沒有內外之分。',
      '這份標準落實在每日的執行中，包含每日勤前教育與工具箱會議、墜落與感電防護、粉塵與噪音防護、動火與高空作業的申請與監護、承攬商的教育訓練與資格查核。我們同步要求合理的工時、完整的勞健保與勞退、零欠薪與零非法聘僱。這份承諾，延伸到工地上的每一位工作者。',
      '此外，所有大型專案皆額外投保工程安全險，例如：營造綜合保險、雇主意外責任險與第三人意外責任險等等...。這麼做的用意，是讓業主、使用者與現場團隊在意外發生前，就已經處於受完整保障的狀態。',
    ],
  },
  {
    num: '03',
    en: 'GOVERNANCE',
    zh: '治理',
    enLabel: 'Governance',
    title: '讓合規，成為可被追蹤的流程',
    labels: { 1: '資訊公開透明', 2: '專業代辦合規', 3: '流程完整可追蹤' } as Record<number, string>,
    paragraphs: [
      '裝修產業最常見的糾紛，都來自於事前沒說清楚。我們選擇把責任在事前就說清楚。',
      '第一，資訊公開透明。我們主動公開室內裝修業登記字號、公司登記資訊與專業技術人員資格，業主隨時可查驗。',
      '第二，專業代辦合規。我們為業主代辦專業裝修許可申請與審查送件，從圖說製作、結構安全、消防避難、無障礙與分間牆檢討，到送件與現場查驗，全程由我們負責。讓設計的創意，始終在合法的框架內被實現。',
      '第三，流程完整可追蹤。從申請到查驗，所有合規程序、材料證明、施工紀錄、檢驗照片與保固文件，皆完整留存並提供雲端備份，清楚可追蹤。合約、追加減與保固範圍，皆以書面載明，所有承諾都留下可被檢驗的紀錄。',
    ],
  },
];

const esgStepsData = esgItems.map((item) => ({
  id: item.num,
  zh: item.zh,
  en: item.enLabel,
  title: item.title,
  labels: item.labels,
  paragraphs: item.paragraphs,
}));

const faqs = [
  { q: '麗荃室內裝修專精哪些領域？', a: '麗荃室內裝修是一間持照的室內、展覽與視覺設計工作室，位於臺灣臺中與臺北，專精博物館等級的展覽、商業室內空間、視覺識別系統與統包工程。' },
  { q: '麗荃室內裝修是什麼時候成立的？', a: '公司成立於 2014 年，已為博物館、政府機關與國際品牌完成超過 42 件專案。' },
  { q: '麗荃室內裝修是否同時負責設計與施工？', a: '是的，專案從設計到施工不會轉手，同一團隊從草圖階段到完工安裝都親自參與。' },
  { q: '麗荃室內裝修是合法登記的室內裝修業者嗎？', a: '是的，我們持有室內裝修從業者登記字號 40E2007328，並代客戶處理專業裝修許可申請與審查送件。' },
];

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://letsuan.com/zh-TW/about#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://letsuan.com/#website' },
      about: { '@id': 'https://letsuan.com/#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://letsuan.com/zh-TW/' },
        { '@type': 'ListItem', position: 2, name: '關於我們', item: canonical },
      ],
    },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, pageJsonLd, faqJsonLd]} lang="zh-TW" alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="about" enHref="/about" />

    <div class="ltsuan-container">
    <section id="hero">
      <div class="ltsuan-hero-grid">
        <div class="ltsuan-hero-copy">
          <h1 class="ltsuan-h1" data-hero-h1>空間與故事，<br /><span class="ltsuan-h1-accent">出自同一雙手</span>。</h1>
          <p class="ltsuan-lead" data-hero-lead>位於臺灣臺中與臺北的室內、展覽與視覺設計工作室，自 2014 年起服務博物館、政府機關與國際品牌，從草圖發想到現場安裝，全程參與。</p>
        </div>
        <div class="ltsuan-hero-panel">
          <div class="ltsuan-hero-photo">
            <picture>
              <source srcset={avifPath('/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg')} type="image/avif" />
              <img src="/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg" alt="訪客在昏暗藍光展廳中觀看海洋擬態大師導覽螢幕下方的發光水族展示櫃" class="ltsuan-hero-photo-img" />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <section id="record">
      <div class="ltsuan-why-grid">
        <div class="ltsuan-stat">
          <div class="ltsuan-stat-row">
            <div class="ltsuan-stat-num">{stats[0].value}</div>
            <div class="ltsuan-stat-meta">
              <div class="ltsuan-stat-label">PROJECTS</div>
              <div class="ltsuan-stat-rule"></div>
              <div class="ltsuan-stat-sub">已交<br />付專案</div>
            </div>
          </div>
          <p class="ltsuan-stat-caption">EST. 2014 — TAICHUNG &amp; TAIPEI</p>
        </div>
        <div class="ltsuan-why-copy">
          <h2 class="ltsuan-why-h2">公司簡介</h2>
          <div class="ltsuan-why-text">
            <p>麗荃室內裝修是一間持照的室內、展覽與視覺設計工作室，位於臺灣臺中與臺北，自 2014 年起交付博物館等級的展覽與商業室內空間。我們的服務範圍涵蓋博物館、水族館、文化場館、企業空間與公共裝置，只要是需要傳達訊息的實體空間，都是我們的專業領域。</p>
            <p>團隊能自在地在敘事設計、空間規劃、視覺系統與現場施工之間切換，確保每個細節都存在於同一個核心概念。</p>
            <p>依專案規模調整團隊組成，視個別專案需求，納入持照建築師、消防技師、土木技師與品管人員、多媒體程式設計師。</p>
          </div>
          <div class="ltsuan-stats-mini-grid">
            {stats.slice(1).map((st) => (
              <div class="ltsuan-stats-mini-card">
                <div class="ltsuan-stats-mini-value">{st.value}</div>
                <div class="ltsuan-stats-mini-label">{st.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="sustainability">
      <div class="ltsuan-esg-eyebrow">
        <span class="ltsuan-esg-eyebrow-rule"></span>
        <span class="ltsuan-esg-eyebrow-text">ESG / SUSTAINABILITY</span>
      </div>

      <div class="ltsuan-esg-intro-grid">
        <h2 class="ltsuan-esg-h2">永續<br />是系統性的實踐</h2>
        <div class="ltsuan-esg-intro-copy">
          <p class="ltsuan-esg-lead-highlight">我們將永續，定義為 ESG 的系統性實踐，而非僅是選用環保建材。</p>
          <p class="ltsuan-esg-lead-text">在室內裝修產業，永續常被簡化為一張綠建材標章。對我們而言，這遠遠不夠。永續是必須落實在每一個設計決策、材料選擇與工程執行中的基本標準，而非額外選項或加價升級。它關乎場域能否被長久使用，現場的人能否被安全對待，以及業主的權益能否被制度完整保障。</p>
        </div>
      </div>

      <div class="ltsuan-process-tracker" data-esg-tracker>
        <div class="ltsuan-process-line-track"></div>
        <div class="ltsuan-process-line-fill" data-esg-fill></div>
        <div class="ltsuan-process-buttons" data-esg-buttons>
          {esgItems.map((item, i) => (
            <button type="button" class="ltsuan-process-btn" data-step-index={i} aria-current={i === 0 ? 'step' : undefined}>
              <span class="ltsuan-process-ring">
                <span class="ltsuan-process-dot"></span>
              </span>
              <span class="ltsuan-process-btn-zh">{item.zh}</span>
              <span class="ltsuan-process-btn-en">{item.enLabel}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="ltsuan-process-detail">
        <div class="ltsuan-process-detail-inner">
          <div class="ltsuan-process-detail-head">
            <span class="ltsuan-process-detail-id" data-esg-detail-id>{esgItems[0].num}</span>
            <span class="ltsuan-process-detail-rule"></span>
            <span class="ltsuan-process-detail-en" data-esg-detail-en>{esgItems[0].enLabel.toUpperCase()}</span>
          </div>
          <h3 class="ltsuan-esg-detail-title" data-esg-detail-title>{esgItems[0].title}</h3>
          <div class="ltsuan-process-detail-desc" data-esg-detail-desc>
            {esgItems[0].paragraphs.map((p, pi) => {
              const { marker, rest } = splitParagraph(p);
              const label = esgItems[0].labels[pi];
              if (marker && label) {
                return (
                  <div class="ltsuan-esg-point">
                    <div class="ltsuan-esg-point-head">
                      <span class="ltsuan-esg-para-marker">{marker}</span>
                      <span class="ltsuan-esg-point-label">{label}</span>
                    </div>
                    <p>{rest}</p>
                  </div>
                );
              }
              return <p class={pi === 0 ? 'ltsuan-esg-para-lead' : ''}>{p}</p>;
            })}
          </div>
        </div>
      </div>

      <div class="ltsuan-process-mobile">
        <div class="ltsuan-process-mobile-line"></div>
        {esgItems.map((item) => (
          <details class="ltsuan-process-mobile-item">
            <summary>
              <span class="ltsuan-process-mobile-dot"></span>
              <span class="ltsuan-process-mobile-zh">{item.zh}</span>
              <span class="ltsuan-process-mobile-en">{item.enLabel}</span>
            </summary>
            <h4 class="ltsuan-esg-mobile-title">{item.title}</h4>
            {item.paragraphs.map((p, pi) => {
              const { marker, rest } = splitParagraph(p);
              const label = item.labels[pi];
              if (marker && label) {
                return (
                  <div class="ltsuan-esg-point">
                    <div class="ltsuan-esg-point-head">
                      <span class="ltsuan-esg-para-marker">{marker}</span>
                      <span class="ltsuan-esg-point-label">{label}</span>
                    </div>
                    <p>{rest}</p>
                  </div>
                );
              }
              return <p class={pi === 0 ? 'ltsuan-esg-para-lead' : ''}>{p}</p>;
            })}
          </details>
        ))}
      </div>

      <p class="ltsuan-esg-close">對我們而言，永續是風險管理，不是成本。<br />它是對場域的尊重，對人的保護，以及對制度的負責。<br />當這三件事被同時做好，設計才有機會真正長久。</p>
    </section>

    <section id="clients">
      <div class="ltsuan-eyebrow ltsuan-eyebrow-dim">合作客戶</div>
      <p class="ltsuan-split-text">我們與政府機關、公共機構及國際品牌合作。</p>
      <p class="ltsuan-client-list">文化部・交通部觀光署・矯正署・空軍軍官學校・國立自然科學博物館・國立歷史博物館・國立臺灣美術館・國立自然科學工藝館・Ørsted・FedEx・東映・小學館・永豐金證券・興陽能源</p>
      <a href="./portfolio" class="ltsuan-see-work-link"><span>查看我們與他們的合作案例</span><span class="ltsuan-see-work-arrow">↗</span></a>
    </section>

    <section id="faq">
      <div class="ltsuan-process-heading">
        <h2 class="ltsuan-process-h2">常見問題</h2>
      </div>
      <div class="ltsuan-faq-grid">
        {faqs.map((f) => (
          <div class="ltsuan-faq-item">
            <h3 class="ltsuan-faq-q">{f.q}</h3>
            <p class="ltsuan-faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="contact">
      <div class="ltsuan-cta">
        <div class="ltsuan-cta-pill"><span class="ltsuan-cta-dot"></span>NEW PROJECTS FOR 2026 — OPEN</div>
        <h2 class="ltsuan-cta-h2">來聊聊您的<br />下一個想法</h2>
        <p class="ltsuan-cta-copy">無論展覽形式為何，我們的思考起點不變：如何引導觀眾走入敘事，並讓體驗成為被帶走的記憶</p>
        <div class="ltsuan-cta-actions">
          <a href="https://letsuan.com/zh-TW/contact" class="ltsuan-cta-btn">
            <span>info@letsuan.com</span>
            <span class="ltsuan-cta-btn-arrow">↗</span>
          </a>
          <div class="ltsuan-cta-note">我們會在兩個工作天內回覆您</div>
        </div>

        <div class="ltsuan-cta-footer">
          <div class="ltsuan-cta-social">
            <a href="https://www.facebook.com/LETSUANDESIGN" target="_blank" rel="noopener" aria-label="Facebook" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.pinterest.com/Letsuan_Design/" target="_blank" rel="noopener" aria-label="Pinterest" class="ltsuan-cta-social-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#f4efe8"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.194-.332 1.361-.052.219-.173.265-.4.16-1.492-.694-2.424-2.874-2.424-4.625 0-3.767 2.737-7.229 7.892-7.229 4.144 0 7.365 2.953 7.365 6.897 0 4.116-2.595 7.428-6.199 7.428-1.211 0-2.349-.629-2.738-1.373 0 0-.599 2.282-.744 2.84-.269 1.037-.997 2.336-1.484 3.129 1.118.346 2.303.53 3.532.53 6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
