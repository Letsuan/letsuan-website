---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/zh-TW/Nav.astro';
import Footer from '../../components/zh-TW/Footer.astro';
import { organizationJsonLd } from '../../data/organization';

const title = '隱私權政策 | Le Tsuan Design';
const description = '麗荃設計的隱私權政策——說明我們如何蒐集、使用並保護透過官網提交的資訊。';
const canonical = 'https://letsuan.com/zh-TW/privacy-policy';
const ogImage = 'https://letsuan.com/assets/logo.png';
const alternateHrefs = [
  { hreflang: 'en', href: 'https://letsuan.com/privacy-policy' },
  { hreflang: 'zh-TW', href: canonical },
];
const email = 'info@letsuan.com';
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={organizationJsonLd} lang="zh-TW" alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="" enHref="/privacy-policy" />

    <section class="ltsuan-privacy-body">
      <div class="ltsuan-eyebrow">法律聲明</div>
      <h1 class="ltsuan-h1">隱私權政策</h1>

      <div class="ltsuan-copy">
        <p class="ltsuan-updated">最後更新：2026年8月7日</p>

        <h2 class="ltsuan-h2">我們蒐集的資訊</h2>
        <p>當你送出我們的聯絡表單時，我們會蒐集你提供的資訊——姓名、電子郵件、電話號碼、公司名稱、預算範圍與專案細節。除了維持聯絡表單運作所需之外，我們不使用追蹤 Cookie 或第三方分析工具。</p>

        <h2 class="ltsuan-h2">我們如何使用你的資訊</h2>
        <p>我們使用你提交的資訊，僅用於回覆你的詢問並討論可能的合作專案。我們不會將你的資訊出售或提供給第三方作行銷用途。</p>

        <h2 class="ltsuan-h2">第三方服務</h2>
        <p>我們的聯絡表單由第三方表單服務商 Tally（tally.so）提供技術支援。表單內容會透過其平台處理，適用 <a href="https://tally.so/privacy-policy" target="_blank" rel="noopener">Tally 自身的隱私權政策</a>。</p>

        <h2 class="ltsuan-h2">資料保存期限</h2>
        <p>我們僅在回覆詢問及保留過往聯繫紀錄所需的期間內，保存聯絡表單的內容，除非你要求刪除。</p>

        <h2 class="ltsuan-h2">你的權利</h2>
        <p>如需查看、更正或刪除我們所持有關於你的任何個人資訊，請透過 <a href={`mailto:${email}`}>{email}</a> 與我們聯絡。</p>

        <h2 class="ltsuan-h2">聯絡我們</h2>
        <p class="ltsuan-last">若對本政策有任何疑問，歡迎寄信至 <a href={`mailto:${email}`}>{email}</a>。</p>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
  }
  .ltsuan-privacy-body {
    padding: 200px 56px 160px;
    max-width: 760px;
    margin: 0 auto;
  }
  .ltsuan-eyebrow {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--ltsuan-accent);
    margin-bottom: 18px;
  }
  .ltsuan-h1 {
    font-weight: 300;
    font-size: clamp(32px, 5vw, 52px);
    margin: 0 0 40px;
  }
  .ltsuan-copy {
    font-size: 15px;
    line-height: 1.85;
    color: rgba(244, 239, 232, 0.75);
  }
  .ltsuan-updated {
    margin: 0 0 24px;
    font-size: 13px;
    color: rgba(244, 239, 232, 0.6);
  }
  .ltsuan-h2 {
    font-size: 16px;
    font-weight: 400;
    color: var(--ltsuan-text);
    margin: 0 0 12px;
  }
  .ltsuan-copy p {
    margin: 0 0 28px;
  }
  .ltsuan-copy p.ltsuan-last {
    margin: 0;
  }
</style>
