---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/zh-TW/Nav.astro';
import Footer from '../../components/zh-TW/Footer.astro';
import { organizationJsonLd } from '../../data/organization';
import { avifPath } from '../../utils/images';

const title = '麗荃室內裝修 | 我們的做法';
const description = '麗荃室內裝修為何堅持設計施工一體：六大核心服務、五階段流程與八項工程能力，皆由同一團隊從概念到開幕全程負責。';
const canonical = 'https://letsuan.com/zh-TW/what-we-do';
const alternateHrefs = [
  { hreflang: 'en', href: 'https://letsuan.com/what-we-do' },
  { hreflang: 'zh-TW', href: canonical },
  { hreflang: 'x-default', href: 'https://letsuan.com/what-we-do' },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://letsuan.com/zh-TW/what-we-do#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://letsuan.com/#website' },
      about: { '@id': 'https://letsuan.com/#organization' },
    },
    {
      '@type': 'OfferCatalog',
      '@id': 'https://letsuan.com/zh-TW/what-we-do#catalog',
      name: '麗荃室內裝修服務與工程能力',
      provider: { '@id': 'https://letsuan.com/#organization' },
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '策展服務', description: '完整的策展規劃：概念發展、內容研究，以及每一檔展覽的敘事腳本撰寫。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '展覽設計', description: '為博物館與文化場館打造敘事導向的展覽與沉浸式裝置。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '室內設計', description: '依照人們實際的移動與聚集方式規劃的商業與機構室內空間。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '視覺設計', description: '透過識別系統、指標與環境圖像，讓品牌貫穿實體空間。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '工程建造', description: '自有製作團隊與工地管理，將設計從圖面化為實體。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '多媒體互動設計', description: '感應觸發、投影與互動螢幕等多媒體裝置的技術規劃與軟硬體整合。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '古蹟與零損傷工程', description: '為受保護建物與古蹟場域設計的自立式、零穿孔結構系統，在不觸碰原始構造的前提下，承載完整的景觀與機電設備荷重。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'IP 授權展覽執行', description: '依授權方規範執行：角色還原度、官方指定色號與完工品質，皆透過現場直接督導與驗收把關。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '暗展場與影音整合', description: '全暗場處理、分區燈光，結合隱藏式配線與機械傳動的多區感應觸發自動化系統。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '高精度環境控制', description: '針對 VR、影音與互動系統，以嚴謹數值公差打造均勻照度、隔音效果與感應敏感度兼具的環境。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '結構與耐震工程', description: '自立式與懸吊結構自設計階段起，即依當地耐震安全係數進行設計與評估。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '壓縮工期現場管理', description: '分階段跨工種排程與多方協調，在共用通道、天候與法規審查等現實限制下，如期達成固定開幕日。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '製作與廢棄物管理', description: '單元與裝置於工廠製作後運至現場組裝，讓材料與人力全程可追溯，並降低現場廢棄物與干擾。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '海外遠端交付', description: '提供精確到位的完整施工文件，讓海外當地團隊無需現場督導，即可完成製作、展示設計與安裝。' } },
      ],
    },
  ],
};

const processSteps = [
  { id: '01', en: 'Feasibility', zh: '需求與可行性評估', desc: '在動筆繪圖前，先完成現地會勘、法規與結構限制盤點，以及客戶需求確認，把基地條件與預算天花板一次盤點清楚，避免設計階段做出中途才發現無法施作的方案。' },
  { id: '02', en: 'Design & Engineering', zh: '概念與展示設計', desc: '設計與結構工程同步進行，讓概念從第一天起就能在基地與法規限制內落地施作，建築、結構與機電圖面同步校對，降低施工階段才發現衝突、必須回頭改圖的風險。' },
  { id: '03', en: 'Fabrication & Testing', zh: '製作與測試', desc: '工廠製作，機電、燈光與影音系統在出廠前完成測試，每個單元出廠前都經過組裝試運轉與品管檢核，把問題留在工廠解決，而不是留到現場才處理。' },
  { id: '04', en: 'On-site Installation', zh: '工程安裝', desc: '在工地管理下依排程逐工種進場安裝，並與場館營運及第三方查驗單位協調配合，同步控管進度與品質，確保每個工種銜接時圖面與現場保持一致。' },
  { id: '05', en: 'Handover', zh: '驗收與交付', desc: '與客戶進行最終巡檢、文件建檔與簽署確認，如涉及授權方或主管機關，同步完成相關程序，並留存完整維護手冊與聯絡窗口，讓開幕後的日常維運也有人可以問。' },
];

const services = [
  { n: '01', zh: '策展服務', en: 'Curatorial Services', headline: '一場好的展覽，從一個好的觀點開始。', desc: '我們負責完整的策展規劃：概念發展、內容研究，以及每一檔展覽的敘事腳本撰寫。十二年博物館與展覽經驗，讓我們懂得如何訂出主題方向、把研究轉化為內容，並理清展示邏輯。', img: '/images/curatorial-services-team-reviewing-concept-letsuan-design.jpg', alt: '策展團隊圍桌檢視展覽概念草稿' },
  { n: '02', zh: '展覽設計', en: 'Exhibition Design', headline: '空間訴說故事，訪客走進其中。', desc: '為博物館、水族館與文化場館設計以故事為核心的展覽。敘事、空間規劃、燈光與互動多媒體共同運作，把抽象主題轉化為訪客走過空間就能讀懂的具體設計。', img: '/images/exhibition-design-museum-gallery-corridor-letsuan-design.jpg', alt: '博物館展覽廊道空間設計' },
  { n: '03', zh: '室內設計', en: 'Interior Design', headline: '為人設計的空間，不只是好看而已。', desc: '身為持照室內裝修業者，我們依照人們實際的移動與聚集方式來設計商業與機構室內空間。空間分區、動線與材質選擇都經過規劃，讓人們能順暢地走進、使用這個空間。', img: '/images/interior-design-executive-office-letsuan-design.jpg', alt: '企業辦公室室內設計空間' },
  { n: '04', zh: '視覺設計', en: 'Visual Design', headline: '走到哪都認得出的品牌。', desc: '我們把客戶的品牌識別、企業識別系統與指標設計，實現在真實的空間裡。從入口招牌到場館內外的環境圖像，logo 系統與視覺調性都忠實延續客戶的品牌樣貌。', img: '/images/visual-design-wayfinding-signage-letsuan-design.jpg', alt: '場館指標與環境視覺設計' },
  { n: '05', zh: '工程建造', en: 'Construction', headline: '從動工到交付，團隊全程在場。', desc: '我們負責展場工程從設計圖到完工的全部過程，包含施工與展示製作。團隊直接進行製作與工地管理，專業工項則由合作團隊在我們直接監督下執行。', img: '/images/construction-site-supervisor-reviewing-plans-letsuan-design.jpg', alt: '工地主管於施工現場檢視圖面' },
  { n: '06', zh: '多媒體互動設計', en: 'Multimedia & Interactive Design', headline: '讓展示與觀眾即時互動，而不只是被動觀看。', desc: '我們規劃感應觸發、投影與互動螢幕等多媒體裝置，讓內容隨著觀眾的動作與停留即時回應。技術規劃、內容腳本與軟硬體整合由同一團隊負責，確保現場穩定運作。', img: '/images/multimedia-interactive-touch-table-exhibit-letsuan-design.jpg', alt: '訪客操作互動觸控展示桌' },
];

const capabilities = [
  { zh: '古蹟與零損傷工程', en: 'Heritage & Non-Invasive Construction', desc: '為受保護建物與古蹟場域設計的自立式、零穿孔結構系統，在不觸碰原始構造的前提下，承載完整的景觀與機電設備荷重。', img: '/images/yokai-world-exhibition-hero-letsuan-design.jpg', alt: 'Experience the Yokai World — Yokai exhibition entrance', evidenceHref: './project-yokai-world', evidenceLabel: 'ゲゲゲの鬼太郎' },
  { zh: 'IP 授權展覽執行', en: 'IP-Licensed Exhibitions', desc: '依授權方規範執行：角色還原度、官方指定色號與完工品質，皆透過現場直接督導與驗收把關。', img: '/images/conan-anniv-kaito-kid-pre-installation-photo-letsuan-design.jpg', alt: 'Photo of the Kaito Kid figure taken before installation, in preparation for fixing it onto the rooftop platform', evidenceHref: './project-serialization-anniversary', evidenceLabel: '名偵探柯南' },
  { zh: '暗展場與影音整合', en: 'Blackout & AV Integration', desc: '全暗場處理、分區燈光，結合隱藏式配線與機械傳動的多區感應觸發自動化系統。', img: '/images/immersive-projection-mapping-grid-installation-letsuan-design.jpg', alt: 'Immersive projection room with a wraparound calibration grid mapped across curved walls and floor, ceiling rigged with rows of projectors, technicians testing the setup', evidenceHref: './project-beyond-just-an-exhibition', evidenceLabel: '不只是展覽–你就是藝術的一部分！' },
  { zh: '高精度環境控制', en: 'Precision Environmental Control', desc: '針對 VR、影音與互動系統，以嚴謹數值公差打造均勻照度、隔音效果與感應敏感度兼具的環境。', img: '/images/notre-dame-profile-line-letsuan-design.jpg', imgPosition: 'center 15%', alt: 'Three visitors in profile wearing VR headsets and backpacks against a black-and-white graphic mural', evidenceHref: './project-notre-dame', evidenceLabel: '永恆聖母院' },
  { zh: '結構與耐震工程', en: 'Structural & Seismic Engineering', desc: '自立式與懸吊結構自設計階段起，即依當地耐震安全係數進行設計與評估。', img: '/images/dragon-to-beast-sauropod-skeletons-being-installed-in-outdoor-letsuan-design.jpg', alt: 'From Dragon to Beast — Sauropod skeletons being installed in outdoor courtyard', evidenceHref: './project-dragon-to-beast', evidenceLabel: '從龍到獸' },
  { zh: '壓縮工期現場管理', en: 'Compressed-Timeline Site Management', desc: '分階段跨工種排程與多方協調，在共用通道、天候與法規審查等現實限制下，如期達成固定開幕日。', img: '/images/wang-ye-worship-donggang-01-letsuan-design.jpg', alt: '天狩神兵——東港迎王祭展覽', evidenceHref: './project-wang-ye-donggang', evidenceLabel: '東港迎王特展' },
  { zh: '製作與廢棄物管理', en: 'In-House Fabrication & Waste Management', desc: '單元與裝置於工廠製作後運至現場組裝，讓材料與人力全程可追溯，並降低現場廢棄物與干擾。', img: '/images/offshore-wind-om-learning-center-01-letsuan-design.jpg', alt: '離岸風電運維中心——會議室牆面為沃旭「Love your home」地球壁畫，前方為會議桌', evidenceHref: './project-offshore-wind', evidenceLabel: '風動台灣' },
  { zh: '海外遠端交付', en: 'Remote International Delivery', desc: '提供精確到位的完整施工文件，讓海外當地團隊無需現場督導，即可完成製作、展示設計與安裝。', img: '/images/la-fortuna-bordada-exhibition-banner-museo-entrance-letsuan-design.jpg', alt: 'La Fortuna Bordada exhibition banner at the Museo Nacional de Artes Decorativas entrance', evidenceHref: './project-la-fortuna-bordada', evidenceLabel: '美麗與吉祥' },
];
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, pageJsonLd]} lang="zh-TW" alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="what-we-do" enHref="/what-we-do" />

    <section id="hero">
      <div class="ltsuan-eyebrow">
        <span class="ltsuan-eyebrow-pill">Since 2014 — Design to Installation</span>
        <span class="ltsuan-eyebrow-line"></span>
        <span class="ltsuan-eyebrow-text">Museum Exhibition Design & Build Studio</span>
      </div>
      <div class="ltsuan-hero-grid">
        <div class="ltsuan-hero-copy">
          <h1 class="ltsuan-h1">賦予空間<br /><span class="ltsuan-h1-accent">具體樣貌</span><span class="ltsuan-h1-dot"></span></h1>
          <p class="ltsuan-lead">從現地會勘到最終交付，同一團隊全程負責可行性評估、設計、製作與安裝每個階段，讓複雜的專業知識變得容易理解，體驗自然而然展開。</p>
        </div>
        <div class="ltsuan-hero-panel">
          <div class="ltsuan-hero-card">
            <div class="ltsuan-hero-card-doc"></div>
            <div class="ltsuan-hero-card-tag">
              <span class="ltsuan-hero-card-tag-label">LE TSUAN / 2024</span>
              <span class="ltsuan-hero-card-tag-rule"></span>
              <span class="ltsuan-hero-card-tag-dot"></span>
            </div>
            <div class="ltsuan-hero-card-foot">
              <span>Fig.01 — Spatial Narrative Study</span>
              <span class="ltsuan-hero-card-badge">Taichung Studio</span>
            </div>
          </div>
          <div class="ltsuan-hero-captions">
            <p>從可行性評估到驗收交付，五個關鍵節點無縫銜接。</p>
            <p>Five stages, one accountable team, start to finish.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="why">
      <div class="ltsuan-why-grid">
        <div class="ltsuan-stat">
          <div class="ltsuan-stat-row">
            <div class="ltsuan-stat-num">12+</div>
            <div class="ltsuan-stat-meta">
              <div class="ltsuan-stat-label">YEARS</div>
              <div class="ltsuan-stat-rule"></div>
              <div class="ltsuan-stat-sub">年<br />博物館<br />現場</div>
            </div>
          </div>
          <p class="ltsuan-stat-caption">EST. 2014 — CONTINUOUS PRACTICE</p>
        </div>
        <div class="ltsuan-why-copy">
          <h2 class="ltsuan-why-h2">為什麼堅持 <span class="ltsuan-pill">設計施工一體</span>？<br />因為圖面是想像，現場才是體驗。</h2>
          <p class="ltsuan-why-highlight">一個燈光角度的偏差、展櫃與牆面 5mm 的誤差，就是一段故事的失真。圖面無法解決現場的問題，只有同一個團隊，才能讓當初的敘事在現場不被妥協。</p>
          <div class="ltsuan-why-cols">
            <div class="ltsuan-why-text">
              <p>許多展覽在圖面上很美，到了現場卻走了味。往往是因為策展、設計、施工分屬不同廠商，責任分散，最後的落差，只能由觀眾承擔。</p>
              <p>麗荃選擇了一條更重、也更負責的路，從策展框架到開幕前最後一次走場點燈，由同一個團隊負責到底。木作、鐵件、燈光與多媒體，皆由同一群人整合製作與現場校準。</p>
              <p>當圖面與現場由同一群人守護，敘事才不會在工地裡走散，展覽才能如承諾般被完整體驗。</p>
            </div>
            <div class="ltsuan-why-card-col">
              <div class="ltsuan-why-card">
                <div class="ltsuan-why-card-label">ONE TEAM ACCOUNTABILITY</div>
                <p class="ltsuan-why-card-body">同一團隊，從概念到開幕。<br /><span>Single point of responsibility — from curatorial framework to final walkthrough.</span></p>
              </div>
              <div class="ltsuan-why-tags">
                <span>製作整合</span>
                <span>現場組裝</span>
                <span>燈光整合</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="services">
      <div class="ltsuan-section-stat">
        <div class="ltsuan-stat-num">6</div>
        <div class="ltsuan-stat-meta">
          <div class="ltsuan-stat-label">SERVICES</div>
          <div class="ltsuan-stat-rule"></div>
          <div class="ltsuan-stat-sub">六大<br />核心<br />服務項目</div>
        </div>
      </div>
      <div class="ltsuan-services-grid">
        {services.map((svc) => (
          <div class="ltsuan-service-card" id={`service-${svc.n}`}>
            <div class="ltsn-panel">
              <picture>
                <source srcset={avifPath(svc.img)} type="image/avif" />
                <img alt={svc.alt} src={svc.img} class="ltsuan-service-img" loading="lazy" decoding="async" />
              </picture>
              <span class="ltsuan-service-img-en">{svc.en.toLowerCase()}</span>
              <span class="ltsuan-service-img-mark">✳</span>
            </div>
            <div class="ltsuan-service-title-row">
              <span class="ltsuan-service-n">{svc.n}</span>
              <span class="ltsuan-service-dot"></span>
              <h3 class="ltsuan-service-zh">{svc.zh}</h3>
            </div>
            <div class="ltsuan-service-en">{svc.en}</div>
            <p class="ltsuan-service-desc">{svc.desc}</p>
            <div class="ltsuan-service-foot">
              <div class="ltsuan-service-rule"></div>
              <p class="ltsuan-service-headline">{svc.headline}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="process-steps">
      <div class="ltsuan-process-heading">
        <h2 class="ltsuan-process-h2">流程</h2>
        <span class="ltsuan-process-sub">從需求確認到交付，同一個團隊負責到底</span>
      </div>

      <div class="ltsuan-process-tracker" data-process-tracker>
        <div class="ltsuan-process-line-track"></div>
        <div class="ltsuan-process-line-fill" data-process-fill></div>
        <div class="ltsuan-process-buttons">
          {processSteps.map((step, i) => (
            <button type="button" class="ltsuan-process-btn" data-step-id={step.id} data-step-index={i} aria-current={i === 0 ? 'step' : undefined}>
              <span class="ltsuan-process-ring">
                <span class="ltsuan-process-dot"></span>
              </span>
