---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/zh-TW/Nav.astro';
import Footer from '../../components/zh-TW/Footer.astro';
import CornerFrame from '../../components/CornerFrame.astro';
import { organizationJsonLd } from '../../data/organization';
import { avifPath } from '../../utils/images';
import { services as coreServiceMeta } from '../../data/homepage-zh';

const coreServiceCopy: Record<string, { headline: string; desc: string }> = {
  curatorial: {
    headline: '一場好的展覽，從一個好的觀點開始。',
    desc: '我們負責完整的策展規劃：概念發展、內容研究，以及每一檔展覽的敘事腳本撰寫。十二年博物館與展覽經驗，讓我們懂得如何訂出主題方向、把研究轉化為內容，並理清展示邏輯，讓訪客走過展場時能跟上展覽想說的論述。',
  },
  exhibition: {
    headline: '空間訴說故事，訪客走進其中。',
    desc: '為博物館、水族館與文化場館設計以故事為核心的展覽。敘事、空間規劃、燈光與互動多媒體共同運作，把抽象主題轉化為訪客走過空間就能讀懂的具體設計，而不是靠滿牆的文字說明。',
  },
  interior: {
    headline: '為人設計的空間，不只是好看而已。',
    desc: '身為持照室內裝修業者，我們依照人們實際的移動與聚集方式來設計商業與機構室內空間，而不只是講究外觀。空間分區、動線與材質選擇都經過規劃，讓人們能順暢地走進、使用這個空間。',
  },
  visual: {
    headline: '走到哪都認得出的品牌。',
    desc: '我們負責品牌識別、企業識別系統與指標設計，以及讓品牌貫穿實體空間的圖像環境。無論場館內外，logo 系統與環境圖像都維持一致的視覺調性，讓訪客一眼就能認出。',
  },
  construction: {
    headline: '從動工到交付，自有團隊全程在場。',
    desc: '我們負責展場工程從設計圖到完工的全部過程，包含施工與展示製作。自有團隊直接進行製作與工地管理，專業工項則由合作團隊在我們直接監督下執行。我們全程把關材料選用、進度排程與品質管控，確保完工空間與圖面相符，並經得起長期使用。',
  },
};

const title = '麗荃室內裝修 | 展覽設計流程';
const description = '了解麗荃室內裝修如何透過五階段流程交付博物館等級的展覽，因應古蹟場域與高精度環境需求量身打造工程規劃。';
const canonical = 'https://letsuan.com/zh-TW/what-we-do';
const alternateHrefs = [
  { hreflang: 'en', href: 'https://letsuan.com/what-we-do' },
  { hreflang: 'zh-TW', href: canonical },
  { hreflang: 'x-default', href: 'https://letsuan.com/what-we-do' },
];
const ogImage = 'https://letsuan.com/assets/logo.png';

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://letsuan.com/zh-TW/what-we-do#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://letsuan.com/#website' },
      about: { '@id': 'https://letsuan.com/#organization' },
    },
    {
      '@type': 'OfferCatalog',
      '@id': 'https://letsuan.com/zh-TW/what-we-do#catalog',
      name: '麗荃室內裝修服務與工程能力',
      provider: { '@id': 'https://letsuan.com/#organization' },
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '展覽設計', description: '為博物館與文化場館打造敘事導向的展覽與沉浸式裝置。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '室內設計', description: '依照人們實際的移動與聚集方式規劃的商業與機構室內空間。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '視覺設計', description: '透過識別系統、指標與環境圖像，讓品牌貫穿實體空間。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '工程建造', description: '自有製作團隊與工地管理，將設計從圖面化為實體。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '古蹟與零損傷工程', description: '為受保護建物與古蹟場域設計的自立式、零穿孔結構系統，在不觸碰原始構造的前提下，承載完整的景觀與機電設備荷重。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'IP 授權展覽執行', description: '依授權方規範執行：角色還原度、官方指定色號與完工品質，皆透過現場直接督導與驗收把關。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '暗展場與影音整合', description: '全暗場處理、分區燈光，結合隱藏式配線與機械傳動的多區感應觸發自動化系統。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '高精度環境控制', description: '針對 VR、影音與互動系統，以嚴謹數值公差打造均勻照度、隔音效果與感應敏感度兼具的環境。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '結構與耐震工程', description: '自立式與懸吊結構自設計階段起，即依當地耐震安全係數進行設計與評估。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '壓縮工期現場管理', description: '分階段跨工種排程與多方協調，在共用通道、天候與法規審查等現實限制下，如期達成固定開幕日。' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '自有製作與廢棄物管理', description: '單元與裝置於自有工廠製作後運至現場組裝，讓材料與人力全程可追溯，並降低現場廢棄物與干擾。每個工地都遵循正式的分類回收流程。' } },
      ],
    },
  ],
};

const processSteps = [
  { num: '01', title: '需求與可行性評估', desc: '在動筆繪圖前，先完成現地會勘、法規與結構限制盤點，以及客戶需求確認。' },
  { num: '02', title: '概念與工程設計', desc: '設計與結構工程同步進行，讓概念從第一天起就能在基地與法規限制內落地施作。' },
  { num: '03', title: '製作與測試', desc: '自有工廠製作，機電、燈光與影音系統在出廠前完成測試。' },
  { num: '04', title: '現場安裝', desc: '在自有工地管理下依排程逐工種進場安裝，並與場館營運及第三方查驗單位協調配合。' },
  { num: '05', title: '驗收與交付', desc: '與客戶進行最終巡檢、文件建檔與簽署確認，如涉及授權方或主管機關，同步完成相關程序。' },
];

const capabilities = [
  { id: 'heritage-non-invasive-construction', title: '古蹟與零損傷工程', desc: '為受保護建物與古蹟場域設計的自立式、零穿孔結構系統，在不觸碰原始構造的前提下，承載完整的景觀與機電設備荷重。', img: '/images/yokai-world-exhibition-hero-letsuan-design.jpg', alt: 'Experience the Yokai World — Yokai exhibition entrance', evidenceHref: './project-yokai-world', evidenceLabel: 'ゲゲゲの鬼太郎' },
  { title: 'IP 授權展覽執行', desc: '依授權方規範執行：角色還原度、官方指定色號與完工品質，皆透過現場直接督導與驗收把關。', img: '/images/conan-anniv-kaito-kid-pre-installation-photo-letsuan-design.jpg', alt: 'Photo of the Kaito Kid figure taken before installation, in preparation for fixing it onto the rooftop platform', evidenceHref: './project-serialization-anniversary', evidenceLabel: '名偵探柯南' },
  { title: '暗展場與影音整合', desc: '全暗場處理、分區燈光，結合隱藏式配線與機械傳動的多區感應觸發自動化系統。', img: '/images/immersive-projection-mapping-grid-installation-letsuan-design.jpg', alt: 'Immersive projection room with a wraparound calibration grid mapped across curved walls and floor, ceiling rigged with rows of projectors, technicians testing the setup', evidenceHref: './project-beyond-just-an-exhibition', evidenceLabel: '不只是展覽–你就是藝術的一部分！' },
  { title: '高精度環境控制', desc: '針對 VR、影音與互動系統，以嚴謹數值公差打造均勻照度、隔音效果與感應敏感度兼具的環境。', img: '/images/marine-illusion-visitors-exploring-the-masters-of-marine-letsuan-design.jpg', imgPosition: 'center 30%', alt: 'Visitors exploring the Masters of Marine Illusion exhibition at Taichung Aquarium, an interior and exhibition design project by Le Tsuan Design', evidenceHref: './project-marine-illusion', evidenceLabel: '眼見為憑？' },
  { title: '結構與耐震工程', desc: '自立式與懸吊結構自設計階段起，即依當地耐震安全係數進行設計與評估。', img: '/images/dragon-to-beast-sauropod-skeletons-being-installed-in-outdoor-letsuan-design.jpg', alt: 'From Dragon to Beast — Sauropod skeletons being installed in outdoor courtyard', evidenceHref: './project-dragon-to-beast', evidenceLabel: '從龍到獸' },
  { title: '壓縮工期現場管理', desc: '分階段跨工種排程與多方協調，在共用通道、天候與法規審查等現實限制下，如期達成固定開幕日。', img: '/images/notre-dame-profile-line-letsuan-design.jpg', imgPosition: 'center 15%', alt: 'Three visitors in profile wearing VR headsets and backpacks against a black-and-white graphic mural', evidenceHref: './project-notre-dame', evidenceLabel: '永恆聖母院' },
  { title: '自有製作與廢棄物管理', desc: '單元與裝置於自有工廠製作後運至現場組裝，讓材料與人力全程可追溯，並降低現場廢棄物與干擾。每個工地都遵循正式的分類回收流程。', img: '/images/mobile-museum-exhibition-01-letsuan-design.jpg', alt: '8.5 ping: A Museum on Wheels — Mobile Museum vehicle', evidenceHref: './project-mobile-museum', evidenceLabel: '8.5坪的博物館' },
  { title: '海外遠端交付', desc: '提供精確到位的完整施工文件，讓海外當地團隊無需現場督導，即可完成製作、展示設計與安裝。', img: '/images/la-fortuna-bordada-exhibition-banner-museo-entrance-letsuan-design.jpg', alt: 'La Fortuna Bordada exhibition banner at the Museo Nacional de Artes Decorativas entrance', evidenceHref: './project-la-fortuna-bordada', evidenceLabel: '美麗與吉祥' },
];
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, pageJsonLd]} lang="zh-TW" alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="what-we-do" enHref="/what-we-do" />

    <section id="process">
      <div class="ltsuan-reveal ltsuan-process-block">
        <div class="ltsuan-process-copy">
          <h1 class="ltsuan-h1">賦予空間具體樣貌。</h1>
          <p class="ltsuan-lead">從現地會勘到最終交付，同一團隊全程負責可行性評估、設計、製作與安裝每個階段，讓複雜的專業知識變得容易理解，體驗自然而然展開。</p>
        </div>
        <a href="./portfolio" class="ltsuan-badge">查看<br />作品集</a>
      </div>
      <div class="ltsuan-hero-media">
        <picture>
          <source srcset={avifPath('/images/centered-sparkler-hand-letsuan-design.jpg')} type="image/avif" />
          <img src="/images/centered-sparkler-hand-letsuan-design.jpg" alt="Hand holding a lit sparkler against a bokeh light backdrop" class="ltsuan-hero-img" />
        </picture>
        <CornerFrame size={16} />
      </div>
    </section>

    <section id="core-services">
      <div class="ltsuan-reveal">
        <h2 class="ltsuan-section-h2">五項服務，一個團隊全程負責。</h2>
      </div>
      <div class="ltsuan-core-grid">
        {coreServiceMeta.map((svc) => (
          <div class="ltsuan-core-card" id={`service-${svc.id}`}>
            <div class="ltsuan-core-img-wrap">
              <picture>
                <source srcset={avifPath(svc.realImg)} type="image/avif" />
                <img alt={svc.alt} src={svc.realImg} class="ltsuan-core-img" loading="lazy" decoding="async" />
              </picture>
            </div>
            <h3 class="ltsuan-core-title">{svc.title}</h3>
            <p class="ltsuan-core-headline">{coreServiceCopy[svc.id].headline}</p>
            <p class="ltsuan-core-desc">{coreServiceCopy[svc.id].desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="process-steps">
      <h2 class="ltsuan-process-h2">從需求確認到交付，同一團隊負責到底。</h2>
      <div class="ltsuan-process-grid">
        <div class="ltsuan-process-line"></div>
        {processSteps.map((step) => (
          <div>
            <div class="ltsuan-tick"></div>
            <div class="ltsuan-step-num">{step.num}</div>
            <h3 class="ltsuan-step-title">{step.title}</h3>
            <p class="ltsuan-step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="services">
      <div class="ltsuan-reveal">
        <h2 class="ltsuan-section-h2">禁得起基地、業主<br />與法規三方考驗的工程。</h2>
        <p class="ltsuan-section-intro">麗荃室內裝修專精古蹟零損傷工程、IP 授權展覽執行、暗展場影音整合，以及高精度環境控制，服務對象涵蓋臺灣及海外的博物館與文化場館。</p>
      </div>
      <div class="ltsuan-capabilities-grid">
        {capabilities.map((cap) => (
          <div class="ltsuan-cap-card" id={cap.id}>
            <CornerFrame size={10} opacity={0.55} />
            <div class="ltsuan-cap-img-wrap">
              <picture>
                <source srcset={avifPath(cap.img)} type="image/avif" />
                <img alt={cap.alt} src={cap.img} style={`object-position:${cap.imgPosition || 'center'}`} class="ltsuan-cap-img" loading="lazy" decoding="async" />
              </picture>
            </div>
            <h3 class="ltsuan-cap-title">{cap.title}</h3>
            <p class="ltsuan-cap-desc">{cap.desc}</p>
            <a href={cap.evidenceHref} class="ltsuan-cap-evidence">{cap.evidenceLabel} →</a>
          </div>
        ))}
      </div>
    </section>

    <Footer background="#0B1526" />
  </div>
</Layout>

<script>
  import '../../scripts/reveal';
</script>

<style is:global>
  :root {
    --ltsuan-bg: #0b1526;
    --ltsuan-panel: #101b33;
    --ltsuan-accent: #8ec31f;
    --ltsuan-accent-hover: #a8dc4a;
    --ltsuan-line: rgba(244, 239, 232, 0.12);
    --ltsuan-dim: rgba(244, 239, 232, 0.6);
    --ltsuan-blueprint: #c9d6e8;
  }
</style>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
  }
  #process {
    padding: 110px 60px 60px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-process-block {
    position: relative;
  }
  .ltsuan-process-copy {
    margin-bottom: 36px;
    max-width: 900px;
  }
  .ltsuan-h1 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(40px, 5.4vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
  }
  .ltsuan-lead {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.3;
    color: var(--ltsuan-dim);
    margin: 0;
    max-width: 52ch;
  }
  .ltsuan-badge {
    position: absolute;
    top: 0;
    right: 0;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 1px solid var(--ltsuan-line);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ltsuan-text);
    text-decoration: none;
  }
  .ltsuan-hero-media {
    position: relative;
    overflow: hidden;
    height: clamp(280px, 36vw, 460px);
  }
  .ltsuan-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
    filter: brightness(0.88) saturate(1.08);
  }
  #core-services {
    padding: 56px 60px 56px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-core-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .ltsuan-core-card {
    background: var(--ltsuan-panel);
    padding: 24px;
  }
  .ltsuan-core-img-wrap {
    position: relative;
    height: 140px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .ltsuan-core-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.85) saturate(1.05);
  }
  .ltsuan-core-title {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 17px;
    margin: 0 0 8px;
  }
  .ltsuan-core-headline {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: 14px;
    color: var(--ltsuan-accent);
    margin: 0 0 10px;
  }
  .ltsuan-core-desc {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    line-height: 1.65;
    color: rgba(244, 239, 232, 0.6);
    margin: 0;
  }
  #process-steps {
    padding: 56px 60px 56px 79px;
    border-bottom: 1px solid var(--ltsuan-line);
  }
  .ltsuan-process-h2 {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(24px, 2.6vw, 32px);
    margin: 0 0 40px;
    max-width: 44ch;
  }
  .ltsuan-process-grid {
    display: grid;
    gap: 24px;
    position: relative;
    grid-template-columns: repeat(5, 1fr);
  }
  @media (max-width: 900px) {
    .ltsuan-process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .ltsuan-process-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .ltsuan-badge {
      position: static !important;
      margin: 20px 0 0 !important;
    }
  }
  .ltsuan-process-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--ltsuan-blueprint);
    opacity: 0.3;
  }
  .ltsuan-tick {
    width: 1px;
    height: 14px;
    background: var(--ltsuan-blueprint);
    opacity: 0.5;
    margin-bottom: 10px;
  }
  .ltsuan-step-num {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--ltsuan-accent);
    margin-bottom: 12px;
  }
  .ltsuan-step-title {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: 17px;
    margin: 0 0 10px;
  }
  .ltsuan-step-desc {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(244, 239, 232, 0.6);
    margin: 0;
  }
  #services {
