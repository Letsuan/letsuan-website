---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "麗荃室內裝修 | ゲゲゲの鬼太郎";
const description = "ゲゲゲの鬼太郎 — 妖怪100物語";
const canonical = "https://letsuan.com/zh-TW/project-yokai-world";
const ogImage = "https://letsuan.com/images/yokai-world-exhibition-hero-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-yokai-world" },
  { hreflang: "zh-TW", href: canonical },
  { hreflang: "x-default", href: "https://letsuan.com/project-yokai-world" },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "ゲゲゲの鬼太郎", "description": "ゲゲゲの鬼太郎 — 妖怪100物語", "url": "https://letsuan.com/zh-TW/project-yokai-world", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/yokai-world-exhibition-hero-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022–2023", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "ゲゲゲの鬼太郎", "item": "https://letsuan.com/zh-TW/project-yokai-world"}]}];
const eyebrowLeft = "展覽 — 2022–2023";
const eyebrowRight = "華山文創園區";
const h1Main = "ゲゲゲの鬼太郎";
const h1Sub = "妖怪100物語";
const metaFields = [{"label": "業主", "value": "水木製作公司（水木プロダクション）"}, {"label": "地點", "value": "臺北，臺灣"}, {"label": "年份", "value": "2022–2023"}, {"label": "面積", "value": "958.68㎡"}, {"label": "類別", "value": "展覽設計、工程施作"}];
const bodyHtml = "<h2>這裡不能釘一根釘子</h2>\n<h2>鬼太郎妖怪展｜958.68㎡零侵入施工，在古蹟裡蓋出零故障的暗黑異空間</h2>\n<p>為紀念水木茂–《鬼太郎》創作者、日本首屈一指的妖怪學者–誕辰100週年，水木製作公司選擇臺灣作為紀念展的首站。展區設置於具高度文資保護規範的歷史建築內，這意味著從第一天開始，工程team面對的就不是「怎麼蓋」的問題，而是「怎麼在不能碰的地方蓋」。我們的目標，是在<a href=\"./what-we-do#heritage-non-invasive-construction\">零侵入</a><a href=\"./what-we-do#service-construction\">施工</a>的前提下，於高壓縮的工期中，完成一座「100%國際級品質移植」的<a href=\"./what-we-do#service-exhibition\">沉浸式</a>暗展場域–高密度玻璃纖維（FRP）複合造型、多區自動化觸發機構、暗場環境下的聲光電整合系統，一次通過日方原廠監修團隊的現場驗收。</p>\n<h2>古蹟不能碰，重量自己想辦法扛</h2>\n<p>展區牆面與地基全面禁止打釘或任何侵入性破壞–這是文資保護的硬規定，沒有商量餘地。我們採用自立式鋼木結構搭配模組化架高地板，把全區數噸重的造景與管線負載，完全轉移到一套獨立的承重系統上，讓古蹟本體從頭到尾不承受一絲結構接觸。因應暗展特有的狹窄迷宮動線，結構材與面材全面採用防焰等級板材與布料，緊急避難指引與隱蔽式消防設施則精準整合進場景造型裡–法規要顧到，視覺完整性也一步都不能讓。</p>\n<h2>機關要嚇人，但不能被看見</h2>\n<p>整個展區藏了為數不少的動態驚喜機關，紅外線（PIR）、微波感應器與高靈敏度壓力感應板，感應端點全數埋進壁面與造景深處，觀眾看不見任何一顆感應器，只會在通過的瞬間，被機關嚇一跳。觀眾一踏進預設區域，微控制器（MCU）就即時觸發氣動或電動機構，配合低延遲爆閃燈光與定向多聲道音效，達成毫秒級的動態衝擊。展期每天要面對數萬人次的觸發頻率，所有機械傳動部件都配置了工業級緩衝避震與高耐磨組件–這不是做一次就好的裝置，是要撐過整個展期、天天被觸發還不能壞的裝置。</p>\n<h2>把光全部關掉，才是真正的工程</h2>\n<p>原展館場域本身有既有光害問題，我們從場館最高處開始，一路向下逐層施作遮光，把每一面牆體都處理過，徹底阻絕外部光源滲入，換來暗展所需的絕對黑域環境–這是後續分區控光與感應機關能精準運作的前提條件，沒有這一步，後面全部不成立。強弱電管線、氣壓管路與控制器，全部集中規劃進造景內部的維修通道，並預留隱蔽式維修孔，讓現場維護不用破壞視覺完整性。多主題沉浸式空間彼此相鄰，聲光很容易互相干擾–我們透過低色溫定向聚光、鏡面光學反射與分區聲壓控制，把每個主題區的聲光都留在自己的邊界裡。</p>\n<h2>疫情下的工期，只能靠調度換出來</h2>\n<p>施工期間正好碰上COVID-19疫情管制，進場人員健康管理與場域人數總量管制，全部得依政府防疫規定落實–人力容留受限，工期又被壓縮到近乎不合理，我們採取分時段工種交叉作業（24-Hour Phased Construction），把木工、機關自動化、弱電、造型噴漆等不同工種的進場時段精準分開，避免人員在同一時間過度集中在同一空間。緊縮到這個程度的時間限制裡，工程進度與品質控管兩件事，一件都沒放掉。</p>\n<h2>日方盯得很細，我們一次就過</h2>\n<p>水木製作公司對IP形象還原、妖怪造型比例、色彩塗裝色號與整體氛圍調性設有極高標準，派了日方專家團隊親自到臺灣展場監督驗收。我們憑藉精準的圖紙轉譯能力，加上純熟的塗裝做舊工藝，現場配合日方指引進行毫米級微調，一次性通過原廠的高標準驗收–沒有二次補件，沒有回頭重做。</p>\n<p>整個展期下來，自動化觸發、燈光與聲學系統維持零故障運作，日本水木製作現場監督團隊審查也是一次通過。這個案子最終留下的，不只是一座讓人願意在裡面被嚇一跳的暗黑異空間，更是一套跨國IP授權展演、古蹟場域施工、機電自動化與暗展工程整合的完整實績–證明「不能碰的地方」跟「國際級品質」，從來不是互斥的兩件事。</p>";
const relatedProjects = [{"href": "./project-story-telling", "label": "五千年的沉默"}, {"href": "./project-nmns-teldap", "label": "科博館數位典藏"}, {"href": "./project-asian-art-biennial", "label": "草皮比作品更需要被保護"}];
const nextHref = "./project-offshore-wind";
const images = [{"src": "../images/yokai-world-exhibition-hero-letsuan-design.jpg", "alt": "體驗妖怪的世界——妖怪展覽入口"}, {"src": "../images/yokai-world-exhibition-03-letsuan-design.jpg", "alt": "妖怪展覽展區"}, {"src": "../images/yokai-world-exhibition-05-letsuan-design.jpg", "alt": "妖怪展覽棲地場景"}, {"src": "../images/yokai-world-exhibition-13-letsuan-design.jpg", "alt": "廊道懸掛裱框妖怪故事插畫展板，牆面採暖色木質裝修"}, {"src": "../images/yokai-world-exhibition-003-letsuan-design.jpg", "alt": "妖怪展覽迎賓裝置"}, {"src": "../images/yokai-world-exhibition-07-letsuan-design.jpg", "alt": "妖怪展覽互動角落"}, {"src": "../images/yokai-world-exhibition-005-letsuan-design.jpg", "alt": "妖怪展覽迷宮區"}, {"src": "../images/yokai-world-exhibition-11-letsuan-design.jpg", "alt": "妖怪集合合照牆"}, {"src": "../images/yokai-world-exhibition-12-letsuan-design.jpg", "alt": "黃色角色介紹牆，展示鬼太郎系列妖怪角色與百年紀念牌匾"}, {"src": "../images/yokai-world-exhibition-91-letsuan-design.jpg", "alt": "妖怪插畫壁畫牆"}, {"src": "../images/yokai-world-exhibition-04-letsuan-design-f779cada.jpg", "alt": "妖怪展覽施工進行中"}];
---

