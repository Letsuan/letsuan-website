---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "Le Tsuan Design | 九十年的天空，值得被好好述說";
const description = "九十年的天空，值得被好好述說 — 光之長廊：空軍軍官學校史特展";
const canonical = "https://letsuan.com/zh-TW/project-air-force-academy";
const ogImage = "https://letsuan.com/images/air-force-academy-eagle-sculpture-installation-with-archway-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-air-force-academy" },
  { hreflang: "zh-TW", href: canonical },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "九十年的天空，值得被好好述說", "description": "九十年的天空，值得被好好述說 — 光之長廊：空軍軍官學校史特展", "url": "https://letsuan.com/zh-TW/project-air-force-academy", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/air-force-academy-eagle-sculpture-installation-with-archway-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2019", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "九十年的天空，值得被好好述說", "item": "https://letsuan.com/zh-TW/project-air-force-academy"}]}];
const eyebrowLeft = "展覽 — 2019";
const eyebrowRight = "空軍軍史館";
const h1Main = "九十年的天空，值得被好好述說";
const h1Sub = "光之長廊：空軍軍官學校史特展";
const metaFields = [{"label": "業主", "value": "空軍軍官學校"}, {"label": "地點", "value": "高雄，臺灣"}, {"label": "年份", "value": "2019"}, {"label": "面積", "value": "396.6948 ㎡"}, {"label": "類別", "value": "策展內容、展覽設計、平面設計、視覺設計、互動多媒體、工程施作"}];
const bodyHtml = "<p>整個展館以時間軸串起動線，讓人一步步從過去走到現在。</p>\n<h2>序展區——築夢藍天</h2>\n<p>一進門就是氣勢十足的視覺牆面，航空幾何線條先把「空軍」意象立起來，再帶觀眾往下走。</p>\n<h2>建校與抗戰歲月區</h2>\n<p>老照片、文獻、文物一件件陳列，不多加修飾，讓那個艱苦年代裡空軍健兒的韌性自己說話。</p>\n<h2>空軍現代化與新一代戰力展區</h2>\n<p>從主力戰機模型到裝備演進，看得出空軍怎麼從草創走到今天的規模與戰力。</p>\n<h2>未來展望與教育傳承區</h2>\n<p>把官校育才的使命與未來航太科技接上，讓展覽不只回頭看，也往前看。</p>\n<h2>視覺美學與展陳細節</h2>\n<h2>歷史軸線牆——以線串史，以時記事</h2>\n<p>這面牆是整個展場的敘事骨架。空軍九十年來的每一件大事，依時間先後標在牆上，一條線貫穿全牆，把散落的節點串成一段完整故事。從建校、抗戰、遷台整軍，一路到今天，每個時間點都是線上的座標。觀眾沿牆走過去，其實就是走過一遍空軍的九十年——不是在看資料，是在走時間。</p>\n<h2>飛翼意象與光影運用</h2>\n<p>天花板採用機翼流線造型，配上打光，做出雲層天際的效果。空間本身就在講「空軍」，不需要靠文字說明。</p>\n<h2>精緻櫥櫃與立體展示</h2>\n<p>展櫃使用高透光抗反射玻璃，燈光特別控制，讓勳章、文物、服飾被好好看見，同時兼顧文物保存需求。</p>\n<h2>實體模型與情境還原</h2>\n<p>展區中間擺了戰機模型與情境還原，不是純平面掛牆，現場感與臨場感明顯更強。</p>\n<h2>結語</h2>\n<p>這個展館做的不只是把歷史資料擺出來，而是把軍事文化的重量，與現代展覽設計的手法揉在一起。走進去的每個人，應該都能感覺到那股從九十年前一路傳下來的、空軍的那股勁。</p>";
const relatedProjects = [{"href": "./project-mobile-museum", "label": "八點五坪的博物館"}, {"href": "./project-orsted-energy", "label": "與風共榮"}, {"href": "./project-offshore-wind", "label": "離岸風電運維中心"}];
const nextHref = "./project-art-gallery-culture";
const images = [{"src": "../images/air-force-academy-eagle-sculpture-installation-with-archway-letsuan-design.jpg", "alt": "R.O.C. Air Force Academy 90th Founding Anniversary — Eagle sculpture installation with archway feature wall"}, {"src": "../images/air-force-academy-feature-wall-archway-with-eagle-sculptures-letsuan-design.jpg", "alt": "Feature wall archway with eagle sculptures and timeline panel"}, {"src": "../images/air-force-academy-cockpit-simulator-interactive-exhibit-letsuan-design.jpg", "alt": "Cockpit simulator interactive exhibit"}, {"src": "../images/air-force-academy-overhead-view-of-exhibition-zone-layout-letsuan-design.jpg", "alt": "Overhead view of exhibition zone layout"}, {"src": "../images/air-force-academy-roc-air-force-academy-feature-wall-letsuan-design.jpg", "alt": "R.O.C. Air Force Academy feature wall with orange lighting"}, {"src": "../images/air-force-academy-visitors-viewing-history-timeline-wall-letsuan-design.jpg", "alt": "Visitors viewing history timeline wall"}, {"src": "../images/air-force-academy-eagle-sculptures-being-transported-to-site-letsuan-design.jpg", "alt": "Eagle sculptures being transported to site"}, {"src": "../images/air-force-academy-construction-team-installing-archway-feature-letsuan-design.jpg", "alt": "Construction team installing archway feature wall"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
  lang="zh-TW"
  alternateHrefs={alternateHrefs}
  closeLabel="關閉"
  backLabel="回作品集"
  nextLabel="下一個專案"
  homeLabel="首頁"
  relatedLabel="相關專案"
  detailLabel="專案詳情"
/>