---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/zh-TW/Nav.astro';
import Footer from '../../components/zh-TW/Footer.astro';
import PortfolioHero from '../../components/zh-TW/PortfolioHero.astro';
import ProjectGrid from '../../components/zh-TW/ProjectGrid.astro';
import { organizationJsonLd } from '../../data/organization';

const title = '麗荃室內裝修 | 展覽與室內設計作品集';
const description = '瀏覽麗荃設計的展覽、室內與視覺設計作品——一間服務博物館、品牌與公共空間的臺灣設計工作室。';
const canonical = 'https://letsuan.com/zh-TW/portfolio';
const ogImage = 'https://letsuan.com/assets/logo.png';
const alternateHrefs = [
  { hreflang: 'en', href: 'https://letsuan.com/portfolio' },
  { hreflang: 'zh-TW', href: canonical },
  { hreflang: 'x-default', href: 'https://letsuan.com/portfolio' },
];

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://letsuan.com/zh-TW/portfolio#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://letsuan.com/#website' },
      about: { '@id': 'https://letsuan.com/#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://letsuan.com/zh-TW/' },
        { '@type': 'ListItem', position: 2, name: '作品集', item: canonical },
      ],
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={[organizationJsonLd, pageJsonLd]} lang="zh-TW" alternateHrefs={alternateHrefs}>
  <div class="ltsuan-page">
    <Nav active="exhibition" enHref="/portfolio" />

    <PortfolioHero />

    <section id="intro">
      <div class="pf-intro-eyebrow">作品典藏</div>
      <h1 class="pf-intro-title">讓空間蛻變為體驗的作品。</h1>
      <p class="pf-intro-copy">精選麗荃室內裝修在各地完成的展覽、室內、視覺設計案例。</p>
    </section>

    <ProjectGrid />

    <div class="pf-spacer"></div>
    <Footer background="var(--ltsuan-bg)" />
  </div>
</Layout>

<style>
  .ltsuan-page {
    background: var(--ltsuan-bg);
  }
  :global(:root) {
    --ltsuan-bg: #0b1526;
    --ltsuan-accent: #8ec31f;
    --ltsuan-accent-hover: #a8dc4a;
    --ltsuan-blueprint: #c9d6e8;
  }
  #intro {
    padding: 170px 56px 63px;
    border-bottom: 1px solid rgba(244, 239, 232, 0.08);
  }
  .pf-intro-eyebrow {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.25em;
    color: var(--ltsuan-accent);
    margin-bottom: 18px;
  }
  .pf-intro-title {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-weight: 300;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.15;
    margin: 0 0 20px;
    max-width: 900px;
    letter-spacing: -0.02em;
  }
  .pf-intro-copy {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(244, 239, 232, 0.6);
    max-width: 600px;
    margin: 0;
  }
  .pf-spacer {
    height: 64px;
  }
</style>
