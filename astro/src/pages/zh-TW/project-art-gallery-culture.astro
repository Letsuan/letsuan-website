];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "看見文化部", "description": "看見文化部 — 一段歷史，無數個日常", "url": "https://letsuan.com/zh-TW/project-art-gallery-culture", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/art-gallery-culture-ministry-of-culture-exhibition-ceiling-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2019", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "看見文化部", "item": "https://letsuan.com/zh-TW/project-art-gallery-culture"}]}];
const eyebrowLeft = "展覽 — 2019";
const eyebrowRight = "文化部藝廊";
