---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "麗荃室內裝修 | 貓美術館";
const description = "貓美術館 — 山本修的超療癒世界";
const canonical = "https://letsuan.com/zh-TW/project-cat-art";
const ogImage = "https://letsuan.com/images/cat-art-starry-night-mural-reinterpreted-with-cat-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-cat-art" },
  { hreflang: "zh-TW", href: canonical },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "貓美術館", "description": "貓美術館 — 山本修的超療癒世界", "url": "https://letsuan.com/zh-TW/project-cat-art", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/cat-art-starry-night-mural-reinterpreted-with-cat-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2024", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "貓美術館", "item": "https://letsuan.com/zh-TW/project-cat-art"}]}];
const eyebrowLeft = "展覽 — 2024";
const eyebrowRight = "屏菸1936文化基地 10號倉庫";
const h1Main = "貓美術館";
const h1Sub = "山本修的超療癒世界";
const metaFields = [{"label": "業主", "value": "貓美術館"}, {"label": "地點", "value": "屏東，臺灣"}, {"label": "年份", "value": "2024"}, {"label": "類別", "value": "展覽設計、平面設計、視覺設計、裝置藝術、工程施作"}];
const bodyHtml = "<p>本案為日本藝術家山本修（Shu Yamamoto）「貓・美術館 CATART」特展於屏東的展場空間設計，我們負責整體規劃、色彩計畫，以及將平面畫作轉譯為立體裝置與<a href=\"./what-we-do#service-exhibition\">沉浸式</a>場景。</p>\n<p>面對橫跨東西方藝術脈絡、風格跳躍的大量作品，設計上的核心課題是：如何用空間語言為每一組作品找到合適的「舞台」，並串成一條節奏分明、持續有記憶點的觀展動線。</p>\n<h2>設計策略：以色塊分區作為敘事骨架</h2>\n<p>我們捨棄畫廊常見的白盒子中性展牆，改以大面積撞色分區劃分敘事節奏–橄欖綠、焦糖黃、薰衣草紫、桃紅、靛藍等色調依序銜接，讓觀眾在移動間自然感受到情緒與氛圍的轉換，而非仰賴文字說明。轉角處的圓拱造型看板將導覽文字與空間造型整合為一，避免額外張貼說明牌破壞立面完整性。</p>\n<h2>從平面到立體：裝置轉譯與場景重建</h2>\n<p>我們將部分畫作角色以真實比例製作成大型立體公仔與雕塑，搭配專屬打光與背景壁畫，讓角色「走出畫框」;另針對特定情境畫作，則採壁畫延伸實體家具的做法–手繪場景與現場家具在透視、光影上精準對位，讓觀眾能直接入座、融入畫面。這類轉譯是本案技術難度最高的部分，考驗的是壁畫繪製、道具訂製與空間尺度之間的整合精度。</p>\n<p>此外，針對不同風格的作品系列，我們也分別設計了對應材質與造型的裝置語彙–從幾何色塊的立體展示牆、教堂花窗式的背光裝置，到普普風線稿造型牆與噴泉造景，讓每個分區都有獨立的空間識別度，而非重複套用同一種展示邏輯。</p>\n<p>2樓整層更以「立體拍照區」為規劃主軸，每個轉角、畸零空間都預先設計成獨立的拍照點，讓動線本身不再只是通道，而是連續不間斷的互動場景。</p>\n<h2>光線與動線設計</h2>\n<p>全場採軌道式重點投射燈，針對作品與裝置個別調整角度與色溫，維持低照度氛圍的同時讓內容「跳」出牆面。動線以牆體轉角劃分段落，讓觀眾在推進過程中持續產生「發現感」。</p>\n<p>展覽開幕後，各分區皆自發成為觀眾拍照打卡的熱點，社群擴散效果良好。整體設計成功在「展示的專業感」與「互動的趣味性」之間取得平衡–好的展場設計，是讓內容說話，而空間負責把人留下來。</p>\n<p>而這也正是這次空間規劃想達成的效果：讓遊客走進貓美術館時，不只是欣賞畫作，而是被空間輕輕捲入「貓化」的過程，成為貓咪世界的一份子。化身為貓，走進名畫場景，探索巨型彩繪玻璃窗「貓之光」，造訪貓咪專屬的「貓宮殿」，並漫步於屏東限定場景：大碗島上的貓咪午睡、貓咪噴泉、貓仔誕生、貓咖啡館與貓咪星空夜。每個展區都以貓的視角重新詮釋世界–慵懶、玩心、無拘無束–邀請訪客自由地找到屬於自己的貓咪宇宙一角。不需要解讀技巧或歷史知識，只要喜歡，盡情凝視即可–這正是我們希望這個空間能傳遞給每一位訪客的體驗。</p>";
const relatedProjects = [{"href": "./project-amazing-homeland", "label": "原鄉驚艷"}, {"href": "./project-serialization-anniversary", "label": "名偵探柯南連載20周年紀念展"}, {"href": "./project-hakka-culture", "label": "藏富客庄"}];
const nextHref = "./project-led-kinetic";
const images = [{"src": "../images/cat-art-dream-painting-cat-parody-with-visitor-letsuan-design.jpg", "alt": "貓美術館——民眾觀看金框裝裱、以貓咪重新詮釋畢卡索《夢》的作品"}, {"src": "../images/cat-art-starry-night-mural-reinterpreted-with-cat-letsuan-design.jpg", "alt": "以貓咪主題重新詮釋《星夜》壁畫"}, {"src": "../images/cat-art-gallery-corridor-with-cat-themed-letsuan-design.jpg", "alt": "展覽廊道陳列貓咪主題重新詮釋的經典肖像畫"}, {"src": "../images/cat-art-yellow-gallery-corridor-with-renoir-style-cat-letsuan-design.jpg", "alt": "黃色展覽廊道陳列雷諾瓦風格的貓咪畫作"}, {"src": "../images/cat-art-yellow-and-pink-gallery-corridor-letsuan-design.jpg", "alt": "黃粉色展覽廊道陳列裱框貓咪畫作"}, {"src": "../images/cat-art-purple-gallery-corridor-with-framed-cat-letsuan-design.jpg", "alt": "紫色展覽廊道陳列裱框貓咪畫作"}, {"src": "../images/cat-art-mona-lisa-cat-scene-with-visitor-letsuan-design.jpg", "alt": "民眾坐在書桌前，一旁為貓咪版蒙娜麗莎場景"}, {"src": "../images/cat-art-sculpted-cat-figures-recreating-sunday-letsuan-design.jpg", "alt": "貓咪雕塑重現《星期天的午後》畫作場景"}, {"src": "../images/cat-art-mondrian-style-geometric-display-installation-letsuan-design.jpg", "alt": "蒙德里安風格幾何展示裝置"}, {"src": "../images/cat-art-sculpted-cat-figures-in-green-park-letsuan-design.jpg", "alt": "貓咪雕塑重現綠地公園場景，搭配陽傘"}, {"src": "../images/cat-art-cat-themed-gallery-room-with-sculpted-cat-letsuan-design.jpg", "alt": "貓咪主題展廳，陳列貓咪雕塑與裱框畫作"}];
---

<ProjectLayout
