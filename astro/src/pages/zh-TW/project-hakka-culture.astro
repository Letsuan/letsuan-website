---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "麗荃室內裝修 | 藏富客庄";
const description = "藏富客庄 — 樟腦產業特展";
const canonical = "https://letsuan.com/zh-TW/project-hakka-culture";
const ogImage = "https://letsuan.com/images/hakka-culture-entrance-feature-wall-with-tree-cutout-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-hakka-culture" },
  { hreflang: "zh-TW", href: canonical },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "藏富客庄", "description": "藏富客庄 — 樟腦產業特展", "url": "https://letsuan.com/zh-TW/project-hakka-culture", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/hakka-culture-entrance-feature-wall-with-tree-cutout-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2012", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "藏富客庄", "item": "https://letsuan.com/zh-TW/project-hakka-culture"}]}];
const eyebrowLeft = "展覽 — 2012";
const eyebrowRight = "客家委員會客家文化發展中心";
const h1Main = "藏富客庄";
const h1Sub = "樟腦產業特展";
const metaFields = [{"label": "業主", "value": "客家委員會客家文化發展中心"}, {"label": "地點", "value": "苗栗，臺灣"}, {"label": "年份", "value": "2012"}, {"label": "類別", "value": "展覽設計、工程施作"}];
const bodyHtml = "<h2>30天，一座樟腦記憶館</h2>\n<p>客家文化館《藏富客庄》樟腦特展｜一場文物保存、產業轉譯與工期壓力的三方拉鋸</p>\n<p>臺灣曾佔全球樟腦產量七成，樟腦與糖、茶並列臺灣三寶，中北部客庄正是核心產區。這是臺灣客家文化館開館首檔特展「藏富客庄」系列，以樟腦為題，重現從採樟、製腦到全球貿易的產業鏈，並延伸至三義木雕、鴨箱寶、面譜文創的轉型。我們負責全案展示工程統籌，把學術論述轉化為觀眾能走進去、聞得到、摸得到的空間–從<a href=\"./what-we-do#service-curatorial\">策展</a>到完工，只有30天。</p>\n<h2>油漆會拖慢工地，所以我們選擇不油漆</h2>\n<p>特展區的隔間系統，我們把木作全部移進工廠模組化預製，現場只做組裝–因為油漆這道工法只能在現場施作，不只拖慢進度、粉塵難以控制，油漆本身的氣味還會干擾整間展館刻意營造的樟木香氣，讓觀眾聞到的不是樟腦，而是油漆味。我們改採現場面材全面貼飾美耐板，取代傳統的現場噴漆做舊，把最耗時、最難管控、也最容易「破功」的工序，提前搬到工廠裡完成。地坪保留館方原有地坪，上覆深色塑膠地磚界定展區，無障礙動線淨寬維持在120公分以上；入口處設置樟木屑香氛槽，配合低速靜音風機擴散–樟腦的揮發性氣味不只侷限在入口，而是瀰漫整間展館，讓觀眾一踏進特展區，就先被味道包圍，比任何說明牌都更快進入樟腦產業的情境。</p>\n<h2>讓百年帳簿呼吸，但呼吸得很小心</h2>\n<p>文物展示櫃是<a href=\"./portfolio\">博物館</a>級規格：實木榫接底座搭配低鐵低反射玻璃，穿透率超過91%，避免反光干擾觀眾判讀。櫃內配置被動式調濕盒，專門針對日治時期帳簿、樟腦晶體這類有機文物進行微環境控制–這些東西怕潮也怕乾，得讓濕度自己找到平衡點，而不是靠外力硬壓。展區同時展示樟木從切塊到蒸煮前粉碎拌料的加工實物，以及三義樟木木雕與其他工藝品實體，讓觀眾看見樟木從原料到產業技術、再到工藝轉型的完整脈絡；腦寮與蒸餾的完整流程則以圖片說明呈現，另外製作了1:10比例的腦寮作業場景模型，把伐木、集材、蒸餾的產業分工，濃縮進一個可以一眼看懂的縮小世界。</p>\n<h2>光要暖，但不能曬壞紙</h2>\n<p>全區採用3000K暖白光，軌道燈搭配15度窄角投射燈重點照明文物，照度控制在50到150lux之間–這個區間是紙質文物保存的硬規範，多一分都不行。樟樹意象區以鄰近樟腦廠提供的真實樟樹材料構成，呈現原料從整木到粉碎拌料等不同加工階段的型態變化，搭配洗牆燈營造森林光斑的氛圍感，讓這區同時是視覺端景，也是一套活的加工流程教材。年表牆與「客家聚落與樟腦產地地圖」的大圖輸出，採用UV直噴搭配無反光膜；解說牌用無酸裱褙與立體切割字，確保長時間展期下不翹曲、不變色。</p>\n<p>整個工程配合臺灣客家文化館的開館時程，採夜間進場、分區封閉<a href=\"./what-we-do#service-construction\">施工</a>，展櫃於工廠預組後才運到現場組裝，把粉塵對館內其他常設展的影響降到最低，並在開展前完成照度、溫濕度與緊急疏散動線的全套測試。從策展到完工的30天裡，這不只是做一個特展，而是在開館壓力下，完成一個同時兼顧文物保存、產業技術轉譯與沉浸體驗的博物館級展示工程。</p>";
const relatedProjects = [{"href": "./project-story-telling", "label": "五千年的沉默"}, {"href": "./project-nmns-teldap", "label": "科博館數位典藏"}, {"href": "./project-wang-ye-donggang", "label": "代天巡狩"}];
const nextHref = "./project-nmh-highlights";
const images = [{"src": "../images/hakka-culture-entrance-feature-wall-with-tree-cutout-letsuan-design.jpg", "alt": "客家文化發展中心——入口主牆搭配樹形鏤空圖案與展覽標題"}, {"src": "../images/hakka-culture-projection-screen-showing-archival-camphor-letsuan-design.jpg", "alt": "投影螢幕播放樟腦產業歷史影像"}, {"src": "../images/hakka-culture-camphor-tree-branch-display-with-wood-letsuan-design.jpg", "alt": "樟樹枝幹裝置搭配木雕文物展示櫃"}, {"src": "../images/hakka-culture-gallery-corridor-with-tree-branch-display-letsuan-design.jpg", "alt": "展覽廊道搭配樹枝裝置與照片看板"}, {"src": "../images/hakka-culture-exhibition-02-letsuan-design.jpg", "alt": "客家文化發展中心閉展場景"}];
