const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "名偵探柯南", "description": "名偵探柯南 — 科學搜查展 – 科教館-臺北、科工館-高雄", "url": "https://letsuan.com/zh-TW/project-detective-conan-taipei", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/detective-conan-taipei-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2019–2020", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "名偵探柯南", "item": "https://letsuan.com/zh-TW/project-detective-conan-taipei"}]}];
