---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { organizationJsonLd } from '../../data/organization';

const title = "Le Tsuan Design | 宇宙";
const description = "宇宙 — 500件LED動態燈光裝置";
const canonical = "https://letsuan.com/zh-TW/project-led-kinetic";
const ogImage = "https://letsuan.com/images/universe-led-kinetic-light-01-letsuan-design.jpg";
const alternateHrefs = [
  { hreflang: "en", href: "https://letsuan.com/project-led-kinetic" },
  { hreflang: "zh-TW", href: canonical },
];
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "宇宙", "description": "宇宙 — 500件LED動態燈光裝置", "url": "https://letsuan.com/zh-TW/project-led-kinetic", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/universe-led-kinetic-light-01-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2024", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首頁", "item": "https://letsuan.com/zh-TW/"}, {"@type": "ListItem", "position": 2, "name": "作品集", "item": "https://letsuan.com/zh-TW/portfolio"}, {"@type": "ListItem", "position": 3, "name": "宇宙", "item": "https://letsuan.com/zh-TW/project-led-kinetic"}]}];
const eyebrowLeft = "展覽 — 2024";
const eyebrowRight = "正佳廣場";
const h1Main = "宇宙";
const h1Sub = "500件LED動態燈光裝置";
const metaFields = [{"label": "業主", "value": "正佳廣場科學館"}, {"label": "地點", "value": "廣州，中國"}, {"label": "年份", "value": "2024"}, {"label": "類別", "value": "展覽設計、裝置藝術、互動多媒體、工程施作"}];
const bodyHtml = "<p>「宇宙」是為廣州正佳廣場科學館打造的動態燈光裝置，由五百件可動 LED 燈具組成，同時承擔照明機能與空間視覺焦點。裝置搭配音樂與旁白敘事，用直觀的方式帶領觀眾進入天文知識。我們負責本案燈光裝置的設計規劃與整合。</p>";
const relatedProjects = [{"href": "./project-notre-dame", "label": "永恆聖母院"}, {"href": "./project-green-energy", "label": "陽光、風、地熱，在一座展館裡相遇"}, {"href": "./project-beyond-just-an-exhibition", "label": "不只是展覽–你就是藝術的一部分！"}];
const nextHref = "./project-beyond-just-an-exhibition";
const images = [{"src": "../images/universe-led-kinetic-light-01-letsuan-design.jpg", "alt": "Universe LED kinetic light installation"}, {"src": "../images/universe-led-kinetic-light-02-letsuan-design.jpg", "alt": "Universe kinetic light closeup"}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
  lang="zh-TW"
  alternateHrefs={alternateHrefs}
  closeLabel="關閉"
  backLabel="回作品集"
  nextLabel="下一個專案"
  homeLabel="首頁"
  relatedLabel="相關專案"
  detailLabel="專案詳情"
/>