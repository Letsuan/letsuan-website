const title = "La Fortuna Bordada | Le Tsuan Design";
const description = "La Fortuna Bordada: Taiwanese indigenous costume exhibition at the Museo Nacional de Historia, Madrid. Exhibition Design — Le Tsuan Design.";
const canonical = "https://letsuan.com/project-la-fortuna-bordada";
const ogImage = "https://letsuan.com/images/la-fortuna-bordada-gallery-corridor-embroidered-garment-panels-letsuan-design.jpg";
const jsonLd = [{"@context": "https://schema.org", "@type": "CreativeWork", "name": "La Fortuna Bordada", "description": "Taiwanese embroidered garments, Museo Nacional de Artes Decorativas, Madrid.", "url": "https://letsuan.com/project-la-fortuna-bordada", "creator": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "image": "https://letsuan.com/images/la-fortuna-bordada-gallery-corridor-embroidered-garment-panels-letsuan-design.jpg", "author": {"@type": "Organization", "name": "Le Tsuan Design", "url": "https://letsuan.com/"}, "datePublished": "2017", "hasPart": [{"@type": "CreativeWork", "name": "\"Beauty and Auspiciousness: Embroidery from the Collection of the National Museum of History\" Opens at Spain's National Museum of Decorative Arts"}]}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "La Fortuna Bordada — Taiwanese Embroidery", "item": "https://letsuan.com/project-la-fortuna-bordada"}]}];
const eyebrowLeft = "EXHIBITION — 2017";
const eyebrowRight = "MUSEO NACIONAL DE ARTES DECORATIVAS";
const h1Main = "La Fortuna Bordada";
const h1Sub = "";
const metaFields = [{"label": "LOCATION", "value": "Madrid, Spain"}, {"label": "YEAR", "value": "2017"}, {"label": "CATEGORY", "value": "Exhibition Design, Interior Design, Graphic Design, Visual Design, Logo Design"}];
const bodyHtml = "<h2>Never Once on Site</h2>\n<p>\"La Fortuna Bordada: Taiwanese Embroidery from the Collection of the National Museum of History\" opened at Spain's Museo Nacional de Artes Decorativas, the first time Taiwanese embroidery craft has been shown in full within Spain's national museum system, made possible after two years of work by Taiwan's Representative Office in Spain. The National Museum of History holds nearly a thousand pieces of Taiwanese clothing and everyday embroidery dating from the latter half of the nineteenth century onward, and this show selected 74 groups from that collection, presented under two themes: everyday dress and accessories, and officials' rank badges. We handled the spatial planning and exhibition construction design for the show. Across the entire project, though, we never had a single person on the ground in Madrid.</p>\n<h2>Design in Taiwan, Delivered as Drawings</h2>\n<p>With the artifacts needing international shipping and the venue on the other side of the world, we worked in a design-in-Taiwan, deliver-by-drawings model. The full spatial plan and every piece of display-fixture design was completed on the Taiwan side, then converted into a complete set of construction drawings and handed to a local Spanish contractor to build and install.</p>\n<p>There was no way to stand on site and supervise, and no way to go back the next day and fix something that didn't work, so the drawings had to spell out every detail on their own. They were the only language we had to communicate with the construction team in Spain.</p>\n<h2>What the Display Stands Had to Account For</h2>\n<p>Embroidered artifacts are fragile, sensitive to light damage, and can't hold up under long-term hanging tension, so we designed dedicated case structures and a garment-suspension system around those limits. Small three-dimensional accessories like purses, embroidered shoes, and children's caps each have their own shape, so we designed acrylic display stands individually for each category, custom-fitting the support structure to the contour of every piece. All of that had to be resolved completely at the design stage, since once the pieces reached Spain there was no room left to adjust anything.</p>\n<p>The key visuals and printed graphics translated the auspicious symbolism carried by the flowers, fruit, birds, and animals in the embroidery patterns into a visual storytelling system Western audiences could read intuitively, so cultural distance never got in the way of understanding.</p>\n<p>This is one of the few overseas museum projects we've delivered entirely through drawings. We were never on site, and yet through a single complete set of construction documents, all 74 groups of embroidered artifacts were hung and cased in Madrid with every dimension in place.</p>";
const relatedProjects = [{"href": "./project-marine-illusion", "label": "Seeing Is Believing"}, {"href": "./project-offshore-wind", "label": "Offshore Wind O&M Building"}, {"href": "./project-westernmost-point", "label": "The Westernmost Point of Taiwan"}];
const nextHref = "./project-serialization-anniversary";
const images = [{"src": "./images/la-fortuna-bordada-exhibition-banner-museo-entrance-letsuan-design.jpg", "alt": "La Fortuna Bordada exhibition banner at the Museo Nacional de Artes Decorativas entrance"}, {"src": "./images/la-fortuna-bordada-gallery-display-cases-embroidered-accessories-letsuan-design.jpg", "alt": "La Fortuna Bordada gallery with display cases of embroidered accessories"}, {"src": "./images/la-fortuna-bordada-gallery-corridor-embroidered-garment-panels-letsuan-design.jpg", "alt": "La Fortuna Bordada gallery corridor with embroidered garment panels"}, {"src": "./images/la-fortuna-bordada-display-case-embroidered-headwear-accessories-letsuan-design.jpg", "alt": "La Fortuna Bordada display case with embroidered headwear and accessories"}, {"src": "./images/la-fortuna-bordada-framed-embroidery-panels-through-archway-letsuan-design.jpg", "alt": "La Fortuna Bordada framed embroidery panels seen through an archway"}, {"src": "./images/la-fortuna-bordada-curators-inspecting-embroidered-artifacts-letsuan-design.jpg", "alt": "La Fortuna Bordada curators inspecting embroidered artifacts in a display case"}, {"src": "./images/la-fortuna-bordada-exhibition-wall-embroidered-panels-letsuan-design.jpg", "alt": "La Fortuna Bordada exhibition wall of embroidered panels"}, {"src": "./images/la-fortuna-bordada-wall-framed-rank-badge-embroidery-letsuan-design.jpg", "alt": "La Fortuna Bordada wall of framed rank badge embroidery with wall text"}];
---

