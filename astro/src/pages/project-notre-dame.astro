const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Eternal Notre-Dame — Taiwan Debut", "description": "A VR immersive experience inside the cathedral undergoing reconstruction, making its Taiwan debut in Kaohsiung.", "url": "https://letsuan.com/project-notre-dame", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/notre-dame-vr-group-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2023", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Eternal Notre-Dame — Taiwan Debut", "item": "https://letsuan.com/project-notre-dame"}]}];
