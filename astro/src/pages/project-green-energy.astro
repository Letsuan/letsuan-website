const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "The Future Is Worth It — Green Energy Vision Pavilion", "description": "A pavilion communicating Taiwan's green-energy transition.", "url": "https://letsuan.com/project-green-energy", "creator": {"@id": "https://letsuan.com/#organization"}, "image": "https://letsuan.com/images/green-energy-vision-pavilion-09-letsuan-design.jpg", "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2022", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "The Future Is Worth It — Green Energy Vision Pavilion", "item": "https://letsuan.com/project-green-energy"}]}];
