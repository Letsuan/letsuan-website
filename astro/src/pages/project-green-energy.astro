const images = [{"src": "./images/green-energy-vision-pavilion-tiered-concrete-planter-wall-letsuan-design.jpg", "alt": "Wind, and Geothermal Energy Converge in a Single Pavilion — Tiered concrete planter wall with cascading greenery at the Green Energy Vision Pavilion entrance"}, {"src": "./images/green-energy-vision-pavilion-10-letsuan-design.jpg", "alt": "Entrance signage reading '台泥綠能願景館' (TCCGE Green Energy Vision Pavilion) with TCCGE and TCC logos"}, {"src": "./images/green-energy-vision-pavilion-11-letsuan-design.jpg", "alt": "Projected animation display beside a plaque explaining the meaning of the TCC Green Energy logo"}, {"src": "./images/green-energy-vision-pavilion-03-letsuan-design.jpg", "alt": "DC/AC current and wind power educational corridor with interactive touch panels at the Green Energy Vision Pavilion"}, {"src": "./images/green-energy-vision-pavilion-01-letsuan-design.jpg", "alt": "Timeline wall with interactive touch panels tracing the history of electricity from the 19th to 21st century"}, {"src": "./images/green-energy-vision-pavilion-02-letsuan-design.jpg", "alt": "Illuminated display panels explaining household electricity use and energy-saving tips"}, {"src": "./images/green-energy-vision-pavilion-13-letsuan-design.jpg", "alt": "Illustrated wind turbine cutout display comparing a 508-meter turbine height against the Taipei 101 skyline"}, {"src": "./images/green-energy-vision-pavilion-07-letsuan-design.jpg", "alt": "Cross-section model of a wind turbine nacelle with numbered labels showing internal mechanical components"}, {"src": "./images/green-energy-vision-pavilion-visitor-viewing-solar-energy-zone-letsuan-design.jpg", "alt": "Visitor viewing the Solar Energy exhibit zone, with solar panel samples and a wind turbine video screen"}, {"src": "./images/green-energy-vision-pavilion-06-letsuan-design.jpg", "alt": "Visitors touring the Geothermal Energy exhibit zone with a guide explaining the display"}, {"src": "./images/green-energy-vision-pavilion-12-letsuan-design.jpg", "alt": "Visitors gathered around an interactive solar power information display at Green Energy Vision Pavilion"}, {"src": "./images/green-energy-vision-pavilion-08-letsuan-design.jpg", "alt": "Installation crew mounting display graphics and panels during construction of the exhibit corridor"}];
