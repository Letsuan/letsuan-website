---
import ProjectLayout from '../components/ProjectLayout.astro';
import { organizationJsonLd } from '../data/organization';

const title = "Letsuan Design | Just Only";
const description = "Just Only. Graphic Design for Just Only Environment Protection, Taiwan, 2010 — graphic design studio Taiwan, Letsuan Design.";
const canonical = "https://letsuan.com/project-just-only-environment";
const alternateHrefs = [
  { hreflang: "en", href: canonical },
  { hreflang: "zh-TW", href: "https://letsuan.com/zh-TW/project-just-only-environment" },
  { hreflang: "x-default", href: canonical },
];

const ogImage = "https://letsuan.com/images/just-only-environment-paper-pulp-mold-technology-brochure-cover-letsuan-design.jpg";
const jsonLd = [organizationJsonLd, {"@context": "https://schema.org", "@type": "CreativeWork", "name": "Just Only Environment Protection Brochure", "url": "https://letsuan.com/project-just-only-environment", "creator": {"@id": "https://letsuan.com/#organization"}, "image": [{"@type": "ImageObject", "url": "https://letsuan.com/images/just-only-environment-paper-pulp-mold-technology-brochure-cover-letsuan-design.jpg", "caption": "Letsuan Design | Just Only — Paper Pulp Mold Technology brochure cover with folded panel detail"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/just-only-environment-brochure-spread-showing-inspection-reports-letsuan-design.jpg", "caption": "Brochure spread showing inspection reports and manufacturing process"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/just-only-environment-brochure-spread-showing-paper-pulp-mold-letsuan-design.jpg", "caption": "Brochure spread showing paper pulp mold tableware product catalog"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/just-only-environment-brochure-back-cover-with-blue-gradient-letsuan-design.jpg", "caption": "Brochure back cover with blue gradient and Paper Pulp Mold Tableware branding"}, {"@type": "ImageObject", "url": "https://letsuan.com/images/just-only-environment-brochure-spread-showing-patterned-paper-pulp-letsuan-design.jpg", "caption": "Letsuan Design | Just Only — Brochure spread showing patterned paper pulp plates and bowls"}], "author": {"@id": "https://letsuan.com/#organization"}, "datePublished": "2010", "dateModified": "2026-09-14", "isPartOf": {"@id": "https://letsuan.com/#website"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://letsuan.com/"}, {"@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://letsuan.com/portfolio"}, {"@type": "ListItem", "position": 3, "name": "Just Only Environment Protection Brochure", "item": "https://letsuan.com/project-just-only-environment"}]}];
const eyebrowLeft = "GRAPHIC DESIGN — 2010";
const eyebrowRight = "TAIWAN";
const h1Main = "Just Only";
const h1Sub = "Environment Protection Brochure";
const metaFields = [{"label": "CLIENT", "value": "Just Only Environment Protection"}, {"label": "YEAR", "value": "2010"}];
const bodyHtml = "<h2>Scope</h2>\n<p>Just Only Environment Protection's brochure, typography, and website were designed by Le Tsuan's in-house team as part of the brand's collateral. A clean, readable design language carries the brand's environmental message, keeping print and digital interfaces consistent in tone.</p>\n<h2 class=\"ltsuan-case-appendix\">Related Services</h2>\n<ul><li><a href=\"./what-we-do#service-visual\">Visual Design</a></li></ul>";
const relatedProjects = [{"href": "./project-fullchamp-brochure", "label": "Fullchamp Brochure Design"}, {"href": "./project-amazing-homeland", "label": "Amazing Homeland"}, {"href": "./project-art-gallery-culture", "label": "Art Gallery (Ministry of Culture)"}];
const nextHref = "./project-fullchamp-brochure";
const images = [{"src": "./images/just-only-environment-paper-pulp-mold-technology-brochure-cover-letsuan-design.jpg", "alt": "Letsuan Design | Just Only — Paper Pulp Mold Technology brochure cover with folded panel detail", "width": 800, "height": 445}, {"src": "./images/just-only-environment-brochure-spread-showing-inspection-reports-letsuan-design.jpg", "alt": "Brochure spread showing inspection reports and manufacturing process", "width": 800, "height": 483}, {"src": "./images/just-only-environment-brochure-spread-showing-paper-pulp-mold-letsuan-design.jpg", "alt": "Brochure spread showing paper pulp mold tableware product catalog", "width": 800, "height": 483}, {"src": "./images/just-only-environment-brochure-back-cover-with-blue-gradient-letsuan-design.jpg", "alt": "Brochure back cover with blue gradient and Paper Pulp Mold Tableware branding", "width": 800, "height": 483}, {"src": "./images/just-only-environment-brochure-spread-showing-patterned-paper-pulp-letsuan-design.jpg", "alt": "Letsuan Design | Just Only — Brochure spread showing patterned paper pulp plates and bowls", "width": 800, "height": 483}];
---

<ProjectLayout
  title={title}
  description={description}
  canonical={canonical}
  alternateHrefs={alternateHrefs}
  ogImage={ogImage}
  jsonLd={jsonLd}
  eyebrowLeft={eyebrowLeft}
  eyebrowRight={eyebrowRight}
  h1Main={h1Main}
  h1Sub={h1Sub}
  metaFields={metaFields}
  bodyHtml={bodyHtml}
  relatedProjects={relatedProjects}
  nextHref={nextHref}
  images={images}
/>
