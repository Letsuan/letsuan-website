---
import { slides as defaultSlides, responsiveSrcset, avifPath } from '../data/homepage';
import type { Slide } from '../data/homepage';

interface Props {
  slides?: Slide[];
}
const { slides = defaultSlides } = Astro.props;

const beamTwinkles = [
  { style: 'left:8%;transform:rotate(3deg);animation-duration:3.4s;animation-delay:0s' },
  { style: 'left:19%;transform:rotate(3deg);animation-duration:4.1s;animation-delay:1.6s' },
  { style: 'left:33%;transform:rotate(3deg);animation-duration:3.8s;animation-delay:.6s' },
  { style: 'left:61%;animation-duration:3.6s;animation-delay:1.1s' },
  { style: 'left:76%;animation-duration:4.3s;animation-delay:3s' },
  { style: 'left:90%;animation-duration:3.9s;animation-delay:2s' },
  { style: 'left:4%;width:9.8px;transform:rotate(3deg);animation-duration:2.9s;animation-delay:1.3s' },
  { style: 'left:15%;width:9.8px;transform:rotate(3deg);animation-duration:3.7s;animation-delay:2.7s' },
  { style: 'left:26%;width:9.8px;transform:rotate(3deg);animation-duration:3.1s;animation-delay:.2s' },
  { style: 'left:44%;width:9.8px;transform:rotate(0deg);animation-duration:4.4s;animation-delay:1.9s' },
  { style: 'left:56%;width:9.8px;transform:rotate(0deg);animation-duration:2.6s;animation-delay:.9s' },
  { style: 'left:69%;width:9.8px;animation-duration:3.9s;animation-delay:3.3s' },
  { style: 'left:84%;width:9.8px;animation-duration:3.3s;animation-delay:.4s' },
  { style: 'left:97%;width:9.8px;animation-duration:4.7s;animation-delay:2.2s' },
];
---

<section id="hero">
  {slides.map((slide, i) => {
    const isActive = i === 0;
    const panClass = i === 2 ? 'ltsuan-pan-lr ltsuan-zoom-in' : 'ltsuan-slow-parallax';
    const personZoomClass = i === 1 ? 'ltsuan-person-grow-glow' : i === 2 ? 'ltsuan-person-grow' : '';
    const personBoxClass = i === 2 ? 'ltsuan-hero-person-worker' : '';
    return (
      <div class="ltsuan-hero-layer" data-idx={i} style={`z-index:${isActive ? 2 : 1};transform:translateY(${isActive ? 0 : -100}%)`}>
        <div class="ltsuan-hero-bg-wrap">
          <picture class="ltsuan-hero-bg-picture">
            <source type="image/avif" srcset={responsiveSrcset(slide.realImg, 'avif', slide.bgWidth)} sizes="115vw" />
            <img
              class:list={['ltsuan-hero-bg-img', panClass]}
              alt={slide.alt}
              src={slide.realImg}
              srcset={responsiveSrcset(slide.realImg, 'jpg', slide.bgWidth)}
              sizes="115vw"
              width={slide.bgWidth}
              height={slide.bgHeight}
              decoding="async"
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </picture>
          {i === 1 && (
            <>
              {beamTwinkles.map((beam) => (
                <div class="ltsuan-beam-twinkle" style={beam.style}></div>
              ))}
            </>
          )}
        </div>

        {slide.personImg && (
          <div class:list={['ltsuan-hero-person-box', personBoxClass]}>
            <picture style="display:block;width:100%;height:100%">
              <source type="image/avif" srcset={avifPath(slide.personImg)} />
              <img
                class:list={['ltsuan-hero-person-img', personZoomClass]}
                alt={slide.personAlt}
                src={slide.personImg}
                width={slide.personWidth}
                height={slide.personHeight}
                loading="lazy"
                decoding="async"
                style={i === 1 ? 'object-fit:contain;object-position:center bottom;filter:brightness(.78) contrast(1.35) saturate(1.05)' : 'object-fit:contain;object-position:center 100%'}
              />
            </picture>
            {i === 1 && <div class="ltsuan-hero-person-tint" style={`mask-image:url(${avifPath(slide.personImg)});-webkit-mask-image:url(${avifPath(slide.personImg)})`}></div>}
          </div>
        )}

        <div class="ltsuan-hero-overlay ltsuan-hero-overlay-1"></div>
        <div class="ltsuan-hero-overlay ltsuan-hero-overlay-2"></div>
        <div class="ltsuan-hero-overlay ltsuan-hero-overlay-3"></div>
        <div class="ltsuan-hero-overlay ltsuan-hero-overlay-4"></div>

        <div class="ltsuan-hero-content-wrap">
          <div class="ltsuan-hero-container">
            <div class="ltsuan-hero-text">
              <h1 class="ltsuan-hero-title" style={[
                slide.titleLineHeight ? `line-height:${slide.titleLineHeight}` : '',
                slide.titleFontScale ? `--ltsuan-title-scale:${slide.titleFontScale}` : '',
              ].filter(Boolean).join(';') || undefined}>
                <span class="ltsuan-hero-title-line-mask">
                  <span class:list={['ltsuan-reveal-line1', { 'is-revealed': isActive }]}>{slide.titleLine1}</span>
                </span>
                <span class="ltsuan-hero-title-line-mask ltsuan-hero-title-line2-mask">
                  <span class:list={['ltsuan-reveal-line2', { 'is-revealed': isActive }]}>{slide.titleLine2}</span>
                </span>
              </h1>
              <div class="ltsuan-hero-subtitle-wrap">
                <p class:list={['ltsuan-hero-subtitle', 'ltsuan-reveal-subtitle', { 'is-revealed': isActive }]} style={slide.subtitleLineHeight ? `line-height:${slide.subtitleLineHeight}` : undefined}>
                  {slide.subtitleLine1}
                  {slide.subtitleLine2 && (
                    <>
                      <br />
                      {slide.subtitleLine2}
                    </>
                  )}
                </p>
              </div>
              <div class="ltsuan-hero-cta-wrap" style={slide.ctaMarginTop ? `margin-top:${slide.ctaMarginTop}` : undefined}>
                <div class:list={['ltsuan-reveal-button', { 'is-revealed': isActive }]}>
                  <a href={slide.href} class="ltsuan-hero-cta">
                    <span>{slide.ctaLabel}</span>
                    <span class="ltsuan-hero-cta-line"></span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  })}

  <div class="ltsuan-hero-deco ltsuan-hero-frame">
    <div class="ltsuan-hero-frame-corner ltsuan-hero-frame-corner-tl"></div>
    <div class="ltsuan-hero-frame-corner ltsuan-hero-frame-corner-tr"></div>
    <div class="ltsuan-hero-frame-corner ltsuan-hero-frame-corner-bl"></div>
    <div class="ltsuan-hero-frame-corner ltsuan-hero-frame-corner-br"></div>
  </div>

  <div class="ltsuan-hero-deco ltsuan-hero-rail">
    <div class="ltsuan-hero-rail-track">
      <div id="ltsuan-rail-progress" class="ltsuan-hero-rail-progress" style={`transform:scaleY(${(1 / slides.length).toFixed(3)})`}></div>
    </div>
    <div class="ltsuan-hero-dots">
      {slides.map((slide, i) => (
        <button
          class="ltsuan-dot-btn"
          data-idx={i}
          aria-label={`Go to slide: ${slide.titleLine1} ${slide.titleLine2}`}
        >
          <div class:list={['ltsuan-dot-num', { 'is-active': i === 0 }]}>{String(i + 1).padStart(2, '0')}</div>
          <div class:list={['ltsuan-dot-ping', { 'is-active': i === 0 }]}></div>
        </button>
      ))}
    </div>
    <div class="ltsuan-hero-rail-tail"></div>
    <div id="ltsuan-counter-label" class="ltsuan-hero-counter">{`SCROLL — 01 / ${String(slides.length).padStart(2, '0')}`}</div>
  </div>

  <div class="ltsuan-hero-bottom-row">
    <div class="ltsuan-hero-scroll-group">
      <div class="ltsuan-hero-deco ltsuan-hero-scrollcue">
        <div class="ltsuan-hero-scroll-circle">
          <div class="ltsuan-hero-scroll-track">
            <div class="ltsuan-beam"></div>
          </div>
        </div>
        <p class="ltsuan-hero-scroll-label">SCROLL TO EXPLORE</p>
      </div>
    </div>
    <div class="ltsuan-hero-auto-group">
      <button id="ltsuan-auto-toggle" class="ltsuan-auto-toggle" aria-label="Toggle automatic slide rotation" aria-pressed="true">
        <span class="ltsuan-auto-track is-on">
          <span id="ltsuan-auto-knob" class="ltsuan-auto-knob is-on"></span>
        </span>
      </button>
      <span class="ltsuan-hero-auto-label">AUTO <span id="ltsuan-auto-label">ON</span></span>
    </div>
  </div>
</section>

<style>
  #hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: var(--ltsuan-bg);
  }
  .ltsuan-hero-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transition: transform 1.1s cubic-bezier(0.76, 0, 0.24, 1);
    backface-visibility: hidden;
  }
  .ltsuan-hero-bg-wrap {
    position: absolute;
    inset: 0;
    transform: scale(1.05);
  }
  .ltsuan-hero-bg-picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ltsuan-hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    display: block;
  }
  .ltsuan-hero-person-box {
    position: absolute;
    inset: 0;
    transform-origin: center bottom;
  }
  .ltsuan-hero-layer[data-idx='1'] .ltsuan-hero-person-box {
    transform: translate(25%, 3%) scale(0.425);
  }
  .ltsuan-hero-person-img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .ltsuan-hero-person-tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: #1e4a7a;
    opacity: 0.4;
    mix-blend-mode: color;
    mask-size: contain;
    mask-position: center bottom;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    -webkit-mask-position: center bottom;
    -webkit-mask-repeat: no-repeat;
  }
  .ltsuan-hero-overlay {
    position: absolute;
    inset: 0;
  }
  .ltsuan-hero-overlay-1 {
    background: rgba(10, 10, 10, 0.15);
  }
  .ltsuan-hero-overlay-2 {
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.1) 55%, rgba(0, 0, 0, 0.2) 100%);
  }
  .ltsuan-hero-overlay-3 {
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.6) 0%, transparent 50%, rgba(0, 0, 0, 0.3) 100%);
  }
  .ltsuan-hero-overlay-4 {
    opacity: 0.6;
    background: radial-gradient(120% 90% at 50% 50%, transparent 60%, rgba(0, 0, 0, 0.7) 100%);
  }
  .ltsuan-beam-twinkle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 19.6px;
    pointer-events: none;
    mix-blend-mode: overlay;
    transform: rotate(-3deg);
    transform-origin: center;
    filter: brightness(1.15);
    mask-image: linear-gradient(90deg, transparent 0%, #000 35%, #000 65%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 35%, #000 65%, transparent 100%);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.9) 35%, rgba(255, 255, 255, 0.9) 65%, rgba(255, 255, 255, 0) 100%);
    animation-name: ltsuanBeamTwinkle;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .ltsuan-hero-content-wrap {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    display: flex;
    align-items: center;
  }
  .ltsuan-hero-container {
    width: 100%;
    max-width: 1280px;
    margin: 0;
    padding: 0 6vw 0 max(6vw, 100px);
  }
  .ltsuan-hero-text {
    max-width: 44%;
    position: relative;
  }
  .ltsuan-hero-title {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin: 0;
    pointer-events: auto;
    font-size: calc(clamp(40px, 8vw, 120px) * var(--ltsuan-title-scale, 1));
  }
  .ltsuan-hero-title-line-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.2em;
  }
  .ltsuan-hero-title-line2-mask {
    margin-top: calc(-0.05em + 5px);
  }
  .ltsuan-reveal-line1,
  .ltsuan-reveal-line2 {
    display: block;
    font-weight: 300;
    transition: transform 0.14s ease-in;
    transform: translateY(100vh);
  }
  .ltsuan-reveal-line1.is-revealed {
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.35s;
    transform: translateY(0%);
  }
  .ltsuan-reveal-line2.is-revealed {
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.5s;
    transform: translateY(0%);
  }
  .ltsuan-hero-subtitle-wrap {
    margin-top: 15px;
    margin-bottom: 22px;
    overflow: hidden;
    padding-bottom: 0.2em;
  }
  .ltsuan-hero-subtitle {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: clamp(30px, 2.4vw, 40px);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: rgba(244, 239, 232, 0.9);
    margin: 0;
    max-width: 36ch;
    line-height: 1.08;
    display: block;
    transition: transform 0.14s ease-in;
    transform: translateY(100vh);
  }
  .ltsuan-hero-subtitle.is-revealed {
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.65s;
    transform: translateY(0%);
  }
  .ltsuan-hero-cta-wrap {
    margin-top: -7px;
    overflow: hidden;
    padding-bottom: 0.2em;
  }
  .ltsuan-reveal-button {
    display: flex;
    align-items: center;
    gap: 20px;
    transition: transform 0.14s ease-in;
    transform: translateY(100vh);
  }
  .ltsuan-reveal-button.is-revealed {
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.8s;
    transform: translateY(0%);
  }
  .ltsuan-hero-cta {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 44px;
    padding: 0 28px;
    border-radius: 999px;
    border: 1px solid rgba(244, 239, 232, 0.25);
    background: rgba(244, 239, 232, 0.06);
    backdrop-filter: blur(6px);
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--ltsuan-text);
    text-decoration: none;
    transition: all 0.35s ease;
  }
  .ltsuan-hero-cta:hover {
    background: var(--ltsuan-text);
    border-color: var(--ltsuan-text);
    color: #0a0a0a;
  }
  .ltsuan-hero-cta-line {
    width: 20px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  @media (min-width: 1280px) and (max-width: 1699px) {
    .ltsuan-hero-title {
      font-size: calc(clamp(40px, 6vw, 88px) * var(--ltsuan-title-scale, 1));
    }
  }
  @media (min-width: 1700px) {
    .ltsuan-hero-text {
      max-width: 50%;
    }
    .ltsuan-hero-title {
      font-size: calc(clamp(120px, 6.2vw, 145px) * var(--ltsuan-title-scale, 1));
    }
    .ltsuan-hero-container {
      max-width: 1500px;
    }
  }
  @media (min-width: 2200px) {
    .ltsuan-hero-text {
      max-width: 50%;
    }
    .ltsuan-hero-title {
      font-size: calc(clamp(120px, 6.2vw, 165px) * var(--ltsuan-title-scale, 1));
    }
    .ltsuan-hero-container {
      max-width: 1750px;
    }
  }
  @media (max-width: 900px) {
    .ltsuan-hero-deco {
      display: none;
    }
    .ltsuan-hero-text {
      max-width: 92%;
    }
    .ltsuan-hero-container {
      padding-left: 6vw;
    }
    .ltsuan-hero-person-worker {
      top: 15% !important;
    }
    .ltsuan-hero-person-worker .ltsuan-hero-person-img {
      object-fit: cover !important;
      object-position: 46% 15% !important;
    }
  }
  @media (min-width: 901px) and (max-width: 1699px) {
    .ltsuan-hero-person-worker {
      left: 25% !important;
      width: 75% !important;
    }
    .ltsuan-hero-person-worker .ltsuan-hero-person-img {
      object-fit: cover !important;
      object-position: 40% 20% !important;
    }
  }

  /* Decorative frame + right-hand rail (shared across all slides, not per-layer) */
  .ltsuan-hero-frame {
    position: absolute;
    left: 79px;
    right: 6vw;
    top: 6vh;
    bottom: 84px;
    border: 1px solid rgba(244, 239, 232, 0.08);
    z-index: 9;
    pointer-events: none;
  }
  .ltsuan-hero-frame-corner {
    position: absolute;
    width: 32px;
    height: 32px;
  }
  .ltsuan-hero-frame-corner-tl {
    top: -1px;
    left: -1px;
    border-top: 1px solid rgba(244, 239, 232, 0.2);
    border-left: 1px solid rgba(244, 239, 232, 0.2);
  }
  .ltsuan-hero-frame-corner-tr {
    top: -1px;
    right: -1px;
    border-top: 1px solid rgba(244, 239, 232, 0.2);
    border-right: 1px solid rgba(244, 239, 232, 0.2);
  }
  .ltsuan-hero-frame-corner-bl {
    bottom: -1px;
    left: -1px;
    border-bottom: 1px solid rgba(244, 239, 232, 0.2);
    border-left: 1px solid rgba(244, 239, 232, 0.2);
  }
  .ltsuan-hero-frame-corner-br {
    bottom: -1px;
    right: -1px;
    border-bottom: 1px solid rgba(244, 239, 232, 0.2);
    border-right: 1px solid rgba(244, 239, 232, 0.2);
  }

  .ltsuan-hero-rail {
    position: absolute;
    right: 4vw;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .ltsuan-hero-rail-track {
    position: relative;
    width: 1px;
    height: 18vh;
    background: rgba(244, 239, 232, 0.1);
    overflow: hidden;
  }
  .ltsuan-hero-rail-progress {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--ltsuan-accent);
    transform-origin: top;
    transition: transform 0.7s cubic-bezier(0.85, 0, 0.15, 1);
  }
  .ltsuan-hero-dots {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ltsuan-dot-btn {
    position: relative;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
  }
  .ltsuan-dot-num {
    position: relative;
    z-index: 1;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 8px;
    letter-spacing: 0.03em;
    transition: all 0.4s ease;
    border: 1px solid rgba(244, 239, 232, 0.4);
    background: transparent;
    color: rgba(244, 239, 232, 0.3);
  }
  .ltsuan-dot-num.is-active {
    border: 1px solid var(--ltsuan-accent);
    background: var(--ltsuan-accent);
    color: #0a0a0a;
    transform: scale(1.1);
  }
  .ltsuan-dot-ping {
    position: absolute;
    inset: -7px;
    border-radius: 50%;
    border: 1px solid rgba(140, 200, 30, 0.35);
    pointer-events: none;
    opacity: 0;
  }
  .ltsuan-dot-ping.is-active {
    opacity: 1;
    animation: ltsuanPing 2.5s ease-out infinite;
  }
  .ltsuan-hero-rail-tail {
    width: 1px;
    height: 6vh;
    background: linear-gradient(rgba(244, 239, 232, 0.1), transparent);
  }
  .ltsuan-hero-counter {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 10px;
    letter-spacing: 0.25em;
    opacity: 0.2;
  }

  .ltsuan-hero-bottom-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    padding: 0 6vw;
    padding-bottom: 28px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    pointer-events: none;
  }
  .ltsuan-hero-scroll-group {
    display: flex;
    align-items: center;
    gap: 24px;
    pointer-events: auto;
  }
  .ltsuan-hero-scrollcue {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ltsuan-hero-scroll-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(244, 239, 232, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ltsuan-hero-scroll-track {
    position: relative;
    width: 1px;
    height: 16px;
    overflow: hidden;
    background: rgba(244, 239, 232, 0.15);
  }
  .ltsuan-beam {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 8px;
    background: var(--ltsuan-text);
    animation: ltsuanBeam 1.6s ease-in-out infinite;
  }
  .ltsuan-hero-scroll-label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    opacity: 0.5;
    margin: 0;
  }
  .ltsuan-hero-auto-group {
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
  }
  .ltsuan-auto-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .ltsuan-auto-track {
    position: relative;
    width: 38px;
    height: 18px;
    border-radius: 999px;
    border: 1px solid rgba(244, 239, 232, 0.15);
    background: transparent;
  }
  .ltsuan-auto-track.is-on {
    border-color: rgba(244, 239, 232, 0.4);
    background: rgba(244, 239, 232, 0.1);
  }
  .ltsuan-auto-knob {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 14px;
    height: 14px;
    background: var(--ltsuan-text);
    border-radius: 50%;
    transition: left 0.25s ease;
  }
  .ltsuan-auto-knob.is-on {
    left: 19px;
  }
  .ltsuan-hero-auto-label {
    font-family: 'Oswald', 'Noto Sans TC', sans-serif;
    font-size: 9px;
    letter-spacing: 0.2em;
    opacity: 0.4;
  }

  @keyframes ltsuanPing {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    75%,
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  @keyframes ltsuanBeam {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(500%);
    }
  }
  @keyframes ltsuanBeamTwinkle {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes ltsuanPanLR {
    0% {
      object-position: 85% 45%;
    }
    100% {
      object-position: 15% 45%;
    }
  }
  @keyframes ltsuanSlowParallax {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.05);
    }
  }
  @keyframes ltsuanZoomIn {
    0% {
      transform: scale(1) translateY(0);
    }
    100% {
      transform: scale(0.96) translateY(0);
    }
  }
  @keyframes ltsuanPersonGrow {
    0% {
      transform: scale(0.96);
    }
    100% {
      transform: scale(1.04);
    }
  }
  @keyframes ltsuanPersonGlow {
    0%,
    100% {
      filter: brightness(0.78) contrast(1.35) saturate(1.05);
    }
    50% {
      filter: brightness(1.2) contrast(1.4) saturate(1.1);
    }
  }
  .ltsuan-slow-parallax {
    animation: ltsuanSlowParallax 9s ease-in-out infinite alternate;
  }
  .ltsuan-pan-lr {
    animation: ltsuanPanLR 5s ease-in-out 1 forwards;
  }
  .ltsuan-zoom-in {
    animation: ltsuanZoomIn 5s ease-out 1 forwards;
  }
  .ltsuan-person-grow {
    animation: ltsuanPersonGrow 5s ease-out 1 forwards;
    transform-origin: center bottom;
  }
  .ltsuan-person-grow-glow {
    transform-origin: center bottom;
    animation-name: ltsuanPersonGrow, ltsuanPersonGlow;
    animation-duration: 5s, 4.6s;
    animation-timing-function: ease-out, ease-in-out;
    animation-delay: 0s, 2.4s;
    animation-iteration-count: 1, infinite;
    animation-fill-mode: forwards, none;
  }
</style>

<script>
  const hero = document.getElementById('hero')!;
  const layers = Array.from(hero.querySelectorAll<HTMLElement>('.ltsuan-hero-layer'));
  const dots = Array.from(hero.querySelectorAll<HTMLButtonElement>('.ltsuan-dot-btn'));
  const railProgress = document.getElementById('ltsuan-rail-progress')!;
  const counterLabel = document.getElementById('ltsuan-counter-label')!;
  const autoToggleBtn = document.getElementById('ltsuan-auto-toggle')!;
  const autoTrack = autoToggleBtn.querySelector('.ltsuan-auto-track')!;
  const autoKnob = document.getElementById('ltsuan-auto-knob')!;
  const autoLabelEl = document.getElementById('ltsuan-auto-label')!;

  const total = layers.length;
  let active = 0;
  let auto = true;
  let transitioning = false;
  let autoTimer: ReturnType<typeof setTimeout> | null = null;
  let textTimer: ReturnType<typeof setTimeout> | null = null;
  let parallaxRAF: number | null = null;

  function restartAnimation(el: Element | null) {
    if (!el) return;
    (el as HTMLElement).style.animation = 'none';
    void (el as HTMLElement).offsetHeight;
    (el as HTMLElement).style.animation = '';
  }

  function setRevealed(layer: HTMLElement, revealed: boolean) {
    layer.querySelector('.ltsuan-reveal-line1')?.classList.toggle('is-revealed', revealed);
    layer.querySelector('.ltsuan-reveal-line2')?.classList.toggle('is-revealed', revealed);
    layer.querySelector('.ltsuan-hero-subtitle')?.classList.toggle('is-revealed', revealed);
    layer.querySelector('.ltsuan-reveal-button')?.classList.toggle('is-revealed', revealed);
  }

  function updateDots() {
    dots.forEach((dot, i) => {
      dot.querySelector('.ltsuan-dot-num')?.classList.toggle('is-active', i === active);
      dot.querySelector('.ltsuan-dot-ping')?.classList.toggle('is-active', i === active);
    });
  }

  function updateRail() {
    railProgress.style.transform = `scaleY(${((active + 1) / total).toFixed(3)})`;
    counterLabel.textContent = `SCROLL — ${String(active + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
  }

  function maybeStartAuto() {
    if (autoTimer) clearTimeout(autoTimer);
    if (!auto) return;
    autoTimer = setTimeout(() => changeSlide((active + 1) % total), 5000);
  }

  function changeSlide(idx: number) {
    if (idx === active || transitioning) return;
    const entering = layers[idx];
    entering.style.transition = 'none';
    entering.style.transform = 'translateY(100%)';
    void entering.offsetHeight;
    entering.style.transition = '';

    restartAnimation(entering.querySelector('.ltsuan-hero-bg-img'));
    restartAnimation(entering.querySelector('.ltsuan-hero-person-img'));

    transitioning = true;
    setRevealed(layers[active], false);
    if (textTimer) clearTimeout(textTimer);
    textTimer = setTimeout(() => {
      layers[active].style.zIndex = '1';
      layers[active].style.transform = 'translateY(-100%)';
      active = idx;
      layers[active].style.zIndex = '2';
      layers[active].style.transform = 'translateY(0%)';
      setRevealed(layers[active], true);
      transitioning = false;
      updateDots();
      updateRail();
      maybeStartAuto();
    }, 320);
  }

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.dataset.idx);
      changeSlide(idx);
    });
  });

  autoToggleBtn.addEventListener('click', () => {
    auto = !auto;
    autoTrack.classList.toggle('is-on', auto);
    autoKnob.classList.toggle('is-on', auto);
    autoLabelEl.textContent = auto ? 'ON' : 'OFF';
    maybeStartAuto();
  });

  hero.addEventListener('mousemove', (e) => {
    if (parallaxRAF) return;
    const rect = hero.getBoundingClientRect();
    const nx = (e.clientX - rect.left) / rect.width - 0.5;
    const ny = (e.clientY - rect.top) / rect.height - 0.5;
    parallaxRAF = requestAnimationFrame(() => {
      parallaxRAF = null;
      const activeLayer = layers[active];
      const idx = Number(activeLayer.dataset.idx);
      const personBox = activeLayer.querySelector<HTMLElement>('.ltsuan-hero-person-box');
      if (idx === 2 && personBox) {
        personBox.style.transition = 'transform .2s ease-out';
        personBox.style.transform = `translate(${(nx * -15.4).toFixed(1)}px, ${(ny * -11).toFixed(1)}px)`;
      }
      const bgWrap = activeLayer.querySelector<HTMLElement>('.ltsuan-hero-bg-wrap');
      if (idx === 2 && bgWrap) {
        bgWrap.style.transition = 'transform .2s ease-out';
        bgWrap.style.transform = `translate(${(nx * -6.6).toFixed(1)}px, ${(ny * -5.5).toFixed(1)}px) scale(1.05)`;
      }
    });
  });

  hero.addEventListener('mouseleave', () => {
    const activeLayer = layers[active];
    const idx = Number(activeLayer.dataset.idx);
    if (idx === 2) {
      const personBox = activeLayer.querySelector<HTMLElement>('.ltsuan-hero-person-box');
      if (personBox) personBox.style.transform = 'translate(0px, 0px)';
      const bgWrap = activeLayer.querySelector<HTMLElement>('.ltsuan-hero-bg-wrap');
      if (bgWrap) bgWrap.style.transform = 'scale(1.05)';
    }
  });

  maybeStartAuto();
</script>
