---
interface Props {
  size?: number;
  opacity?: number;
}
const { size = 16, opacity = 0.7 } = Astro.props;
const base = `position:absolute;width:${size}px;height:${size}px;opacity:${opacity}`;
---

<span style={`${base};top:${size >= 16 ? 14 : size >= 14 ? 10 : 6}px;left:${size >= 16 ? 14 : size >= 14 ? 10 : 6}px;border-top:1px solid var(--ltsuan-blueprint);border-left:1px solid var(--ltsuan-blueprint)`}></span>
<span style={`${base};top:${size >= 16 ? 14 : size >= 14 ? 10 : 6}px;right:${size >= 16 ? 14 : size >= 14 ? 10 : 6}px;border-top:1px solid var(--ltsuan-blueprint);border-right:1px solid var(--ltsuan-blueprint)`}></span>
<span style={`${base};bottom:${size >= 16 ? 14 : size >= 14 ? 10 : 6}px;left:${size >= 16 ? 14 : size >= 14 ? 10 : 6}px;border-bottom:1px solid var(--ltsuan-blueprint);border-left:1px solid var(--ltsuan-blueprint)`}></span>
<span style={`${base};bottom:${size >= 16 ? 14 : size >= 14 ? 10 : 6}px;right:${size >= 16 ? 14 : size >= 14 ? 10 : 6}px;border-bottom:1px solid var(--ltsuan-blueprint);border-right:1px solid var(--ltsuan-blueprint)`}></span>
